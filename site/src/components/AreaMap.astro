---
// Offensive zone from above, net at the top, drawn from the shooter's point of view (his left on the left).
// Two layers: areas of the zone shaded by how much of his shooting comes from each, and every unblocked shot.
// Areas are rings and wedges around the middle of the net with softened corners (lib/areaShapes.ts). Their outlines
// live once per page in AreaShapes.astro, which a page using this map must include.
interface AreaStat { shots: number; goals: number; share: number; avg: number }
interface Props {
  id: string;
  areas: Record<string, AreaStat>;
  shots?: [number, number, number, number, number][];
  tip: (key: string, a: AreaStat) => string;
  label: (a: AreaStat) => string;
  shade: (a: AreaStat) => number; // 0..1
}
const { id, areas, shots = [], tip, label, shade } = Astro.props;
import { sx, sy, polar, AREA_KEYS, shapeId, type Pt } from '../lib/areaShapes';
// Where each area's number sits, as [distance from the net, degrees off straight out] for the left-hand areas.
const spot: Record<string, [number, number]> = {
  crease: [3.4, 0], behind: [6.5, 180], lowSlot: [15, 0], netSideL: [15, 60], cornerL: [30, 96], highSlot: [34, 0],
  circleL: [34, 44], outerL: [53, 45], point: [55, 0], pointL: [65, 32],
};
const centre = (k: string): Pt => {
  const [d, a] = spot[k] ?? spot[k.replace(/R$/, 'L')];
  return polar(d, k.endsWith('R') ? -a : a);
};
const board = 'M0 75 V26 A26 26 0 0 1 26 0 H59 A26 26 0 0 1 85 26 V75';
---
<figure class="areamap" id={id}>
  <svg viewBox="-1 -1 87 78" role="img" aria-label="Where his shots come from">
    <defs><clipPath id={`${id}-clip`}><path d={`${board} Z`} /></clipPath></defs>
    <path class="rk-board" d={board} />
    <g clip-path={`url(#${id}-clip)`} class="am-areas">
      {AREA_KEYS.map((k) => (
        <g class="am-area" data-tip={tip(k, areas[k])} tabindex="0" style={`--s:${shade(areas[k] ?? { shots: 0, goals: 0, share: 0, avg: 0 })}`}>
          <use href={`#${shapeId(k)}`} />
        </g>
      ))}
    </g>
    <line class="rk-blue" x1="0" x2="85" y1="75" y2="75" />
    <line class="rk-red" x1="4.2" x2="80.8" y1="11" y2="11" />
    <circle class="rk-thin" cx="20.5" cy="31" r="15" /><circle class="rk-thin" cx="64.5" cy="31" r="15" />
    <path class="rk-crease" d="M36.5 11 A6 6 0 0 0 48.5 11" />
    <rect class="rk-net" x="39.5" y="8" width="6" height="3" />
    <g class="am-labels">
      {AREA_KEYS.map((k) => { const [x, y] = centre(k); const a = areas[k]; return a && a.shots > 0 && <text x={+x.toFixed(1)} y={+(y + 1.3).toFixed(1)} class:list={{ dark: shade(a) > 0.55 }}>{label(a)}</text>; })}
    </g>
    <g class="am-shots">
      {shots.filter((s) => s[0] >= 25).map(([x, y, xg, goal, cur]) => <circle class:list={['ps', { goal: goal === 1, old: cur === 0 }]} cx={sx(y)} cy={sy(x)} r={+(0.7 + Math.sqrt(xg / 1000) * 3.6).toFixed(2)} />)}
    </g>
    {/* SVG has no z-index, so the hover outline is a copy of each area drawn above everything else. */}
    <g class="am-rings" clip-path={`url(#${id}-clip)`}>
      {AREA_KEYS.map((k) => <use href={`#${shapeId(k)}`} />)}
    </g>
  </svg>
</figure>

<style is:global>
  .areamap svg { width: 100%; height: auto; display: block; }
  .am-area use { fill: color-mix(in oklab, var(--ink) calc(var(--s) * 62%), var(--sheet)); stroke: var(--sheet); stroke-width: 0.7; stroke-linejoin: round; }
  .am-area { cursor: help; outline: none; }
  .am-rings use { fill: none; stroke: var(--ink); stroke-width: 0.6; stroke-linejoin: round; pointer-events: none; display: none; }
  .areamap.dots .am-rings { display: none; }
  /* One rule per area, in SHAPES order (15 areas). */
  .areamap svg:has(.am-area:nth-child(1):is(:hover, :focus)) .am-rings use:nth-child(1) { display: inline; }
  .areamap svg:has(.am-area:nth-child(2):is(:hover, :focus)) .am-rings use:nth-child(2) { display: inline; }
  .areamap svg:has(.am-area:nth-child(3):is(:hover, :focus)) .am-rings use:nth-child(3) { display: inline; }
  .areamap svg:has(.am-area:nth-child(4):is(:hover, :focus)) .am-rings use:nth-child(4) { display: inline; }
  .areamap svg:has(.am-area:nth-child(5):is(:hover, :focus)) .am-rings use:nth-child(5) { display: inline; }
  .areamap svg:has(.am-area:nth-child(6):is(:hover, :focus)) .am-rings use:nth-child(6) { display: inline; }
  .areamap svg:has(.am-area:nth-child(7):is(:hover, :focus)) .am-rings use:nth-child(7) { display: inline; }
  .areamap svg:has(.am-area:nth-child(8):is(:hover, :focus)) .am-rings use:nth-child(8) { display: inline; }
  .areamap svg:has(.am-area:nth-child(9):is(:hover, :focus)) .am-rings use:nth-child(9) { display: inline; }
  .areamap svg:has(.am-area:nth-child(10):is(:hover, :focus)) .am-rings use:nth-child(10) { display: inline; }
  .areamap svg:has(.am-area:nth-child(11):is(:hover, :focus)) .am-rings use:nth-child(11) { display: inline; }
  .areamap svg:has(.am-area:nth-child(12):is(:hover, :focus)) .am-rings use:nth-child(12) { display: inline; }
  .areamap svg:has(.am-area:nth-child(13):is(:hover, :focus)) .am-rings use:nth-child(13) { display: inline; }
  .areamap svg:has(.am-area:nth-child(14):is(:hover, :focus)) .am-rings use:nth-child(14) { display: inline; }
  .areamap svg:has(.am-area:nth-child(15):is(:hover, :focus)) .am-rings use:nth-child(15) { display: inline; }
  .am-labels text { font: 600 3.4px var(--ui); fill: var(--ink); text-anchor: middle; pointer-events: none; }
  .am-labels text.dark { fill: var(--sheet); }
  .am-shots { display: none; }
  .areamap.dots .am-shots { display: inline; }
  .areamap.dots .am-area use { fill: var(--sheet); stroke: none; }
  .areamap.dots .am-labels { display: none; }
  .areamap.dots .am-area { pointer-events: none; }
  .ps { fill: var(--team, var(--ink)); fill-opacity: 0.32; stroke: none; }
  .ps.goal { fill: var(--ink); fill-opacity: 0.95; stroke: var(--sheet); stroke-width: 0.3; }
  html[data-mode='season'] .ps.old { display: none; }
</style>
