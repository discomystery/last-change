---
// One league-percentile bar. The tick marks league average (50th); the thin line is the 80% range.
interface Props { team: string; pct: number; band?: number; label?: string; small?: boolean }
const { team, pct, band = 0, label, small = false } = Astro.props;
const lo = Math.max(0, pct - band);
const hi = Math.min(100, pct + band);
const tip = `${label ?? team}: ${pct}th percentile` + (band ? `, likely between ${Math.round(lo)} and ${Math.round(hi)}` : '');
---
<div class:list={['bar', `t-${team}`, { small }]} data-tip={tip}>
  <span class="bar-team">{team}</span>
  <span class="bar-track">
    <span class="bar-fill" style={`width:${pct}%`}></span>
    {band > 0 && <span class="bar-band" style={`left:${lo}%;width:${hi - lo}%`}></span>}
  </span>
  <span class="bar-val">{pct}</span>
</div>
