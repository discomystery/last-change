---
// The post-game reveal of our hidden pre-game win chance, told as a scroll story: the gauge and one line of text stay
// still on screen while scrolling fades each step's note in and out in place, and each step moves the needle by what
// that input was worth. "Show every step at once" swaps
// the story for the full list with the longer explanations (also what shows without scripts or with reduced motion).
export type Beat = { key: string; label: string; short: string; long?: string; pts: number; before: number; end: number; sum?: boolean };
interface Props { team: string; teamCls: string; other: string; otherCls: string; chance: number; outcome: string; beats: Beat[] }
const { team, teamCls, other, otherCls, chance, outcome, beats } = Astro.props;
// Small tracks in the full list run from 20% to 80% so a few points still show; the big gauge runs 0 to 100.
const at = (v: number) => Math.max(0, Math.min(100, ((v - 20) / 60) * 100));
const signed = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${-n}` : '0');
const steps = beats.filter((b) => !b.sum && b.key !== 'start');
---
<div class="cs" data-team={team} data-other={other}>
  <div class="cs-head">
    <p class="mini-h">Our win chance, kept hidden until the final</p>
    <button type="button" class="cs-toggle" hidden><span class="to-list">Show every step at once</span><span class="to-story">Play it as a story</span></button>
  </div>

  <div class="cs-story" hidden style={`--n:${beats.length}`}>
    <div class="cs-stage">
      <div class="cs-gauge">
        <p class="cs-num"><span class="cs-val">50</span>%<small>for {team} to win</small></p>
        <div class={`cs-track ${otherCls}`}>
          <span class={`cs-fill ${teamCls}`} style="width:50%"></span>
          <i class="cs-mid"></i>
          <i class="cs-ghost" style="left:50%"></i>
          <i class="cs-needle" style="left:50%"></i>
        </div>
        <div class="cs-ends"><span class={teamCls}><i></i>{team}</span><span class={otherCls}>{other}<i></i></span></div>
      </div>
      <ol class="cs-texts">
        {beats.map((b, i) => (
          <li class="cs-text" data-end={b.end.toFixed(2)} data-before={b.before.toFixed(2)} data-pts={b.pts} style={i ? 'opacity:0' : ''} aria-hidden={i ? 'true' : 'false'}>
            <p class="cs-title">{b.label}{!b.sum && b.key !== 'start' && <span class="cs-pts">{signed(b.pts)}</span>}</p>
            <p class="cs-line">{b.short}</p>
            {i === beats.length - 1 && <p class="cs-out">{outcome}</p>}
          </li>
        ))}
      </ol>
      <div class="cs-foot"><ol class="cs-pips" aria-hidden="true">{beats.map(() => <li></li>)}</ol><button type="button" class="cs-skip">Skip to every step</button></div>
    </div>
  </div>

  <div class="cs-list card">
    <p class="cs-num static"><span>{chance}%</span><small>for {team} to win, the morning of the game</small></p>
    <p class="cs-out">{outcome}</p>
    <ol class="steps">
      {beats.map((b) => (
        <li class:list={['step', { sum: b.sum, start: b.key === 'start' }]}>
          <div class="st-l"><b>{b.label}</b>{(b.long ?? (b.sum || b.key === 'start' ? '' : b.short)) && <span>{b.long ?? b.short}</span>}</div>
          <div class="st-t" aria-hidden="true">
            <i class="mid"></i>
            {b.pts !== 0 && !b.sum && <span class={`seg ${b.pts > 0 ? teamCls : otherCls}`} style={`left:${Math.min(at(b.before), at(b.end)).toFixed(1)}%;width:${Math.abs(at(b.end) - at(b.before)).toFixed(1)}%`}></span>}
            <i class="dot" style={`left:${at(b.end).toFixed(1)}%`}></i>
          </div>
          <div class="st-n">{!b.sum && b.key !== 'start' && signed(b.pts)}<b>{Math.round(b.end)}%</b></div>
        </li>
      ))}
    </ol>
    <p class="note small">Worked out the morning of the game, from earlier games only. The preview could hint at it in words but never showed the number.</p>
  </div>
</div>

<script is:inline>
  (() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.cs:not([data-ready])').forEach((cs) => {
      cs.dataset.ready = '1';
      const story = cs.querySelector('.cs-story'), list = cs.querySelector('.cs-list'), btn = cs.querySelector('.cs-toggle');
      const stage = cs.querySelector('.cs-stage'), val = cs.querySelector('.cs-val'), fill = cs.querySelector('.cs-fill');
      const needle = cs.querySelector('.cs-needle'), ghost = cs.querySelector('.cs-ghost');
      const texts = [...cs.querySelectorAll('.cs-text')], pips = [...cs.querySelectorAll('.cs-pips li')], n = texts.length;
      let shown = 50, raf = 0, current = -1, ticking = false;
      const tween = (to) => {
        cancelAnimationFrame(raf);
        const from = shown, t0 = performance.now(), dur = 650;
        const step = (t) => {
          const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
          shown = from + (to - from) * e;
          val.textContent = Math.round(shown);
          if (k < 1) raf = requestAnimationFrame(step);
        };
        raf = requestAnimationFrame(step);
      };
      // The needle moves once per step, when that step's note takes over.
      const setStep = (i) => {
        if (i === current) return;
        current = i;
        const t = texts[i], end = +t.dataset.end, before = +t.dataset.before, pts = +t.dataset.pts;
        fill.style.width = `${end}%`;
        needle.style.left = `${end}%`;
        ghost.style.left = `${before}%`;
        ghost.classList.toggle('seen', pts !== 0);
        pips.forEach((p, j) => p.classList.toggle('on', j <= i));
        texts.forEach((x, j) => x.setAttribute('aria-hidden', j === i ? 'false' : 'true'));
        tween(end);
      };
      // Each step owns an equal slice of the scroll. Inside its slice a note fades and drifts in, holds, then fades and
      // drifts out as the next one arrives (the first starts shown, the last stays).
      const frame = () => {
        ticking = false;
        if (story.hidden) return;
        // Progress runs from the moment the stage pins (story top reaches the stage's sticky top) to when it unpins.
        const r = story.getBoundingClientRect(), run = r.height - stage.offsetHeight, pin = parseFloat(getComputedStyle(stage).top) || 0;
        const p = Math.max(0, Math.min(1, (pin - r.top) / Math.max(1, run)));
        const f = p * n, i = Math.min(n - 1, Math.floor(f)), local = f - i;
        texts.forEach((t, j) => {
          let o = 0, y = 0;
          if (j === i) {
            const fadeIn = j === 0 ? 1 : Math.min(1, local / 0.22);
            const fadeOut = j === n - 1 ? 1 : Math.min(1, (1 - local) / 0.22);
            o = Math.min(fadeIn, fadeOut);
            y = j > 0 && local < 0.22 ? (1 - fadeIn) * 18 : j < n - 1 && local > 0.78 ? -(1 - fadeOut) * 18 : 0;
          }
          t.style.opacity = o.toFixed(3);
          t.style.transform = `translateY(${y.toFixed(1)}px)`;
        });
        setStep(i);
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
      const mode = (asStory) => { story.hidden = !asStory; list.hidden = asStory; cs.classList.toggle('as-story', asStory); if (asStory) frame(); };
      btn.hidden = false;
      btn.addEventListener('click', () => mode(story.hidden));
      cs.querySelector('.cs-skip').addEventListener('click', () => { mode(false); cs.scrollIntoView({ block: 'start' }); scrollBy(0, -90); });
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      mode(!reduce);
    });
  })();
</script>

<style>
  .cs { margin-top: 22px; }
  .cs-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 16px; }
  .cs-toggle { font: 500 13px var(--ui); color: var(--ink-2); background: var(--track); border: 0; border-radius: 999px; padding: 6px 12px; cursor: pointer; }
  .cs-toggle:hover { color: var(--ink); background: var(--rule); }
  .cs .to-story, .cs.as-story .to-list { display: none; }
  .cs.as-story .to-story { display: inline; }

  /* The story: one still frame (gauge, then the current note) pinned while the page scrolls under it. Each step gets
     a slice of scroll; the container is tall enough to give every step one. */
  .cs-story { position: relative; margin: 10px auto 0; max-width: 760px; height: calc(var(--n) * 48vh + 100vh); }
  .cs-stage { position: sticky; top: calc(var(--bar-h, 34px) + 12px); height: calc(100vh - var(--bar-h, 34px) - 24px);
    display: flex; flex-direction: column; }
  .cs-gauge { background: var(--sheet); border-radius: 18px; padding: 18px 22px 16px; box-shadow: 0 0 0 1px var(--rule); }
  .cs-num { display: flex; align-items: baseline; gap: 2px; margin: 0 0 14px; font: 700 64px/0.95 var(--display); font-variant-numeric: tabular-nums; }
  .cs-num small { font: 600 15px var(--ui); color: var(--ink-2); margin-left: 12px; }
  .cs-track { position: relative; height: 14px; border-radius: 999px; background: color-mix(in oklab, var(--team) 35%, var(--track)); }
  .cs-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 999px 0 0 999px; background: var(--team); transition: width 0.65s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .cs-mid { position: absolute; left: 50%; top: -5px; bottom: -5px; width: 2px; margin-left: -1px; background: var(--sheet); }
  .cs-ghost { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--ink-3); opacity: 0; transition: left 0.65s, opacity 0.3s; }
  .cs-ghost.seen { opacity: 0.6; }
  .cs-needle { position: absolute; top: 50%; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 3px var(--sheet);
    transition: left 0.65s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .cs-ends { display: flex; justify-content: space-between; margin-top: 10px; font: 600 13px var(--ui); }
  .cs-ends i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--team); margin: 0 6px; }

  /* Every note sits in the same spot; only the current one is visible. */
  .cs-texts { list-style: none; padding: 0; margin: 0; position: relative; flex: 1; min-height: 220px; }
  .cs-text { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;
    padding: 0 12px; will-change: opacity, transform; }
  .cs-title { font: 600 12px var(--ui); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin: 0 0 10px; display: flex; gap: 10px; align-items: center; }
  .cs-pts { font: 700 12px var(--ui); color: var(--ink); background: var(--track); border-radius: 999px; padding: 2px 9px; letter-spacing: 0.02em; }
  .cs-line { font: 600 30px/1.22 var(--display); max-width: 22ch; margin: 0; text-wrap: balance; }
  .cs-out { font: 400 20px/1.4 var(--body); color: var(--ink-2); margin: 14px 0 0; }
  .cs-foot { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-bottom: 12px; }
  .cs-skip { font: 500 12.5px var(--ui); color: var(--ink-3); background: none; border: 0; padding: 4px 8px; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--rule); }
  .cs-skip:hover { color: var(--ink); }
  .cs-pips { list-style: none; padding: 0; margin: 0; display: flex; justify-content: center; gap: 7px; }
  .cs-pips li { width: 7px; height: 7px; border-radius: 50%; background: var(--rule); transition: background 0.3s; }
  .cs-pips li.on { background: var(--ink-3); }

  /* Every step at once. */
  .cs-list { margin-top: 12px; }
  .cs-num.static { margin-top: 0; }
  .cs-list > .cs-out { margin: -4px 0 16px; }
  .steps { list-style: none; padding: 0; margin: 0; }
  .step { display: grid; grid-template-columns: minmax(0, 1fr) 180px 74px; grid-template-areas: 'l t n'; gap: 6px 16px; align-items: center;
    padding: 10px 0; border-top: 1px solid var(--rule); font: 400 14px/1.45 var(--ui); }
  .step:first-child { border-top: 0; }
  .st-l { grid-area: l; }
  .st-l b { display: block; font-weight: 600; }
  .st-l span { display: block; color: var(--ink-2); font-size: 13.5px; }
  .st-n { grid-area: n; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .st-n b { color: var(--ink); font-weight: 600; margin-left: 10px; }
  .st-t { grid-area: t; position: relative; height: 8px; background: var(--track); border-radius: 999px; }
  .st-t .mid { position: absolute; left: 50%; top: -4px; bottom: -4px; width: 1px; background: var(--ink-3); opacity: 0.5; }
  .st-t .seg { position: absolute; top: 0; bottom: 0; background: var(--team); border-radius: 999px; }
  .st-t .dot { position: absolute; top: 50%; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 2px var(--sheet); }
  .step.sum { border-top-color: var(--ink-3); }
  .step.sum .st-l b, .step.sum .st-n b { font-weight: 700; }

  @media (max-width: 719px) {
    .cs-story { height: calc(var(--n) * 55vh + 100vh); }
    .cs-stage { top: calc(var(--bar-h, 34px) + 58px); height: calc(100vh - var(--bar-h, 34px) - 58px - 76px); }
    .cs-gauge { padding: 14px 16px 12px; }
    .cs-num { font-size: 48px; margin-bottom: 10px; }
    .cs-line { font-size: 25px; }
    .cs-out { font-size: 18px; }
    .step { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'l n' 't t'; }
  }
  @media (prefers-reduced-motion: reduce) { .cs-fill, .cs-needle, .cs-ghost { transition: none; } }
</style>
