---
// "Who gets the offensive-zone faceoffs": how much a coach sends his busiest forwards out for attacking-zone faceoffs and leaves the
// defensive-zone draws to the bottom six. A habit, not good or bad, so it uses the neutral slider.
import Marker from './Marker.astro';
import teams from '../../public/data/teams.json';

interface Split { top: number; bottom: number; gap: number }
export interface Deploy { top: number; bottom: number; gap: number; last: number | null; games: number; blend: number; rank: number; of: number; pct: number; median: number; home: Split | null; road: Split | null }
interface Props { d: Deploy; abbr: string; title?: string; tonight?: 'home' | 'road'; cls?: string }
const { d, abbr, title, tonight, cls = '' } = Astro.props;
// Name who decides it: the head coach when we know him, else the team (plural verbs, as everywhere).
const team = (teams as any[]).find((t) => t.abbr === abbr);
const coach: string | null = team?.coach ?? null;
const who = coach ?? team?.place ?? abbr;
const does = coach ? 'does' : 'do';
const their = coach ? 'his' : 'their';

const nums = (t: number, b: number) => `${their} top forwards start there <strong>${t}%</strong> of the time, the bottom six <strong>${b}%</strong>`;
// Verdict from the ranked figure (both seasons, this one weighing more); the numbers are this season's.
const verdict = `${who} ${does} ${d.pct >= 70
  ? 'it more than most'
  : d.pct <= 30
    ? d.gap < 0 ? 'the opposite' : 'it less than most'
    : 'it about as much as most'}`;
const split = (s: Split) => `top forwards ${s.top}%, bottom six ${s.bottom}%`;
const homeRoad = d.home && d.road
  ? tonight === 'road'
    ? ` On the road, where the home coach has the last change: ${split(d.road)}. At home: ${split(d.home)}.`
    : ` At home, where they have the last change: ${split(d.home)}. On the road: ${split(d.road)}.`
  : '';
const lastBit = d.last === null ? '' : ` Last season their top forwards' number was ${d.last > 0 ? `${d.last} higher than the bottom six's` : d.last < 0 ? `${-d.last} lower than the bottom six's` : 'the same as the bottom six\'s'}.`;
const tip = `The percentages are how often each group starts in the offensive zone this season, counting only 5-on-5 faceoffs in the two ends (not center ice). Top forwards are each game's three forwards with the most 5-on-5 ice time; the bottom six are the six with the least. On a typical team the top forwards' number is about ${d.median} higher.${homeRoad}${lastBit} The slider ranks all ${d.of} teams on the gap between the two groups, counting last season too.`;
---
<div class={`card deploy ${cls}`}>
  <p class="mini-h">{title ?? 'Who gets the offensive-zone faceoffs'}</p>
  <p class="deploy-say">
    Most coaches give their top line the faceoffs in the offensive zone. {verdict}: <Fragment set:html={nums(d.top, d.bottom)} />.
  </p>
  <div class="deploy-scale">
    <span class="lo">Spread around</span>
    <Marker pct={d.pct} tip={`${d.pct > 55 ? `Saves the offensive-zone draws for the top forwards more than ${d.pct}% of teams` : d.pct < 45 ? `Spreads the offensive-zone draws around more than ${100 - d.pct}% of teams` : 'About as much as most teams'}. Not good or bad: a coaching choice.`} />
    <span class="hi">Saved for the top line</span>
    <span class="term" tabindex="0" data-tip={tip}>How this is measured</span>
  </div>
</div>

<style>
  .deploy { margin-top: 18px; }
  .deploy-say { margin: 6px 0 10px; font: 400 15px/1.5 var(--ui); }
  .deploy-scale { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font: 400 12.5px/1.3 var(--ui); color: var(--ink-3); }
  .deploy-scale .term { margin-left: auto; }
  @media (max-width: 520px) { .deploy-scale .term { margin-left: 0; flex-basis: 100%; } }
</style>
