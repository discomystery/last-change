          const flash = mk('rect', { x: x - 3, y: T, width: 6, height: B - T, fill: C[s.h], class: 'gf-flash' }, fx); flash.style.animationDuration = '0.6s'; setTimeout(() => flash.remove(), 700);
          chip(`<span class="t">${clock(s.t)}</span>Big chance · ${s.who}, ${Math.round(s.xg * 100)}%`, null, false);
        } else {
