---
// "How it unfolded" on post-game pages: the game replayed in game time from data/flow/{id}.json (pipeline/export/flow.py),
// fetched when the section comes near so the shots and shifts are not copied into the page. Two views of the same shots
// (expected goals piling up, or each team's pressure), a rink that fills in with them, a scoreboard with power-play tags,
// big chances and goals called out as they happen, and every shift folded away underneath. Playback runs on game time:
// quiet stretches skate by, the clock slows into dangerous chances and stops for a beat on goals. Pausing, or tapping a
// moment on the chart, shows who was on the ice; that moment stays until another tap or a replay. Visitors who ask for
// less motion see the finished chart and can still tap through it.
interface Props { id: number; away: string; home: string; awayName: string; homeName: string; score: [number, number]; end: string }
const { id, away, home, awayName, homeName, score, end } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="card gflow" id="gflow" data-src={`${base}data/flow/${id}.json`} data-away={away} data-home={home} data-an={awayName} data-hn={homeName} data-score={score.join(',')} data-end={end}>
  <div class="pick gf-pick"><span>Show the game as</span><select id="gf-view" aria-label="Chart"><option value="pile">chances piling up</option><option value="ice">who had the ice</option></select></div>
  <div class="gf-bar">
    <button class="gf-play" type="button" id="gf-play" aria-label="Play the game"><svg viewBox="0 0 10 10" id="gf-pi" aria-hidden="true"><path d="M1.5 0.5 9.5 5 1.5 9.5Z" /></svg></button>
    <div class="gf-board" aria-live="polite"><span class="gf-clk" id="gf-clk">Final</span><span class="gf-sc" id="gf-sc"></span></div>
  </div>
  <div class="gf-calls" id="gf-calls" aria-live="polite"></div>
  <div class="gf-stage" id="gf-stage"><p class="gf-wait">Loading the game…</p></div>
  <div class="gf-key" id="gf-key"></div>
</div>

<style is:global>
  .gflow { --c0: var(--away); --c1: var(--home); }
  .gflow .gf-pick { margin-top: 0; }
  .gf-wait { font: 500 14px var(--ui); color: var(--ink-3); padding: 40px 0; text-align: center; }
  .gf-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 12px; }
  /* A small round play button, the same size as Run it back's replay icon. */
  .gf-play { flex: none; width: 30px; height: 30px; padding: 0; color: var(--sheet); background: var(--ink); border: 0; border-radius: 50%; cursor: pointer; display: grid; place-items: center; }
  .gf-play svg { width: 11px; height: 11px; fill: currentColor; }
  .gf-play:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .gf-board { display: flex; align-items: center; gap: 12px; margin-left: auto; white-space: nowrap; font: 600 15px var(--ui); font-variant-numeric: tabular-nums; }
  .gf-clk { color: var(--ink-3); width: 6.6em; text-align: right; white-space: nowrap; }
  .gf-sc { display: inline-flex; gap: 8px; align-items: center; }
  .gf-n { font: 600 22px/1 var(--display); font-variation-settings: 'SOFT' 100; font-variant-numeric: tabular-nums; min-width: 0.75em; text-align: center; display: inline-block; }
  .gf-n.bump { animation: gf-bump 0.7s cubic-bezier(0.3, 1.8, 0.5, 1); }
  @keyframes gf-bump { 0% { transform: scale(1); } 30% { transform: scale(1.7); } 100% { transform: scale(1); } }
  .gf-pp { font: 800 10px var(--ui); letter-spacing: 0.08em; color: #fff; background: var(--c); border-radius: 4px; padding: 2px 5px; opacity: 0; transform: scale(0.6); transition: opacity 0.25s, transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .gf-pp.on { opacity: 1; transform: none; }
  /* Phones: the clock and score share one row with the play button, so everything tightens to fit 360 px. */
  @media (max-width: 480px) {
    .gf-bar, .gf-board { gap: 8px; }
    .gf-board { font-size: 13.5px; min-width: 0; }
    .gf-clk { width: 5.9em; }
    .gf-sc { gap: 5px; }
    .gf-n { font-size: 20px; }
    .gf-pp { font-size: 9px; padding: 2px 4px; letter-spacing: 0.05em; }
  }
  .gf-calls { height: 28px; margin-top: 10px; display: flex; gap: 6px; align-items: center; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, #000 78%, transparent); mask-image: linear-gradient(90deg, #000 78%, transparent); }
  .gf-chip { flex: none; max-width: 340px; overflow: hidden; white-space: nowrap; font: 600 13px var(--ui); padding: 4px 11px; border-radius: 999px; background: var(--track); color: var(--ink); transition: opacity 0.4s; animation: gf-chipin 0.5s cubic-bezier(0.25, 1.2, 0.4, 1); }
  .gf-chip.old { opacity: 0.55; }
  .gf-chip .t { color: var(--ink-3); font-weight: 500; margin-right: 6px; }
  .gf-chip.goal { background: var(--c); color: #fff; letter-spacing: 0.02em; }
  .gf-chip.goal .t { color: rgba(255, 255, 255, 0.75); }
  .gf-chip.goal b { font-weight: 800; margin-right: 6px; letter-spacing: 0.08em; }
  @keyframes gf-chipin { from { max-width: 0; opacity: 0; padding-left: 0; padding-right: 0; } }
  .gf-stage { position: relative; margin-top: 6px; }
  .gf-stage svg { width: 100%; height: auto; display: block; touch-action: pan-y; overflow: visible; }
  .gf-ax { font: 500 11px var(--ui); fill: var(--ink-3); }
  .gf-axh { font: 600 10px var(--ui); letter-spacing: 0.08em; fill: var(--ink-3); }
  .gf-lab { font: 600 11.5px var(--ui); fill: var(--ink-2); }
  .gf-gl { transition: opacity 0.2s; }
  .gf-tip { position: absolute; pointer-events: none; background: var(--ink); color: var(--sheet); font: 500 12px/1.4 var(--ui); padding: 6px 9px; border-radius: 8px; white-space: nowrap; transform: translate(-50%, calc(-100% - 10px)); opacity: 0; transition: opacity 0.12s; z-index: 3; }
  .gf-tip.on { opacity: 1; }
  .gf-key { display: flex; gap: 6px 16px; flex-wrap: wrap; font: 500 13px var(--ui); color: var(--ink-2); margin-top: 10px; }
  .gf-key i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; background: var(--c); }
  .gf-key .ring { background: none; border: 2px solid var(--ink-2); width: 7px; height: 7px; }
  .gf-key .hollow { background: none; border: 1.5px dashed var(--ink-3); width: 8px; height: 8px; }
  .gf-sname { font: 500 9.5px var(--ui); fill: var(--ink-3); transition: fill 0.2s; }
  .gf-sname.on, .gf-sname.hl { fill: var(--ink); font-weight: 700; }
  .gf-sgrp { font: 700 8px var(--ui); fill: var(--ink-3); letter-spacing: 0.06em; }
  .gf-sbar { opacity: 0.5; transition: opacity 0.2s; }
  .live .gf-srow .gf-sbar { opacity: 0.28; }
  .live .gf-srow.on .gf-sbar { opacity: 1; }
  .picking .gf-srow .gf-sbar { opacity: 0.15; }
  .picking .gf-srow.hl .gf-sbar { opacity: 1; }
  .gf-srow.gflash .gf-sbar, .gf-srow.gflash .gf-strack { animation: gf-gflash 1.2s ease-out; }
  .gf-sname.gflash { animation: gf-gname 1.2s ease-out; }
  @keyframes gf-gflash { 0%, 40% { opacity: 1; filter: brightness(1.25) saturate(1.3); } }
  @keyframes gf-gname { 0%, 50% { fill: var(--ink); font-weight: 800; } }
  .gf-onice { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 18px; margin-top: 10px; padding: 0 14px; border-radius: 10px; background: var(--ice); font: 500 13.5px/1.45 var(--ui); max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.35s ease, opacity 0.3s, padding 0.3s; }
  .gf-onice.on { max-height: 260px; opacity: 1; padding-block: 12px; }
  .gf-onice p { margin: 0; }
  .gf-onice .ic-t { grid-column: 1 / -1; font: 600 11px var(--ui); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .gf-onice .ic { border-left: 3px solid var(--c); padding-left: 10px; min-width: 0; }
  .gf-onice .ic-h { font-weight: 700; display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .gf-onice .ic-h span { font-weight: 500; font-size: 12px; color: var(--ink-3); }
  .gf-onice .ic p b { display: inline-block; width: 16px; color: var(--ink-3); font-size: 11px; }
  .gf-onice .ltag { font: 700 10px var(--ui); color: var(--ink-2); background: var(--sheet); border-radius: 4px; padding: 1px 5px; margin-left: 6px; }
  .gf-onice .none { color: var(--ink-3); font-style: italic; }
  @media (max-width: 560px) { .gf-onice { grid-template-columns: 1fr; } }
  details.gf-fold { margin-top: 12px; }
  details.gf-fold summary { list-style: none; cursor: pointer; text-align: center; padding: 2px; }
  details.gf-fold summary span { display: inline-block; font: 500 12.5px var(--ui); color: var(--ink-2); border: 1px solid var(--rule); border-radius: 999px; padding: 4px 12px; transition: border-color 0.15s, color 0.15s; }
  details.gf-fold summary:hover span { border-color: var(--ink-3); color: var(--ink); }
  details.gf-fold summary::-webkit-details-marker { display: none; }
  details.gf-fold summary span::after { content: ' +'; }
  details.gf-fold[open] summary span::after { content: ' −'; }
  details.gf-fold[open] .gf-fold-body { animation: gf-lab 0.35s ease; }
  .gf-shot, .gf-gp, .gf-gl text { transform-box: fill-box; transform-origin: center; }
  .gf-pop { animation: gf-popa 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) backwards; }
  .gf-pop-big { animation: gf-popa 0.6s cubic-bezier(0.25, 2.2, 0.45, 1) backwards; }
  .gf-pop-goal { animation: gf-popg 0.9s cubic-bezier(0.25, 2.4, 0.4, 1) backwards; }
  @keyframes gf-popa { from { transform: scale(0); opacity: 0; } }
  @keyframes gf-popg { 0% { transform: scale(0); } 35% { transform: scale(2.1); } 100% { transform: scale(1); } }
  .gf-ripple { fill: none; transform-box: fill-box; transform-origin: center; animation: gf-ripple 0.9s ease-out forwards; }
  .gf-ripple.big { animation-duration: 1.3s; }
  @keyframes gf-ripple { from { transform: scale(0.4); opacity: 0.9; } to { transform: scale(var(--s, 3)); opacity: 0; } }
  .gf-flash { animation: gf-flash 0.9s ease-out forwards; }
  @keyframes gf-flash { from { opacity: 0.55; } to { opacity: 0; } }
  .gf-label-in { animation: gf-lab 0.45s cubic-bezier(0.3, 1.5, 0.5, 1) backwards; }
  @keyframes gf-lab { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .gflow *, .gflow *::before, .gflow *::after { animation: none !important; transition: none !important; } }
</style>

<script>
  type Shot = { t: number; h: number; xg: number; g: number; x: number; y: number; who: string; en: number; st: number };
  type Skater = { id: number; n: string; h: number; grp: string; s: [number, number][]; toi: number };
  type Flow = { game_id: number; len: number; shots: (number | null)[][]; pp: number[][]; players: { id: number; n: string; h: number; grp: string; s: number[] }[]; goalies: { id: number; n: string; h: number; s: number[] }[]; names?: Record<string, string> };

  const host = document.getElementById('gflow') as HTMLElement | null;
  if (host) start(host);

  function start(host: HTMLElement) {
    const C = ['var(--c0)', 'var(--c1)'];
    const NS = 'http://www.w3.org/2000/svg';
    const mk = (tag: string, attrs: Record<string, string | number> = {}, parent?: Element): any => { const n = document.createElementNS(NS, tag); for (const k in attrs) n.setAttribute(k, String(attrs[k])); if (parent) parent.append(n); return n; };
    const txt = (parent: Element, x: number, y: number, s: string | number, cls: string, anchor = 'start') => { const t = mk('text', { x, y, class: cls, 'text-anchor': anchor }, parent); t.textContent = String(s); return t; };
    const last = (n: string) => n.split('. ').slice(1).join('. ') || n;
    const tag = (s: Shot) => (s.en ? 'EN' : s.st > 0 ? 'PP' : s.st < 0 ? 'SH' : '');
    const clock = (t: number) => { t = Math.floor(t); if (t >= 3600) { const s = t - 3600; return `OT ${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; } const p = Math.min(2, Math.floor(t / 1200)), s = t - p * 1200; return `${['1st', '2nd', '3rd'][p]} ${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };
    const clockMS = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
    const CALM = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DANGER = 0.15;
    const narrow = () => host.clientWidth < 560;
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const stage = $('gf-stage'), selV = $('gf-view') as HTMLSelectElement, btn = $('gf-play');
    const ds = host.dataset;
    const sc = (ds.score ?? '0,0').split(',').map(Number);
    const endWord = ds.end && ds.end !== 'REG' ? ds.end : '';
    let g: any = null;
    let S: any = null; // the current drawing
    let anim: any = null;
    let paused: { ms: number; t: number; i: number } | null = null; // where a paused game stopped
    let pinned: number | null = null; // a moment the reader tapped or dragged to

    function load() {
      fetch(ds.src!).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); }).then((f: Flow) => {
        const names: Record<string, string> = { ...(f.names ?? {}) };
        for (const p of [...f.players, ...f.goalies]) names[p.id] = p.n;
        const pairs = (s: number[]) => { const o: [number, number][] = []; for (let i = 0; i < s.length; i += 2) o.push([s[i], s[i + 1]]); return o; };
        g = {
          away: ds.away, home: ds.home, an: ds.an, hn: ds.hn, score: sc, end: endWord, len: f.len,
          shots: f.shots.map(([t, h, xg, gl, x, y, who, en, st]) => ({ t, h, xg, g: gl, x, y, who: names[String(who)] ?? '', en, st: st ?? NaN }) as Shot),
          pp: f.pp.map(([h, a, b]) => ({ h, a, b })),
          players: f.players.map((p) => { const s = pairs(p.s); return { ...p, s, toi: s.reduce((v, [a, b]) => v + b - a, 0) }; }) as Skater[],
          gk: f.goalies.map((p) => ({ ...p, s: pairs(p.s) })),
        };
        // older files carry no strength: read it from the power-play stretches (a power-play goal ends the stretch)
        for (const s of g.shots as Shot[]) if (Number.isNaN(s.st)) { const p = s.en ? null : g.pp.find((q: any) => s.t >= q.a && s.t <= q.b); s.st = p ? (p.h === s.h ? 1 : -1) : 0; }
        draw();
        watchForPlay();
      }).catch(() => { stage.innerHTML = '<p class="gf-wait">The game’s shots could not be loaded.</p>'; btn.hidden = true; });
    }

    function tipFor(box: HTMLElement) { let t = box.querySelector(':scope > .gf-tip') as HTMLElement; if (!t) { t = document.createElement('div'); t.className = 'gf-tip'; box.append(t); } return { show(x: number, y: number, html: string) { t.innerHTML = html; const w = t.offsetWidth, bw = box.clientWidth; t.style.left = Math.max(w / 2, Math.min(bw - w / 2, x)) + 'px'; t.style.top = y + 'px'; t.classList.add('on'); }, hide() { t.classList.remove('on'); } }; }

    // goal names in rows that never collide; a dry run on a detached group sizes the space
    function goalRows(parent: Element, goals: Shot[], X: (t: number) => number, y0: number, maxX: number) {
      const rows: [number, number, number][] = [], els: [Shot, any][] = [];
      for (const s of goals) {
        const name = last(s.who) + (tag(s) ? ` (${tag(s)})` : ''), w = name.length * 6.6 + 14, x = X(s.t), flip = x + w > maxX;
        const a0 = flip ? x - w : x - 4, b0 = flip ? x + 4 : x + w; let r = 0;
        while (rows.some(([a, b, rr]) => rr === r && a0 < b && b0 > a)) r++;
        rows.push([a0, b0, r]);
        const y = y0 + r * 16;
        const gg = mk('g', { class: 'gf-gl' }, parent);
        mk('circle', { cx: x, cy: y - 4, r: 4, fill: C[s.h] }, gg);
        txt(gg, flip ? x - 8 : x + 8, y, name, 'gf-lab', flip ? 'end' : 'start');
        els.push([s, gg]);
      }
      return { n: rows.reduce((m, r) => Math.max(m, r[2] + 1), 0), els };
    }

    function frame(svg: Element, X: (t: number) => number, END: number, T: number, B: number) {
      for (const p of g.pp) mk('rect', { x: X(p.a), y: T, width: Math.max(2, X(p.b) - X(p.a)), height: B - T, fill: C[p.h], 'fill-opacity': 0.1 }, svg);
      [1200, 2400, 3600].filter((t) => t < END).forEach((t, i) => mk('line', { x1: X(t), x2: X(t), y1: T, y2: B, stroke: i === 1 ? 'var(--line-red)' : 'var(--line-blue)', 'stroke-width': 3 }, svg));
      const per: [number, number, string][] = [[0, 1200, '1ST'], [1200, 2400, '2ND'], [2400, 3600, '3RD']]; if (END > 3600) per.push([3600, END, 'OT']);
      for (const [a, b, l] of per) txt(svg, (X(a) + X(b)) / 2, B + 18, l, 'gf-axh', 'middle');
    }

    function draw() {
      stop(); paused = null; pinned = null;
      const view = selV.value;
      stage.replaceChildren();
      const W = narrow() ? 440 : Math.round(Math.min(1000, Math.max(720, host.clientWidth - 36))), L = narrow() ? 30 : 104, R = W - 14, END = Math.max(3600, g.len);
      const X = (t: number) => L + (R - L) * t / END;
      const goals: Shot[] = g.shots.filter((s: Shot) => s.g);
      const up = goals.filter((s) => !s.h), dn = goals.filter((s) => s.h);
      const svg = mk('svg', { role: 'img' }, stage);
      let T: number, B: number, VH: number;
      const lines = [0, 1].map((h) => { let v = 0; const pts: [number, number][] = [[0, 0]]; for (const s of g.shots) if (s.h === h && !s.en) { v += s.xg; pts.push([s.t, v]); } return pts; });
      const cum = (h: number, t: number) => { let v = 0; for (const [tt, vv] of lines[h]) if (tt <= t) v = vv; return v; };
      let names: [Shot, any][] = [], curves: any[] = [], yAt: (s: Shot) => number;
      if (view === 'pile') {
        const nAll = goalRows(mk('g'), goals, X, 0, W).n;
        T = 30 + nAll * 16; B = T + 200; VH = B + 28;
        svg.setAttribute('aria-label', 'Expected goals adding up through the game');
        frame(svg, X, END, T, B);
        const ymax = Math.max(2, Math.ceil(Math.max(cum(0, END), cum(1, END)) + 0.3)); const Y = (v: number) => B - (B - T) * v / ymax;
        for (let v = 0; v <= ymax; v++) { mk('line', { x1: L, x2: R, y1: Y(v), y2: Y(v), stroke: 'var(--rule)' }, svg); txt(svg, L - 8, Y(v) + 4, v, 'gf-ax', 'end'); }
        txt(svg, L, T - 8 - nAll * 16 + 2, 'EXPECTED GOALS', 'gf-axh');
        curves = lines.map((pts, h) => { let d = `M${X(0)},${Y(0)}`; for (const [t, v] of pts.slice(1)) d += `H${X(t).toFixed(1)}V${Y(v).toFixed(1)}`; d += `H${X(END)}`; return mk('path', { d, fill: 'none', stroke: C[h], 'stroke-width': 2.5, 'stroke-linejoin': 'round' }, svg); });
        names = goalRows(svg, goals, X, T - 10 - (nAll - 1) * 16, W).els;
        yAt = (s) => Y(cum(s.h, s.t));
      } else {
        const nUp = goalRows(mk('g'), up, X, 0, W).n, nDn = goalRows(mk('g'), dn, X, 0, W).n;
        T = 34 + nUp * 16; B = T + 210; const M = (T + B) / 2; VH = B + 38 + nDn * 16 + 18;
        svg.setAttribute('aria-label', 'Each team’s pressure through the game');
        frame(svg, X, END, T, B);
        const STEP = 15, HALF = 150, grid: number[] = []; for (let t = 0; t <= END; t += STEP) grid.push(t);
        const dens = [0, 1].map((h) => grid.map((t) => g.shots.reduce((sum: number, s: Shot) => { if (s.h !== h || s.en) return sum; const d = Math.abs(s.t - t); return d < HALF ? sum + s.xg * (1 - d / HALF) : sum; }, 0)));
        const ymax = Math.max(0.45, ...dens.flat()) * 1.05, H = (v: number) => (M - T - 6) * v / ymax;
        mk('line', { x1: L, x2: R, y1: M, y2: M, stroke: 'var(--ink-3)' }, svg);
        curves = [0, 1].map((h) => { const sg = h ? 1 : -1; let d = `M${X(0)},${M}`; grid.forEach((t, i) => d += `L${X(t).toFixed(1)},${(M + sg * H(dens[h][i])).toFixed(1)}`); d += `L${X(END)},${M}Z`; return mk('path', { d, fill: C[h], 'fill-opacity': 0.75, stroke: C[h], 'stroke-width': 1.5, 'stroke-linejoin': 'round' }, svg); });
        txt(svg, L, T - 8 - nUp * 16 + 2, `${g.an.toUpperCase()} PRESSING ↑`, 'gf-axh'); txt(svg, L, VH - 2, `↓ ${g.hn.toUpperCase()} PRESSING`, 'gf-axh');
        names = [...goalRows(svg, up, X, T - 10 - (nUp - 1) * 16, W).els, ...goalRows(svg, dn, X, B + 40, W).els];
        yAt = (s) => (s.h ? B - 10 : T + 10);
        for (const s of goals) mk('line', { x1: X(s.t), x2: X(s.t), y1: M, y2: yAt(s), stroke: C[s.h], 'stroke-dasharray': '2 2', class: 'gf-gstem', 'data-t': s.t }, svg);
      }
      svg.setAttribute('viewBox', `0 0 ${W} ${VH}`);
      const goalMarks: [Shot, any][] = goals.map((s) => [s, mk('circle', { cx: X(s.t), cy: yAt(s), r: 6, fill: 'var(--sheet)', stroke: C[s.h], 'stroke-width': 3, class: 'gf-gp' }, svg)]);
      const fx = mk('g', {}, svg);
      const cur = mk('line', { y1: T, y2: B, stroke: 'var(--ink)', 'stroke-dasharray': '3 3', opacity: 0 }, svg);

      const ice = document.createElement('div'); ice.className = 'gf-onice'; ice.setAttribute('aria-live', 'polite'); stage.append(ice);
