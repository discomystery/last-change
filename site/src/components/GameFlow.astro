        svg.querySelectorAll('.gf-gstem').forEach((e: any) => e.style.opacity = +e.dataset.t <= t ? 1 : 0);
        const clip = t >= END ? '' : `inset(0 ${(100 - (X(t) - L) / (R - L) * 100).toFixed(2)}% 0 0)`;
        curves.forEach((p) => p.style.clipPath = clip);
        cur.setAttribute('opacity', t < END ? 1 : 0); cur.setAttribute('x1', X(t)); cur.setAttribute('x2', X(t));
        board(t); setPP(t); SH.at(t);
      };

      // effects for one shot during playback
      const fire = (s: Shot) => {
        const d = dots.find((q) => q[0] === s)!, x = X(s.t);
        d[1].style.opacity = 1;
        d[1].classList.remove('gf-pop', 'gf-pop-big', 'gf-pop-goal'); void d[1].getBBox();
        if (s.g) {
          d[1].classList.add('gf-pop-goal');
          [2.4, 3.6].forEach((k, i) => { const r = mk('circle', { cx: d[2], cy: d[3], r: 4.5, class: 'gf-ripple big', stroke: C[s.h], 'stroke-width': 1.6 - i * 0.5 }, rfx); r.style.setProperty('--s', k); r.style.animationDelay = i * 150 + 'ms'; setTimeout(() => r.remove(), 1700); });
          const gm = goalMarks.find((q) => q[0] === s)![1]; gm.style.opacity = 1; gm.classList.remove('gf-pop-goal'); void gm.getBBox(); gm.classList.add('gf-pop-goal');
          const r2 = mk('circle', { cx: x, cy: yAt(s), r: 7, class: 'gf-ripple big', stroke: C[s.h], 'stroke-width': 2.5 }, fx); r2.style.setProperty('--s', 4); setTimeout(() => r2.remove(), 1500);
          const nm = names.find((q) => q[0] === s)![1]; nm.style.opacity = 1; nm.classList.remove('gf-label-in'); void nm.getBBox(); nm.classList.add('gf-label-in');
          svg.querySelectorAll('.gf-gstem').forEach((e: any) => { if (+e.dataset.t === s.t) e.style.opacity = 1; });
          const flash = mk('rect', { x: x - 6, y: T, width: 12, height: B - T, fill: C[s.h], class: 'gf-flash' }, fx); setTimeout(() => flash.remove(), 1000);
          chip(`<span class="t">${clock(s.t)}</span><b>GOAL</b>${s.who}${s.en ? ', empty net' : s.st > 0 ? ', power play' : s.st < 0 ? ', shorthanded' : ''}`, C[s.h], true); SH.goal(s);
          board(s.t + 0.01);
