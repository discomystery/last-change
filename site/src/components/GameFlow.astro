          mk('circle', { cx, cy, r: 15, ...thin }, rk);
          mk('circle', { cx, cy, r: 1, fill: red }, rk);
          mk('path', { d: `M${cx - 3} ${cy - 15} v-2 M${cx + 3} ${cy - 15} v-2 M${cx - 3} ${cy + 15} v2 M${cx + 3} ${cy + 15} v2 M${cx - 6} ${cy - 1.5} h-3 v-2 M${cx + 6} ${cy - 1.5} h3 v-2 M${cx - 6} ${cy + 1.5} h-3 v2 M${cx + 6} ${cy + 1.5} h3 v2`, ...thin }, rk); // hash marks
