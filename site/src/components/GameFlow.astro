    }

    function chip(html: string, c: string | null, goal: boolean) {
      const box = $('gf-calls');
      const el = document.createElement('span'); el.className = 'gf-chip' + (goal ? ' goal' : ''); el.innerHTML = html; if (c) el.style.setProperty('--c', c);
      box.prepend(el);
