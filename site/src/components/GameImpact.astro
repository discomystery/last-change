---
// Post-game Impact, line by line: each player's night as one number, grouped the way his coach used him tonight.
// Data: scores/{game_id}.json, written by pipeline/export/game_scores.py from finished games only.
import Section from './Section.astro';
import PLink from './PLink.astro';
import Pips from './Pips.astro';
import '../styles/blocks.css';

type Row = { id: number; name: string; team: string; pos: string; score: number; pct: number | null; parts: { sheet?: number; play?: number; special?: number; usage?: number; net?: number } };
type Unit = { kind: 'F' | 'D'; n: number; ids: number[]; sec: number; xgf: number; xga: number };
type Scores = { game_id: number; away: string; home: string; players: Row[]; units?: Record<string, Unit[]> };
interface Props { gameId: number; place: (a: string) => string; side: (a: string) => string }
const { gameId, place, side } = Astro.props;

const files = import.meta.glob<{ default: Scores }>('../../public/data/scores/2*.json', { eager: true });
const d = Object.values(files).find((f) => f.default.game_id === gameId)?.default;
const order = d ? [d.away, d.home] : [];
const one = (v: number) => (Math.round(v * 10) / 10 === 0 ? '0.0' : v > 0 ? `+${v.toFixed(1)}` : `−${(-v).toFixed(1)}`);
const two = (v: number) => (v > 0 ? `+${v.toFixed(2)}` : v < 0 ? `−${(-v).toFixed(2)}` : '0.00');
const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
const peer: Record<string, string> = { D: 'defensemen', G: 'goalies' };
// Three plain sources instead of a legend: what he put on the scoresheet, what happened with him on the ice
// (5-on-5 and special teams), and the company he kept.
const sources = (r: Row) => r.pos === 'G' ? [] : [
  { k: 'scoring', v: r.parts.sheet ?? 0 },
  { k: 'ice', v: (r.parts.play ?? 0) + (r.parts.special ?? 0) },
  { k: 'company', v: r.parts.usage ?? 0 },
];
const mostly = (r: Row) => {
  if (r.pos === 'G') return r.score >= 0 ? 'saves' : 'goals allowed';
  const top = sources(r).sort((a, b) => Math.abs(b.v) - Math.abs(a.v))[0];
  if (Math.abs(r.score) < 0.15) return 'quiet';
  if (top.k === 'company') return top.v > 0 ? 'easy company' : 'tough company';
  if (top.k === 'scoring') return top.v > 0 ? 'scoring' : 'penalties';
  return top.v > 0 ? 'on the ice' : 'on the ice';
};
const tip = (r: Row) => {
  const where = r.pct == null ? '' : ` Better than ${r.pct}% of ${peer[r.pos] ?? 'forwards'}’ nights last season.`;
  if (r.pos === 'G') return `${two(r.score)} goals saved above expected.${where}`;
  const p = r.parts;
  return `Scoresheet ${two(p.sheet ?? 0)}. At 5-on-5 ${two(p.play ?? 0)}. Special teams ${two(p.special ?? 0)}. Company kept ${two(p.usage ?? 0)}.${where}`;
};
const byId = new Map(d?.players.map((r) => [r.id, r]) ?? []);
// Tonight's groups for a team: forward lines, then pairs, then the goalies and anyone not in a regular group.
const groups = (t: string) => {
  const units = (d?.units?.[t] ?? []).map((u) => ({ ...u, rows: u.ids.map((i) => byId.get(i)).filter(Boolean) as Row[] }));
  const placed = new Set(units.flatMap((u) => u.ids));
  const mine = d?.players.filter((r) => r.team === t) ?? [];
  return { units, goalies: mine.filter((r) => r.pos === 'G'), rest: mine.filter((r) => r.pos !== 'G' && !placed.has(r.id)), all: mine };
};
const best = d ? d.players.filter((r) => r.pos !== 'G').slice(0, 3) : [];
---
{d && d.players.length > 0 && (() => {
  const row = (r: Row) => (
    <li class="im-row" tabindex="0" data-tip={tip(r)}>
      <span class="im-name"><PLink id={r.id} name={r.name} /></span>
      <span class="im-from">{mostly(r)}</span>
      {r.pct != null ? <Pips pct={r.pct} tip={tip(r)} /> : <span></span>}
      <strong class="im-n">{one(r.score)}</strong>
    </li>
  );
  return (
  <Section id="impact" title="Impact" placeholder={false}
    takeaway="How much each player moved tonight’s result, set out the way his coach used him.">
    <p class="im-lead">
      The biggest nights: {best.map((r, i) => <Fragment>{i > 0 && (i === best.length - 1 ? ' and ' : ', ')}<span class={`im-who t-${side(r.team)}`}><i></i><PLink id={r.id} name={r.name} /> <span class="im-lead-n">{one(r.score)}</span></span></Fragment>)}.
    </p>
    <div class="jpick">
      <span>Show</span>
      <select id="im-team" aria-label="Team">{order.map((a) => <option value={a}>{place(a)}</option>)}</select>
      <select id="im-view" aria-label="Order"><option value="lines">line by line</option><option value="rank">from best to worst</option></select>
    </div>
    {order.map((t) => {
      const g = groups(t);
      return (
        <div class={`im-team t-${side(t)}`} data-team={t}>
          <div class="im-view two" data-view="lines">
            {g.units.map((u) => (
              <div class="card im-unit">
                <div class="unit-top">
                  <span class="unit-label">{u.kind === 'F' ? `L${u.n}` : `P${u.n}`}</span>
                  <span class="unit-toi"><span class="term" tabindex="0" data-tip={`5-on-5 time these ${u.kind === 'F' ? 'three' : 'two'} spent on the ice together tonight. Groups are numbered by that time, most first.`}><strong>{clock(u.sec)}</strong> together</span> · <span class="term" tabindex="0" data-tip={`Expected goals at 5-on-5 while they were on together: ${u.xgf.toFixed(2)} for, ${u.xga.toFixed(2)} against.`}>chances {u.xgf.toFixed(1)}–{u.xga.toFixed(1)}</span></span>
                </div>
                <ul class="im-rows">{u.rows.map(row)}</ul>
              </div>
            ))}
            {(g.goalies.length > 0 || g.rest.length > 0) && (
              <div class="card im-unit">
                <div class="unit-top"><span class="unit-label">{g.rest.length ? 'In net and the rest' : 'In net'}</span></div>
                <ul class="im-rows">{[...g.goalies, ...g.rest].map(row)}</ul>
              </div>
            )}
          </div>
          <div class="im-view card" data-view="rank" hidden>
            <ol class="im-rows im-ranked">{g.all.map(row)}</ol>
          </div>
        </div>
      );
    })}
    <p class="note">The number is roughly in goals: what he added to his team tonight, or cost it. The pucks compare it with every night last season at his position. The small word says where most of it came from. Tap a player for the parts.</p>
    <details class="fold how im-how">
      <summary><span class="show">How Impact is worked out</span><span class="hide">Hide how Impact is worked out</span></summary>
      <div class="how-body">
        <p class="note"><strong>Scoring</strong>: each goal is shared 40% to the scorer, 35% to the first assist and 25% to the second, plus a quarter of the expected goals of his own shots. A penalty drawn adds 0.16 and one taken costs 0.16, what a power play is worth on average; each faceoff won or lost moves it by 0.006.</p>
        <p class="note"><strong>On the ice</strong> counts most: expected goals for minus against with him on at 5-on-5, half compared with league average (adjusted for score and venue) and half compared with his own team when he was on the bench, plus a smaller amount for actual goals. A player on a losing team can score well if his line held its own. Power-play and penalty-kill time is compared with a league-average unit.</p>
        <p class="note"><strong>Company</strong>: from every player’s 5-on-5 impact over the two seasons before, a player out with strong linemates against weak opponents gives a little back, and the reverse earns a little. <strong>Goalies</strong>: goals saved above expected. Empty-net shots and shootouts are left out. One game is a small sample: this says who moved this result, not who is better.</p>
      </div>
    </details>
  </Section>
  );
})()}

<script is:inline>
  // "Show [team] [line by line / from best to worst]": opens on the visitor's own team when it played.
  (() => {
    const team = document.getElementById('im-team'), view = document.getElementById('im-view');
    if (!team) return;
    const mine = [...team.options].find((o) => o.value === window.lcPrefs?.get('team'));
    if (mine) team.value = mine.value;
    const show = () => document.querySelectorAll('.im-team').forEach((t) => {
      t.hidden = t.dataset.team !== team.value;
      t.querySelectorAll('.im-view').forEach((v) => { v.hidden = v.dataset.view !== view.value; });
    });
    team.addEventListener('change', show);
    view.addEventListener('change', show);
    show();
  })();
</script>

<style>
  .im-lead { margin-top: 18px; font: 400 18px/1.6 var(--body); }
  .im-who { white-space: nowrap; }
  .im-who i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--team); margin-right: 6px; vertical-align: 1px; }
  .im-lead-n { font: 700 15px var(--ui); color: var(--ink-2); }
  .jpick { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 18px; font: 600 20px var(--display); }
  .jpick select { font: 600 17px var(--ui); color: var(--ink); background: var(--sheet); border: 0; border-bottom: 3px solid var(--ink); border-radius: 8px 8px 0 0; padding: 8px 10px; max-width: 100%; cursor: pointer; }
  .im-team[hidden], .im-view[hidden] { display: none; }
  .im-view.two { margin-top: 18px; gap: 16px; align-items: start; }
  .im-view.card { margin-top: 18px; }
  .im-rows { display: grid; gap: 2px; margin-top: 10px; }
  .im-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto 3.2em; align-items: center; gap: 12px; padding: 5px 6px; margin: 0 -6px; border-radius: 6px; cursor: help; }
  .im-row:hover, .im-row:focus-visible { background: var(--track); }
  .im-name { font: 600 15px/1.3 var(--ui); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .im-from { font: 600 10px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); white-space: nowrap; }
  .im-n { font: 700 17px var(--ui); text-align: right; }
  .im-ranked { counter-reset: r; }
  .im-ranked .im-name::before { counter-increment: r; content: counter(r); display: inline-block; width: 1.6em; font: 700 13px var(--ui); color: var(--ink-3); }
  @media (max-width: 420px) { .im-row { gap: 8px; } .im-from { display: none; } }
  .im-how { margin-top: 16px; }
  .how-body { display: grid; gap: 8px; padding-top: 12px; }
  .im-how .hide, .im-how[open] .show { display: none; }
  .im-how[open] .hide { display: inline; }
</style>
