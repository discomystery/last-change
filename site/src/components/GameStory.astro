---
import PLink from './PLink.astro';
// The short version: the plain-English story at the top of preview and post-game pages (pipeline/export/stories.py).
// The story reads at a comfortable width on the left; "Who to watch" (or "What it means") sits in a pale panel on the
// right, and drops under the story on narrow screens. A preview's first paragraph ends with the matchup's lean, written
// from one team's side: both versions are rendered and the page's pov CSS shows the visitor's team's, else the home team's.
export type Story = { kicker: string; head: string; paras: string[]; people?: Record<string, number>; ranks?: string[]; lean?: Record<string, string>; list_head: string; items: { tag: string; text: string }[] };
interface Props { story: Story; sides?: Record<string, 'away' | 'home'>; kicker?: boolean }
const { story, sides = {}, kicker = true } = Astro.props;
const band = Astro.slots.has('band');
const leanTeams = Object.keys(story.lean ?? {}).filter((t) => sides[t]);
// A player's line right after his name, "(10 G / 4 A / 14 P in 13 GP)" or a goalie's "(3-3-3 / .899 SV% in 9 GS)", is
// drawn as a tag, and the name before it links to his page (Sora, 2026-10-30). `people` maps those names to ids.
// A habit's league rank, "(32nd)" or "(3rd lowest)", is a pill whose tooltip comes from `ranks`, in reading order.
const TAG = /\s?\((?:(\d+) G \/ (\d+) A \/ (\d+) P in (\d+) GP|(\d+)-(\d+)-(\d+)(?: \/ (\.\d{3}) SV%)? in (\d+) GS|((?:\d+(?:st|nd|rd|th) )?lowest|\d+(?:st|nd|rd|th)))\)/g;
const plural = (n: string, w: string) => `${n} ${w}${n === '1' ? '' : 's'}`;
const people = Object.entries(story.people ?? {}).sort((x, y) => y[0].length - x[0].length);
type Tag = { text: string; small: string; tip: string };
const ranks = [...(story.ranks ?? [])];
type Piece = string | { name: string; id: number } | Tag;
const pieces = (p: string): Piece[] => {
  const out: Piece[] = [];
  let last = 0;
  for (const m of p.matchAll(TAG)) {
    if (m[10] !== undefined && !ranks.length) continue;  // a rank with no tooltip stays plain text
    let before = p.slice(last, m.index);
    const who = people.find(([n]) => before.endsWith(n));
    if (who) before = before.slice(0, -who[0].length);
    out.push(before);
    if (who) out.push({ name: who[0], id: who[1] });
    out.push(m[10] !== undefined ? { text: m[10], small: '', tip: ranks.shift()! } : m[1] !== undefined
      ? { text: `${m[1]} G / ${m[2]} A / ${m[3]} P`, small: `in ${m[4]} GP`,
          tip: `${plural(m[1], 'goal')}, ${plural(m[2], 'assist')} and ${plural(m[3], 'point')} in ${plural(m[4], 'game')} this season` }
      : { text: `${m[5]}-${m[6]}-${m[7]}${m[8] ? ` / ${m[8]} SV%` : ''}`, small: `in ${m[9]} GS`,
          tip: `${plural(m[5], 'win')}, ${m[6]} loss${m[6] === '1' ? '' : 'es'} and ${m[7]} overtime or shootout loss${m[7] === '1' ? '' : 'es'}${m[8] ? `, with a ${m[8]} save percentage,` : ''} in ${plural(m[9], 'start')} this season` });
    last = m.index! + m[0].length;
  }
  out.push(p.slice(last));
  return out;
};
---
<div class={`card story${band ? ' has-band' : ''}`}>
  <div class="s-head">
    {kicker && <p class="mini-h">{story.kicker}</p>}
    <h3>{story.head}</h3>
  </div>
  <div class="s-text">
    {leanTeams.length > 0 ? (
      <>
        {leanTeams.map((t) => <p class={`para pov pov-${sides[t]}`}>{[story.paras[0], story.lean![t]].filter(Boolean).join(' ')}</p>)}
        {story.paras.slice(1).map((p) => <p class="para">{pieces(p).map((x) => typeof x === 'string' ? x : 'id' in x ? <PLink id={x.id} name={x.name} /> : <> <span class="chip phrase box" data-tip={x.tip}>{x.text}{x.small && <> <span class="gp">{x.small}</span></>}</span></>)}</p>)}
      </>
    ) : story.paras.map((p) => <p class="para">{pieces(p).map((x) => typeof x === 'string' ? x : 'id' in x ? <PLink id={x.id} name={x.name} /> : <> <span class="chip phrase box" data-tip={x.tip}>{x.text}{x.small && <> <span class="gp">{x.small}</span></>}</span></>)}</p>)}
    <slot />
  </div>
  {band && <div class="s-band"><slot name="band" /></div>}
  {story.items.length > 0 && (
    <div class="s-list">
      <h4 class="list-h box-h">{story.list_head}</h4>
      <ul>
        {story.items.map((i) => <li><span class="tag">{i.tag}</span><span>{i.text}</span></li>)}
      </ul>
    </div>
  )}
</div>
<style>
  .box { margin: 0 1px; }
  .box .gp { font-weight: 500; color: var(--ink-3); }
  .story { margin-bottom: 20px; padding: 24px 26px; display: grid; gap: 0 36px;
    grid-template-columns: minmax(0, 64ch) minmax(270px, 1fr); grid-template-areas: 'head list' 'text list'; grid-template-rows: auto 1fr; }
  .s-head { grid-area: head; }
  .s-text { grid-area: text; align-self: start; }
  /* Post-game numbers: a band across the bottom of the card, under both the story and the side box. */
  .story.has-band { grid-template-areas: 'head list' 'text list' 'band band'; grid-template-rows: auto 1fr auto; }
  .s-band { grid-area: band; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--rule); }
  .s-list { grid-area: list; background: var(--ice); border-radius: 12px; padding: 16px 18px; align-self: start; }
  .story h3 { font: 600 28px/1.15 var(--display); margin: 6px 0 12px; }
  .story .para { font: 400 18px/1.6 var(--body); color: var(--ink-2); margin: 0 0 12px; }
  .list-h { margin: 0 0 4px;
    padding-bottom: 8px; border-bottom: 1px solid var(--line, rgba(0, 0, 0, 0.12)); }
  .story ul { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 12px; }
  .story li { display: grid; gap: 2px; align-content: start; font: 400 16px/1.5 var(--ui); }
  .story .tag { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); }
  @media (max-width: 900px) {
    .story { grid-template-columns: 1fr; grid-template-areas: 'head' 'text' 'list'; grid-template-rows: auto; }
    .story.has-band { grid-template-areas: 'head' 'text' 'band' 'list'; }
    .s-band { border-top: 0; padding-top: 4px; }
    /* Stacked, the side box sits under the story (or the post-game bars), never touching it. */
    .s-text > :global(:last-child) { margin-bottom: 0; }
    .s-list { margin-top: 22px; }
  }
  @media (max-width: 560px) {
    .story { padding: 18px 16px; }
    .story h3 { font-size: 24px; }
  }
</style>
