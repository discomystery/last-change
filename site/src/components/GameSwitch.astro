---
// One game, two pages: a pair of pills under the rink that flips between the preview and the post-game page,
// the page being read filled in. Shown only once both pages exist, so it reads the same on either side of the final.
interface Props { id: number; on: 'preview' | 'recap' }
const { id, on } = Astro.props;
const base = import.meta.env.BASE_URL;
const pages = [['preview', 'Preview', `${base}preview/${id}/`], ['recap', 'Post-game', `${base}recap/${id}/`]] as const;
---
<nav class="gswitch" aria-label="This game's pages">
  {pages.map(([key, label, href]) => key === on
    ? <span class="pill" aria-current="page">{label}</span>
    : <a class="pill" href={href}>{label}</a>)}
</nav>

<style>
  .gswitch { display: inline-flex; gap: 6px; margin-top: 4px; }
</style>
