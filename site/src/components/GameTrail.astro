---
// Where a game sits: a trail back to the day's games, and each team's previous and next game, linking to the
// post-game page or preview when one exists (otherwise to that day on the Games page).
import schedule from '../../public/data/schedule.json';
import teams from '../../public/data/teams.json';
import recapIndex from '../../public/data/recaps/index.json';
import previewIndex from '../../public/data/previews/index.json';

// `part` picks the trail back to the day's games (above the rink) or each team's previous and next game (below it).
interface Props { id: number; part: 'crumbs' | 'around' }
const { id, part } = Astro.props;
const base = import.meta.env.BASE_URL;
const games = [...schedule.games].sort((a, b) => a.start.localeCompare(b.start));
const g = games.find((x) => x.id === id)!;
const recaps = new Set(recapIndex.games.map((x) => x.id));
const previews = new Set(previewIndex.map((x) => x.id));
const place = Object.fromEntries(teams.map((t) => [t.abbr, t.place]));
const day = (d: string, opts: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-US', { ...opts, timeZone: 'UTC' }).format(new Date(d + 'T12:00:00Z'));
const href = (x: (typeof games)[number]) => (x.final && recaps.has(x.id) ? `${base}recap/${x.id}/` : !x.final && previews.has(x.id) ? `${base}preview/${x.id}/` : `${base}games/#${x.date}`);
const label = (x: (typeof games)[number], me: string) => {
  const opp = x.home === me ? x.away : x.home;
  const where = x.home === me ? 'vs' : 'at';
  if (x.final) {
    const [mine, theirs] = x.home === me ? [x.hs, x.as] : [x.as, x.hs];
    return `${where} ${opp}, ${mine! > theirs! ? 'W' : 'L'} ${mine}–${theirs}${x.end && x.end !== 'REG' ? ` (${x.end})` : ''}`;
  }
  return `${where} ${opp}, ${day(x.date, { month: 'short', day: 'numeric' })}`;
};
const around = [g.away, g.home].map((me) => {
  const mine = games.filter((x) => x.home === me || x.away === me);
  const i = mine.findIndex((x) => x.id === id);
  return { me, prev: mine[i - 1], next: mine[i + 1] };
});
---
{g && part === 'crumbs' && (
  <nav class="crumbs" aria-label="Where this game sits"><a href={`${base}games/`}>Games</a><span aria-hidden="true">›</span><a href={`${base}games/#${g.date}`}>{day(g.date, { weekday: 'long', month: 'long', day: 'numeric' })}</a><span aria-hidden="true">›</span><span aria-current="page">{g.away} at {g.home}</span></nav>
)}
{g && part === 'around' && (
  <div class="under">
    <div class="when"><slot /></div>
    {around.map(({ me, prev, next }, i) => (
      <nav class:list={['around', i ? 'home' : 'away']} aria-label={`${place[me] ?? me}: previous and next game`}>
        <a class="who tlink" href={`${base}team/${me}/`}>{me}</a>
        <span class="pills">
          {prev ? <a class="pill" href={href(prev)}><span aria-hidden="true">‹</span> {label(prev, me)}</a> : <span class="pill none">First game</span>}
          {next ? <a class="pill" href={href(next)}>{label(next, me)} <span aria-hidden="true">›</span></a> : <span class="pill none">Last game</span>}
        </span>
      </nav>
    ))}
  </div>
)}

<style>
  /* Under the rink: when the game is in the middle, and each team's previous and next game under its own end of the rink. */
  .under { display: grid; grid-template-columns: 1fr auto 1fr; grid-template-areas: 'away when home'; align-items: center; gap: 14px 20px; margin: 16px 0 12px; padding-inline: 5.5%; }
  /* The side padding lines the buttons up with the rink's goal lines, not its rounded ends. */
  .when { grid-area: when; text-align: center; font: 400 14px/1.4 var(--ui); color: var(--ink-2); }
  .around { display: grid; gap: 6px; justify-items: start; }
  .around.away { grid-area: away; }
  .around.home { grid-area: home; justify-items: end; }
  /* On wide screens each team's games sit under its own end of the rink, so the name is only needed on phones. */
  .who { display: none; font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); }
  .who:hover { color: var(--ink); }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .home .pills { justify-content: flex-end; }
  @media (max-width: 719px) {
    .under { grid-template-columns: 1fr 1fr; grid-template-areas: 'when when' 'away home'; align-items: start; }
    .who { display: block; }
    .pills { flex-direction: column; align-items: flex-start; }
    .home .pills { align-items: flex-end; }
  }
</style>
