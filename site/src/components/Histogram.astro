---
// Night to night: one bar per goal-wide group of starts on a goals-saved-above-expected scale, from a bad night to
// stealing one (the outer two groups take everything past two goals either way). Each bar carries its count, the
// even mark sits between the middle bars, and the labels are in the sans. Styles live in Base.astro (`.nbars`).
interface Props { team: string; bins: { lo: number; n: number }[]; name: string; wide?: boolean }
const { team, bins, name } = Astro.props;
const max = Math.max(...bins.map((b) => b.n), 1);
const sign = (v: number) => (v > 0 ? `+${v}` : v < 0 ? `−${Math.abs(v)}` : '0');
const range = (lo: number) => (lo <= -3 ? 'more than 2 goals below expected' : lo >= 2 ? '2 or more goals saved above expected' : `between ${sign(lo)} and ${sign(lo + 1)} goals saved above expected`);
const total = bins.reduce((t, b) => t + b.n, 0);
---
<div class:list={['nbars', `t-${team}`]} role="img" aria-label={`${name}: ${total} starts by goals saved above expected`}>
  <div class="nb-cols">
    {bins.map((b, k) => (
      <div class="nb-col" tabindex={b.n ? 0 : undefined} data-tip={b.n ? `${b.n} ${b.n === 1 ? 'start' : 'starts'} ${range(b.lo)}` : undefined}>
        <span class="nb-n">{b.n || ''}</span>
        <span class="nb-bar" style={`--h:${(b.n / max).toFixed(3)};--i:${k}`}></span>
      </div>
    ))}
    <i class="nb-even" aria-hidden="true"></i>
  </div>
  <p class="nb-lab" aria-hidden="true"><span>Bad night −3</span><span>0</span><span>+3 Stole it</span></p>
</div>
