---
// Night to night as one split bar: his starts as rough nights (more than a goal below expected), about expected
// (within a goal either way) and strong nights (a goal or more above), read left to right in deepening shades of the
// team colour. The export keeps six goal-wide groups; the outer pairs make the rough and strong parts. Styles live in
// Base.astro (`.nsplit`).
interface Props { team: string; bins: { lo: number; n: number }[]; name: string; wide?: boolean }
const { team, bins, name } = Astro.props;
const sum = (f: (lo: number) => boolean) => bins.filter((b) => f(b.lo)).reduce((t, b) => t + b.n, 0);
const parts = [
  { k: 'rough', n: sum((lo) => lo < -1), word: 'rough', tip: 'more than a goal below expected' },
  { k: 'even', n: sum((lo) => lo === -1 || lo === 0), word: 'about expected', tip: 'within a goal of expected, either way' },
  { k: 'strong', n: sum((lo) => lo >= 1), word: 'strong', tip: 'a goal or more saved above expected' },
];
const total = parts.reduce((t, p) => t + p.n, 0);
const starts = (n: number) => `${n} ${n === 1 ? 'start' : 'starts'}`;
---
<div class:list={['nsplit', `t-${team}`]} role="img" aria-label={`${name}: ${parts.map((p) => `${p.n} ${p.word}`).join(', ')} of ${starts(total)}`}>
  <div class="ns-bar">
    {parts.map((p, i) => p.n > 0 && <span class={`ns-${p.k}`} style={`flex-grow:${p.n};--i:${i}`} tabindex="0" data-tip={`${starts(p.n)} ${p.tip}`}></span>)}
  </div>
  <p class="ns-lab">{parts.map((p) => <span><b>{p.n}</b> {p.word}</span>)}</p>
</div>
