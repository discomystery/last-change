---
interface Props { team: string; bins: { lo: number; n: number }[]; name: string; wide?: boolean }
const { team, bins, name, wide = false } = Astro.props;
const max = Math.max(...bins.map((b) => b.n), 1);
// `wide` is a flatter drawing for full-width slots, so the labels stay small when it is stretched.
const W = wide ? 420 : 180, H = 64, bw = W / bins.length;
const sign = (v: number) => (v > 0 ? `+${v}` : v < 0 ? `−${Math.abs(v)}` : '0');
---
<svg class:list={['histo', `t-${team}`]} viewBox={`0 0 ${W} ${H + 16}`} role="img" aria-label={`${name}: goals saved above expected, game by game`}>
  {bins.map((b, i) => {
    const h = Math.max(1.5, (b.n / max) * (H - 4));
    return <path class="histo-bar" d={`M${i * bw + 1} ${H} V${H - h + 3} a3 3 0 0 1 3 -3 H${(i + 1) * bw - 4} a3 3 0 0 1 3 3 V${H} Z`} data-tip={`${b.n} starts between ${sign(b.lo)} and ${sign(b.lo + 1)} goals saved above expected`} />;
  })}
  <line class="histo-axis" x1="0" x2={W} y1={H} y2={H} />
  <line class="histo-zero" x1={W / 2} x2={W / 2} y1="0" y2={H + 3} />
  <text x="1" y={H + 13}>−3 (bad night)</text>
  <text x={W / 2} y={H + 13} text-anchor="middle">0</text>
  <text x={W - 1} y={H + 13} text-anchor="end">+3 (stole it)</text>
</svg>
