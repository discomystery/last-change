---
// "Lately" (Sora, 2026-10-30, thread "Improve game previews and automate tuning"): both clubs' last ten games at the
// bottom of the preview's story card, from the snapshot's `lately` (pipeline/export/lately.py, games before the day
// of the game only). A result strip, then goals, share of the 5-on-5 chances, power play, penalty kill and the
// projected goalie's last five starts. Facts about what has happened, never a lean on tonight.
import { fullName, playerHref } from '../lib/playerLinks';
import { ordinal } from '../lib/traits';
import teamsData from '../../public/data/teams.json';

export type Form = {
  n: number;
  games: { date: string; opp: string; home: boolean; gf: number; ga: number; end: string; res: 'W' | 'L' | 'OT' }[];
  record: { w: number; l: number; otl: number; gf: number; ga: number };
  chances: { now: number | null; season: number | null; gap: number | null; word: 'usual' | 'better' | 'worse'; season_games: number; rank?: number | null; of?: number };
  pp?: [number, number];
  pk?: [number, number];
  goalie?: { id: number; starts: number; saves: number; shots: number; gsax: number };
};
interface Props { lately?: Record<string, Form>; stakes?: string; order: readonly string[]; sides: Record<string, 'away' | 'home'> }
const { lately = {}, stakes, order, sides } = Astro.props;
const TS = teamsData as { abbr: string; nick: string; place: string }[];
const nick = (a: string) => TS.find((t) => t.abbr === a)?.nick ?? a;
const fmt = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
const said = { W: 'won', L: 'lost', OT: 'lost' } as const;
const gameTip = (g: Form['games'][number]) =>
  `${fmt(g.date)}, ${g.home ? 'vs' : 'at'} ${g.opp}: ${said[g.res]} ${g.gf}–${g.ga}${g.end !== 'REG' ? ` in ${g.end === 'OT' ? 'overtime' : 'a shootout'}` : ''}`;
const pct = (v: number) => `${Math.round(v)}%`;
const svp = (s: number, a: number) => (a ? (s / a).toFixed(3).replace(/^0/, '') : '–');
const sgn = (v: number) => (Math.abs(v) < 0.05 ? '0.0' : `${v > 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`);
const chanceWord = (c: Form['chances']) =>
  c.word === 'better' ? `up from ${pct(c.season!)} over the season` : c.word === 'worse' ? `down from ${pct(c.season!)} over the season` : null;
const teams = order.filter((a) => lately[a]);
---
{stakes && <p class="lt-stakes"><span class="mini-h">Standings</span> {stakes}</p>}
{teams.length === 2 && (
  <div class="lately" aria-label="Lately">
    {teams.map((a) => {
      const f = lately[a];
      const c = f.chances;
      const wd = chanceWord(c);
      return (
        <div class={`lt t-${sides[a]}`}>
          <p class="lt-h"><span class="mini-h">{nick(a)}, last {f.n}</span> <strong>{f.record.w}-{f.record.l}-{f.record.otl}</strong></p>
          <ol class="lt-games" aria-label={`${nick(a)} results, oldest first`}>
            {f.games.map((g) => <li class={`r-${g.res.toLowerCase()}`} tabindex="0" data-tip={gameTip(g)}><span>{g.res === 'OT' ? (g.end === 'SO' ? 'SO' : 'OT') : g.res}</span></li>)}
          </ol>
          <dl class="lt-facts">
            <div><dt>Goals</dt><dd>{f.record.gf}–{f.record.ga}</dd></div>
            {c.now != null && (
              <div>
                <dt><span class="term" tabindex="0" data-tip={`Their share of the expected goals at 5-on-5 over these ${f.n} games, weighted for the score and home ice. 50% is even.${c.rank ? ` ${ordinal(c.rank)} of ${c.of} teams over their last ten.` : ''}`}>Chances</span></dt>
                <dd>{pct(c.now)}{c.rank ? <span class="n"> · {ordinal(c.rank)}</span> : null}{wd && <span class="n"> · {wd}</span>}</dd>
              </div>
            )}
            {f.pp && (
              <div><dt><span class="term" tabindex="0" data-tip="Power-play goals, out of their power plays, over these games (the league’s own counts).">Power play</span></dt><dd>{f.pp[0]} of {f.pp[1]}</dd></div>
            )}
            {f.pk && (
              <div><dt><span class="term" tabindex="0" data-tip="Times shorthanded over these games, and how many of those the other team scored on.">Penalty kill</span></dt><dd>{f.pk[1] - f.pk[0]} of {f.pk[1]} killed</dd></div>
            )}
            {f.goalie && (
              <div class="lt-g">
                <dt><span class="term" tabindex="0" data-tip={`The goalie expected to start, over his last ${f.goalie.starts === 1 ? 'start' : `${f.goalie.starts} starts`} this season: save percentage, and goals saved above what our chance model expected.`}>In net</span></dt>
                <dd>{playerHref(f.goalie.id) ? <a class="plink" href={playerHref(f.goalie.id)}>{fullName(f.goalie.id, '')}</a> : fullName(f.goalie.id, '')}: {svp(f.goalie.saves, f.goalie.shots)}, {sgn(f.goalie.gsax)} saved above expected <span class="n">in his last {f.goalie.starts === 1 ? 'start' : `${f.goalie.starts} starts`}</span></dd>
              </div>
            )}
          </dl>
        </div>
      );
    })}
  </div>
)}
<style>
  .lately { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px 36px; }
  .lt-stakes { font: 400 18px/1.6 var(--body); color: var(--ink-2); margin: 0 0 16px; }
  .lt-stakes .mini-h { margin-right: 6px; }
  .lt-h { display: flex; align-items: baseline; gap: 10px; margin: 0 0 8px; }
  .lt-h strong { font: 700 18px var(--ui); color: var(--ink); }
  .lt-games { list-style: none; display: flex; gap: 4px; padding: 0; margin: 0 0 12px; }
  .lt-games li { width: 26px; height: 22px; border-radius: 6px; display: grid; place-items: center;
    font: 700 10.5px var(--ui); letter-spacing: 0.03em; cursor: default; }
  .lt-games .r-w { background: var(--team); color: var(--sheet); }
  .lt-games .r-ot { box-shadow: inset 0 0 0 1.5px var(--team); color: var(--team); }
  .lt-games .r-l { background: var(--track); color: var(--ink-3); }
  .lt-facts { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; font: 400 15px/1.45 var(--ui); }
  .lt-facts > div { display: contents; }
  .lt-facts dt { font: 600 11px/2 var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); }
  .lt-facts dd { margin: 0; color: var(--ink); min-width: 0; white-space: normal; }
  .lt { min-width: 0; }
  .lt-facts { grid-template-columns: auto minmax(0, 1fr); }
  .lt-facts .n { color: var(--ink-3); }
  @media (max-width: 900px) { .lately { grid-template-columns: 1fr; } }
  @media (max-width: 400px) { .lt-games li { width: 22px; } .lt-games { gap: 3px; } }
</style>
