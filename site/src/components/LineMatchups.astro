---
// Post-game "Who played against whom" (Sora, 2026-10-15, after the mock-up "Post-game Line Matchups"), under a fold at
// the bottom of "How it unfolded". The lede and "What changed" notes come from matchups/{id}.json (export/matchups.py)
// at build time; since 2026-10-29 the chart is the shift tape (LineTape.astro), whose row captions carry the split
// strips that used to stand here.
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import LineTape from './LineTape.astro';

interface Props { id: number; away: string; home: string; awayPlace: string; homePlace: string }
const { id, away, home, awayPlace, homePlace } = Astro.props;
const path = resolve(process.cwd(), 'public/data/matchups', `${id}.json`);
const mu = existsSync(path) ? JSON.parse(readFileSync(path, 'utf8')) : null;
---
{mu && (
  <details class="fold pgmu-fold">
    <summary><span class="closed">Show the matchups</span><span class="opened">Hide the matchups</span></summary>
    <h3 class="sub pgmu-h">Matchups</h3>
    <p class="pgmu-lede">{mu.lede}</p>
    {mu.notes.length > 0 && (
      <div class="card pgmu-changed">
        <p class="box-h">What changed</p>
        <ul>{mu.notes.map((n: { head: string; text: string }) => <li><strong>{n.head}</strong><p>{n.text}</p></li>)}</ul>
        {mu.foot && <p class="pgmu-foot">{mu.foot}</p>}
      </div>
    )}
    <LineTape id={id} away={away} home={home} awayPlace={awayPlace} homePlace={homePlace} />
  </details>
)}

<style is:global>
  .pgmu-fold .pgmu-h { margin-top: 4px; }
  .pgmu-lede { font: 400 17px/1.5 var(--body); color: var(--ink-2); margin: 0 0 14px; }
  .pgmu-changed ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .pgmu-changed li { display: grid; gap: 2px; }
  .pgmu-changed li strong { font: 700 15px var(--ui); }
  .pgmu-changed li p { margin: 0; font: 400 15.5px/1.55 var(--body); color: var(--ink-2); }
  .pgmu-foot { font: 400 13.5px/1.5 var(--ui); color: var(--ink-3); margin: 14px 0 0; }
</style>
