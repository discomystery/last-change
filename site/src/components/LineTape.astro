  .lt-goal { cursor: pointer; }
  .lt-goal line { stroke: var(--team); stroke-width: 1.5; stroke-dasharray: 3 2; }
  .lt-goal circle { fill: var(--team); stroke: var(--sheet); stroke-width: 2; }
  .lt-goal.on line { stroke-width: 2.5; stroke-dasharray: none; }
  .lt-goal.dim { opacity: 0.3; }
  .lt-goal:focus-visible { outline: none; }
  .lt-goal:focus-visible circle { stroke: var(--ink); }
  .lt-ax { font: 600 11px var(--ui); letter-spacing: 0.07em; text-transform: uppercase; fill: var(--ink-3); }
  .lt-min { letter-spacing: 0.02em; }
  .lt-team { position: absolute; left: 0; margin: 0; padding-right: 6px; background: var(--sheet); font: 600 14px var(--ui); color: var(--ink); white-space: nowrap; }
  .lt-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--team); margin-right: 7px; vertical-align: 0; }
  .lt-lbl { position: absolute; left: 0; margin: 0; transform: translateY(-50%); display: flex; align-items: center; gap: 8px; font: 500 13px var(--ui); color: var(--ink-2); pointer-events: none; white-space: nowrap; }
  .lt-lbl b { flex: none; width: 22px; font-weight: 700; color: var(--ink); }
  .lt-lbl .lt-names { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .lt-lbl .pips { pointer-events: auto; }
  .lt-key { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 20px; margin: 16px 0 0; font: 500 13px var(--ui); color: var(--ink-2); }
  .lt-k { display: inline-block; vertical-align: -1px; margin-right: 7px; }
  .lt-k.bar { width: 18px; height: 10px; border-radius: 2px; background: var(--ink-2); }
  .lt-k.pp { width: 18px; height: 12px; border-radius: 2px; background: color-mix(in oklab, var(--ink) 10%, transparent); }
  .lt-k.goal { width: 10px; height: 10px; border-radius: 50%; background: var(--ink-2); }
  .lt-goals .mini-h { margin: 0 0 8px; }
  .lt-gl { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .lt-gp { font-variant-numeric: tabular-nums; }
  .lt-gp .lt-dot { width: 8px; height: 8px; margin-right: 6px; }
  .lt-cap { margin-top: 16px; border-top: 1px solid var(--rule); padding-top: 16px; }
  .lt-hint { font: 400 17px/1.5 var(--body); color: var(--ink-2); margin: 0; }
  .lt-jump { font: inherit; color: var(--ink); background: none; border: 0; padding: 0; text-decoration: underline 1px var(--ink-3); text-underline-offset: 5px; cursor: pointer; }
  .lt-gh { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .lt-gh .mini-h { margin: 0; }
  .lt-score { font: 600 26px/1 var(--display); font-variation-settings: 'SOFT' 100; color: var(--ink); margin-right: 2px; }
  .lt-say { font: 400 17px/1.5 var(--body); color: var(--ink); margin: 10px 0 12px; }
  .lt-fives { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .lt-five { border-radius: 12px; padding: 12px 14px; background: var(--ice); }
  .lt-five.sc { background: color-mix(in oklab, var(--team) 10%, var(--sheet)); }
  .lt-fh { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; margin: 0; font: 500 14px var(--ui); color: var(--ink-2); }
  .lt-fh b { color: var(--ink); font-weight: 700; }
  .lt-fh .lt-dot { margin-right: 0; }
  .lt-fh .pips { margin-left: auto; }
  .lt-fn { font: 500 14px/1.5 var(--ui); color: var(--ink); margin: 8px 0 0; }
  .lt-fn.lt-d { margin-top: 2px; }
  .lt-how { margin: 8px 0 0; font: 400 14px/1.5 var(--ui); color: var(--ink-2); }
  .lt-how strong, .lt-list .how strong { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .lt-sh { margin: 18px 0 8px; }
  .lt-strips .note, .lt-grp > .note { margin: 14px 0 0; }
  /* blocks.css sets the box captions at 10px; the tape keeps every label at the 11px floor. */
  .ltape .strip i { font-size: 11px; }
  .lt-mixed { font: 400 13px var(--ui); color: var(--ink-3); margin: 6px 0 0; }
  .lt-pl { padding: 18px; }
  .lt-pl > .lt-how { margin-top: 0; }
  .lt-split { margin-top: 14px; }
  .lt-ns { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .lt-ns span:nth-child(n) { text-align: left; }
  .lt-s-ev, .lt-shift.ev { background: var(--team); fill: var(--team); }
  .lt-s-pp, .lt-shift.pp { background: color-mix(in oklab, var(--team) 52%, var(--sheet)); fill: color-mix(in oklab, var(--team) 52%, var(--sheet)); }
  .lt-s-pk, .lt-shift.pk { background: color-mix(in oklab, var(--team) 22%, var(--sheet)); fill: color-mix(in oklab, var(--team) 22%, var(--sheet)); }
  .lt-s-oth, .lt-shift.oth { background: color-mix(in oklab, var(--ink-3) 45%, var(--sheet)); fill: color-mix(in oklab, var(--ink-3) 45%, var(--sheet)); }
  .lt-pl svg { display: block; overflow: visible; margin-top: 4px; }
  .lt-pg { fill: var(--team); stroke: var(--sheet); stroke-width: 2; cursor: help; }
  .lt-note { margin: 6px 0 0; }
  .lt-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; }
  .lt-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .lt-list li { display: grid; gap: 1px; }
  .lt-list li.thin { opacity: 0.55; }
  .lt-with { font: 500 14px var(--ui); color: var(--ink); }
  .lt-with b { margin-right: 4px; }
  .lt-list .how { font: 400 13px var(--ui); color: var(--ink-2); }
  @media (max-width: 719px) {
    .lt-fives, .lt-cols { grid-template-columns: 1fr; }
    /* The name line sits on the card's own colour, so goal lines and shading only cross the bars. */
    .lt-lbl.narrow { transform: none; height: 20px; background: var(--sheet); }
    .lt-card { display: flex; flex-direction: column; }
    .lt-goals { order: 0; }
    .lt-cap { order: 1; margin: 0 0 16px; border-top: 0; padding-top: 0; border-bottom: 1px solid var(--rule); padding-bottom: 16px; scroll-margin-top: 120px; }
    .lt-chart { order: 2; }
    .lt-key { order: 3; }
  }
</style>
