  .lt-ppb { fill: var(--team); fill-opacity: 0.1; }
  .lt-col { fill: var(--ink); fill-opacity: 0.07; }
  .lt-hit { fill: transparent; cursor: pointer; }
  .lt-track { fill: var(--track); opacity: 0.5; }
