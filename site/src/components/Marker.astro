---
// Neutral slider: where a number sits from low to high among its peers. Not a judgement.
interface Props { pct: number; tip: string }
const { pct, tip } = Astro.props;
---
<span class="marker" role="img" aria-label={tip} data-tip={tip} tabindex="0"><i style={`--p:${Math.max(0, Math.min(100, pct))}`}></i></span>
