---
// MOCK (design discussion, not for merge): "What he carries" on a skater's page. How much of his team's scoring,
// power play and ice time runs through him, who is next in line for each job, and what happened when he was out.
// Numbers below are Pastrnak's, computed by hand from player_game / team_game for the mock.
import Section from './Section.astro';

const team = 'Boston';
type Tile = { label: string; big: string; of: string; share: number; ref?: [number, string]; next: string; tip: string };
const tiles: Record<'blend' | 'season', Tile[]> = {
  blend: [
    { label: 'Goals he’s in on', big: '40%', of: '107 of Boston’s 271 goals', share: 39.5, ref: [29.8, 'A typical first-line forward: 30%'], next: 'Next: Zacha and Geekie, 23% each', tip: 'Goals he scored or assisted on, out of all Boston goals in the games he played. 10th-highest share in the league last season.' },
    { label: 'Goals he scores', big: '11%', of: '31 of 271', share: 11.4, next: 'Geekie scores more: 35 goals, 13%', tip: 'His own goals, out of all Boston goals in the games he played.' },
    { label: 'Power-play goals he’s in on', big: '54%', of: '29 of 54, scoring or first assist', share: 53.7, next: 'Next: Geekie, 30%', tip: 'Power-play goals he scored or set up with the last pass, out of Boston’s power-play goals in his games.' },
    { label: 'Shots on goal', big: '13%', of: '284 of 2,241', share: 12.7, ref: [5.6, 'An even share among 18 skaters: 6%'], next: 'Next: Geekie, 8%', tip: 'His shots on goal, out of all of Boston’s in his games.' },
  ],
  season: [
    { label: 'Goals he’s in on', big: '35%', of: '7 of Boston’s 20 goals', share: 35, ref: [29.8, 'A typical first-line forward: 30%'], next: 'Next: Minten, 25%', tip: 'Goals he scored or assisted on, out of all Boston goals in the games he played.' },
    { label: 'Goals he scores', big: '10%', of: '2 of 20', share: 10, next: 'Tied with Mittelstadt and Peterka', tip: 'His own goals, out of all Boston goals in the games he played.' },
    { label: 'Power-play goals he’s in on', big: '3 of 3', of: 'scoring or first assist', share: 100, next: 'Next: Geekie, 2 of 3', tip: 'Power-play goals he scored or set up with the last pass.' },
    { label: 'Shots on goal', big: '15%', of: '23 of 153', share: 15, ref: [5.6, 'An even share among 18 skaters: 6%'], next: 'Next: Minten, 10%', tip: 'His shots on goal, out of all of Boston’s in his games.' },
  ],
};
type Job = { job: string; load: string; more: string; next: string; nextMore?: string };
const jobs: Record<'blend' | 'season', Job[]> = {
  blend: [
    { job: 'First line', load: 'Right wing with Zacha and Geekie', more: '7:49 a game together lately', next: 'Peterka', nextMore: 'Boston’s next most-used right wing' },
    { job: 'Power play', load: 'Both units, as the trigger', more: 'on for 77% of Boston’s power-play time', next: 'Peterka joins PP2', nextMore: 'Geekie stays the PP1 shooter beside Zacha' },
    { job: 'Ice time', load: '20:30 a game', more: 'most of any Boston forward', next: 'E. Lindholm', nextMore: '17:49 a game' },
    { job: 'Penalty kill', load: 'Not used', more: 'nothing to replace', next: '' },
  ],
  season: [
    { job: 'First line', load: 'Right wing with Zacha and Geekie', more: '7:49 a game together lately', next: 'Peterka', nextMore: 'Boston’s next most-used right wing' },
    { job: 'Power play', load: 'Both units, as the trigger', more: 'on for 78% of Boston’s power-play time', next: 'Peterka joins PP2', nextMore: 'Geekie stays the PP1 shooter beside Zacha' },
    { job: 'Ice time', load: '18:31 a game', more: 'most of any Boston forward', next: 'Zacha', nextMore: '17:16 a game' },
    { job: 'Penalty kill', load: 'Not used', more: 'nothing to replace', next: '' },
  ],
};
// Goals he is in on per game, against typical forwards by where they rank on their team in ice time (2025-26).
const lane = { max: 1.5, him: 1.29, marks: [[0.3, 'Typical fill-in', '10th to 13th forward'], [0.61, 'Second line', '4th to 6th forward'], [0.93, 'First line', 'top three forwards']] as [number, string, string][] };
---
<Section id="carries" title="What he carries" placeholder={false} takeaway={`How much of ${team}’s game runs through him, and what they would have to replace without him.`}>
  {(['blend', 'season'] as const).map((m) => (
    <div class={`gmode m-${m}`}>
      <ul class="ld-tiles">
        {tiles[m].map((t) => (
          <li class="card ld-tile">
            <p class="mini-h"><span class="term" tabindex="0" data-tip={t.tip}>{t.label}</span></p>
            <p class="ld-big">{t.big}</p>
            <p class="ld-of">{t.of}</p>
            <div class="ld-bar" role="img" aria-label={`${t.big} of ${team}’s`}>
              <i style={`width:${Math.min(100, t.share)}%`}></i>
              {t.ref && <b style={`left:${t.ref[0]}%`} tabindex="0" data-tip={t.ref[1]}></b>}
            </div>
            <p class="ld-next">{t.next}</p>
          </li>
        ))}
      </ul>
      <div class="card ld-jobs">
        <p class="mini-h">If he’s out, who picks it up</p>
        <dl>
          {jobs[m].map((j) => (
            <div>
              <dt>{j.job}</dt>
              <dd class="ld-load"><span>{j.load}</span><span class="n">{j.more}</span></dd>
              {j.next && <dd class="ld-who"><span><a class="plink" href="#">{j.next}</a></span>{j.nextMore && <span class="n">{j.nextMore}</span>}</dd>}
            </div>
          ))}
        </dl>
        <p class="note">“Next in line” is the player who already does the most of that job after him. It is not a guess at the coach’s choice.</p>
      </div>
    </div>
  ))}
  <div class="ld-two">
    <div class="card">
      <p class="mini-h">What a fill-in gives back</p>
      <p class="ld-say">He’s in on <strong>1.29 goals a game</strong>. A typical depth forward called up to replace him is in on about 0.30.</p>
      <div class="ld-lane">
        <span class="ld-line"></span>
        {lane.marks.map(([v, l, tip]) => <span class="ld-mark" style={`left:${(100 * v) / lane.max}%`} tabindex="0" data-tip={`${l} (${tip}): ${v.toFixed(2)} goals a game`}><i></i><em>{l}</em></span>)}
        <span class="ld-him" style={`left:${(100 * lane.him) / lane.max}%`}><i></i><em>Pastrnak</em></span>
      </div>
      <p class="n">Goals scored or assisted per game, last season. Forwards grouped by where they rank on their own team in ice time.</p>
    </div>
    <div class="card">
      <p class="mini-h">When he’s been out</p>
      <p class="ld-say">He missed <strong>5 games</strong> last season (Nov 28 to Dec 6). Boston won 2 of them.</p>
      <table class="ld-ww">
        <thead><tr><th></th><th>With him</th><th>Without</th></tr></thead>
        <tbody>
          <tr><th>Won</th><td>39 of 77</td><td>2 of 5</td></tr>
          <tr><th>Goals a game</th><td>3.3</td><td>3.4</td></tr>
          <tr><th><span class="term" tabindex="0" data-tip="Expected goals for minus against per game, all situations, empty nets left out.">Chance edge a game</span></th><td>−0.34</td><td>−0.73</td></tr>
        </tbody>
      </table>
      <p class="n">Steeves moved up beside E. Lindholm and Geekie; Mittelstadt got more power-play time. Five games is far too few to read much into: short stretches swing either way by luck.</p>
    </div>
  </div>
</Section>

<style>
  .ld-tiles { display: grid; gap: 14px; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 18px; }
  @media (max-width: 900px) { .ld-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .ld-tile { display: grid; align-content: start; gap: 2px; }
  .ld-big { font: 600 40px/1.05 var(--display); font-variation-settings: 'SOFT' 100; margin-top: 2px; }
  .ld-of { font: 400 14px/1.4 var(--ui); color: var(--ink-2); }
  .ld-bar { position: relative; height: 8px; margin: 12px 0 10px; border-radius: 4px; background: var(--track); }
  .ld-bar i { position: absolute; inset: 0 auto 0 0; border-radius: 4px; background: var(--team); }
  .ld-bar b { position: absolute; top: -4px; width: 2px; height: 16px; margin-left: -1px; background: var(--ink); border-radius: 1px; cursor: help; }
  .ld-next { font: 400 13px/1.4 var(--ui); color: var(--ink-3); }
  .ld-jobs { margin-top: 14px; }
  .ld-jobs dl > div { display: grid; grid-template-columns: 130px minmax(0, 1.3fr) minmax(0, 1fr); gap: 4px 16px; padding: 12px 0; border-top: 1px solid var(--rule); }
  .ld-jobs dl > div:first-child { border-top: 0; padding-top: 4px; }
  .ld-jobs dt { font: 600 11px/2.2 var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); }
  .ld-jobs dd { display: grid; align-content: start; gap: 1px; font: 400 16px/1.45 var(--ui); }
  .ld-jobs dd .n { font-size: 14px; }
  .ld-who::before { content: 'Next in line'; font: 600 11px/1.6 var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); }
  .ld-jobs dl > div:first-child .ld-who::before { }
  @media (max-width: 640px) {
    .ld-jobs dl > div { grid-template-columns: 1fr; }
  }
  .ld-two { display: grid; gap: 14px; margin-top: 14px; }
  @media (min-width: 820px) { .ld-two { grid-template-columns: 1fr 1fr; } }
  .ld-two .card { display: grid; align-content: start; gap: 10px; }
  .ld-say { font: 400 16px/1.5 var(--ui); }
  .ld-lane { position: relative; height: 62px; margin: 6px 10px 0; }
  .ld-line { position: absolute; left: -10px; right: -10px; top: 24px; height: 4px; border-radius: 2px; background: var(--track); }
  .ld-mark, .ld-him { position: absolute; top: 0; width: 0; }
  .ld-mark i { position: absolute; top: 20px; left: -1px; width: 2px; height: 12px; background: var(--ink-3); border-radius: 1px; }
  .ld-mark em, .ld-him em { position: absolute; top: 38px; transform: translateX(-50%); font: 400 12px var(--ui); font-style: normal; color: var(--ink-3); white-space: nowrap; }
  .ld-mark em { top: 38px; }
  .ld-mark:nth-of-type(odd) em { top: 0; }
  .ld-him i { position: absolute; top: 19px; left: -7px; width: 14px; height: 14px; border-radius: 50%; background: var(--team); box-shadow: 0 0 0 2px var(--sheet); }
  .ld-him em { font-weight: 600; color: var(--ink); top: 0; }
  .ld-ww { border-collapse: collapse; font: 400 15px var(--ui); width: 100%; }
  .ld-ww th, .ld-ww td { padding: 7px 0; text-align: right; }
  .ld-ww tbody th { text-align: left; font-weight: 600; }
  .ld-ww thead th { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); }
  .ld-ww tbody tr { border-top: 1px solid var(--rule); }
</style>
