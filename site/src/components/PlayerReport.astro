---
// MOCK (design discussion): ties a skater's page to his post-game report cards and Swing.
// "What they count on him for": the duties his report cards grade him on, why he has each, and how often he has
// delivered; then where he stands on the duties he isn't graded on. "Recent games": one row per game with the
// report-card result, each duty's mark, and his Swing. Reads the real jobs/ and scores/ files.
import Section from './Section.astro';
import Pips from './Pips.astro';
import schedule from '../../public/data/schedule.json';

interface Props { p: any; place: string }
const { p, place } = Astro.props;
const base = import.meta.env.BASE_URL;
const jobFiles = import.meta.glob<{ default: any }>('../../public/data/jobs/2*.json', { eager: true });
const scoreFiles = import.meta.glob<{ default: any }>('../../public/data/scores/2*.json', { eager: true });
const scores = Object.fromEntries(Object.values(scoreFiles).map((f) => [f.default.game_id, f.default]));
const games = new Map((schedule as any).games.map((g: any) => [g.id, g]));
const rows = Object.values(jobFiles).map((f) => f.default).flatMap((d) => {
  const all = Array.isArray(d.players) ? d.players : Object.values(d.players).flat();
  const c = (all as any[]).find((x) => x.id === p.id);
  if (!c) return [];
  const sc = scores[d.game_id]?.players.find((x: any) => x.id === p.id);
  const g: any = games.get(d.game_id);
  const home = g.home === p.team;
  const us = home ? g.hs : g.as, them = home ? g.as : g.hs;
  return [{ id: d.game_id, date: g.date, opp: home ? g.away : g.home, home, us, them, end: g.end, card: c, swing: sc }];
}).sort((a, b) => (a.date < b.date ? 1 : -1));
const latest = rows[0]?.card;
const duties = (latest?.jobs ?? []) as any[];
const mark = { held: '✓', partly: '≈', missed: '✕', na: '–' } as const;
const word = { held: 'Did it', partly: 'Partly', missed: 'Didn’t', na: 'Can’t judge' } as const;
const pillWord = { huge: '★ Huge night', big: 'Big night', did: 'Did his job', mixed: 'Mixed night', didnt: 'Off night', rough: 'Rough night' } as const;
const pillClass = { huge: 'huge', big: 'did', did: 'did', mixed: 'mixed', didnt: 'didnt', rough: 'rough' } as const;
const peer: Record<string, string> = { F: 'forwards', D: 'defensemen', C: 'centers', W: 'wingers' };
const why = (j: any) => (j.key === 'pp' ? `${j.per_game} a game on the power play` : j.key === 'pk' ? `${j.per_game} a game killing penalties` : j.why === 'role' ? 'Takes plenty of faceoffs' : `Better than ${j.pct}% of ${peer[j.vs ?? 'F']}`);
const record = (key: string) => rows.slice().reverse().map((r) => (r.card.jobs.find((j: any) => j.key === key)?.verdict ?? 'na') as keyof typeof mark);
const delivered = (v: string[]) => v.filter((x) => x === 'held').length;
// Duties a player can be given, with his standing on the ones he isn't. Bars match the report cards: 1:30 a game on
// the power play, 1:00 on the kill, 8 draws a game, or 75th percentile at his position for a strength.
const traits = p.traits ?? {};
const others = [
  ['pk', 'Killing penalties', p.role?.toi?.toi_pk >= 15 ? `${Math.floor(p.role.toi.toi_pk / 60)}:${String(p.role.toi.toi_pk % 60).padStart(2, '0')} a game` : 'Rarely kills penalties', 'Needs 1:00 a game', null],
  ['faceoffs', 'Faceoffs', p.sub === 'W' ? 'A winger: rarely takes the draw' : null, 'Needs 8 draws a game', null],
  ['chances', 'Creating his own chances', null, 'Needs better than 75%', 'chances'],
  ['defImpact', 'Preventing chances at 5-on-5', null, 'Needs better than 75%', 'defImpact'],
  ['takeaways', 'Takeaways', null, 'Needs better than 75%', 'takeaways'],
  ['hits', 'Hitting', null, 'Needs better than 75%', 'hits'],
  ['blocks', 'Blocking shots', null, 'Needs better than 75%', 'blocks'],
].filter(([k]) => !duties.some((j) => j.key === k)) as [string, string, string | null, string, string | null][];
const fmtDate = (d: string) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const SW = 1.2; // Swing bar half-width, in Swing points
---
<Section id="counted" title={`What ${place} count on him for`} placeholder={false} takeaway="What his post-game report cards judge him on, why, and how often he has done it.">
  <ul class="rp-duties">
    {duties.map((j) => { const v = record(j.key); return (
      <li class="card rp-duty">
        <p class="ld-h2">{j.label}</p>
        <p class="rp-why">{j.why === 'role' ? <>Relied on for {why(j)}</> : why(j)}</p>
        <p class="rp-typ">A typical night: <strong>{j.usual}</strong> <span>{j.unit}</span></p>
        <div class="rp-rec">
          <span class="rp-marks">{v.map((x, k) => <span class:list={['rp-m', x]} tabindex="0" data-tip={`${fmtDate(rows[rows.length - 1 - k].date)}: ${word[x]}`}>{mark[x]}</span>)}</span>
          <span class="rp-n"><strong>{delivered(v)} of {v.length}</strong> games</span>
        </div>
      </li>
    ); })}
  </ul>
  <div class="card rp-other">
    <p class="chart-title">Not on his report card</p>
    <ul>
      {others.map(([k, label, text, bar, trait]) => { const t = trait ? traits[trait]?.blend : null; return (
        <li>
          <span class="rp-ol">{label}</span>
          <span class="rp-ov">{t ? <><Pips pct={t.pct} tip={`Better than ${t.pct}% of ${peer[t.vs ?? 'F']}.`} /> <span>better than {t.pct}%{t.pct >= 65 && t.pct < 75 ? ', just short' : ''}</span></> : <span>{text}</span>}</span>
          <span class="rp-bar">{bar}</span>
        </li>
      ); })}
    </ul>
    <p class="note">His report card grades him on what {place} rely on him for and what he does better than most at his position. These are the others, against the same bars.</p>
  </div>
</Section>

<Section id="recent" title="Recent games" placeholder={false} takeaway="His report card and Swing from each game, newest first.">
  <div class="card rp-games">
    <div class="rp-head" aria-hidden="true"><span>Game</span><span>Report card <em class="rp-keys">{duties.map((j) => j.label.replace(' at 5-on-5', '').toLowerCase()).join(' · ')}</em></span><span>Swing</span></div>
    <ul>
      {rows.map((r) => { const s = r.swing; const w = Math.min(1, Math.abs(s.score) / SW) * 50; return (
        <li>
          <a class="rp-game" href={`${base}recap/${r.id}/`}>
            <span class="rp-d">{fmtDate(r.date)}</span>
            <span class="rp-o">{r.home ? 'vs' : 'at'} {r.opp}</span>
            <span class="rp-res">{r.us > r.them ? 'W' : r.end === 'REG' ? 'L' : 'OTL'} {r.us}–{r.them}{r.end !== 'REG' ? ` ${r.end}` : ''}</span>
          </a>
          <span class="rp-card">
            <span class:list={['pc-sum', pillClass[r.card.pill as keyof typeof pillClass]]}>{pillWord[r.card.pill as keyof typeof pillWord]}</span>
            <span class="rp-marks">{r.card.jobs.map((j: any) => <span class:list={['rp-m', j.verdict]} tabindex="0" data-tip={`${j.label}: ${word[j.verdict as keyof typeof word]}. ${j.text}`}>{mark[j.verdict as keyof typeof mark]}</span>)}</span>
            <span class="rp-box">{r.card.box.g} G · {r.card.box.a} A · {r.card.toi}</span>
          </span>
          <span class="rp-sw" tabindex="0" data-tip={`Swing ${s.score.toFixed(2)}: better than ${s.pct}% of nights by forwards last season.`}>
            <span class="rp-track"><i class:list={{ neg: s.score < 0 }} style={s.score >= 0 ? `left:50%;width:${w}%` : `left:${50 - w}%;width:${w}%`}></i></span>
            <strong>{s.score >= 0 ? '+' : '−'}{Math.abs(s.score).toFixed(1)}</strong>
          </span>
        </li>
      ); })}
    </ul>
    <p class="note">Swing is how much his night moved the game, from the post-game page. Tap a game for the full report.</p>
  </div>
</Section>

<style>
  .ld-h2 { font: 600 18px/1.15 var(--display); font-variation-settings: 'SOFT' 100; }
  .rp-duties { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); margin-top: 18px; }
  .rp-duty { display: grid; gap: 8px; align-content: start; }
  .rp-why { font: 400 15px/1.4 var(--ui); }
  .rp-keys { font: 400 11px var(--ui); font-style: normal; text-transform: none; letter-spacing: 0; color: var(--ink-3); margin-left: 6px; }
  .rp-tag { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); margin-right: 4px; }
  .rp-typ { font: 400 14px/1.4 var(--ui); color: var(--ink-2); }
  .rp-typ strong { color: var(--ink); }
  .rp-rec { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-top: 10px; border-top: 1px solid var(--rule); }
  .rp-marks { display: inline-flex; gap: 4px; }
  .rp-m { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--ink); font: 700 11px var(--ui); cursor: help; }
  .rp-m.held { background: var(--ink); color: var(--sheet); }
  .rp-m.missed, .rp-m.na { border-style: dashed; border-color: var(--ink-3); color: var(--ink-2); }
  .rp-n { font: 400 14px var(--ui); color: var(--ink-2); white-space: nowrap; }
  .rp-n strong { color: var(--ink); }
  .rp-other { margin-top: 14px; }
  .rp-other ul { display: grid; }
  .rp-other li { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: 4px 16px; align-items: center; padding: 9px 0; border-top: 1px solid var(--rule); font: 400 15px/1.4 var(--ui); }
  .rp-other li:first-child { border-top: 0; }
  .rp-ol { font-weight: 600; }
  .rp-ov { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); }
  .rp-bar { font-size: 13px; color: var(--ink-3); }
  @media (max-width: 640px) { .rp-other li { grid-template-columns: 1fr; gap: 2px; } }
  .rp-games { margin-top: 18px; }
  .rp-head, .rp-games li { display: grid; grid-template-columns: minmax(170px, 1fr) minmax(0, 1.6fr) minmax(150px, 0.9fr); gap: 6px 18px; align-items: center; }
  .rp-head { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); padding-bottom: 6px; }
  .rp-games li { padding: 10px 0; border-top: 1px solid var(--rule); }
  .rp-game { display: flex; flex-wrap: wrap; gap: 2px 10px; color: inherit; text-decoration: none; font: 400 15px var(--ui); }
  .rp-game:hover .rp-o { text-decoration: underline; }
  .rp-d { color: var(--ink-3); min-width: 48px; }
  .rp-o { font-weight: 600; }
  .rp-res { color: var(--ink-2); }
  .rp-card { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .pc-sum { font: 700 12px var(--ui); padding: 3px 10px; border-radius: 999px; border: 2px solid var(--ink); white-space: nowrap; min-width: 92px; text-align: center; }
  .pc-sum.did { background: var(--ink); color: var(--sheet); }
  .pc-sum.huge { background: var(--team); border-color: var(--team); color: var(--sheet); }
  .pc-sum.rough { background: var(--ink-3); border-color: var(--ink-3); color: var(--sheet); }
  .pc-sum.didnt { border-style: dashed; border-color: var(--ink-3); color: var(--ink-2); }
  .rp-box { font: 400 13px var(--ui); color: var(--ink-3); }
  .rp-sw { display: grid; grid-template-columns: 1fr 40px; align-items: center; gap: 10px; cursor: help; }
  .rp-track { position: relative; height: 12px; border-radius: 3px; background: var(--track); }
  .rp-track::after { content: ''; position: absolute; left: 50%; top: -3px; bottom: -3px; width: 1px; background: var(--ink-3); }
  .rp-track i { position: absolute; top: 0; bottom: 0; border-radius: 3px; background: var(--team); }
  .rp-track i.neg { opacity: 0.45; }
  .rp-sw strong { font: 700 15px var(--ui); text-align: right; }
  @media (max-width: 719px) {
    .rp-head { display: none; }
    .rp-games li { grid-template-columns: 1fr 120px; }
    .rp-card { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
