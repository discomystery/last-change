---
// A player's cut-out photo with no background, meant to stand on a line in the layout: its bottom edge is the bottom of
// the shoulders, so the parent lines it up with a rule or a box edge. Renders nothing when there is no photo, and
// removes itself if the photo fails to load (fresh call-ups often have none yet).
import { photoOf } from '../lib/portraits';

interface Props { id: number; size: number; class?: string }
const { id, size, class: cls } = Astro.props;
const src = photoOf(id);
---
{src && <img class:list={['portrait', cls]} src={src} alt="" width={size} height={size} loading="lazy" decoding="async" onerror="this.remove()" />}

<style>
  .portrait { display: block; flex: none; object-fit: contain; object-position: 50% 100%; user-select: none; pointer-events: none; }
  /* The NHL's studio shots read dark on the site, so lift them a little (user picked "A, Lighter" of three strengths). */
  .portrait { filter: var(--portrait-filter, brightness(1.1) contrast(1.03)); }
  /* Drawn 30% bigger than its box without changing the box (Sora picked "Moderate", 2026-10-13), grown up from the
     line he stands on so his head sits higher (Sora, same day). The NHL's cut-outs leave empty space above the head,
     so the growth mostly fills that; the shoulders may spread a little past the box's sides. */
  .portrait { transform: scale(1.3); transform-origin: 50% 100%; }
</style>
