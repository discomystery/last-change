---
// The two site-wide switches (which seasons, adjusted or recorded) in a small form that stays at the top of the screen
// while scrolling: beside the pinned section menu, or on their own (Base.astro) on pages without one. Same data-pref
// buttons as the settings strip, so Base's settings script wires them up and keeps them in step.
---
<div class="pswitch" role="group" aria-label="Settings">
  <div class="mode sm" role="group" aria-label="Which seasons the numbers use">
    <button type="button" data-pref="mode" data-value="blend" title="This season blended with last">Blended</button>
    <button type="button" data-pref="mode" data-value="season" title="This season alone">This season</button>
  </div>
  <div class="mode sm" role="group" aria-label="Adjusted scores or recorded numbers">
    <button type="button" data-pref="arena" data-value="adjusted" title="Scores adjusted for each arena’s scorer and for score and home ice">Adjusted</button>
    <button type="button" data-pref="arena" data-value="raw" title="Numbers exactly as recorded">Recorded</button>
  </div>
</div>
