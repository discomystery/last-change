---
interface Pt { x: number; y: number; name?: string; team?: string }
interface Hi extends Pt { team: string; name: string; probable: boolean }
interface Props { league: Pt[]; highlights: Hi[]; tall?: boolean; xDomain?: [number, number]; yDomain?: [number, number]; xMid?: number }
const { league, highlights, tall = false, xDomain = [1.9, 3.25], yDomain = [-0.75, 0.75], xMid = 2.575 } = Astro.props;
// `tall` draws a near-square chart for narrow, tall slots.
// The plot sits in a pale box with the quadrant names inside its corners; the vertical range gets extra room so dots
// clear those names.
const W = 360, H = tall ? 400 : 300, m = { l: 0, r: 0, t: 0, b: 26 };
const yPad = (yDomain[1] - yDomain[0]) * 0.22;
const yLo = yDomain[0] - yPad, yHi = yDomain[1] + yPad;
const bh = H - m.b;
// Rounded to a tenth of a unit (well under a pixel): full-precision coordinates were a large share of each page.
const X = (v: number) => +(m.l + ((v - xDomain[0]) / (xDomain[1] - xDomain[0])) * (W - m.l - m.r)).toFixed(1);
const Y = (v: number) => +(m.t + ((yHi - v) / (yHi - yLo)) * (bh - m.t)).toFixed(1);
const cx = X(xMid), cy = Y(0);
// Name labels (sans, about 6.2 units a character): each tries right of its dot, then left, above and below, and takes
// the first spot that clears the box edges, every named goalie's dot and the labels already placed. If none is clear
// it goes right of the dot, nudged up or down past the labels in the way.
type Box = { x0: number; x1: number; y0: number; y1: number };
const hit = (a: Box, b: Box) => a.x0 < b.x1 && a.x1 > b.x0 && a.y0 < b.y1 && a.y1 > b.y0;
const dots: Box[] = highlights.map((p) => ({ x0: X(p.x) - 8, x1: X(p.x) + 8, y0: Y(p.y) - 8, y1: Y(p.y) + 8 }));
const placed: Box[] = [];
const labels = highlights.map((p) => {
  const x = X(p.x), y = Y(p.y), w = p.name.length * 6.2;
  const tries: { lx: number; ly: number; anchor: string; box: Box }[] = [
    { lx: x + 11, ly: y + 4, anchor: 'start', box: { x0: x + 11, x1: x + 11 + w, y0: y - 6, y1: y + 6 } },
    { lx: x - 11, ly: y + 4, anchor: 'end', box: { x0: x - 11 - w, x1: x - 11, y0: y - 6, y1: y + 6 } },
    { lx: x, ly: y - 12, anchor: 'middle', box: { x0: x - w / 2, x1: x + w / 2, y0: y - 22, y1: y - 9 } },
    { lx: x, ly: y + 20, anchor: 'middle', box: { x0: x - w / 2, x1: x + w / 2, y0: y + 9, y1: y + 22 } },
  ];
  const fits = (t: (typeof tries)[number]) => t.box.x0 >= 2 && t.box.x1 <= W - 2 && t.box.y0 >= 2 && t.box.y1 <= bh - 2
    && !placed.some((o) => hit(o, t.box)) && !dots.some((d, j) => highlights[j] !== p && hit(d, t.box));
  let t = tries.find(fits);
  if (!t) {
    t = x < W - 110 ? tries[0] : tries[1];
    for (const o of placed) if (hit(o, t.box)) { const dy = t.box.y0 <= o.y0 ? o.y0 - 13 - t.box.y0 : o.y1 + 1 - t.box.y0; t = { ...t, ly: t.ly + dy, box: { ...t.box, y0: t.box.y0 + dy, y1: t.box.y1 + dy } }; }
  }
  placed.push(t.box);
  return { lx: +t.lx.toFixed(1), ly: +t.ly.toFixed(1), anchor: t.anchor };
});
---
<svg class="quad" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Goalie performance against the workload his team gives him">
  <rect class="q-box" x="0" y="0" width={W} height={bh} rx="12" />
  <line class="q-axis" x1="0" x2={W} y1={cy} y2={cy} />
  <line class="q-axis" x1={cx} x2={cx} y1="0" y2={bh} />
  <text class="q-corner" x="12" y="22"><tspan x="12">System and goalie</tspan><tspan x="12" dy="13">both good</tspan></text>
  <text class="q-corner" x={W - 12} y="22" text-anchor="end"><tspan x={W - 12}>Goalie bailing</tspan><tspan x={W - 12} dy="13">them out</tspan></text>
  <text class="q-corner" x="12" y={bh - 26}><tspan x="12">Goalie giving back</tspan><tspan x="12" dy="13">what the system earns</tspan></text>
  <text class="q-corner" x={W - 12} y={bh - 26} text-anchor="end"><tspan x={W - 12}>Trouble</tspan><tspan x={W - 12} dy="13">everywhere</tspan></text>
  <text class="q-axis-label" x={W / 2} y={H - 6} text-anchor="middle">Team allows fewer chances ← → more chances</text>
  {league.map((p) => (
    <g class="q-pt" data-tip={p.name ? `${p.name}${p.team ? ` (${p.team})` : ''}: ${p.y > 0 ? '+' : '−'}${Math.abs(p.y).toFixed(2)} goals saved above expected per 60; his team allows ${p.x.toFixed(2)} expected goals per 60 in front of him.` : undefined}>
      <circle class="q-hit" cx={X(p.x)} cy={Y(p.y)} r="8" />
      <circle class="q-lg" cx={X(p.x)} cy={Y(p.y)} r="3" />
    </g>
  ))}
  {highlights.map((p, i) => {
    const l = labels[i];
    return (
      <g class={`t-${p.team}`} data-tip={`${p.name} (${p.team}): ${p.y > 0 ? '+' : '−'}${Math.abs(p.y).toFixed(2)} goals saved above expected per 60; team allows ${p.x.toFixed(2)} expected goals per 60 in front of him`}>
        <circle class:list={['q-hi', { backup: !p.probable }]} cx={X(p.x)} cy={Y(p.y)} r="6.5" />
        <text class="q-name" x={l.lx} y={l.ly} text-anchor={l.anchor}>{p.name}</text>
      </g>
    );
  })}
</svg>
