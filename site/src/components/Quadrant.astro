---
interface Pt { x: number; y: number }
interface Hi extends Pt { team: string; name: string; probable: boolean }
interface Props { league: Pt[]; highlights: Hi[] }
const { league, highlights } = Astro.props;
const W = 360, H = 300, m = { l: 14, r: 14, t: 26, b: 34 };
const X = (v: number) => m.l + ((v - 1.9) / (3.25 - 1.9)) * (W - m.l - m.r);
const Y = (v: number) => m.t + ((0.75 - v) / 1.5) * (H - m.t - m.b);
const cx = X(2.575), cy = Y(0);
---
<svg class="quad" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Goalie performance against the workload his team gives him">
  <line class="q-axis" x1={m.l} x2={W - m.r} y1={cy} y2={cy} />
  <line class="q-axis" x1={cx} x2={cx} y1={m.t} y2={H - m.b} />
  <text class="q-corner" x={m.l} y="14">System and goalie both good</text>
  <text class="q-corner" x={W - m.r} y="14" text-anchor="end">Goalie bailing them out</text>
  <text class="q-corner" x={m.l} y={H - m.b + 14}>Goalie giving back what the system earns</text>
  <text class="q-corner" x={W - m.r} y={H - m.b + 14} text-anchor="end">Trouble everywhere</text>
  <text class="q-axis-label" x={W / 2} y={H - 3} text-anchor="middle">Team allows fewer chances ← → more chances</text>
  {league.map((p) => <circle class="q-lg" cx={X(p.x)} cy={Y(p.y)} r="3" />)}
  {highlights.map((p, i) => {
    const right = X(p.x) < W - 110;
    return (
      <g class={`t-${p.team}`} data-tip={`${p.name} (${p.team}): ${p.y > 0 ? '+' : '−'}${Math.abs(p.y).toFixed(2)} goals saved above expected per hour; team allows ${p.x.toFixed(2)} expected goals per hour in front of him`}>
        <circle class:list={['q-hi', { backup: !p.probable }]} cx={X(p.x)} cy={Y(p.y)} r="6.5" />
        <text class="q-name" x={X(p.x) + (right ? 11 : -11)} y={Y(p.y) + 4} text-anchor={right ? 'start' : 'end'}>{p.name}</text>
      </g>
    );
  })}
</svg>
