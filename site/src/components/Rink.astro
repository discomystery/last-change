---
// The matchup drawn as a rink seen from above: visitors on the left, home team on the right.
// With the site's motion on, it drops the puck once when it comes into view: the lines paint in from centre ice,
// the centre circle draws itself, the teams skate in from their own ends, and a final score ticks up.
// Real pages pass `sides`; the mock recap still falls back to the mock teams.
import { order, home, teams, type Abbr } from '../data/mock';
type Side = { abbr: string; cls: string; full: string; rec?: string; score?: number; home: boolean; href?: string };
interface Props { score?: Record<Abbr, number>; centre?: string; sides?: Side[] }
const { score, centre = 'at', sides } = Astro.props;
const rec = (a: Abbr) => `${teams[a].record.w}-${teams[a].record.l}-${teams[a].record.otl}`;
const list: Side[] = sides ?? order.map((a) => ({ abbr: a, cls: `t-${a}`, full: `${teams[a].place} ${teams[a].name}`, rec: rec(a), score: score?.[a], home: a === home }));
const scored = list.some((s) => s.score !== undefined);
---
<div class="rink" data-drop>
  <svg class="rk-boards" aria-hidden="true"><rect pathLength="100" /></svg>
  <span class="rl goal l"></span><span class="rl blue l"></span><span class="rl red"></span><span class="rl blue r"></span><span class="rl goal r"></span>
  <span class="dot-circle"><span>{centre}</span></span>
  {list.map((s) => (
    <div class:list={['side', s.cls, s.home ? 'is-home' : 'is-away']}>
      <p class="abbr">{s.href ? <a class="rlink" href={s.href}>{s.abbr}</a> : s.abbr}{s.score !== undefined && <span class="score" data-to={s.score}>{s.score}</span>}</p>
      <p class="fullname">{s.href ? <a class="rlink" href={s.href}>{s.full}</a> : s.full}</p>
      {!scored && s.rec && <p class="rec">{s.rec}</p>}
      {s.home && !scored && <p class="lc"><span class="term" tabindex="0" data-tip="The home coach sends his players out second after every whistle, so he picks the matchups.">Has last change</span></p>}
    </div>
  ))}
</div>

<style>
  .rink { position: relative; display: grid; grid-template-columns: 1fr 1fr; background: var(--sheet); border: 2px solid var(--ink); border-radius: 56px; overflow: hidden; min-height: 220px; }
  .rl { position: absolute; top: 0; bottom: 0; }
  .rl.red { left: 50%; width: 5px; margin-left: -2.5px; background: var(--line-red); }
  .rl.blue { width: 5px; background: var(--line-blue); }
  .rl.blue.l { left: 37.5%; } .rl.blue.r { right: 37.5%; }
  .rl.goal { width: 1px; background: var(--line-red); }
  .rl.goal.l { left: 5.5%; } .rl.goal.r { right: 5.5%; }
  .dot-circle { position: absolute; left: 50%; top: 50%; width: 72px; height: 72px; margin: -36px 0 0 -36px; border-radius: 50%; border: 2px solid var(--line-blue); background: var(--sheet); display: grid; place-items: center; font: italic 500 22px/1 var(--body); color: var(--ink-2); }
  /* The ring is its own layer so it can draw itself while the disc already covers the red line. */
  .dot-circle::before { content: ''; position: absolute; inset: -2px; border-radius: 50%; border: 2px solid var(--line-blue); }
  .dot-circle { border-color: transparent; }
  /* The boards, drawn by the script below once it knows the rink's size; until then the plain border shows. */
  .rk-boards { display: none; position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .rk-boards rect { fill: none; stroke: var(--ink); stroke-width: 2; }
  .rink.boards { border-color: transparent; background-clip: padding-box; }
  .rink.boards .rk-boards { display: block; }
  .side { position: relative; padding: 28px clamp(20px, 7vw, 76px); display: flex; flex-direction: column; justify-content: center; gap: 2px; min-width: 0; }
  .side.is-home { text-align: right; align-items: flex-end; }
  .abbr { font: 700 clamp(42px, 12.5vw, 108px) / 0.9 var(--ui); letter-spacing: -0.035em; color: var(--team); display: flex; align-items: baseline; gap: 0.25em; }
  .is-home .abbr { flex-direction: row-reverse; }
  .score { color: var(--ink); font: 600 1em/0.9 var(--display); font-variation-settings: 'SOFT' 100; letter-spacing: -0.02em; }
  @media (max-width: 620px) {
    .abbr:has(.score) { flex-direction: column; align-items: inherit; gap: 6px; }
    .is-home .abbr:has(.score) { flex-direction: column; align-items: flex-end; }
  }
  /* The big team names fade a touch under the pointer: a highlight box would swamp letters this size. */
  .rlink { color: inherit; transition: opacity 0.15s ease; }
  .rlink:hover { opacity: 0.7; }
  .fullname { font-weight: 600; font-size: clamp(13px, 2.6vw, 17px); margin-top: 10px; line-height: 1.3; }
  .rec { color: var(--ink-2); font: 400 14px var(--ui); }
  .lc { font: 600 13px var(--ui); margin-top: 4px; }

  /* Dropping the puck (html.motion only, so reduced motion and automated browsers see the rink as it is).
     Until the rink is on screen its moving parts wait out of sight; `.run` plays them once. */
  :global(html.motion) .rink:not(.run) :is(.rl, .dot-circle, .abbr, .fullname, .rec, .lc, .rk-boards) { opacity: 0; }
  .run .rk-boards rect { stroke-dasharray: 100; animation: rk-trace 1.1s cubic-bezier(0.5, 0, 0.3, 1) backwards; }
  @keyframes rk-trace { from { stroke-dashoffset: 100; } }
  .run .rl { animation: rk-line 0.6s cubic-bezier(0.3, 0.8, 0.25, 1) 0.15s backwards; }
  .run .rl.blue { animation-delay: 0.25s; }
  .run .rl.goal { animation-delay: 0.35s; }
  .run .dot-circle { animation: rk-fade 0.3s ease 0.1s backwards; }
  .run .dot-circle::before { animation: rk-draw 0.8s ease-out 0.3s backwards; }
  .run .dot-circle > span { animation: rk-fade 0.5s ease 0.6s backwards; }
  .run .is-away .abbr { animation: rk-in-l 0.8s cubic-bezier(0.2, 0.9, 0.2, 1) 0.35s backwards; }
  .run .is-home .abbr { animation: rk-in-r 0.8s cubic-bezier(0.2, 0.9, 0.2, 1) 0.35s backwards; }
  .run :is(.fullname, .rec, .lc) { animation: rk-fade 0.6s ease 0.8s backwards; }
  @property --rk-arc { syntax: '<angle>'; inherits: false; initial-value: 360deg; }
  @keyframes rk-line { from { transform: scaleY(0); } }
  @keyframes rk-draw { from { --rk-arc: 0deg; } }
  .run .dot-circle::before { -webkit-mask: conic-gradient(#000 var(--rk-arc), transparent 0); mask: conic-gradient(#000 var(--rk-arc), transparent 0); }
  @keyframes rk-fade { from { opacity: 0; } }
  @keyframes rk-in-l { from { opacity: 0; transform: translateX(-46px); } }
  @keyframes rk-in-r { from { opacity: 0; transform: translateX(46px); } }
</style>

<script>
  // Drop the puck once per rink, when it is half on screen. A final score counts up from zero as the teams arrive.
  const root = document.documentElement;
  if (root.classList.contains('motion') && 'IntersectionObserver' in window) {
    // Fit the boards' outline to each rink (inside its 2px border, which then turns clear) and keep it fitted.
    const fit = (rink: HTMLElement) => {
      const r = rink.querySelector('.rk-boards rect');
      if (!r || !rink.clientWidth) return;
      const w = rink.clientWidth, h = rink.clientHeight, rad = parseFloat(getComputedStyle(rink).borderTopLeftRadius) - 3;
      r.setAttribute('x', '1'); r.setAttribute('y', '1');
      r.setAttribute('width', String(w - 2)); r.setAttribute('height', String(h - 2));
      r.setAttribute('rx', String(Math.max(0, Math.min(rad, h / 2 - 1))));
      rink.classList.add('boards');
    };
    const ro = 'ResizeObserver' in window ? new ResizeObserver((es) => es.forEach((e) => fit(e.target as HTMLElement))) : null;
    document.querySelectorAll<HTMLElement>('[data-drop]').forEach((r) => { fit(r); ro?.observe(r); });
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const rink = e.target as HTMLElement;
        rink.querySelectorAll<HTMLElement>('.score[data-to]').forEach((s) => {
          const to = +s.dataset.to!;
          s.textContent = '0';
          for (let i = 1; i <= to; i++) setTimeout(() => { s.textContent = String(i); }, 700 + i * Math.min(140, 700 / to));
        });
        rink.classList.add('run');
      }
    }, { threshold: 0.5 });
    document.querySelectorAll('[data-drop]').forEach((r) => io.observe(r));
  }
</script>
