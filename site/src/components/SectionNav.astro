---
// Section menu for long pages (team, preview, post-game, player, league, track record, methods), one style on every
// page (Sora, 2026-10-13). Wide screens: a row of section names pinned while scrolling. Phones: a thin bar pinned to
// the top of the screen, "Jump to [section]", using the phone's own picker; it follows along to name the section being read. Renders two siblings (no wrapper) so the
// pinned elements stick for the whole page, not just inside a short wrapper.
// Reading line (Sora picked B and D of the section-menu pitches, 2026-10-13): a line with one dot per section runs
// under the pinned row (under each name) and under the phone bar (evenly spaced); a puck slides along it with the
// scroll, the line darkens behind it and each dot fills once its section has been reached. Phones add "Next: ...".
// The frosted strip ends flush on the reading line (Sora, 2026-10-15), so the line is its bottom edge and the dots and
// puck hang half below it.
// Settings live in the team pill (SiteTools), which rides at the right of the pinned row on computers.
// Each link carries a class so the site's plain-text-link style (Base.astro, `a:not([class])`) never reaches it.
import SiteTools from './SiteTools.astro';
interface Props { items: [string, string][] }
const { items } = Astro.props;
// Mid-sentence in "Jump to [section]", a section name starts lower case ("Jump to next game"), unless it starts with
// a capitalized word such as an abbreviation ("NHL ...").
const inSentence = (label: string) => (/^[A-Z][a-z]/.test(label) ? label[0].toLowerCase() + label.slice(1) : label);
---
<div class="secnav-pin"><nav class="jump secnav-pills pinned" aria-label="Sections">{items.map(([id, label]) => <a class="secnav-a" href={`#${id}`}>{label}</a>)}<span class="secnav-line" aria-hidden="true"></span><span class="secnav-fill" aria-hidden="true"></span>{items.map(() => <span class="secnav-tick" aria-hidden="true"></span>)}<span class="secnav-puck" aria-hidden="true"></span></nav><div class="secnav-prefs"><SiteTools menu /></div></div>
<div class="secnav-bar">
  <div class="secnav-jumprow">
    <label for="secnav-pick">Jump to</label>
    <select id="secnav-pick" aria-label="Jump to a section">{items.map(([id, label]) => <option value={id}>{inSentence(label)}</option>)}</select>
  </div>
  <div class="secnav-foot"><p class="secnav-next" aria-hidden="true"></p></div>
  <div class="secnav-dots"><span class="secnav-line" aria-hidden="true"></span><span class="secnav-fill" aria-hidden="true"></span>{items.map(() => <span class="secnav-tick" aria-hidden="true"></span>)}<span class="secnav-puck" aria-hidden="true"></span></div>
</div>

<script is:inline>
  // Runs once the page has loaded: the sections it tracks come after this menu in the page.
  const secnavStart = () => {
    const pick = document.getElementById('secnav-pick');
    if (!pick) return;
    const bar = document.querySelector('.secnav-bar');
    const row = document.querySelector('.secnav-pills');
    const names = [...row.querySelectorAll('a')];
    const labels = names.map((a) => a.textContent);
    const ids = [...pick.options].map((o) => o.value);
    const secs = ids.map((id) => document.getElementById(id));
    const next = bar.querySelector('.secnav-next');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    pick.addEventListener('change', () => {
      const el = document.getElementById(pick.value);
      if (el) el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });
    // Each track: where its dots sit along it (centre of each name on the row, evenly spaced on phones).
    const tracks = [];
    if (row.classList.contains('pinned')) tracks.push({ box: row, xs: () => names.map((a) => a.offsetLeft + a.offsetWidth / 2) });
    const dots = bar.querySelector('.secnav-dots');
    tracks.push({ box: dots, xs: () => ids.map((_, i) => (ids.length > 1 ? (dots.clientWidth * i) / (ids.length - 1) : 0)) });
    const lay = () => tracks.forEach((t) => {
      const x = t.xs();
      t.x = x;
      t.ticks = [...t.box.querySelectorAll('.secnav-tick')];
      t.ticks.forEach((d, i) => (d.style.left = x[i] + 'px'));
      const line = t.box.querySelector('.secnav-line');
      line.style.left = x[0] + 'px';
      line.style.width = x[x.length - 1] - x[0] + 'px';
      t.box.querySelector('.secnav-fill').style.left = x[0] + 'px';
    });
    let queued = false, cur = -1;
    const update = () => {
      queued = false;
      const visible = getComputedStyle(bar).display !== 'none';
      const reach = scrollY + (visible ? bar.offsetHeight : row.offsetHeight) + 40;
      // Page position of each section's top; a missing section borrows the one before it.
      let prev = 0;
      const tops = secs.map((s) => (prev = s ? s.getBoundingClientRect().top + scrollY : prev));
      let i = 0;
      tops.forEach((t, k) => { if (t <= reach) i = k; });
      const atEnd = scrollY + innerHeight >= document.documentElement.scrollHeight - 2;
      // How far through the section being read: the puck sits between its dot and the next one.
      let f = i;
      if (atEnd) f = i = ids.length - 1;
      else if (i < ids.length - 1 && tops[i + 1] > tops[i]) f = i + Math.min(1, Math.max(0, (reach - tops[i]) / (tops[i + 1] - tops[i])));
      if (reach < tops[0]) f = 0;
      tracks.forEach((t) => {
        if (!t.x) return;
        const k = Math.floor(f), b = Math.min(k + 1, t.x.length - 1);
        const px = t.x[k] + (t.x[b] - t.x[k]) * (f - k);
        t.box.querySelector('.secnav-puck').style.translate = `${px}px 0`;
        t.box.querySelector('.secnav-fill').style.width = Math.max(0, px - t.x[0]) + 'px';
        t.ticks.forEach((d, j) => d.classList.toggle('past', j <= f + 0.001));
      });
      if (i === cur) return;
      cur = i;
      if (document.activeElement !== pick) pick.value = ids[i];
      next.textContent = i < ids.length - 1 ? 'Next: ' + labels[i + 1] : '';
      names.forEach((a, k) => a.classList.toggle('here', k === i));
      const here = names[i];
      if (here && row.classList.contains('pinned')) {
        const want = here.offsetLeft - row.clientWidth / 2 + here.offsetWidth / 2;
        if (Math.abs(row.scrollLeft - want) > 4) row.scrollTo({ left: want, behavior: reduce ? 'auto' : 'smooth' });
      }
    };
    const refresh = () => { lay(); cur = -1; update(); };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    if ('ResizeObserver' in window) { const ro = new ResizeObserver(refresh); ro.observe(row); ro.observe(dots); }
    else addEventListener('resize', refresh);
    if (document.fonts) document.fonts.ready.then(refresh);
    refresh();
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', secnavStart);
  else secnavStart();
</script>

<style is:global>
  /* Plain section names; the one being read is dark. Pinned rows get the reading line underneath. */
  .jump.secnav-pills { gap: 2px; }
  .jump.secnav-pills a { font-weight: 600; color: var(--ink-3); border: 0; background: none; padding: 5px 10px; transition: color 0.2s; }
  .jump.secnav-pills a:hover { color: var(--ink); }
  .jump.secnav-pills a.here { color: var(--ink); }
  /* The pinned row sits in a frosted strip with the team pill and the page-list icon at its right once the top menu
     has scrolled away (Sora, 2026-10-14). */
  .secnav-pin {
    position: sticky; top: 0; z-index: 15; display: flex; align-items: flex-start; gap: 12px; margin: 14px -16px 0; padding-right: 16px;
  }
  /* The frosted background stops 3 px up, at the reading line's lower edge (the strip's own box runs on to hold the
     dots that hang below the line). */
  .secnav-pin::before, .secnav-bar::before {
    content: ''; position: absolute; inset: 0 0 3px 0; z-index: -1; pointer-events: none;
    background: color-mix(in oklab, var(--ice) 96%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  }
  .secnav-pin .jump.secnav-pills { flex: 1; min-width: 0; margin: 0; padding-block: 8px 14px; }
  /* Centred on the section names: the names are 30.8 px boxes from 8 px down, the pill about 28 px tall. */
  .secnav-prefs { display: none; flex: none; padding-top: 9px; }
  html.prefs-away .secnav-prefs { display: block; }
  html.motion.prefs-away .secnav-prefs { animation: secnav-in 0.25s ease-out; }
  @keyframes secnav-in { from { opacity: 0; translate: 6px 0; } }
  .secnav-line, .secnav-fill { position: absolute; bottom: 3px; height: 2px; border-radius: 1px; background: var(--rule); pointer-events: none; }
  .secnav-fill { background: var(--ink); width: 0; }
  .secnav-tick { position: absolute; bottom: 1px; width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: var(--sheet); box-shadow: inset 0 0 0 1.5px var(--rule); pointer-events: none; }
  .secnav-tick.past { background: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }
  .secnav-puck { position: absolute; left: -4px; bottom: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--ink); pointer-events: none; }
  html.motion .secnav-puck { transition: translate 0.12s linear; }
  html.motion .secnav-tick { transition: background 0.25s, box-shadow 0.25s; }
  .secnav-bar { display: none; }
  @media (max-width: 719px) {
    .jump.secnav-pills { display: none; }
    .secnav-pin { display: none; }  /* beats the shared .jump row style, whichever loads last */
    .secnav-bar {
      display: block; position: sticky; top: 0; z-index: 15;
      margin: 14px -16px 0; padding: 9px 16px 0;
    }
    .secnav-jumprow { display: flex; align-items: baseline; gap: 10px; font: 500 17px/1.3 var(--ui); color: var(--ink-2); }
    .secnav-jumprow label { white-space: nowrap; }
    .secnav-jumprow select { min-width: 0; }
    .secnav-dots { position: relative; height: 12px; margin: 2px 4px 0; }
    /* "Next" at the right, just above the dotted line. */
    .secnav-foot { display: flex; align-items: center; padding: 6px 0 0; }
    .secnav-next { flex: 1; min-width: 0; margin: 0; font: 500 12px var(--ui); color: var(--ink-3); text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    main [id] { scroll-margin-top: 104px; }
  }
  @media (prefers-reduced-motion: reduce) { .jump.secnav-pills a { transition: none; } }
</style>
