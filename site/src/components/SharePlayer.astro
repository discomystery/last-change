---
// The player page's share card (lib/shareCard.ts): a skater's player card, or a goalie's goalie card. Everything on it
// is worked out here from the same data the page shows; the skater card follows the visitor's Seasons setting.
import ShareDialog from './ShareDialog.astro';
import { cardColours } from '../lib/teams';
import { clock } from '../lib/format';
import { standouts, ordinal, posWord, type Skater, type Mode } from '../lib/players';
import { cardsFor } from '../lib/reportCards';
import teamsData from '../../public/data/teams.json';
import { goalieCard } from '../lib/goalieShare';
import type { GoalieCardData, PlayerCardData, ScaleLane, Tile } from '../lib/shareCard';

interface Props { p: any }
const { p } = Astro.props;
const team = teamsData.find((t) => t.abbr === p.team);
const place = team?.place ?? p.team;
const own = cardColours(p.team, p.team).own[p.team];
const last = p.last ?? p.name.split(' ').slice(-1)[0];
const asOf = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }).format(new Date(p.generated_at));
const sub = (extra: (string | null)[]) => [p.number != null ? `#${p.number}` : null, posWord[p.pos] ?? p.pos, team?.name ?? p.team, ...extra].filter(Boolean).join(' · ');
const isG = p.group === 'G';
const modes: Mode[] = ['blend', 'season'];

let skater: PlayerCardData | null = null;
if (!isG && p.traits && p.stats?.season) {
  const s = p as Skater;
  const st = s.stats.season!;
  // Share-of-scoring tiles, as in "What he carries": goals he's in on, then power-play goals (else his own goals, shots).
  const INFO: Record<string, [string, string]> = { inOn: ['Goals he’s in on', 'goals'], pp: ['Power-play goals', 'PP goals'], goals: ['Goals he scores', 'goals'], shots: ['Shots on goal', 'shots'] };
  const TIERS: [number, string, string][] = [[10, 'One of a kind', 'v1'], [32, 'Load-bearing', 'v2'], [64, 'Major piece', 'v3'], [128, 'Contributor', 'v4'], [Infinity, 'Spread around', 'v5']];
  const tiles = (mode: Mode): Tile[] => {
    const all = (p.carries?.tiles?.[mode] ?? []) as { key: string; num: number; den: number; v: number; rank: number | null; mates: [string, number, number][] }[];
    const by = Object.fromEntries(all.map((x) => [x.key, x]));
    const two = ['inOn', 'pp', 'goals', 'shots'].map((k) => by[k]).filter((x) => x && x.den > 0).slice(0, 2);
    const max = Math.max(1, ...two.flatMap((x) => x.mates.map((m) => m[1])), ...two.map((x) => x.v)) * 1.08;
    return two.map((x) => {
      const tier = x.rank == null ? null : TIERS.find(([n]) => x.rank! <= n)!;
      return { label: INFO[x.key][0], v: x.v, sub: `${x.num} of ${x.den} ${INFO[x.key][1]}${x.rank != null ? ` · ${ordinal(x.rank)} in the NHL` : ''}`,
        tier: tier?.[1] ?? null, cls: tier?.[2] ?? 'v5', mates: x.mates.map((m) => [Math.round((1000 * m[1]) / max) / 10, !!m[2]] as [number, boolean]) };
    });
  };
  const lanes = (mode: Mode): ScaleLane[] => standouts(s, mode).best.slice(0, 2).map((x) => ({
    label: x.info.label, rank: x.rank ? `${ordinal(x.rank)} of ${x.of} ${x.vs}` : `${ordinal(x.pct)} percentile`,
    pct: x.pct, lo: x.est?.lo ?? null, hi: x.est?.hi ?? null, ends: [x.info.lo, x.info.hi],
  }));
  const duties = (cardsFor(p.id, p.team)[0]?.card?.jobs ?? []) as { label: string }[];
  skater = {
    id: p.id, name: p.name, last, number: p.number, sub: sub([p.age ? String(p.age) : null]), place, own, asOf,
    stats: [[st.gp, 'GP'], [st.g, 'G'], [st.a, 'A'], [st.p, 'P'], [clock(st.toi), 'TOI']],
    // The card's heading already says what they count on him for, so the chips drop the "at 5-on-5" tail to fit one row.
    chips: duties.map((j) => j.label.replace(/ at 5-on-5$/, '')),
    modes: Object.fromEntries(modes.map((m) => [m, { lanes: lanes(m), tiles: tiles(m) }])) as PlayerCardData['modes'],
  };
}

const goalie: GoalieCardData | null = isG ? goalieCard({ name: p.name, number: p.number, sub: sub([]), team: p.team, goalie: p.goalie, asOf }) : null;
const data = skater ? { kind: 'player', d: skater } : goalie ? { kind: 'goalie', d: goalie } : null;
---
{data && (
  <>
    <script type="application/json" id="share-player" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    <ShareDialog />
  </>
)}
<script>
  import type { GoalieCardData, PlayerCardData } from '../lib/shareCard';
  import { openShare, onShare, mode, slug } from '../lib/shareSheet';
  const el = document.getElementById('share-player');
  if (el) {
    const { kind, d } = JSON.parse(el.textContent!) as { kind: 'player'; d: PlayerCardData } | { kind: 'goalie'; d: GoalieCardData };
    onShare('player', () => {
      const m = kind === 'player' ? mode() : 'blend';
      openShare({ title: kind === 'player' ? 'Share this player' : 'Share this goalie', file: `spare-line-change-${slug(d.name)}${m === 'season' ? '-this-season' : ''}.png`, key: `${kind}:${m}`,
        make: async (t) => {
          const lib = await import('../lib/shareCard');
          return lib.render(kind === 'player' ? lib.playerCard(d as PlayerCardData, m, t) : lib.goalieCard(d as GoalieCardData, t));
        } });
    });
  }
</script>
