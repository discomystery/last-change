---
// The post-game page's share sheet: what each "Share" link makes (the game, a team's Swing, one player's night), drawn
// in the visitor's browser by lib/shareCard.ts. This file only hands over the game's own facts; the Swing and report
// card numbers are read from data/scores and data/jobs when someone opens a card.
import ShareDialog from './ShareDialog.astro';
import { cardColours } from '../lib/teams';
import teamsData from '../../public/data/teams.json';
import index from '../../public/data/players/index.json';
import type { GameData } from '../lib/shareCard';
import { jobsFor, scoresFor } from '../lib/gameFiles';

type Lane = GameData['calls'][number]['lane'];
type Call = { head: string; said?: string; title?: string; plain?: string; verdict: string | null; lane?: Lane };
interface Props {
  r: { game_id: number; start: string; away: string; home: string; venue: string; end: string; score: Record<string, number>; calls: Call[]; story?: { head: string; paras: string[] } | null; replays?: { xg: Record<string, number> } | null };
  replays: { away: number; tie: number; home: number } | null;
  replayHead: string;
}
const { r, replays, replayHead } = Astro.props;
const { away, home } = r;
const T = Object.fromEntries(teamsData.map((t) => [t.abbr, t]));
const cc = cardColours(away, home);
const teams = Object.fromEntries([away, home].map((a) => [a, { place: T[a]?.place ?? a, name: T[a]?.name ?? a, nick: T[a]?.nick ?? a, own: cc.own[a], match: cc.matchup[a] }]));

const scores = scoresFor<{ players: { id: number; pos: string; score: number }[] }>(r.game_id);
const jobs = jobsFor<{ players: { id: number; box: { g: number; a: number } }[] }>(r.game_id);
const P = new Map((index as { id: number; name: string; number?: number | null }[]).map((p) => [p.id, p]));
const ids = new Set([...(scores?.players ?? []), ...(jobs?.players ?? [])].map((p) => p.id));
const people = Object.fromEntries([...ids].filter((id) => P.has(id)).map((id) => [id, [P.get(id)!.name, P.get(id)!.number ?? null]]));

// The night's best skater by Swing, with his points: "Jackson Blake: a goal, an assist, Swing +1.9".
const count = (n: number, one: string, many: string) => (n === 1 ? one : n > 1 ? `${n} ${many}` : '');
const best = (() => {
  const top = scores?.players.filter((p) => p.pos !== 'G').sort((a, b) => b.score - a.score)[0];
  if (!top) return null;
  const box = jobs?.players.find((p) => p.id === top.id)?.box;
  const pts = box ? [count(box.g, 'a goal', 'goals'), count(box.a, 'an assist', 'assists')].filter(Boolean) : [];
  const v = top.score > 0 ? `+${top.score.toFixed(1)}` : top.score.toFixed(1);
  return `${P.get(top.id)?.name ?? (top as { name?: string }).name}: ${[...pts, `Swing ${v}`].join(', ')}`;
})();

const graded = r.calls.filter((c) => c.verdict === 'held' || c.verdict === 'partly' || c.verdict === 'missed');
const data: Omit<GameData, 'id'> & { id: number } = {
  id: r.game_id, base: import.meta.env.BASE_URL, away, home, venue: r.venue, end: r.end, score: r.score,
  date: new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(r.start)),
  head: r.story?.head ?? `${teams[away].nick} ${r.score[away]}, ${teams[home].nick} ${r.score[home]}`,
  lede: r.story?.paras?.[0] ?? null,
  teams,
  replays: replays && r.replays ? { ...replays, head: replayHead, xg: r.replays.xg } : null,
  calls: graded.map((c) => ({ said: c.said ?? `the preview’s “${c.head}”`, title: c.title ?? c.plain ?? c.head, verdict: c.verdict as 'held' | 'partly' | 'missed', lane: c.lane ?? null })),
  best,
  people,
};
---
<script type="application/json" id="share-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
<ShareDialog />
<script>
  import type { GameData } from '../lib/shareCard';
  import { openShare, onShare, slug, type Theme } from '../lib/shareSheet';
  // The card maker (and the library that turns it into a picture) loads on the first Share tap, not with the page.
  const lib = () => import('../lib/shareCard');

  const g = JSON.parse(document.getElementById('share-data')!.textContent!) as GameData;
  const game = `${g.away}-at-${g.home}-${slug(g.date.replace(/^\w+, /, ''))}`;
  const file = (s: string) => `spare-line-change-${s}.png`;
  onShare('game', () => openShare({ title: 'Share this game', file: file(game), key: 'game',
    make: async (t: Theme) => { const { gameCard, render } = await lib(); return render(gameCard(g, t)); } }));
  onShare('swing', () => {
    // With both teams shown, the card is the visitor's own team's when it played, else the visitors'.
    const picked = (document.getElementById('sw-team') as HTMLSelectElement | null)?.value;
    const mine = (window as { lcPrefs?: { get(k: string): string | null } }).lcPrefs?.get('team');
    const team = picked && g.teams[picked] ? picked : mine && g.teams[mine] ? mine : g.away;
    const nick = g.teams[team].nick;
    openShare({ title: `Share the ${nick}${nick.endsWith('s') ? '’' : '’s'} Swing`, file: file(`${game}-swing-${team}`), key: `swing:${team}`,
      make: async (t) => { const { swingCard, render, load } = await lib(); return render(swingCard(g, await load(g, 'scores'), team, t)); } });
  });
  onShare('night', (b) => {
    const id = Number(b.dataset.id);
    const who = g.people[id]?.[0];
    openShare({ title: who ? `Share ${who}’s night` : 'Share his night', file: file(`${slug(who ?? String(id))}-${game}`), key: `night:${id}`,
      make: async (t) => {
        const { nightCard, render, load } = await lib();
        const [s, j] = await Promise.all([load(g, 'scores').catch(() => null), load(g, 'jobs')]);
        return render(nightCard(g, s as never, j as never, id, t));
      } });
  });
</script>
