---
// The team page's share card: their most distinctive style traits (lib/shareCard.ts teamCard). The traits are picked
// here, for both season readings; the card follows the visitor's Seasons setting.
import ShareDialog from './ShareDialog.astro';
import { cardColours } from '../lib/teams';
import { fpInfo, ordinal } from '../data/mock';
import teamsData from '../../public/data/teams.json';
import fpData from '../../public/data/fingerprints.json';
import type { ScaleLane, TeamCardData } from '../lib/shareCard';

interface Props { abbr: string }
const { abbr } = Astro.props;
const t = teamsData.find((x) => x.abbr === abbr)!;
type Est = { pct: number | null; lo: number; hi: number; rank: number };
const dims = (fpData.teams as unknown as Record<string, { dims: Record<string, Record<'blend' | 'season', Est | null>> }>)[abbr].dims;
// Six traits: those whose likely range sits clear of the middle first (as "What sets them apart" picks), then the
// next furthest from average, each list most extreme first.
const pick = (mode: 'blend' | 'season'): ScaleLane[] => {
  const ok = fpData.ready.filter((k) => dims[k]?.[mode]?.pct != null && fpInfo[k]).map((k) => ({ k, e: dims[k][mode]! }));
  const far = (x: { e: Est }) => Math.abs(x.e.pct! - 50);
  const clear = ok.filter((x) => x.e.lo >= 65 || x.e.hi <= 35).sort((a, b) => far(b) - far(a));
  const rest = ok.filter((x) => !clear.includes(x)).sort((a, b) => far(b) - far(a));
  return [...clear, ...rest].slice(0, 6).map(({ k, e }) => ({ label: fpInfo[k].label, rank: ordinal(e.rank), pct: e.pct!, lo: e.lo, hi: e.hi, ends: [fpInfo[k].lo, fpInfo[k].hi] }));
};
const day = (iso: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }).format(new Date(iso));
const data: TeamCardData = {
  abbr, name: t.name, place: t.place, own: cardColours(abbr, abbr).own[abbr], asOf: day(fpData.generated_at),
  line: `${t.w}-${t.l}-${t.otl} · ${ordinal(t.div_rank)} in the ${t.division}`,
  modes: { blend: pick('blend'), season: pick('season') },
};
---
<script type="application/json" id="share-team" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
<ShareDialog />
<script>
  import type { TeamCardData } from '../lib/shareCard';
  import { openShare, onShare, mode } from '../lib/shareSheet';
  const d = JSON.parse(document.getElementById('share-team')!.textContent!) as TeamCardData;
  onShare('team', () => {
    const m = mode();
    openShare({ title: `Share ${d.place}’s style`, file: `spare-line-change-${d.abbr}-style${m === 'season' ? '-this-season' : ''}.png`, key: `team:${m}`,
      make: async (t) => { const { teamCard, render } = await import('../lib/shareCard'); return render(teamCard(d, m, t)); } });
  });
</script>
