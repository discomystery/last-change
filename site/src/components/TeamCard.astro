---
// One team in a list: colour dot, name linking to its page, record and points. The page fills in `.tnext` (next game)
// in the browser, so it stays current between builds.
import { teamPaint } from '../lib/teams';
// `pos` adds the club's place in a ranked list (the league standings views); `pct` shows points percentage in place of
// points. The name keeps its own line (Sora, 2026-10-16): points sit beside it, the record under them.
interface Props { t: { abbr: string; name: string; w: number; l: number; otl: number; pts: number; gp?: number; pt_pct?: number }; pos?: number; pct?: boolean }
const { t, pos, pct } = Astro.props;
const p = t.pt_pct ?? (t.gp ? t.pts / (2 * t.gp) : null);
const pctWord = p === null ? '–' : p.toFixed(3).replace(/^0/, '');
const base = import.meta.env.BASE_URL;
---
<li class="card row tcard go" data-team={t.abbr} style={`--c:${teamPaint(t.abbr)}`}>
  <a class="tname go-link" href={`${base}team/${t.abbr}/`}>{pos && <span class="tpos">{pos}</span>}<i></i>{t.name}</a>
  <span class="tpts">{pct ? <>{pctWord} <span class="n">pts %</span></> : <>{t.pts} <span class="n">pts</span></>}</span>
  <span class="tnext n"></span>
  <span class="trec n">{t.w}-{t.l}-{t.otl}</span>
</li>

<style>
  .tcard { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; align-items: baseline; }
  .tname { font: 600 17px var(--ui); display: inline-flex; align-items: center; gap: 9px; min-width: 0; white-space: nowrap; }
  .tpos { min-width: 1.4em; font: 600 13px var(--ui); color: var(--ink-3); font-variant-numeric: tabular-nums; text-align: right; }
  .tname i { width: 11px; height: 11px; border-radius: 50%; background: var(--c); flex: none; }
  .tpts { font: 700 15px var(--ui); white-space: nowrap; text-align: right; }
  .tpts .n { font-weight: 500; }
  .trec { font: 500 13px var(--ui); color: var(--ink-2); white-space: nowrap; text-align: right; font-variant-numeric: tabular-nums; }
  .tnext { font: 400 13px var(--ui); color: var(--ink-3); padding-left: 20px; min-width: 0; }
  .tcard:has(.tpos) .tnext { padding-left: calc(20px + 1.4em + 9px); }
</style>
