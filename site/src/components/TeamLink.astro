---
// A team name or abbreviation that opens the team's page. Inherits the surrounding text style.
interface Props { abbr: string; class?: string }
const { abbr, class: cls } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class:list={['tlink', cls]} href={`${base}team/${abbr}/`}><slot /></a>

<style>
</style>
