---
// A line or pair's players, each with his sweater number.
import PLink from './PLink.astro';
import { sweater } from '../lib/playerLinks';
interface Props { players: string[]; ids?: (number | null)[] }
const { players, ids = [] } = Astro.props;
---
<p class="unit-names">{players.map((n, i) => {
  const no = sweater(ids[i]);
  return <span class="unit-p">{no != null && <span class="unit-no" aria-label={`number ${no}`}>{no}</span>}<PLink id={ids[i]} name={n} /></span>;
})}</p>
