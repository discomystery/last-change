---
import teams from '../../public/data/teams.json';
type Section = 'home' | 'games' | 'teams' | 'players' | 'league' | 'record' | 'methods';
interface Props { title: string; description?: string; mock?: boolean | 'mixed'; section?: Section }
const { title, description = 'Hockey matchup previews that explain how two teams play, before they play.', mock = true, section } = Astro.props;
// Main sections. League and Track record have their place in the menu before their pages exist.
const tabs: { id: Section; label: string; href?: string; soon?: string }[] = [
  { id: 'games', label: 'Games', href: 'games/' },
  { id: 'teams', label: 'Teams', href: 'teams/' },
  { id: 'players', label: 'Players', href: 'players/' },
  { id: 'league', label: 'League', soon: 'Coming soon: all 32 teams on every scale, and every goalie on one chart.' },
  { id: 'record', label: 'Track record', soon: 'Coming soon: how often the previews’ calls hold up, all season.' },
];
const cur = (id: Section) => (section === id ? 'page' : undefined);
const base = import.meta.env.BASE_URL;
const teamList = teams as { abbr: string; name: string }[];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..800,100&family=Hanken+Grotesk:wght@400;500;600;700&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&family=Young+Serif&display=swap" rel="stylesheet" />
  </head>
  <body>
    {mock === 'mixed' ? (
      <div class="mockbar" role="note"><strong>Part real, part mock-up.</strong> Sections tagged “placeholder numbers” are invented; everything else is real.</div>
    ) : mock ? (
      <div class="mockbar" role="note">
        <strong>Mock-up.</strong> Names, records, date and venue are real. Every statistic, line combination and insight is a placeholder.
      </div>
    ) : (
      <div class="mockbar real" role="note"><strong>Real data.</strong> Everything on this page is computed from actual games.</div>
    )}
    <header class="site-head">
      <div class="brand">
        <a class="wordmark" href={base}>Last Change</a>
        <span class="wordmark-note">working title</span>
        <nav class="site-nav" aria-label="Site">
          <a id="my-team-link" class="my-team" href={base} data-base={base} hidden></a>
          {tabs.map((t) => t.soon
            ? <span class="soon" tabindex="0" data-tip={t.soon}>{t.label}</span>
            : <a href={`${base}${t.href}`} aria-current={cur(t.id)}>{t.label}</a>)}
          <a class="minor" href={`${base}methods/`} aria-current={cur('methods')}>Methods</a>
        </nav>
      </div>
      <button type="button" class="prefs-toggle" id="prefs-toggle" aria-expanded="false" aria-controls="prefs">Settings</button>
      <div class="prefs" id="prefs" aria-label="Your settings">
        <label class="pref">
          <span>Your team</span>
          <select id="team-pick">
            <option value="">Choose a team</option>
            {teamList.map((t) => <option value={t.abbr}>{t.name}</option>)}
          </select>
        </label>
        <div class="pref">
          <span>Numbers from</span>
          <div class="mode" role="group" aria-label="Which seasons the numbers use">
            <button type="button" data-pref="mode" data-value="blend">This season and last</button>
            <button type="button" data-pref="mode" data-value="season">This season only</button>
          </div>
        </div>
        <div class="pref">
          <span class="term" tabindex="0" data-tip="Hits, giveaways, takeaways and blocks are counted by each arena’s scorer, and some count more generously than others. Arena-adjusted turns them into a score that corrects for that. Raw shows the numbers exactly as recorded.">Hits and takeaways</span>
          <div class="mode" role="group" aria-label="Arena-adjusted scores or raw recorded numbers">
            <button type="button" data-pref="arena" data-value="adjusted">Arena-adjusted</button>
            <button type="button" data-pref="arena" data-value="raw">Raw</button>
          </div>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <nav class="tabbar" aria-label="Site">
      <a href={base} aria-current={cur('home')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 4l9 7v9h-6v-6H9v6H3z" /></svg>Home</a>
      <a href={`${base}games/`} aria-current={cur('games')}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>Games</a>
      <a href={`${base}teams/`} aria-current={cur('teams')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6z" /></svg>Teams</a>
      <a href={`${base}players/`} aria-current={cur('players')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>Players</a>
      <button type="button" id="more-toggle" aria-expanded="false" aria-controls="more" aria-current={['league', 'record', 'methods'].includes(section ?? '') ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="19" cy="12" r="1.8" /></svg>More</button>
    </nav>
    <div class="more" id="more" hidden>
      <a id="more-my-team" href={base} data-base={base} hidden>My team</a>
      <span class="soon">League <em>coming soon</em></span>
      <span class="soon">Track record <em>coming soon</em></span>
      <a href={`${base}methods/`}>Methods</a>
      <a href={`${base}check/`}>Real lines check</a>
      <a href={`${base}xg-check/`}>Chance check</a>
    </div>
    <footer class="site-foot">
      <p>Expected goals data from <a href="https://moneypuck.com">MoneyPuck.com</a>. Game data: NHL.</p>
      <p>A fan project. Not affiliated with the NHL or any of its teams.</p>
      <p class="checks">Behind the numbers: <a href={`${base}methods/`}>Methods</a> · <a href={`${base}check/`}>Real lines check</a> · <a href={`${base}xg-check/`}>Chance check</a></p>
    </footer>
    <div id="tip" role="tooltip" hidden></div>
    <script is:inline>
      // Visitor settings: remembered in this browser only, applied before anything else runs.
      (() => {
        const defaults = { team: '', mode: 'blend', arena: 'adjusted' };
        const read = (k) => { try { return localStorage.getItem('lc-' + k) || defaults[k]; } catch { return defaults[k]; } };
        const root = document.documentElement;
        const apply = (k, v) => {
          root.dataset[k] = v;
          document.querySelectorAll(`[data-pref="${k}"]`).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === v)));
          if (k === 'team') document.getElementById('team-pick').value = v;
          if (k === 'team') {
            ['my-team-link', 'more-my-team'].forEach((id) => { const l = document.getElementById(id); l.hidden = !v; if (v) l.href = l.dataset.base + 'team/' + v + '/'; });
            if (v) document.getElementById('my-team-link').textContent = v;
          }
        };
        const set = (k, v) => {
          try { localStorage.setItem('lc-' + k, v); } catch {}
          apply(k, v);
          document.dispatchEvent(new CustomEvent('prefs', { detail: { key: k, value: v } }));
        };
        window.lcPrefs = { get: (k) => root.dataset[k] ?? defaults[k], set };
        Object.keys(defaults).forEach((k) => apply(k, read(k)));
        document.querySelectorAll('[data-pref]').forEach((b) => b.addEventListener('click', () => set(b.dataset.pref, b.dataset.value)));
        document.getElementById('team-pick').addEventListener('change', (e) => set('team', e.target.value));
        const more = document.getElementById('more'), moreBtn = document.getElementById('more-toggle');
        const setMore = (open) => { more.hidden = !open; moreBtn.setAttribute('aria-expanded', String(open)); };
        moreBtn.addEventListener('click', (e) => { e.stopPropagation(); setMore(more.hidden); });
        document.addEventListener('click', (e) => { if (!more.hidden && !more.contains(e.target)) setMore(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMore(false); });
        const toggle = document.getElementById('prefs-toggle');
        toggle.addEventListener('click', () => {
          const open = document.getElementById('prefs').classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const tip = document.getElementById('tip');
        let current = null;
        const show = (el) => {
          current = el;
          tip.textContent = el.dataset.tip;
          tip.hidden = false;
          const r = el.getBoundingClientRect();
          const t = tip.getBoundingClientRect();
          const left = Math.max(8, Math.min(window.innerWidth - t.width - 8, r.left + r.width / 2 - t.width / 2));
          const above = r.top - t.height - 8;
          tip.style.left = left + 'px';
          tip.style.top = (above > 8 ? above : r.bottom + 8) + 'px';
        };
        const hide = () => { current = null; tip.hidden = true; };
        const target = (e) => (e.target instanceof Element ? e.target.closest('[data-tip]') : null);
        document.addEventListener('pointerover', (e) => { const el = target(e); if (el && e.pointerType !== 'touch') show(el); });
        document.addEventListener('pointerout', (e) => { if (target(e) && e.pointerType !== 'touch') hide(); });
        document.addEventListener('focusin', (e) => { const el = target(e); if (el) show(el); });
        document.addEventListener('focusout', hide);
        document.addEventListener('click', (e) => { const el = target(e); if (!el) return hide(); current === el && !tip.hidden && e.pointerType === 'touch' ? hide() : show(el); });
        window.addEventListener('scroll', hide, { passive: true });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ice: #edf2f6;
    --sheet: #ffffff;
    --ink: #0f1c2b;
    --ink-2: #48586a;
    --ink-3: #6f7e8e;
    --rule: #d2dce5;
    --track: #e4ebf1;
    --heat: var(--ink);            /* matchup boxes: share of ice time, sheet → heat */
    --heat-on-hot: var(--sheet);
    --heat-on-hotter: var(--sheet);
    --CAR: #c8102e;
    --EDM: #1f4e9e;
    --line-red: rgba(200, 16, 46, 0.32);
    --line-blue: rgba(31, 78, 158, 0.32);
    --display: 'Fraunces', Georgia, serif;
    --body: 'Literata', Georgia, serif;
    --ui: 'Hanken Grotesk', system-ui, sans-serif;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ice: #0a121a;
      --sheet: #111c27;
      --ink: #e6edf3;
      --ink-2: #a9b6c3;
      --ink-3: #7c8a98;
      --rule: #25333f;
      --track: #26384a;
      --heat: #8fb3e8;
      --heat-on-hot: var(--ink);
      --heat-on-hotter: #0a121a;
      --CAR: #ee5a70;
      --EDM: #5a90ea;
      --line-red: rgba(238, 90, 112, 0.38);
      --line-blue: rgba(90, 144, 234, 0.38);
    }
  }
  .t-CAR { --team: var(--CAR); }
  .t-EDM { --team: var(--EDM); }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--ice); color: var(--ink); font: 400 17px/1.6 var(--body); font-variant-numeric: lining-nums tabular-nums; }
  h1, h2, h3, h4, .wordmark { font-variation-settings: 'SOFT' 100; }
  .mockbar, .site-foot, .ph, .chip, .key, .note, .bar, .wordmark-note, .n, .cite, table, dl { font-family: var(--ui); }
  a { color: inherit; }
  h1, h2, h3, h4, p, figure, ul, ol, dl, dd { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  :focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 3px; }

  .mockbar {
    position: sticky; top: 0; z-index: 20; padding: 8px 16px; font-size: 13px; line-height: 1.35; text-align: center;
    color: var(--ink); border-bottom: 1px solid var(--rule);
    background: repeating-linear-gradient(-45deg, var(--sheet) 0 10px, var(--track) 10px 20px);
  }
  .mockbar.real { background: var(--sheet); }
  .site-head, main, .site-foot { max-width: 1080px; margin-inline: auto; padding-inline: 16px; }
  .site-head { padding-block: 18px 6px; display: grid; gap: 14px; }
  .brand { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; }
  .site-nav { margin-left: auto; display: flex; flex-wrap: wrap; gap: 4px 18px; font: 600 14px var(--ui); }
  .site-nav a { white-space: nowrap; }
  .site-nav a { text-decoration: none; }
  .site-nav { align-items: center; }
  .site-nav a, .site-nav .soon { padding: 6px 0; border-bottom: 2px solid transparent; }
  .site-nav a:hover { border-bottom-color: var(--rule); }
  .site-nav a[aria-current='page'] { border-bottom-color: var(--ink); }
  .site-nav .soon { color: var(--ink-3); font-weight: 500; cursor: default; }
  .site-nav .minor { font-weight: 500; color: var(--ink-2); padding-left: 14px; border-left: 1px solid var(--rule); border-bottom: 0; }
  .site-nav .my-team { border: 1px solid var(--ink); border-radius: 999px; padding: 3px 11px; }
  .tabbar, .more { display: none; }
  .checks a { color: inherit; }
  @media (max-width: 719px) {
    .site-nav { display: none; }
    body { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
    .tabbar { display: grid; grid-template-columns: repeat(5, 1fr); position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: var(--sheet); border-top: 1px solid var(--rule); padding: 6px 4px calc(6px + env(safe-area-inset-bottom)); }
    .tabbar a, .tabbar button { display: grid; justify-items: center; gap: 3px; font: 600 11px var(--ui); color: var(--ink-3); text-decoration: none; background: none; border: 0; padding: 4px 0; cursor: pointer; }
    .tabbar svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
    .tabbar [aria-current='page'], .tabbar button[aria-expanded='true'] { color: var(--ink); }
    .tabbar [aria-current='page'] svg { stroke-width: 2.4; }
    .more:not([hidden]) { display: grid; position: fixed; right: 10px; bottom: calc(72px + env(safe-area-inset-bottom)); z-index: 41; min-width: 220px; background: var(--sheet); border: 1px solid var(--rule); border-radius: 16px; padding: 8px; box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18); font: 600 15px var(--ui); }
    .more a, .more .soon { padding: 11px 12px; border-radius: 10px; text-decoration: none; }
    .more a:hover { background: var(--track); }
    .more .soon { color: var(--ink-3); font-weight: 500; }
    .more em { font-style: normal; font-size: 12px; margin-left: 6px; }
  }
  .prefs { display: flex; flex-wrap: wrap; gap: 10px 24px; align-items: center; padding: 10px 14px; background: var(--sheet); border: 1px solid var(--rule); border-radius: 14px; font: 400 13px var(--ui); color: var(--ink-2); }
  .prefs-toggle { display: none; justify-self: start; font: 600 13px var(--ui); color: var(--ink); background: var(--sheet); border: 1px solid var(--ink); border-radius: 999px; padding: 7px 14px; cursor: pointer; }
  .prefs-toggle::after { content: ' ▾'; }
  .prefs-toggle[aria-expanded='true']::after { content: ' ▴'; }
  @media (max-width: 719px) {
    .prefs-toggle { display: inline-block; }
    .prefs:not(.open) { display: none; }
  }
  .pref { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .pref > span { font-weight: 600; }
  .prefs select { font: 600 13px var(--ui); color: var(--ink); background: var(--sheet); border: 1px solid var(--ink); border-radius: 999px; padding: 6px 10px; max-width: 100%; }
  .mode { display: inline-flex; border: 1px solid var(--ink); border-radius: 999px; padding: 2px; background: var(--sheet); }
  .mode button { font: 600 13px var(--ui); color: var(--ink); background: none; border: 0; border-radius: 999px; padding: 5px 11px; cursor: pointer; }
  .mode button[aria-pressed='true'] { background: var(--ink); color: var(--sheet); }
  .nrink { position: relative; display: grid; grid-template-columns: 1fr 1fr; background: var(--sheet); border: 2px solid var(--ink); border-radius: 56px; overflow: hidden; min-height: 200px; }
  .nrink .rl { position: absolute; top: 0; bottom: 0; width: 5px; }
  .nrink .rl.red { left: 50%; margin-left: -2.5px; background: var(--line-red); }
  .nrink .rl.blue { background: var(--line-blue); } .nrink .rl.blue.l { left: 37.5%; } .nrink .rl.blue.r { right: 37.5%; }
  .nrink .circle { position: absolute; left: 50%; top: 50%; width: 72px; height: 72px; margin: -36px 0 0 -36px; border-radius: 50%; border: 2px solid var(--line-blue); background: var(--sheet); display: grid; place-items: center; font: italic 500 22px/1 var(--body); color: var(--ink-2); }
  .nrink .side { position: relative; padding: 26px clamp(20px, 7vw, 76px); display: flex; flex-direction: column; justify-content: center; min-width: 0; }
  .nrink .side.home { align-items: flex-end; text-align: right; }
  .nrink .abbr { font: 700 clamp(42px, 12.5vw, 108px) / 0.9 var(--ui); letter-spacing: -0.035em; color: var(--ink-3); }
  .nrink .abbr.me { color: var(--ink); }
  .nrink .full { font-weight: 600; font-size: clamp(13px, 2.6vw, 17px); margin-top: 10px; line-height: 1.3; }
  .nrink .lc { font: 600 13px var(--ui); margin-top: 4px; color: var(--ink-2); }
  .next-meta { font: 400 14px var(--ui); color: var(--ink-2); margin-top: 12px; }
  .a-raw { display: none; }
  html[data-arena='raw'] .a-raw { display: inline; }
  html[data-arena='raw'] .a-adj { display: none; }
  .wordmark { font: 700 26px/1 var(--display); letter-spacing: -0.01em; text-decoration: none; }
  .wordmark-note { font-size: 12px; color: var(--ink-3); }
  .site-foot { padding-block: 28px 48px; font-size: 13px; color: var(--ink-2); display: grid; gap: 4px; }

  /* Sections */
  .sec { margin-top: 72px; scroll-margin-top: 96px; }
  .sec-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; border-bottom: 5px solid var(--line-blue); padding-bottom: 10px; }
  .sec-head h2 { font: 700 34px/1.05 var(--display); letter-spacing: -0.01em; }
  .ph { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-2); border: 1px dashed var(--ink-3); border-radius: 3px; padding: 2px 6px; }
  .takeaway { margin-top: 14px; color: var(--ink-2); font-size: 18px; }
  .sub { font: 600 23px/1.15 var(--display); margin: 40px 0 12px; }
  .card { background: var(--sheet); border: 1px solid var(--rule); border-radius: 18px; padding: 18px; }
  .two { display: grid; gap: 28px 24px; margin-top: 22px; }
  @media (min-width: 820px) { .two { grid-template-columns: 1fr 1fr; } }
  .team-h { display: flex; align-items: center; gap: 8px; font: 700 22px/1 var(--display); margin-bottom: 14px; }
  .team-h::before, .key i { content: ''; width: 12px; height: 12px; border-radius: 50%; background: var(--team); display: inline-block; }
  .note { font-size: 14px; line-height: 1.5; color: var(--ink-2); margin-top: 12px; }
  .term { text-decoration: underline dotted var(--ink-3); text-underline-offset: 3px; cursor: help; }
  .key { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--ink-2); margin-top: 14px; align-items: center; }
  .key span { display: inline-flex; align-items: center; gap: 6px; }
  .key .avg::before { content: ''; width: 2px; height: 14px; background: var(--ink); display: inline-block; }
  .key .rng::before { content: ''; width: 18px; height: 2px; background: var(--ink); display: inline-block; }
  .chip { display: inline-block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 2px 7px; border-radius: 999px; border: 1px solid var(--rule); color: var(--ink-2); white-space: nowrap; }
  .chip.solid { background: var(--ink); color: var(--sheet); border-color: var(--ink); }

  /* The obvious fold: a full-width bar that opens and closes a longer set. */
  .fold { margin-top: 18px; }
  .fold > summary { list-style: none; display: flex; justify-content: center; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 14px; background: var(--track); font: 500 15px var(--ui); color: var(--ink); }
  .fold > summary::-webkit-details-marker { display: none; }
  .fold > summary::after { content: '+'; }
  .fold[open] > summary::after { content: '–'; }
  .fold > summary:hover { background: var(--rule); }
  .fold .opened, .fold[open] .closed { display: none; }
  .fold[open] .opened { display: inline; }
  .fold[open] > summary { margin-bottom: 18px; }
  /* Quality meter and neutral marker */
  .pips { display: inline-flex; gap: 3px; vertical-align: middle; cursor: help; }
  .pips i { width: 10px; height: 10px; border-radius: 50%; background: var(--rule); }
  .pips i.on { background: var(--ink); }
  /* Same height, colour and puck as the meter above, so the two sit level: a faint track with one puck inside. */
  .marker { position: relative; display: inline-block; width: 62px; height: 10px; border-radius: 999px; background: var(--rule); vertical-align: middle; cursor: help; }
  .marker i { position: absolute; top: 0; left: calc((100% - 10px) * var(--p, 50) / 100); width: 10px; height: 10px; border-radius: 50%; background: var(--ink); }
  .plink { text-decoration: underline; text-decoration-thickness: 1px; text-decoration-color: var(--ink-3); text-underline-offset: 5px; cursor: pointer; }
  .plink:hover { text-decoration-color: var(--ink); }
  details > summary { cursor: pointer; font: 600 14px var(--ui); color: var(--ink-2); padding: 6px 0; }
  details[open] > summary { margin-bottom: 8px; }

  #tip { font-family: var(--ui); position: fixed; z-index: 50; max-width: min(300px, calc(100vw - 16px)); background: var(--ink); color: var(--sheet); font-size: 13px; line-height: 1.4; padding: 8px 10px; border-radius: 6px; pointer-events: none; }

  /* Percentile bars */
  .bar { display: grid; grid-template-columns: 34px 1fr 26px; align-items: center; gap: 8px; font-size: 12px; }
  .bar-team { font-weight: 600; color: var(--ink-2); letter-spacing: 0.03em; }
