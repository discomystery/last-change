---
import teams from '../../public/data/teams.json';
import '../styles/motion.css';
type Section = 'home' | 'games' | 'teams' | 'players' | 'league' | 'record' | 'methods';
interface Props { title: string; description?: string; section?: Section }
const { title, description = 'Hockey matchup previews that explain how two teams play, before they play.', section } = Astro.props;
// Main sections. An entry with `soon` instead of `href` keeps its place in the menu before its page exists.
const tabs: { id: Section; label: string; href?: string; soon?: string }[] = [
  { id: 'games', label: 'Games', href: 'games/' },
  { id: 'teams', label: 'Teams', href: 'teams/' },
  { id: 'players', label: 'Players', href: 'players/' },
  { id: 'league', label: 'League', href: 'league/' },
  { id: 'record', label: 'Track record', href: 'record/' },
];
const SITE_NAME = 'Spare Line Change';
const cur = (id: Section) => (section === id ? 'page' : undefined);
const base = import.meta.env.BASE_URL;
const teamList = teams as { abbr: string; name: string }[];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_NAME ? title : `${title} · ${SITE_NAME}`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <script is:inline>
      // Motion (styles/motion.css) only for visitors who have not asked for less of it, and never in automated browsers,
      // so screenshots and checks see every card. If the reveal script below never starts, the class comes off again.
      if (!navigator.webdriver && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(() => { if (!window.lcMotion) document.documentElement.classList.remove('motion'); }, 3000);
      }
    </script>
    <script is:inline>
      // The two ticket stubs (styles above) for home and team pages: next game and latest post-game, each a link.
      // g: a schedule game with t (Date); final games carry as/hs and end. colour(abbr, g) gives a team's matchup colour.
      window.lcTicket = (g, { eyebrow, href, sub, colour }) => {
        const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
        const card = el(href ? 'a' : 'div', 'card tk');
        if (href) card.href = href;
        const stub = el('div', 'tk-stub');
        stub.append(el('span', null, g.t.toLocaleDateString(undefined, { weekday: 'short' })), el('span', 'tk-d', String(g.t.getDate())), el('span', null, g.t.toLocaleDateString(undefined, { month: 'short' })));
        const ab = (a) => { const s = el('span', 'tk-ab', a); const c = colour(a, g); if (c) s.style.setProperty('--team', c); return s; };
        const row = el('p', 'tk-m');
        if (g.final) {
          row.append(ab(g.away), el('span', 'tk-sc', String(g.as)), el('span', 'tk-dash', '–'), el('span', 'tk-sc', String(g.hs)), ab(g.home));
          if (g.end && g.end !== 'REG') row.append(el('span', 'tk-end', g.end));
          row.setAttribute('aria-label', `${g.away} ${g.as}, ${g.home} ${g.hs}${g.end && g.end !== 'REG' ? ` (${g.end})` : ''}`);
        } else row.append(ab(g.away), el('span', 'tk-at', 'at'), ab(g.home));
        const main = el('div', 'tk-main');
        main.append(el('span', 'eyebrow', eyebrow), row);
        if (sub) { const p = el('p', 'tk-sub'); p.append(...sub); main.append(p); }
        card.append(stub, main);
        return card;
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..800,100&family=Hanken+Grotesk:wght@400;500;600;700&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&display=swap" rel="stylesheet" />
    <noscript><style>.xp[hidden] { display: block; } .xp-q { display: none; }</style></noscript>
  </head>
  <body>
    <header class="site-head">
      <div class="brand">
        <span class="brand-name">
          <a class="wordmark" href={base}>Spare Line Change</a>
          <span class="beta" tabindex="0" data-tip="Spare Line Change is in beta: pages and numbers are still being built and checked, so some may change.">Beta</span>
        </span>
        <nav class="site-nav" aria-label="Site">
          <a id="my-team-link" class="my-team" href={base} data-base={base} hidden></a>
          {tabs.map((t) => t.soon
            ? <span class="soon" tabindex="0" data-tip={t.soon}>{t.label}</span>
            : <a href={`${base}${t.href}`} aria-current={cur(t.id)}>{t.label}</a>)}
          <a class="minor" href={`${base}methods/`} aria-current={cur('methods')}>Methods</a>
        </nav>
      </div>
      <button type="button" class="prefs-toggle" id="prefs-toggle" aria-expanded="false" aria-controls="prefs">Settings</button>
      <div class="prefs" id="prefs" aria-label="Your settings">
        <label class="pref">
          <span>Your team</span>
          <select id="team-pick">
            <option value="">Choose a team</option>
            {teamList.map((t) => <option value={t.abbr}>{t.name}</option>)}
          </select>
        </label>
        <div class="pref">
          <span>Numbers from</span>
          <div class="mode" role="group" aria-label="Which seasons the numbers use">
            <button type="button" data-pref="mode" data-value="blend">This season and last</button>
            <button type="button" data-pref="mode" data-value="season">This season only</button>
          </div>
        </div>
        <div class="pref">
          <span class="term" tabindex="0" data-tip="Two kinds of numbers are adjusted before they’re shown. Hits, giveaways, takeaways and blocks are counted by each arena’s scorer, and some count more generously than others. Shot rates are weighted for the score and home ice, because teams that are behind shoot more. Adjusted shows both as scores, where 100 is league average. Raw shows the numbers exactly as recorded.">Adjusted stats</span>
          <div class="mode" role="group" aria-label="Adjusted scores or raw recorded numbers">
            <button type="button" data-pref="arena" data-value="adjusted">Adjusted</button>
            <button type="button" data-pref="arena" data-value="raw">Raw</button>
          </div>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <nav class="tabbar" aria-label="Site">
      <a href={base} aria-current={cur('home')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 4l9 7v9h-6v-6H9v6H3z" /></svg>Home</a>
      <a href={`${base}games/`} aria-current={cur('games')}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg>Games</a>
      <a href={`${base}teams/`} aria-current={cur('teams')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6z" /></svg>Teams</a>
      <a href={`${base}players/`} aria-current={cur('players')}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>Players</a>
      <button type="button" id="more-toggle" aria-expanded="false" aria-controls="more" aria-current={['league', 'record', 'methods'].includes(section ?? '') ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="19" cy="12" r="1.8" /></svg>More</button>
    </nav>
    <div class="more" id="more" hidden>
      <a id="more-my-team" href={base} data-base={base} hidden>My team</a>
      <a href={`${base}league/`} aria-current={cur('league')}>League</a>
      <a href={`${base}record/`} aria-current={cur('record')}>Track record</a>
      <a href={`${base}methods/`}>Methods</a>
    </div>
    <footer class="site-foot">
      <p>Game data: NHL. Expected goals are calculated with Spare Line Change’s <a href={`${base}methods/`}>own model</a>.</p>
      <p>A fan project, in beta: pages and numbers may still change. Not affiliated with the NHL or any of its teams.</p>
    </footer>
    <div id="tip" role="tooltip" hidden></div>
    <script is:inline>
      // Visitor settings: remembered in this browser only, applied before anything else runs.
      (() => {
        const defaults = { team: '', mode: 'blend', arena: 'adjusted' };
        const read = (k) => { try { return localStorage.getItem('lc-' + k) || defaults[k]; } catch { return defaults[k]; } };
        const root = document.documentElement;
        const apply = (k, v) => {
          root.dataset[k] = v;
          document.querySelectorAll(`[data-pref="${k}"]`).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === v)));
          if (k === 'team') document.getElementById('team-pick').value = v;
          if (k === 'team') {
            ['my-team-link', 'more-my-team'].forEach((id) => { const l = document.getElementById(id); l.hidden = !v; if (v) l.href = l.dataset.base + 'team/' + v + '/'; });
            if (v) document.getElementById('my-team-link').textContent = v;
          }
        };
        const set = (k, v) => {
          try { localStorage.setItem('lc-' + k, v); } catch {}
          apply(k, v);
          document.dispatchEvent(new CustomEvent('prefs', { detail: { key: k, value: v } }));
        };
        window.lcPrefs = { get: (k) => root.dataset[k] ?? defaults[k], set };
        Object.keys(defaults).forEach((k) => apply(k, read(k)));
        document.querySelectorAll('[data-pref]').forEach((b) => b.addEventListener('click', () => set(b.dataset.pref, b.dataset.value)));
        document.getElementById('team-pick').addEventListener('change', (e) => set('team', e.target.value));
        const more = document.getElementById('more'), moreBtn = document.getElementById('more-toggle');
        const setMore = (open) => { more.hidden = !open; moreBtn.setAttribute('aria-expanded', String(open)); };
        moreBtn.addEventListener('click', (e) => { e.stopPropagation(); setMore(more.hidden); });
        document.addEventListener('click', (e) => { if (!more.hidden && !more.contains(e.target)) setMore(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMore(false); });
        const toggle = document.getElementById('prefs-toggle');
        toggle.addEventListener('click', () => {
          const open = document.getElementById('prefs').classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(open));
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const tip = document.getElementById('tip');
        let current = null;
        const show = (el) => {
          current = el;
          tip.textContent = el.dataset.tip;
          tip.hidden = false;
          const r = el.getBoundingClientRect();
          const t = tip.getBoundingClientRect();
          const left = Math.max(8, Math.min(window.innerWidth - t.width - 8, r.left + r.width / 2 - t.width / 2));
          const above = r.top - t.height - 8;
          tip.style.left = left + 'px';
          tip.style.top = (above > 8 ? above : r.bottom + 8) + 'px';
        };
        const hide = () => { current = null; tip.hidden = true; };
        const target = (e) => (e.target instanceof Element ? e.target.closest('[data-tip]') : null);
        document.addEventListener('pointerover', (e) => { const el = target(e); if (el && e.pointerType !== 'touch') show(el); });
        document.addEventListener('pointerout', (e) => { if (target(e) && e.pointerType !== 'touch') hide(); });
        document.addEventListener('focusin', (e) => { const el = target(e); if (el) show(el); });
        document.addEventListener('focusout', hide);
        document.addEventListener('click', (e) => { const el = target(e); if (!el) return hide(); current === el && !tip.hidden && e.pointerType === 'touch' ? hide() : show(el); });
        window.addEventListener('scroll', hide, { passive: true });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });
      })();
    </script>
    <script is:inline>
      // Explainers: a "?" beside a heading (Section.astro, Explain.astro) opens and closes the explanation under it.
      document.addEventListener('click', (e) => {
        const q = e.target instanceof Element ? e.target.closest('.xp-q') : null;
        const panel = q && document.getElementById(q.getAttribute('aria-controls'));
        if (!panel) return;
        const open = q.getAttribute('aria-expanded') !== 'true';
        q.setAttribute('aria-expanded', String(open));
        panel.hidden = !open;
      });
    </script>
    <script is:inline>
      // Matchup strips: pointing at (or tapping) an opposing line's box lights that line up in every strip of the card.
      (() => {
        const light = (e) => {
          const box = e.target.closest?.('.strip > span');
          const card = e.target.closest?.('.stripcard');
          if (!card) return;
          if (box) card.dataset.hl = String([...box.parentElement.children].indexOf(box));
          else delete card.dataset.hl;
        };
        document.addEventListener('pointerover', light);
        document.addEventListener('focusin', light);
        document.addEventListener('pointerout', (e) => { const card = e.target.closest?.('.stripcard'); if (card && !card.contains(e.relatedTarget)) delete card.dataset.hl; });
      })();
    </script>
    <script is:inline>
      // Reveal cards, headings and charts as they scroll into view (see styles/motion.css). Cards a page script adds
      // later, like a day's games, are picked up too. Ones that arrive together come in one after another.
      (() => {
        window.lcMotion = true;
        const root = document.documentElement;
        if (!root.classList.contains('motion') || !('IntersectionObserver' in window)) return root.classList.remove('motion');
        const main = document.querySelector('main');
        const SEL = '.card, .sec-head, .takeaway, .fold';
        const io = new IntersectionObserver((entries) => {
          let n = 0;
          entries.filter((e) => e.isIntersecting).forEach((e) => {
            e.target.style.setProperty('--rv-delay', Math.min(n++, 6) * 70 + 'ms');
            e.target.classList.add('seen');
            io.unobserve(e.target);
          });
        });
        const watch = (el) => {
          // A copied card (the teams page clones some) may carry `rv` without having been seen: watch it again.
          if (el.classList.contains('rv')) return el.classList.contains('seen') || io.observe(el);
          if (el.parentElement?.closest('.rv')) return;
          el.classList.add('rv');
          io.observe(el);
        };
        const scan = (node) => { if (node.matches?.(SEL)) watch(node); node.querySelectorAll?.(SEL).forEach(watch); };
        scan(main);
        new MutationObserver((ms) => ms.forEach((m) => m.addedNodes.forEach((node) => node.nodeType === 1 && scan(node)))).observe(main, { childList: true, subtree: true });
      })();
    </script>
    <script is:inline>
      // Rink headers (Rink.astro on preview and post-game pages): the boards and goal creases are drawn in an SVG fitted to each rink, so the creases stay round
      // whatever the rink's shape. With the site's motion on, the puck drops once when a rink is half on screen: the
      // boards trace round, the lines and centre circle draw themselves, the teams skate in and a final score counts up.
      (() => {
        const root = document.documentElement, NS = 'http://www.w3.org/2000/svg';
        const add = (parent, tag, attrs) => { const el = document.createElementNS(NS, tag); for (const k in attrs) el.setAttribute(k, String(attrs[k])); parent.append(el); return el; };
        const fit = (rink) => {
          let svg = rink.querySelector(':scope > .rk-boards');
          if (!svg) { svg = document.createElementNS(NS, 'svg'); svg.setAttribute('class', 'rk-boards'); svg.setAttribute('aria-hidden', 'true'); add(svg, 'rect', { pathLength: 100 }); rink.prepend(svg); }
          const r = svg.querySelector('rect'), w = rink.clientWidth, h = rink.clientHeight;
          if (!w || (rink.dataset.fw === String(w) && rink.dataset.fh === String(h))) return;
          rink.dataset.fw = String(w); rink.dataset.fh = String(h);
          const rad = parseFloat(getComputedStyle(rink).borderTopLeftRadius) - 3;
          Object.entries({ x: 1, y: 1, width: w - 2, height: h - 2, rx: Math.max(0, Math.min(rad, h / 2 - 1)) }).forEach(([k, v]) => r.setAttribute(k, String(v)));
          svg.querySelector('.rk-marks')?.remove();
          // A goal crease, a half circle 6 ft deep in front of each goal line (the rink is 85 ft wide).
          const g = add(svg, 'g', { class: 'rk-marks' }), ft = h / 85;
          for (const side of [0, 1]) {
            const gx = side ? w * 0.945 : w * 0.055;
            add(g, 'path', { class: 'rk-crease', d: `M${gx} ${h / 2 - 6 * ft} a${6 * ft} ${6 * ft} 0 0 ${side ? 0 : 1} 0 ${12 * ft}Z` });
          }
          rink.classList.add('boards');
        };
        const motion = root.classList.contains('motion') && 'IntersectionObserver' in window;
        const io = motion && new IntersectionObserver((entries) => entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          e.target.querySelectorAll('.score[data-to]').forEach((s) => {
            const to = +s.dataset.to;
            s.textContent = '0';
            for (let i = 1; i <= to; i++) setTimeout(() => { s.textContent = String(i); }, 700 + i * Math.min(140, 700 / to));
          });
          e.target.classList.add('run');
        }), { threshold: 0.5 });
        const ro = 'ResizeObserver' in window && new ResizeObserver((es) => es.forEach((e) => fit(e.target)));
        const taken = new WeakSet();
        const take = (rink) => { if (taken.has(rink)) return; taken.add(rink); fit(rink); ro && ro.observe(rink); io && io.observe(rink); };
        const scan = (n) => { if (n.matches?.('[data-drop]')) take(n); n.querySelectorAll?.('[data-drop]').forEach(take); };
        scan(document);
        new MutationObserver((ms) => ms.forEach((m) => m.addedNodes.forEach((n) => n.nodeType === 1 && scan(n)))).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    <script is:inline>
      // Season switch: on screen, the scales' dots glide to their new spots a card at a time, each leaving an open ring
      // where it was and a bar over the distance it moved (the chart guide's gap), which stay a few seconds and fade
      // (styles/motion.css). The whisker steps aside while the gap shows. Off screen they simply change.
      document.addEventListener('prefs', (e) => {
        const root = document.documentElement;
        if (e.detail.key !== 'mode' || !root.classList.contains('motion')) return;
        const vh = window.innerHeight;
        const lanes = [...document.querySelectorAll('.lane')].filter((l) => {
          if (!l.querySelector('.dot') || !l.offsetParent) return false;
          const r = l.getBoundingClientRect();
          return r.bottom > -40 && r.top < vh + 40;
        }).slice(0, 240);
        const groups = [...new Set(lanes.map((l) => l.closest('.card') || l.parentElement))];
        lanes.forEach((l) => l.style.setProperty('--sd', Math.min(groups.indexOf(l.closest('.card') || l.parentElement), 12) * 45 + 'ms'));
        lanes.forEach((l) => {
          const dot = l.querySelector('.dot');
          if (!l.clientWidth) return;
          const was = (100 * parseFloat(getComputedStyle(dot).left)) / l.clientWidth;
          const now = parseFloat(getComputedStyle(l).getPropertyValue('--v'));
          l.querySelectorAll('.sw-gap, .dot-ghost').forEach((x) => x.remove());
          if (!isFinite(was) || !isFinite(now) || Math.abs(now - was) < 1.5) return;
          const g = document.createElement('i');
          g.className = 'dot-ghost';
          g.style.left = was + '%';
          const bar = document.createElement('i');
          bar.className = 'sw-gap';
          bar.style.left = Math.min(was, now) + '%';
          bar.style.width = Math.abs(now - was) + '%';
          bar.style.transformOrigin = now > was ? 'left' : 'right';
          // Previews compare two teams on one card; there the ring alone marks where each was (no bar between them).
          if (l.closest('.fpp')) l.append(g); else { l.append(bar, g); l.classList.add('gapping'); }
          clearTimeout(l.lcGapT);
          l.lcGapT = setTimeout(() => { bar.remove(); g.remove(); l.classList.remove('gapping'); }, 4200);
        });
        root.classList.add('mode-switch');
        clearTimeout(window.lcModeT);
        window.lcModeT = setTimeout(() => root.classList.remove('mode-switch'), 700);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ice: #edf2f6;
    --sheet: #ffffff;
    --ink: #0f1c2b;
    --ink-2: #48586a;
    --ink-3: #6f7e8e;
    --rule: #d2dce5;
    --track: #e4ebf1;
    --heat: var(--ink);            /* matchup boxes: share of ice time, sheet → heat */
    --heat-on-hot: var(--sheet);
    --heat-on-hotter: var(--sheet);
    --CAR: #c8102e;
    --EDM: #1f4e9e;
    --line-red: rgba(200, 16, 46, 0.32);
    --line-blue: rgba(31, 78, 158, 0.32);
    --display: 'Fraunces', Georgia, serif;
    --body: 'Literata', Georgia, serif;
    --ui: 'Hanken Grotesk', system-ui, sans-serif;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ice: #0a121a;
      --sheet: #111c27;
      --ink: #e6edf3;
      --ink-2: #a9b6c3;
      --ink-3: #7c8a98;
      --rule: #25333f;
      --track: #26384a;
      --heat: #8fb3e8;
      --heat-on-hot: var(--ink);
      --heat-on-hotter: #0a121a;
      --CAR: #ee5a70;
      --EDM: #5a90ea;
      --line-red: rgba(238, 90, 112, 0.38);
      --line-blue: rgba(90, 144, 234, 0.38);
    }
  }
  .t-CAR { --team: var(--CAR); }
  .t-EDM { --team: var(--EDM); }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--ice); color: var(--ink); font: 400 17px/1.6 var(--body); font-variant-numeric: lining-nums tabular-nums; }
  h1, h2, h3, h4, .wordmark { font-variation-settings: 'SOFT' 100; }
  .site-foot, .ph, .chip, .key, .note, .bar, .wordmark-note, .n, .cite, table, dl { font-family: var(--ui); }
  a { color: inherit; text-decoration: none; }
  /* Links never look like underlined web links. A link inside text is set a little bolder; under the
     pointer every text link (team names, crumbs) gets a soft rounded highlight instead of an underline. */
  :is(main, .site-foot) a:not([class]) { font-weight: 600; }
  .crumbs a { font-weight: inherit; }
  :is(main, .site-foot) a:not([class]), .tlink, .crumbs a, .eyebrow a, .hl {
    border-radius: 5px; -webkit-box-decoration-break: clone; box-decoration-break: clone;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }
  :is(:is(main, .site-foot) a:not([class]), .tlink, .crumbs a, .eyebrow a, .hl):hover { background: var(--track); box-shadow: 0 0 0 3px var(--track); color: var(--ink); }
  /* A card that is one link as a whole (a game, a team, a player): its main link stretches over the card,
     and the card lifts under the pointer (motion.css). Any other link inside sits above the stretch. */
  .card.go { position: relative; cursor: pointer; transition: border-color 0.15s ease; }
  .card.go .go-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; z-index: 0; }
  .card.go :is(a:not(.go-link), button) { position: relative; z-index: 1; }
  .card.go:hover { border-color: var(--ink-3); }
