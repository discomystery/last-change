---
// Temporary comparison page: lighter ways to draw the show/hide fold. Not linked from the site.
import Base from '../layouts/Base.astro';
const opts = [
  { id: 'a', name: 'A. Soft bar', why: 'Still full width and easy to hit, but a pale fill with no outline and regular-weight text. It sits behind the cards instead of in front of them.' },
  { id: 'b', name: 'B. Line with a button on it', why: 'A thin rule across the page with a small button sitting in the middle of it. Reads as “there’s more below this line”.' },
  { id: 'c', name: 'C. One more card', why: 'Drawn exactly like the cards above it, so it carries the same weight as they do: label on the left, plus sign on the right.' },
  { id: 'd', name: 'D. Plain link', why: 'Just words and an arrow, with the same hairline underline as player names. The lightest of the four.' },
  { id: 'now', name: 'What’s live now', why: 'For comparison.' },
];
---
<Base title="Fold options">
  <h1 class="page-h">Lighter ways to draw “show all”</h1>
  <p class="lede">Each one opens and closes. Two cards sit above each so you can judge its weight against the rest of the page.</p>
  {opts.map((o) => (
    <section class={`opt v-${o.id}`}>
      <h2>{o.name}</h2>
      <p class="why">{o.why}</p>
      <ul class="grid">
        <li class="card"><p class="t">Power kill</p><p class="s">Carolina: 1.3 expected goals created per hour shorthanded</p></li>
        <li class="card"><p class="t">Forecheck pressure</p><p class="s">Carolina: forecheck score 123 (100 is league average)</p></li>
      </ul>
      <details class="f">
        <summary><span class="closed">Show all 18 traits</span><span class="opened">Hide the full set</span><span class="ic" aria-hidden="true"></span></summary>
        <ul class="grid">
          <li class="card"><p class="t">Shot volume</p><p class="s">The other twelve traits would appear here.</p></li>
          <li class="card"><p class="t">Pace</p><p class="s">And so on.</p></li>
        </ul>
      </details>
    </section>
  ))}
</Base>

<style>
  .page-h { font: 700 clamp(30px, 6vw, 44px) / 1.1 var(--display); margin-top: 24px; }
  .lede { color: var(--ink-2); margin-top: 8px; }
  .opt { margin-top: 44px; padding-top: 18px; border-top: 5px solid var(--line-blue); }
  .opt h2 { font: 700 24px/1.1 var(--display); }
  .why { font: 400 15px/1.45 var(--ui); color: var(--ink-2); margin: 6px 0 16px; }
  .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); }
  .t { font: 600 20px/1.15 var(--display); }
  .s { font: 400 14px var(--ui); margin-top: 8px; }
  .f { margin-top: 14px; }
  .f > summary { list-style: none; cursor: pointer; color: var(--ink); padding: 0; }
  .f > summary::-webkit-details-marker { display: none; }
  .f .opened, .f[open] .closed { display: none; }
  .f[open] .opened { display: inline; }
  .f[open] > summary { margin-bottom: 14px; }
  .ic::before { content: '+'; }
  .f[open] .ic::before { content: '–'; }

  .v-a .f > summary { display: flex; justify-content: center; gap: 10px; padding: 12px 16px; border-radius: 14px; background: var(--track); font: 500 15px var(--ui); }
  .v-a .f > summary:hover { background: var(--rule); }

  .v-b .f > summary { display: flex; align-items: center; gap: 14px; font: 600 13px var(--ui); }
  .v-b .f > summary::before, .v-b .f > summary::after { content: ''; flex: 1; height: 1px; background: var(--ink-3); opacity: 0.6; }
  .v-b .f > summary > span:not(.ic) { order: 0; }
  .v-b .f .closed, .v-b .f[open] .opened { border: 1px solid var(--ink-3); border-radius: 999px; padding: 6px 14px; background: var(--sheet); }
  .v-b .f .ic { display: none; }
  .v-b .f > summary:hover .closed, .v-b .f > summary:hover .opened { border-color: var(--ink); }

  .v-c .f > summary { display: flex; justify-content: space-between; align-items: center; padding: 16px 18px; background: var(--sheet); border: 1px solid var(--rule); border-radius: 18px; font: 600 20px/1.15 var(--display); }
  .v-c .f .ic { font: 400 24px/0.8 var(--ui); color: var(--ink-2); }
  .v-c .f > summary:hover { border-color: var(--ink); }

  .v-d .f > summary { display: inline-flex; gap: 8px; font: 600 16px var(--ui); }
  .v-d .f .closed, .v-d .f .opened { text-decoration: underline; text-decoration-thickness: 1px; text-decoration-color: var(--ink-3); text-underline-offset: 5px; }
  .v-d .ic::before { content: '↓'; }
  .v-d .f[open] .ic::before { content: '↑'; }
  .v-d .f > summary:hover .closed, .v-d .f > summary:hover .opened { text-decoration-color: var(--ink); }

  .v-now .f > summary { display: flex; justify-content: center; align-items: center; gap: 10px; padding: 14px 18px; border: 2px solid var(--ink); border-radius: 999px; background: var(--sheet); font: 700 15px var(--ui); }
  .v-now .f .ic { font: 700 22px/0.8 var(--ui); }
  .v-now .f > summary:hover { background: var(--ink); color: var(--sheet); }
</style>
