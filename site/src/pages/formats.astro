---
// Temporary comparison page, round three: "how they win" with the two teams directly comparable. Not linked.
import Base from '../layouts/Base.astro';
import * as m from '../data/mock';
const { order, teams } = m;
const max = Math.max(...m.goalSources.flatMap((s) => [s.CAR, s.EDM, s.lg]));
const w = (v: number) => `${(v / max) * 100}%`;
const short: Record<string, string> = { 'Sustained zone time': 'Zone time', 'Power play': 'Power play', Rush: 'Rush', Rebound: 'Rebound', 'Off a turnover': 'Turnover', 'Off a faceoff win': 'Faceoff', 'Empty net': 'Empty net', Shorthanded: 'Shorthanded' };
const lead = (s: (typeof m.goalSources)[0]) => (s.CAR === s.EDM ? 'Even' : `${s.CAR > s.EDM ? teams.CAR.place : teams.EDM.place} +${Math.abs(s.CAR - s.EDM)}`);
const opts = [
  { id: 'a', name: 'A. Paired bars in small cards', why: 'One small card per goal source, two per row on a phone and four on desktop. Inside each, the two teams’ bars are stacked from the same starting line, so the longer one is obvious. A tick marks league average.' },
  { id: 'b', name: 'B. One shared line per source', why: 'A compact table. Each row is one goal source with both teams as dots on the same line, so you read the gap between the dots directly. Numbers sit at the right.' },
  { id: 'c', name: 'C. Side-by-side columns', why: 'A classic grouped chart: for each goal source the two teams stand next to each other as columns. The quickest to scan for “who does this more”.' },
  { id: 'd', name: 'D. Back to back, with a verdict column', why: 'The mirrored chart you liked, kept, but the middle now says who leads and by how much, so you don’t have to compare bar lengths across the gap.' },
];
---
<Base title="How they win formats">
  <h1 class="page-h">How they win: four ways to compare directly</h1>
  <p class="lede">Each option is followed by the same two level “when they win” cards you liked.</p>
  {opts.map((o) => (
    <section class={`opt v-${o.id}`}>
      <h2>{o.name}</h2>
      <p class="why">{o.why}</p>
      <div class="key">{order.map((a) => <span class={`t-${a}`}><i></i>{teams[a].place}</span>)}<span class="avg">League average</span></div>

      {o.id === 'a' && (
        <ul class="cards4">
          {m.goalSources.map((s) => (
            <li class="card">
              <p class="src-name">{s.label}</p>
              {order.map((a) => <div class={`pb t-${a}`}><span class="trk"><span class="fill" style={`width:${w(s[a])}`}></span><span class="lg" style={`left:${w(s.lg)}`}></span></span><b>{s[a]}%</b></div>)}
            </li>
          ))}
        </ul>
      )}

      {o.id === 'b' && (
        <div class="card">
          <ul class="rows">
            {m.goalSources.map((s) => (
              <li>
                <span class="src-name">{s.label}</span>
                <span class="line"><span class="lg" style={`left:${w(s.lg)}`}></span><span class="span" style={`left:${w(Math.min(s.CAR, s.EDM))};width:${w(Math.abs(s.CAR - s.EDM))}`}></span>{order.map((a) => <span class={`d t-${a}`} style={`left:${w(s[a])}`}></span>)}</span>
                <span class="nums">{order.map((a) => <span class={`t-${a}`}><i></i>{s[a]}%</span>)}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {o.id === 'c' && (
        <div class="card">
          <ul class="cols">
            {m.goalSources.map((s) => (
              <li>
                <div class="plot">
                  <span class="lgh" style={`bottom:${w(s.lg)}`}></span>
                  {order.map((a) => <span class={`col t-${a}`} style={`height:${w(s[a])}`}><b>{s[a]}</b></span>)}
                </div>
                <span class="src-name">{short[s.label]}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {o.id === 'd' && (
        <div class="card">
          {m.goalSources.map((s) => (
            <div class="bf">
              <div class="bar left t-CAR"><b>{s.CAR}%</b><span class="trk"><span class="fill" style={`width:${w(s.CAR)}`}></span><span class="lg" style={`right:${w(s.lg)}`}></span></span></div>
              <div class="mid"><span class="src-name">{s.label}</span><span class:list={['who', s.CAR > s.EDM ? 't-CAR' : s.EDM > s.CAR ? 't-EDM' : '']}>{lead(s)}</span></div>
              <div class="bar t-EDM"><span class="trk"><span class="fill" style={`width:${w(s.EDM)}`}></span><span class="lg" style={`left:${w(s.lg)}`}></span></span><b>{s.EDM}%</b></div>
            </div>
          ))}
        </div>
      )}

      <div class="two even">
        {order.map((a) => <div class={`card t-${a}`}><p class="nm"><i></i>When {teams[a].place} wins</p><ul class="rec">{m.recipes[a].map((r) => <li><p>{r.text}</p><p class="cite">{r.sample}</p></li>)}</ul></div>)}
      </div>
    </section>
  ))}
</Base>

<style>
  .page-h { font: 700 clamp(30px, 6vw, 44px) / 1.1 var(--display); margin-top: 24px; }
  .lede { color: var(--ink-2); margin-top: 8px; }
  .opt { margin-top: 56px; padding-top: 18px; border-top: 5px solid var(--line-blue); }
  .opt h2 { font: 700 28px/1.1 var(--display); }
  .why { font: 400 15px/1.45 var(--ui); color: var(--ink-2); margin: 6px 0 14px; }
  .key { margin: 0 0 14px; }
  .src-name { font: 600 14px var(--ui); }
  .nm { display: flex; align-items: center; gap: 8px; font: 700 22px/1 var(--display); margin-bottom: 12px; }
  .nm i, .nums i { width: 10px; height: 10px; border-radius: 50%; background: var(--team); display: inline-block; flex: none; }
  .two.even { align-items: stretch; margin-top: 14px; }
  .rec { display: grid; gap: 14px; }
  .rec li + li { border-top: 1px solid var(--rule); padding-top: 14px; }
  .cite { font: 400 12px var(--ui); color: var(--ink-3); margin-top: 4px; }
  .trk { position: relative; display: block; height: 10px; }
  .fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--team); border-radius: 0 5px 5px 0; min-width: 3px; }
  .lg { position: absolute; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; background: var(--ink); }

  .cards4 { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 820px) { .cards4 { grid-template-columns: repeat(4, 1fr); } }
  .cards4 li { display: grid; gap: 8px; padding: 14px 16px; border-radius: 14px; }
  .pb { display: grid; grid-template-columns: 1fr 38px; align-items: center; gap: 8px; font: 600 13px var(--ui); }
  .pb b { text-align: right; }

  .rows li { display: grid; grid-template-columns: minmax(120px, 190px) 1fr auto; align-items: center; gap: 16px; padding: 11px 0; border-top: 1px solid var(--rule); }
  .rows li:first-child { border-top: 0; }
  .line { position: relative; height: 14px; margin-inline: 7px; }
  .line::before { content: ''; position: absolute; left: -7px; right: -7px; top: 5px; height: 4px; border-radius: 2px; background: var(--track); }
  .line .lg { top: 0; bottom: 0; opacity: 0.5; }
  .line .span { position: absolute; top: 5px; height: 4px; background: var(--ink-3); }
  .d { position: absolute; top: 0; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--team); box-shadow: 0 0 0 2px var(--sheet); }
  .nums { display: inline-flex; gap: 14px; font: 600 13px var(--ui); }
  .nums span { display: inline-flex; align-items: center; gap: 5px; min-width: 48px; }
  @media (max-width: 560px) { .rows li { grid-template-columns: 1fr auto; } .rows .line { grid-column: 1 / -1; order: 3; } }

  .cols { display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px; }
  .cols li { display: grid; gap: 8px; justify-items: center; text-align: center; }
  .plot { position: relative; height: 170px; width: 100%; display: flex; justify-content: center; align-items: flex-end; gap: 2px; border-bottom: 1px solid var(--ink-3); }
  .col { width: min(22px, 36%); background: var(--team); border-radius: 4px 4px 0 0; position: relative; min-height: 3px; }
  .col b { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); font: 600 11px var(--ui); color: var(--ink); padding-bottom: 2px; }
  .lgh { position: absolute; left: 12%; right: 12%; height: 2px; background: var(--ink); opacity: 0.55; }
  .cols .src-name { font-size: 12px; line-height: 1.2; }

  .bf { display: grid; grid-template-columns: 1fr minmax(130px, 210px) 1fr; align-items: center; gap: 12px; padding: 9px 0; border-top: 1px solid var(--rule); }
  .bf:first-child { border-top: 0; }
  .bf .mid { display: grid; justify-items: center; gap: 2px; text-align: center; }
  .who { font: 600 12px var(--ui); color: var(--ink-2); display: inline-flex; align-items: center; gap: 5px; }
  .who.t-CAR::before, .who.t-EDM::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--team); }
  .bar { display: grid; grid-template-columns: 1fr 40px; align-items: center; gap: 8px; font: 600 13px var(--ui); }
  .bar.left { grid-template-columns: 40px 1fr; }
  .bar b { text-align: right; }
  .bar.left b { text-align: left; }
  .bar.left .fill { left: auto; right: 0; border-radius: 5px 0 0 5px; }
  .bar.left .lg { margin-left: 0; margin-right: -1px; }
</style>
