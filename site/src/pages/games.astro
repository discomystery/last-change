---
// Every game, by day. Built in the browser from the latest schedule, so today's slate and the Preview / Post-game
// buttons are always current. "My team's games" shows the whole season for the visitor's team instead.
import Base from '../layouts/Base.astro';
import { ownPaints } from '../lib/teams';
const base = import.meta.env.BASE_URL;
---
<Base section="games" title="Games" description="Every NHL game: previews before puck drop, post-game pages after.">
  <header class="page-top"><h1>Games</h1></header>
  <div class="pick" id="games-pick" data-base={base}>
    <span>Show</span>
    <select id="games-scope" aria-label="Which games"><option value="all">every game</option></select>
    <span class="pick-pair"><span>in</span><select id="games-month" aria-label="Which month"></select></span>
  </div>
  <div id="day-view">
    <div class="strip-wrap">
      <button type="button" class="step" id="prev-day" aria-label="Previous day">‹</button>
      <ol class="days" id="days">{Array.from({ length: 9 }, () => <li aria-hidden="true"><span class="skel skel-day"></span></li>)}</ol>
      <button type="button" class="step" id="next-day" aria-label="Next day">›</button>
    </div>
    <h2 class="day-h" id="day-h"><span class="skel skel-line" aria-hidden="true"></span></h2>
    <ul class="glist" id="day-games">{Array.from({ length: 4 }, () => <li class="skel skel-card" aria-hidden="true"></li>)}</ul>
  </div>
  <div id="team-view" hidden></div>
  <script type="application/json" id="mcol" set:html={JSON.stringify({ c: ownPaints() })}></script>
  <p class="note">Times are shown in your own time zone. Scores update live while games are on (from ESPN’s scoreboard). Previews open a week before each game; post-game pages appear soon after the final horn.</p>
</Base>

<script is:inline>
  (async () => {
    const host = document.getElementById('games-pick'), base = host.dataset.base;
    const get = (n) => fetch(`${base}data/${n}.json`).then((r) => r.json());
    const [teams, sched, pv, rc] = await Promise.all([get('teams'), get('schedule'), get('previews/index'), get('recaps/index')]);
    const T = Object.fromEntries(teams.map((t) => [t.abbr, t]));
    const PREVIEWS = new Set(pv.map((p) => p.id));
    const RECAPS = new Set(rc.games.map((g) => g.id));
    const games = sched.games.map((g) => ({ ...g, t: new Date(g.start) })).sort((a, b) => a.t - b.t);
    const L = window.lcLive;
    L.watch(sched.games);
    const MC = JSON.parse(document.getElementById('mcol').textContent);
    const colourOf = (a) => MC.c[a];
    let player = null;
    const names = () => { if (!player) { player = () => null; get('players/index').then((ix) => { player = L.players(ix, base); document.dispatchEvent(new CustomEvent('live')); }).catch(() => {}); } return (n, t) => player(n, t); };
    const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
    const time = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const dayLong = new Intl.DateTimeFormat(undefined, { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
    const dayShort = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
    const asDate = (d) => new Date(d + 'T12:00:00Z');

    const card = (g, me) => {
      const li = el('li', 'card row gcard');
      const when = el('span', 'g-when');
      if (me) when.append(dayShort.format(asDate(g.date)) + ' · ');
      when.append(g.final ? (g.end && g.end !== 'REG' ? `Final (${g.end})` : 'Final') : el('span', 'lv-clock', time.format(g.t)));
      const row = (a, score, side) => {
        // Score bug like the home page's tiles: the club’s abbreviation in its own colour, the score in the serif.
        const r = el('span', 'g-team');
        const ab = el('span', 'g-ab', a);
        const c = colourOf(a, g);
        if (c) ab.style.setProperty('--t', c);
        const nm = el('span', 'g-nick', T[a]?.nick ?? '');
        nm.title = T[a]?.name ?? a;
        r.append(ab, nm);
        const other = side === 'home' ? g.as : g.hs;
        if (g.final) r.append(el('strong', `g-sc${score < other ? ' l' : ''}`, String(score)));
        else { const s = el('strong', 'g-sc lv-sc'); s.dataset.side = side; r.append(s); }
        return r;
      };
      const teamsBox = el('span', 'g-teams');
      teamsBox.append(row(g.away, g.as, 'away'), row(g.home, g.hs, 'home'));
      const acts = el('span', 'g-acts');
      // A game with a page is one card that opens it; the button is the cue, the whole card is the target.
      const go = (label, href) => { const a = el('a', 'g-btn go-link', `${label} ›`); a.href = href; acts.append(a); li.classList.add('go'); };
      if (g.final && RECAPS.has(g.id)) go('Post-game', `${base}recap/${g.id}/`);
      else if (!g.final && L.get(g.id)?.st === 'post') acts.append(el('span', 'n', 'Post-game soon'));
      else if (!g.final && PREVIEWS.has(g.id)) go('Preview', `${base}preview/${g.id}/`);
      else if (!g.final) acts.append(el('span', 'n', 'Preview opens a week before'));
      li.append(when, teamsBox, el('span', 'g-venue n', g.venue ?? ''), acts);
      if (me) li.classList.add(g.home === me ? 'home' : 'road');
      if (!g.final) { li.dataset.live = g.id; window.lcLive.paint(li); }
      return li;
    };

    // A day with a game on splits into On now (a live card each), Later and Final; other days are one list.
    const stOf = (g) => (g.final ? 'post' : L.get(g.id)?.st ?? 'pre');
    const groupKey = (d) => games.filter((g) => g.date === d).map((g) => `${g.id}:${stOf(g)}`).join(',');
    let shownKey = '';
    const head = (text, liveDot) => { const h = el('li', 'g-group'); if (liveDot) h.append(el('span', 'g-dot')); h.append(text); return h; };
    const dayCards = (d) => {
      const day = games.filter((g) => g.date === d);
      const on = day.filter((g) => stOf(g) === 'in');
      if (!on.length) return day.map((g) => card(g));
      const later = day.filter((g) => stOf(g) === 'pre' || stOf(g) === 'off');
      const done = day.filter((g) => stOf(g) === 'post');
      const live = on.map((g) => {
        const li = el('li', 'g-live');
        li.append(L.card(g, { colour: colourOf, nick: (a) => T[a]?.nick, player: names(), href: PREVIEWS.has(g.id) ? `${base}preview/${g.id}/` : null }));
        return li;
      });
      return [
        head(`On now · ${on.length}`, true), ...live,
        ...(later.length ? [head(`Later · ${later.length}`), ...later.map((g) => card(g))] : []),
        ...(done.length ? [head(`Final · ${done.length}`), ...done.map((g) => card(g))] : []),
      ];
    };
    // When a game starts or ends, the day on show is regrouped; scores in between update in place.
    document.addEventListener('live', () => { if (scope.value === 'all' && current && groupKey(current) !== shownKey) { shownKey = groupKey(current); document.getElementById('day-games').replaceChildren(...dayCards(current)); } });

    // Day view: a strip of every date with games; opens on today (or the next day with games).
    const dates = [...new Set(games.map((g) => g.date))];
    const today = new Date().toLocaleDateString('en-CA');
    let current = location.hash.slice(1);
    if (!dates.includes(current)) current = dates.find((d) => d >= today) ?? dates[dates.length - 1];
    const strip = document.getElementById('days');
    strip.replaceChildren();
    dates.forEach((d) => {
      const li = el('li');
      const b = el('button', 'day');
      b.type = 'button';
      b.dataset.date = d;
      b.append(el('span', 'd1', dayShort.format(asDate(d)).replace(/,.*/, '')), el('span', 'd2', dayShort.format(asDate(d)).replace(/^[^,]*,\s*/, '')), el('span', 'd3', `${games.filter((g) => g.date === d).length} games`));
      if (d === today) b.classList.add('today');
      b.addEventListener('click', () => showDay(d));
      li.append(b);
      strip.append(li);
    });
    // A small puck under the strip glides to the day picked (motion only, styled below).
    const puck = el('li', 'day-puck');
    puck.setAttribute('aria-hidden', 'true');
    strip.append(puck);
    const motion = () => document.documentElement.classList.contains('motion');
    let shown = null;
    const showDay = (d) => {
      // Moving to a later day, the games come in from the right; to an earlier one, from the left.
      const from = shown && motion() ? (d > shown ? 'from-r' : d < shown ? 'from-l' : '') : '';
      shown = d;
      current = d;
      history.replaceState(null, '', '#' + d);
      strip.querySelectorAll('.day').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.date === d)));
      strip.querySelector(`[data-date="${d}"]`)?.scrollIntoView({ block: 'nearest', inline: 'center' });
      monthPick.value = d.slice(0, 7);
      document.getElementById('day-h').textContent = (d === today ? 'Today, ' : '') + dayLong.format(asDate(d));
      const list = document.getElementById('day-games');
      const cards = dayCards(d);
      if (from) cards.forEach((c, i) => { c.classList.add('rv', 'seen'); c.style.setProperty('--k', String(Math.min(i, 8))); });
      list.classList.remove('from-l', 'from-r');
      void list.offsetWidth;
      if (from) list.classList.add(from);
      list.replaceChildren(...cards);
      shownKey = groupKey(d);
      const b = strip.querySelector(`[data-date="${d}"]`);
      if (b) puck.style.translate = `${b.parentElement.offsetLeft + b.offsetWidth / 2}px 0`;
    };
    // Fade whichever end of the strip has more days hidden past it, so the last visible day isn't sliced in half.
    const edges = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      strip.classList.toggle('more-l', strip.scrollLeft > 2);
      strip.classList.toggle('more-r', strip.scrollLeft < max - 2);
    };
    strip.addEventListener('scroll', edges, { passive: true });
    window.addEventListener('resize', edges);
    window.addEventListener('resize', () => { const b = strip.querySelector('[aria-pressed="true"]'); if (b) puck.style.translate = `${b.parentElement.offsetLeft + b.offsetWidth / 2}px 0`; });

    // Month menu: jumps to the first day with games that month (today, if it falls in the month picked).
    const monthPick = document.getElementById('games-month');
    const monthName = new Intl.DateTimeFormat(undefined, { month: 'long', year: 'numeric', timeZone: 'UTC' });
    [...new Set(dates.map((d) => d.slice(0, 7)))].forEach((m) => { const o = el('option', null, monthName.format(asDate(m + '-15'))); o.value = m; monthPick.append(o); });
    monthPick.addEventListener('change', () => {
      const m = monthPick.value;
      if (scope.value !== 'all') { document.getElementById('m-' + m)?.scrollIntoView({ block: 'start', behavior: 'smooth' }); return; }
      showDay(current.startsWith(m) ? current : (today.startsWith(m) && dates.find((d) => d >= today && d.startsWith(m))) || dates.find((d) => d.startsWith(m)));
    });

    const step = (k) => { const i = dates.indexOf(current) + k; if (i >= 0 && i < dates.length) showDay(dates[i]); };
    document.getElementById('prev-day').addEventListener('click', () => step(-1));
    document.getElementById('next-day').addEventListener('click', () => step(1));

    // Team view: the visitor's team's whole season, months as headings, scrolled to the next game.
    const scope = document.getElementById('games-scope');
    const month = new Intl.DateTimeFormat(undefined, { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const showTeam = (me) => {
      const box = document.getElementById('team-view');
      box.replaceChildren();
      let cur = null, list = null;
      games.filter((g) => g.home === me || g.away === me).forEach((g) => {
        const m = month.format(asDate(g.date));
        if (m !== cur) { cur = m; const h = el('h2', 'day-h', m); h.id = 'm-' + g.date.slice(0, 7); box.append(h); list = el('ul', 'glist'); box.append(list); }
        const c = card(g, me);
        if (!g.final && !box.querySelector('.next')) c.classList.add('next');
        list.append(c);
      });
      box.querySelector('.next')?.scrollIntoView({ block: 'center' });
    };
    const apply = () => {
      const mine = scope.value !== 'all';
      document.getElementById('day-view').hidden = mine;
      document.getElementById('team-view').hidden = !mine;
      if (mine) showTeam(scope.value); else showDay(current);
      edges();
    };
    const mine = window.lcPrefs?.get('team');
    if (mine && T[mine]) { const o = el('option', null, `${T[mine].place}’s games`); o.value = mine; scope.append(o); }
    scope.addEventListener('change', apply);
    apply();
  })();
</script>

<style is:global>
  /* Global: most of this page is built in the browser, which scoped styles don't reach. */
  .strip-wrap { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 6px; margin-top: 16px; }
  .days { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 2px; --fl: 0px; --fr: 0px; -webkit-mask-image: linear-gradient(to right, transparent, #000 var(--fl), #000 calc(100% - var(--fr)), transparent); mask-image: linear-gradient(to right, transparent, #000 var(--fl), #000 calc(100% - var(--fr)), transparent); }
  .days::-webkit-scrollbar { display: none; }
  .day-puck { display: none; }
  html.motion .days { position: relative; padding-bottom: 14px; }
  html.motion .day-puck { display: block; position: absolute; left: -3.5px; bottom: 2px; width: 7px; height: 7px; border-radius: 50%; background: var(--ink); transition: translate 0.5s cubic-bezier(0.3, 1.25, 0.5, 1); }
  html.motion .glist.from-l > .card { animation: g-from-l 0.4s cubic-bezier(0.25, 0.9, 0.3, 1) backwards; animation-delay: calc(var(--k, 0) * 30ms); }
  html.motion .glist.from-r > .card { animation: g-from-r 0.4s cubic-bezier(0.25, 0.9, 0.3, 1) backwards; animation-delay: calc(var(--k, 0) * 30ms); }
  @keyframes g-from-l { from { opacity: 0; translate: -36px 0; } }
  @keyframes g-from-r { from { opacity: 0; translate: 36px 0; } }
  .days.more-l { --fl: 64px; }
  .days.more-r { --fr: 64px; }
  .pick-pair { display: inline-flex; align-items: center; gap: 10px; }
  .step { font: 600 22px/1 var(--ui); width: 34px; align-self: stretch; margin-block: 2px; border-radius: 10px; border: 1px solid var(--rule); background: var(--sheet); color: var(--ink); cursor: pointer; }
  .day { display: grid; justify-items: center; gap: 1px; min-width: 76px; padding: 7px 8px; border-radius: 12px; border: 1px solid var(--rule); background: var(--sheet); color: var(--ink); cursor: pointer; font-family: var(--ui); }
  .day .d1 { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); }
  .day .d2 { font-size: 15px; font-weight: 700; }
  .day .d3 { font-size: 11px; color: var(--ink-3); }
  .day.today { border-color: var(--ink-3); }
  .day[aria-pressed='true'] { background: var(--ink); color: var(--sheet); border-color: var(--ink); }
  .day[aria-pressed='true'] span { color: var(--sheet); }
  .day-h { font: 600 22px/1.15 var(--display); margin: 26px 0 10px; scroll-margin-top: 80px; }
  .glist { display: grid; gap: 8px; }
  @media (min-width: 820px) { .glist { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .glist { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .glist .g-group { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; margin: 18px 0 2px; font: 600 11px var(--ui); letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-2); }
  .glist .g-group:first-child { margin-top: 0; }
  .glist .g-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--live); }
  .glist .g-live { display: grid; }
  .gcard { display: grid; grid-template-columns: 1fr auto; gap: 6px 14px; align-items: center; }
  .gcard .g-when { grid-column: 1 / -1; font: 600 11px var(--ui); color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.07em; }
  .gcard .g-teams { display: grid; gap: 4px; }
  .gcard .g-team { display: flex; align-items: baseline; gap: 10px; }
  .gcard .g-ab { min-width: 50px; font: 700 21px/1.1 var(--ui); letter-spacing: -0.03em; color: var(--t, var(--ink)); }
  .gcard .g-nick { flex: 1; min-width: 0; font: 400 14px var(--ui); color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gcard .g-sc { font: 600 23px/1.1 var(--display); font-variation-settings: 'SOFT' 100; }
  .gcard .g-sc.l { color: var(--ink-3); }
  .gcard .g-teams { grid-column: 1 / -1; }
  .gcard .g-acts { justify-self: end; }
  .gcard .g-acts .n { font: 500 12px var(--ui); color: var(--ink-3); }
  .gcard .g-venue { font-size: 12px; }
  .gcard.next { outline: 2px solid var(--ink); }
  .gcard .g-btn { font: 600 13px var(--ui); color: var(--ink); text-decoration: none; white-space: nowrap; }
  .gcard.go:hover .g-btn { text-decoration: underline; text-underline-offset: 4px; }
</style>
