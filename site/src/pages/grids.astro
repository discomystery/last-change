---
// Temporary comparison page: ways to lay out the matchup grid now that rows carry player names. Not linked.
import Base from '../layouts/Base.astro';
import linesData from '../../public/data/lines.json';
const ln = (linesData.teams as any).CAR;
const rows = ln.matchups.home.rows as { label: string; minutes: number; share: (number | null)[]; expected: number[] }[];
const last = (label: string) => (ln.units.find((u: any) => u.label === label)?.players ?? []).map((n: string) => n.split(' ').slice(1).join(' ')).join(' · ');
const heat = (v: number | null) => (v === null ? '' : `background: color-mix(in oklab, var(--ink) ${Math.round(v * 1.5)}%, var(--sheet)); color: ${v >= 36 ? 'var(--sheet)' : 'var(--ink)'}`);
const kinds = [['L', 'Forward lines'], ['P', 'Defense pairs']] as const;
const opp = ['Opp. L1', 'Opp. L2', 'Opp. L3', 'Opp. L4'];
const opts = [
  { id: 'a', name: 'A. Names on their own line', why: 'Each group’s names sit on a slim line above its four boxes, so the boxes keep their full width. Still two grids side by side.' },
  { id: 'b', name: 'B. One wide grid at a time', why: 'A single full-width grid with a roomy name column, so every name fits on one line. Forward lines first, defense pairs directly below.' },
  { id: 'c', name: 'C. Split strips', why: 'Each group gets one strip divided into four parts, sized by how its time was split. Wider and darker means more time against that line. Names sit to the left on one line.' },
  { id: 'd', name: 'D. Name key above', why: 'The grids stay compact with just L1 to L4, and a key directly above lists who is on each. The least change from before.' },
  { id: 'now', name: 'What’s live now', why: 'For comparison.' },
];
---
<Base title="Matchup grid options" mock={false}>
  <h1 class="page-h">Ways to fit the names into the matchup grid</h1>
  <p class="lede">Carolina’s real home-game numbers, laid out five ways.</p>
  {opts.map((o) => (
    <section class={`opt v-${o.id}`}>
      <h2>{o.name}</h2>
      <p class="why">{o.why}</p>

      {o.id === 'd' && <ul class="namekey card">{rows.map((r) => <li><b>{r.label}</b>{last(r.label)}</li>)}</ul>}

      {o.id === 'c' ? (
        <div class="card">
          {kinds.map(([k, title]) => (
            <>
              <h4 class="mini">{title} against opposing forward lines</h4>
              <ul class="strips">
                {rows.filter((r) => r.label[0] === k).map((r) => (
                  <li><span class="lab"><b>{r.label}</b>{last(r.label)}</span>
                    <span class="strip">{r.share.map((v, j) => <span style={`flex:${Math.max(v ?? 0, 6)};${heat(v)}`}><i>L{j + 1}</i>{v}%</span>)}</span>
                  </li>
                ))}
              </ul>
            </>
          ))}
        </div>
      ) : (
        <div class:list={['wrap', { two: o.id !== 'b' }]}>
          {kinds.map(([k, title]) => (
            <div class="card">
              <h4 class="mini">{title} against opposing forward lines</h4>
              <table class="heat">
                <thead><tr>{o.id !== 'a' && <td></td>}{opp.map((n) => <th scope="col">{n}</th>)}</tr></thead>
                <tbody>
                  {rows.filter((r) => r.label[0] === k).map((r) => o.id === 'a' ? (
                    <>
                      <tr class="nmrow"><th colspan="4" scope="rowgroup"><b>{r.label}</b>{last(r.label)}</th></tr>
                      <tr>{r.share.map((v) => <td style={heat(v)}>{v}%</td>)}</tr>
                    </>
                  ) : (
                    <tr>
                      <th scope="row"><b>{r.label}</b>{(o.id === 'b' || o.id === 'now') && <span class="who">{last(r.label)}</span>}</th>
                      {r.share.map((v) => <td style={heat(v)}>{v}%</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      )}
    </section>
  ))}
</Base>

<style>
  .page-h { font: 700 clamp(30px, 6vw, 44px) / 1.1 var(--display); margin-top: 24px; }
  .lede { color: var(--ink-2); margin-top: 8px; }
  .opt { margin-top: 48px; padding-top: 18px; border-top: 5px solid var(--line-blue); }
  .opt h2 { font: 700 26px/1.1 var(--display); }
  .why { font: 400 15px/1.45 var(--ui); color: var(--ink-2); margin: 6px 0 16px; }
  .mini { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); margin-bottom: 8px; }
  .wrap { display: grid; gap: 14px; }
  .wrap.two { align-items: stretch; margin-top: 0; }
  .heat { width: 100%; border-collapse: separate; border-spacing: 2px; font-size: 13px; table-layout: fixed; }
  .heat thead th { font: 600 11px var(--ui); color: var(--ink-2); padding: 4px 2px; }
  .heat tbody td { text-align: center; padding: 11px 0; border-radius: 4px; font-weight: 600; }
  .heat tbody th { text-align: left; font: 400 13px var(--ui); color: var(--ink-2); }
  .heat tbody th b { font: 700 14px var(--ui); color: var(--ink); margin-right: 8px; }

  .v-a .nmrow th { padding: 10px 0 2px; }
  .v-a tbody .nmrow:first-child th { padding-top: 2px; }

  .v-b .heat tbody th { width: 300px; white-space: nowrap; font-size: 14px; }
  .v-b .heat tbody td { padding: 12px 0; }
  @media (max-width: 640px) { .v-b .heat tbody th { width: 42%; white-space: normal; } }

  .strips { display: grid; gap: 8px; margin-bottom: 18px; }
  .strips:last-child { margin-bottom: 0; }
  .strips li { display: grid; grid-template-columns: minmax(150px, 280px) 1fr; align-items: center; gap: 14px; }
  .lab { font: 400 14px var(--ui); color: var(--ink-2); }
  .lab b { font-weight: 700; color: var(--ink); margin-right: 8px; }
  .strip { display: flex; gap: 2px; height: 38px; }
  .strip > span { display: flex; flex-direction: column; justify-content: center; align-items: center; border-radius: 4px; font: 600 13px/1.1 var(--ui); min-width: 34px; }
  .strip i { font: 500 10px var(--ui); font-style: normal; opacity: 0.75; }
  @media (max-width: 640px) { .strips li { grid-template-columns: 1fr; gap: 4px; } }

  .namekey { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 6px 24px; margin-bottom: 14px; font: 400 14px var(--ui); color: var(--ink-2); }
  .namekey b { color: var(--ink); margin-right: 8px; }
  .v-d .heat tbody th { width: 40px; }

  .v-now .heat tbody th { width: 46%; line-height: 1.25; padding-right: 8px; }
</style>
