---
// Home (Sora, 2026-10-14): the visitor's own team's last and next game, last night around the league (the game of the
// night and the other results, most interesting first), today's games (the game to watch, the rest of tonight, and
// tomorrow only when there's room), and league leaders with last night's standout stat. Built in the browser from
// home.json (export/home.py), the schedule and the standings, so the visitor's team and division can lift games.
import Base from '../layouts/Base.astro';
import { cardTable } from '../lib/teams';
const base = import.meta.env.BASE_URL;
---
<Base section="home" title="Spare Line Change">
  <div id="home" data-base={base}>
    <section id="pick" hidden>
      <h1 class="page-top">Pick your team</h1>
      <p class="lede">Choose a team and this page becomes theirs. Your choice is remembered on this device, and you can change it from the team pill in the top menu (on a phone, the settings row at the bottom).</p>
      <ul class="teamgrid" id="teamgrid"></ul>
    </section>

    <section id="mine" hidden>
      <p class="mine-meta" id="mine-eyebrow"></p>
      <div class="mine-live" id="mine-live" hidden></div>
      <div class="tickets" id="tickets"></div>
    </section>

    <section id="onnow" class="band-sec" hidden>
      <h2 class="band">On now around the league</h2>
      <p class="band-sub" id="onnow-sub"></p>
      <div class="lv-tiles" id="onnow-tiles"></div>
    </section>

    <section id="night" class="band-sec">
      <h2 class="band" id="night-h">Last night</h2>
      <p class="band-sub" id="night-sub"></p>
      <div class="split" id="night-split"><div class="skel skel-row" aria-hidden="true"></div><div class="skel skel-row" aria-hidden="true"></div></div>
    </section>

    <section id="today" class="band-sec">
      <h2 class="band" id="today-h">Today around the league</h2>
      <p class="band-sub" id="today-sub"></p>
      <div class="split" id="today-split"><div class="skel skel-row" aria-hidden="true"></div><div class="skel skel-row" aria-hidden="true"></div></div>
    </section>

    <section id="leaders" class="band-sec" hidden>
      <h2 class="band">League leaders</h2>
      <p class="band-sub" id="lead-sub">This season</p>
      <div class="lead-grid">
        <div class="card lead-main">
          <p class="pick"><label for="stat">Show leaders in</label> <select id="stat">
            <option value="p">points</option><option value="g">goals</option><option value="a">assists</option><option value="x">expected goals</option><option value="gs">goals saved above expected</option>
          </select></p>
          <ol class="board" id="board"></ol>
          <p class="foot-note" id="board-note"></p>
          <p class="foot-note"><a id="board-all" href="players/leaders/">See every player →</a></p>
        </div>
        <div class="card dyn" id="standout" hidden>
          <div class="lead-top">
            <span class="box-h">Last night’s standout stat</span>
            <h3 id="so-h"></h3>
            <p class="so-sub" id="so-sub"></p>
          </div>
          <ol class="board" id="so-board"></ol>
        </div>
      </div>
    </section>
  </div>
  <script type="application/json" id="mcol" set:html={JSON.stringify(cardTable())}></script>
</Base>

<script is:inline>
  (async () => {
    const root = document.getElementById('home');
    const base = root.dataset.base;
    const get = (n) => fetch(`${base}data/${n}.json`).then((r) => (r.ok ? r.json() : null)).catch(() => null);
    const [teams, sched, home, pv] = await Promise.all(['teams', 'schedule', 'home', 'previews/index'].map(get));
    const PREVIEWS = new Set((pv ?? []).map((p) => p.id));
    const byAbbr = Object.fromEntries(teams.map((t) => [t.abbr, t]));
    const games = sched.games.map((g) => ({ ...g, t: new Date(g.start) })).sort((a, b) => a.t - b.t);
    const L = window.lcLive;
    L.watch(sched.games);
    // Live cards spell names our way and link them; the player list is fetched only once a game is on.
    let player = null;
    const names = () => { if (!player) { player = () => null; get('players/index').then((ix) => { player = L.players(ix, base); document.dispatchEvent(new CustomEvent('live')); }); } return (n, t) => player(n, t); };
    const MC = JSON.parse(document.getElementById('mcol').textContent);
    const colourOf = (a, g) => (a === g.away ? MC.s[`${g.away}@${g.home}`] : null) ?? MC.c[a];
    const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
    const day = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
    const time = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const dateOf = (s) => new Date(`${s}T12:00:00`);
    const RECAP = new Set((home?.results ?? []).flatMap((b) => b.rows.filter((r) => !r.pending).map((r) => r.id)));
    const SHORT = { Metropolitan: 'Metro' };
    const ab = (a, g, cls = 'ab') => { const s = el('span', cls, a); const c = colourOf(a, g); if (c) s.style.setProperty('--t', c); return s; };
    const plural = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
    const record = (a) => { const t = byAbbr[a]; return t ? `${t.nick ?? a} ${t.w}-${t.l}-${t.otl}` : a; };

    // The visitor's division lifts games: both teams in it most, one of them a little.
    const boost = (r, me) => {
      const d = me && byAbbr[me]?.division;
      if (!d) return r.score;
      const n = [r.away, r.home].filter((a) => byAbbr[a]?.division === d).length;
      return r.score + (n === 2 ? 10 : n === 1 ? 5 : 0);
    };
    const divTag = (r, me) => {
      const d = me && byAbbr[me]?.division;
      return d && byAbbr[r.away]?.division === d && byAbbr[r.home]?.division === d ? (SHORT[d] ?? d) : null;
    };
    const rank = (rows, me) => [...rows].sort((a, b) => boost(b, me) - boost(a, me));

    // One featured game: matchup, headline, a few sentences, why we picked it, and the way in.
    const feature = (r, kind, me) => {
      const g = { ...r, t: r.start ? new Date(r.start) : dateOf(r.date) };
      const href = kind === 'result' ? (RECAP.has(r.id) ? `${base}recap/${r.id}/` : `${base}games/#${r.date}`) : (r.preview ? `${base}preview/${r.id}/` : `${base}games/#${r.date}`);
      const a = el('a', 'card feat');
      a.href = href;
      const top = el('div', 'feat-top');
      const eb = el('span', 'eyebrow', kind === 'result' ? (r.venue ?? '') : null);
      if (kind !== 'result') eb.append(el('span', 'lv-clock', time.format(g.t)), r.venue ? ` · ${r.venue}` : '');
      top.append(el('span', 'box-h', kind === 'result' ? 'Game of the night' : 'Game to watch'), eb);
      const m = el('p', 'feat-m');
      if (kind === 'result') {
        m.append(ab(r.away, g), el('span', 'sc', String(r.as)), el('span', 'dash', '–'), el('span', 'sc', String(r.hs)), ab(r.home, g));
        if (r.end && r.end !== 'REG') m.append(el('span', 'end', r.end));
        m.setAttribute('aria-label', `${r.away} ${r.as}, ${r.home} ${r.hs}`);
      } else {
        m.append(ab(r.away, g), ...window.lcLive.middle({ sc: 'sc', dash: 'dash' }), ab(r.home, g));
        a.dataset.live = r.id;
      }
      a.append(top, m);
      if (r.head) a.append(el('h3', null, r.head));
      if (r.story) a.append(el('p', 'story', r.story));
      if (r.chips?.length) {
        const why = el('div', 'why');
        why.setAttribute('aria-label', 'Why we picked it');
        why.append(...r.chips.map((c) => el('span', 'chip phrase', c)));
        a.append(why);
      }
      const foot = el('div', 'feat-foot');
      foot.append(el('span', null, kind === 'result' ? (r.calls ?? '') : `${record(r.away)} · ${record(r.home)}`), el('span', 'go', kind === 'result' ? 'Post-game ›' : (r.preview ? 'Preview ›' : 'That day’s games ›')));
      a.append(foot);
      window.lcLive.paint(a);
      return a;
    };

    // A condensed row: time (and the division tag) or the score, with a one-line note.
    const row = (r, kind, me) => {
      const g = { ...r, t: r.start ? new Date(r.start) : dateOf(r.date) };
      const a = el('a', 'row');
      a.href = kind === 'result' ? (RECAP.has(r.id) ? `${base}recap/${r.id}/` : `${base}games/#${r.date}`) : (r.preview ? `${base}preview/${r.id}/` : `${base}games/#${r.date}`);
      const m = el('span', 'm');
      if (kind === 'result') {
        const hw = r.hs > r.as;
        const w = (side) => (side === 'home') === hw;
        const sideAb = (x, side) => { const s = ab(x, g, `ab ${w(side) ? 'w' : 'l'}`); return s; };
        m.append(sideAb(r.away, 'away'), el('span', `sc${w('away') ? '' : ' l'}`, String(r.as)), el('span', 'l', '–'), el('span', `sc${w('home') ? '' : ' l'}`, String(r.hs)), sideAb(r.home, 'home'));
        if (r.end && r.end !== 'REG') m.append(el('span', 'end', r.end));
        m.setAttribute('aria-label', `${r.away} ${r.as}, ${r.home} ${r.hs}`);
        a.append(m);
      } else {
        const tm = el('span', 'time');
        tm.append(el('span', 'lv-clock', time.format(g.t)));
        const d = divTag(r, me);
        if (d) tm.append(el('span', 'div chip', d));
        m.append(ab(r.away, g), ...window.lcLive.middle({ at: 'at', sc: 'sc', dash: 'l' }), ab(r.home, g));
        a.append(tm, m);
        a.dataset.live = r.id;
      }
      a.append(el('span', 'tag', r.pending ? 'Still coming in' : (r.note ?? '')));
      window.lcLive.paint(a);
      return a;
    };
    const card = (head, side, cls = 'card list') => {
      const d = el('div', cls);
      if (head) { const h = el('div', 'list-h'); h.append(el('span', 'box-h', head)); if (side) h.append(el('span', 'eyebrow', side)); d.append(h); }
      return d;
    };
    const more = (text, href) => { const a = el('a', 'more', text); a.href = href; return a; };

    // Last night: the latest game day before today wherever the visitor is (the day turns over at 3 AM, window.lcDay).
    // Today's own results take over once none of today's games are left to play, or after midnight (before the 3 AM
    // turnover), so late at night tonight's scores lead instead of the night before's.
    const renderNight = (me) => {
      const today = window.lcDay();
      const blocks = (home?.results ?? []).filter((b) => b.rows.length);
      const late = today !== window.lcDay.clock();
      const left = !late && (home?.coming ?? []).some((x) => x.date === today && x.rows.length);
      const b = [...blocks].reverse().find((x) => x.date < today || (x.date === today && !left)) ?? blocks[blocks.length - 1];
      const sec = document.getElementById('night');
      if (!b) { sec.hidden = true; return; }
      const yest = window.lcDay(-1);
      document.getElementById('night-h').textContent = b.date === today ? 'Tonight’s results' : b.date === yest ? 'Last night' : 'Latest results';
      document.getElementById('night-sub').textContent = `${day.format(dateOf(b.date))} · ${plural(b.games, 'game')}`;
      const ranked = rank(b.rows, me);
      const top = ranked.find((r) => r.away !== me && r.home !== me && !r.pending) ?? ranked[0];
      const split = document.getElementById('night-split');
      const list = card('Other results', 'Most interesting first');
      ranked.filter((r) => r !== top).slice(0, 6).forEach((r) => list.append(row(r, 'result', me)));
      list.append(more(`All ${b.games} results ›`, `${base}games/#${b.date}`));
      split.replaceChildren(feature(top, 'result', me), list);
    };

    // Today: tonight's games first; tomorrow only fills room left beside the game to watch, else it's a one-line button.
    let fill = () => {};
    const renderToday = (me) => {
      const today = window.lcDay();
      const blocks = (home?.coming ?? []).filter((b) => b.rows.length);
      // games already under way stay in tonight's list until the page is rebuilt
      let i = blocks.findIndex((x) => x.date >= today);
      const sec = document.getElementById('today');
      if (i < 0) { sec.hidden = true; return; }
      const tn = blocks[i], tm = blocks[i + 1];
      document.getElementById('today-h').textContent = tn.date === today ? 'Today around the league' : tn.date === window.lcDay(1) ? 'Tomorrow around the league' : `Around the league, ${day.format(dateOf(tn.date))}`;
      document.getElementById('today-sub').textContent = `${day.format(dateOf(tn.date))} · ${plural(tn.games, 'game')}`;
      const ranked = rank(tn.rows, me);
      const top = ranked.find((r) => r.away !== me && r.home !== me) ?? ranked[0];
      const rest = ranked.filter((r) => r !== top);
      const split = document.getElementById('today-split');
      const feat = feature(top, 'coming', me);
      const lists = el('div', 'stack');
      split.replaceChildren(feat, lists);
      const tmRanked = tm ? rank(tm.rows, me) : [];
      const tmLabel = tm ? (tm.date === window.lcDay(1) ? 'Tomorrow' : day.format(dateOf(tm.date)).split(',')[0]) : null;
      const tmAll = tm ? `All of ${tmLabel === 'Tomorrow' ? 'tomorrow’s' : `${tmLabel}’s`} games ›` : null;
      fill = () => {
        const side = getComputedStyle(split).gridTemplateColumns.split(' ').length > 1;
        const room = side ? feat.offsetHeight : Infinity;
        lists.replaceChildren();
        const tnCard = card(rest.length ? (tn.date === today ? 'Also tonight' : 'Also that day') : null);
        if (rest.length) lists.append(tnCard);
        const tmBtn = card(null, null, 'card list btn-card');
        if (tm) { tmBtn.append(more(tmAll, `${base}games/#${tm.date}`)); lists.append(tmBtn); }
        const cap = side ? Infinity : 5;
        let shown = 0;
        for (const r of rest) {
          if (shown >= cap) break;
          tnCard.append(row(r, 'coming', me));
          if (lists.offsetHeight > room) { tnCard.lastElementChild.remove(); break; }
          shown++;
        }
        if (shown < rest.length) {
          tnCard.append(more(`All ${tn.games} of ${tn.date === today ? 'tonight’s' : 'that day’s'} games ›`, `${base}games/#${tn.date}`));
          if (lists.offsetHeight > room && shown) tnCard.querySelectorAll('.row')[shown - 1].remove();
          return;
        }
        if (!tm) return;
        // Everything tonight fits: give the next day's best games the room left, if at least one fits.
        const tmCard = card(tmLabel, `${day.format(dateOf(tm.date))} · ${plural(tm.games, 'game')}`);
        tmCard.append(more(tmAll, `${base}games/#${tm.date}`));
        tmBtn.replaceWith(tmCard);
        let added = 0;
        for (const r of tmRanked) {
          if (!side && added >= 3) break;
          tmCard.lastElementChild.before(row(r, 'coming', me));
          if (lists.offsetHeight > room) { tmCard.querySelectorAll('.row')[added].remove(); break; }
          added++;
        }
        if (!added) tmCard.replaceWith(tmBtn);
      };
      fill();
    };

    // On now: a small tile for every game being played (the visitor's own game is in the tickets above), their division
    // first, then any game still to come today. Hidden when nothing is on.
    const renderOnNow = (me) => {
      const sec = document.getElementById('onnow');
      const today = games.filter((g) => !g.final && ['in', 'post'].includes(L.get(g.id)?.st) && g.away !== me && g.home !== me);
      const live = today.filter((g) => L.get(g.id).st === 'in');
      if (!live.length) { sec.hidden = true; return; }
      const done = today.filter((g) => L.get(g.id).st === 'post');
      const later = games.filter((g) => !g.final && (L.get(g.id)?.st ?? 'pre') === 'pre' && g.date === live[0].date && g.away !== me && g.home !== me);
      const lift = (g) => boost({ score: 0, away: g.away, home: g.home }, me);
      L.want(live.map((g) => g.id));
      const tile = (g) => {
        const s = L.get(g.id);
        const a = el('a', 'card lv-tile');
        a.dataset.live = g.id;
        a.href = PREVIEWS.has(g.id) ? `${base}preview/${g.id}/` : `${base}games/#${g.date}`;
        a.append(el('span', 'lv-clock', time.format(g.t)));
        const on = s && s.st !== 'pre';
        const r = (x, sc, other) => { const p = el('span', 'lt-r'); p.append(ab(x, g, 'lt-ab'), el('span', `lt-sc${sc < other ? ' l' : ''}`, on ? String(sc) : '')); return p; };
        a.append(r(g.away, s?.as, s?.hs), r(g.home, s?.hs, s?.as));
        const x = L.goals(g.id)?.at(-1);
        const who = x && (names()(x.scorer, x.side === 'home' ? g.home : g.away)?.last ?? x.scorer?.split(' ').slice(1).join(' '));
        a.append(el('span', 'lt-note', !on ? (g.venue ?? '') : who ? `Last goal: ${who}` : s.st === 'in' ? 'No goals yet' : ''));
        L.paint(a);
        return a;
      };
      const rows = [...[...live].sort((x, y) => lift(y) - lift(x) || x.t - y.t), ...done, ...later];
      const all = el('a', 'more', 'All games ›');
      all.href = `${base}games/#${live[0].date}`;
      document.getElementById('onnow-tiles').replaceChildren(...rows.map(tile), all);
      document.getElementById('onnow-sub').textContent = [`${plural(live.length, 'game')} on`, done.length ? `${done.length} just finished` : null, later.length ? `${later.length} still to come` : null].filter(Boolean).join(' · ');
      sec.hidden = false;
    };

    // League leaders, with what each player added on the latest game day.
    const NOTES = {
      p: 'Goals plus assists.',
      x: 'Expected goals from his own shots: who gets the best chances, whether or not they go in. Empty-net shots left out.',
      gs: 'Goals saved above expected: goals an average goalie would have let in on the same shots, minus his.',
    };
    const fmt = (k, v) => (k === 'x' || k === 'gs' ? Number(v).toFixed(1) : String(v));
    const delta = (k, v) => (!v ? '' : `${v > 0 ? '+' : '−'}${fmt(k, Math.abs(v))}`);
    const boardRows = (rows, k, me, hot) => rows.map((r, i) => {
      const li = el('li', [r.team === me ? 'you' : '', r.id === hot ? 'hot' : ''].filter(Boolean).join(' '));
      const nm = el('span', 'nm');
      const a = el('a', 'plink', r.name);
      a.href = `${base}player/${r.id}/`;
      nm.append(a, ab(r.team, { away: null, home: r.team }));
      li.append(el('span', 'rk', String(i + 1)), nm, el('span', 'gp', `${r.gp} ${k === 'gs' ? 'GS' : 'GP'}`), el('span', 'v', fmt(k, r.v)), el('span', 'ln', delta(k, r.ln)));
      return li;
    });
    const renderLeaders = (me) => {
      const L = home?.leaders;
      if (!L) return;
      document.getElementById('leaders').hidden = false;
      const lastDay = (home.results ?? []).filter((b) => b.rows.length).at(-1)?.date;
      const yest = window.lcDay(-1), today = window.lcDay();
      const when = lastDay === today ? 'tonight' : lastDay === yest ? 'last night' : `on ${day.format(dateOf(lastDay))}`;
      document.getElementById('lead-sub').textContent = lastDay ? `This season · grey figures are what each player added ${when}` : 'This season';
      const sel = document.getElementById('stat');
      const draw = () => {
        const k = sel.value;
        document.getElementById('board').replaceChildren(...boardRows(L[k] ?? [], k, me));
        const mine = (L[k] ?? []).some((r) => r.team === me);
        document.getElementById('board-note').textContent = `${NOTES[k] ?? ''}${mine ? ' Your team’s players are in bold.' : ''}`.trim();
        document.getElementById('board-all').href = `${base}players/leaders/${k === 'gs' ? '?k=g' : ['g', 'a'].includes(k) ? `?s=${k}` : ''}`;
      };
      sel.onchange = draw;
      draw();
      const S = home.standout;
      const so = document.getElementById('standout');
      so.hidden = !S;
      if (S) {
        so.querySelector('.box-h').textContent = lastDay === today ? 'Tonight’s standout stat' : lastDay === yest ? 'Last night’s standout stat' : 'The latest standout stat';
        document.getElementById('so-h').textContent = S.head;
        document.getElementById('so-sub').textContent = S.sub;
        document.getElementById('so-board').replaceChildren(...boardRows(S.rows, S.stat, me, S.id));
      }
    };

    const render = () => {
      const me = window.lcPrefs.get('team');
      const now = new Date();
      document.getElementById('pick').hidden = !!me;
      document.getElementById('mine').hidden = !me;
      if (!me) {
        const grid = document.getElementById('teamgrid');
        grid.replaceChildren(...teams.map((t) => {
          const b = el('button', 'card row teambtn');
          b.type = 'button';
          b.append(el('span', 'tb-abbr', t.abbr), el('span', 'tb-name', t.name));
          b.addEventListener('click', () => window.lcPrefs.set('team', t.abbr));
          const li = el('li');
          li.append(b);
          return li;
        }));
      } else {
        const t = byAbbr[me];
        const mine = games.filter((g) => g.home === me || g.away === me);
        let next = mine.find((g) => !g.final && g.t > new Date(now - 4 * 3600e3));
        const eb = document.getElementById('mine-eyebrow');
        const link = el('a', null, 'Team page');
        link.href = `${base}team/${me}/`;
        const ord = (n) => `${n}${n % 100 >= 11 && n % 100 <= 13 ? 'th' : { 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] ?? 'th'}`;
        eb.replaceChildren(`${t.name} · ${t.w}-${t.l}-${t.otl}${t.div_rank ? ` · ${ord(t.div_rank)} in the ${t.division}` : ''} · `, link);
        const tickets = [];
        const last = [...mine].reverse().find((g) => g.final);
        if (last) {
          const [ms, ts] = last.home === me ? [last.hs, last.as] : [last.as, last.hs];
          const opp = last.home === me ? last.away : last.home;
          const head = home?.latest?.[me]?.id === last.id ? home.latest[me].head : null;
          const sub = [`${ms > ts ? 'Beat' : 'Lost to'} ${byAbbr[opp]?.place ?? opp}.`];
          if (head && !/ beat | roll past /.test(head)) sub.push(` ${head}.`);
          tickets.push(window.lcTicket(last, { eyebrow: 'Last game', href: `${base}recap/${last.id}/`, sub, colour: colourOf }));
        }
        // While the visitor's game is on (or just over), its live card sits above the two tickets.
        const on = next && L.get(next.id);
        const liveBox = document.getElementById('mine-live');
        if (on && (on.st === 'in' || on.st === 'post')) {
          liveBox.replaceChildren(el('span', 'eyebrow', on.st === 'in' ? 'On now' : 'Just finished'), L.card(next, { wide: true, colour: colourOf, nick: (a) => byAbbr[a]?.nick, player: names(), href: PREVIEWS.has(next.id) ? `${base}preview/${next.id}/` : null }));
          liveBox.hidden = false;
          // The Next game ticket moves on to the game after this one.
          next = mine.find((g) => !g.final && g.t > next.t);
        } else { liveBox.hidden = true; liveBox.replaceChildren(); }
        if (next) {
          const has = PREVIEWS.has(next.id);
          const when = [el('strong', 'lv-clock', time.format(next.t)), ` · ${next.venue ?? ''}`];
          if (!has) when.push(el('br'), 'Preview opens a week before the game');
          tickets.push(window.lcTicket(next, { eyebrow: 'Next game', href: has ? `${base}preview/${next.id}/` : null, sub: when, colour: colourOf }));
        }
        document.getElementById('tickets').replaceChildren(...tickets);
      }
      renderOnNow(me);
      renderNight(me);
      renderToday(me);
      renderLeaders(me);
    };
    render();
    document.addEventListener('prefs', (e) => { if (e.detail.key === 'team') render(); });
    // Live updates: the tiles redraw; the whole page only when the visitor's own game starts or ends.
    let mineKind = null;
    const kindOf = () => { const me = window.lcPrefs.get('team'); const g = me && games.find((x) => (x.home === me || x.away === me) && !x.final && x.t > new Date(Date.now() - 4 * 3600e3)); return g ? (L.get(g.id)?.st ?? 'pre') : null; };
    mineKind = kindOf();
    document.addEventListener('live', () => {
      const k = kindOf();
      if (k !== mineKind) { mineKind = k; render(); } else renderOnNow(window.lcPrefs.get('team'));
    });
    // Phones fire resize as the address bar slides away while scrolling: refill only when the width changes.
    let fillW = innerWidth;
    addEventListener('resize', () => { if (innerWidth !== fillW) { fillW = innerWidth; fill(); } });
    document.fonts?.ready.then(() => fill());
  })();
</script>

