---
// Home: built in the browser from the real schedule, around whichever team the visitor has chosen.
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base section="home" title="Last Change" mock={false}>
  <div id="home" data-base={base}>
    <section id="pick" hidden>
      <h1 class="page-top">Pick your team</h1>
      <p class="lede">Choose a team and this page becomes theirs. Your choice is remembered on this device, and you can change it at the top of any page.</p>
      <ul class="teamgrid" id="teamgrid"></ul>
    </section>

    <section id="mine" hidden>
      <p class="mine-meta" id="mine-eyebrow"></p>
      <div id="next"></div>
      <div id="latest"></div>
      <div class="cols">
        <div>
          <h2>Coming up</h2>
          <ul class="games" id="upcoming"></ul>
        </div>
        <div>
          <h2>Recent results</h2>
          <ul class="games" id="recent"></ul>
        </div>
      </div>
    </section>

    <section id="league">
      <h2 id="slate-h">Around the league</h2>
      <ul class="games slate" id="slate"></ul>
      <p class="more-link"><a href={`${base}games/`}>Every game, day by day →</a></p>
      <h2 id="results-h" hidden>Latest results</h2>
      <ul class="games slate" id="results"></ul>
    </section>
  </div>
</Base>

<script is:inline>
  (async () => {
    const root = document.getElementById('home');
    const base = root.dataset.base;
    const [teams, sched, pv, rc] = await Promise.all(['teams', 'schedule', 'previews/index', 'recaps/index'].map((n) => fetch(`${base}data/${n}.json`).then((r) => r.json())));
    const RECAPS = new Set(rc.games.map((g) => g.id));
    const byAbbr = Object.fromEntries(teams.map((t) => [t.abbr, t]));
    const games = sched.games.map((g) => ({ ...g, t: new Date(g.start) })).sort((a, b) => a.t - b.t);
    const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
    const day = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
    const time = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const finals = new Set(sched.games.filter((g) => g.final).map((g) => g.id));
    const PREVIEWS = Object.fromEntries(pv.filter((p) => !finals.has(p.id)).map((p) => [p.id, 'Preview']));

    const row = (g, me) => {
      const li = el('li', 'card row game');
      const opp = me ? (g.home === me ? g.away : g.home) : null;
      const tl = el('span', 'g-title');
      const link = (x) => { const l = el('a', 'tlink', me ? (byAbbr[x]?.name ?? x) : x); l.href = `${base}team/${x}/`; return l; };
      if (me) tl.append(`${g.home === me ? 'vs' : 'at'} `, link(opp)); else tl.append(link(g.away), ' at ', link(g.home));
      li.append(el('span', 'g-when', day.format(g.t) + (g.final ? '' : ' · ' + time.format(g.t))), tl);
      if (g.final) {
        const mine = me ? (g.home === me ? [g.hs, g.as] : [g.as, g.hs]) : [g.as, g.hs];
        const extra = g.end && g.end !== 'REG' ? ` (${g.end})` : '';
        const res = me ? (mine[0] > mine[1] ? 'W ' : 'L ') : '';
        const sc = el(RECAPS.has(g.id) ? 'a' : 'span', 'g-score', `${res}${mine[0]}–${mine[1]}${extra}`);
        if (RECAPS.has(g.id)) { sc.href = `${base}recap/${g.id}/`; sc.title = 'How the game went, and how the preview held up'; }
        li.append(sc);
      } else if (PREVIEWS[g.id]) {
        const a = el('a', 'g-link', PREVIEWS[g.id]);
        a.href = `${base}preview/${g.id}/`;
        li.append(a);
      } else {
        li.append(el('span', 'g-soon', g.venue ?? ''));
      }
      return li;
    };

    const render = () => {
      const me = window.lcPrefs.get('team');
      const now = new Date();
      document.getElementById('pick').hidden = !!me;
      document.getElementById('mine').hidden = !me;
      if (!me) {
        const grid = document.getElementById('teamgrid');
        grid.replaceChildren(...teams.map((t) => {
          const b = el('button', 'card row teambtn');
          b.type = 'button';
          b.append(el('span', 'tb-abbr', t.abbr), el('span', 'tb-name', t.name));
          b.addEventListener('click', () => window.lcPrefs.set('team', t.abbr));
          const li = el('li');
          li.append(b);
          return li;
        }));
      } else {
        const t = byAbbr[me];
        const mine = games.filter((g) => g.home === me || g.away === me);
        const next = mine.find((g) => !g.final && g.t > new Date(now - 4 * 3600e3));
        const eb = document.getElementById('mine-eyebrow');
        const link = el('a', null, `${t.name} team page`);
        link.href = `${base}team/${me}/`;
        eb.replaceChildren(`${t.w}-${t.l}-${t.otl} · `, link);
        const box = document.getElementById('next');
        box.replaceChildren();
        if (next) {
          const rink = el('div', 'nrink');
          ['rl blue l', 'rl red', 'rl blue r'].forEach((c) => rink.append(el('span', c)));
          rink.append(el('span', 'circle', 'at'));
          [next.away, next.home].forEach((a, i) => {
            const side = el('div', 'side' + (i ? ' home' : ''));
            const ab = el('p', 'abbr' + (a === me ? ' me' : ''));
            const l = el('a', 'tlink', a); l.href = `${base}team/${a}/`; ab.append(l);
            side.append(ab, el('p', 'full', byAbbr[a]?.name ?? a));
            if (i) side.append(el('p', 'lc', 'Has last change'));
            rink.append(side);
          });
          const meta = el('p', 'next-meta', `Next game: ${day.format(next.t)}, ${time.format(next.t)} · ${next.venue ?? ''}`);
          box.append(rink, meta);
          if (PREVIEWS[next.id]) { const a = el('a', 'g-link', PREVIEWS[next.id]); a.href = `${base}preview/${next.id}/`; meta.append(' · ', a); }
          else meta.append(' · Preview opens a week before the game');
        }
        const last = [...mine].reverse().find((g) => g.final && RECAPS.has(g.id));
        const lbox = document.getElementById('latest');
        lbox.replaceChildren();
        if (last) {
          const info = rc.games.find((x) => x.id === last.id);
          const [ms, ts] = last.home === me ? [last.hs, last.as] : [last.as, last.hs];
          const opp = last.home === me ? last.away : last.home;
          const c = el('a', 'card latest');
          c.href = `${base}recap/${last.id}/`;
          c.append(el('span', 'eyebrow', `Latest post-game · ${day.format(last.t)}`),
                   el('span', 'l-score', `${ms > ts ? 'Won' : 'Lost'} ${ms}–${ts}${last.end && last.end !== 'REG' ? ` (${last.end})` : ''} ${last.home === me ? 'against' : 'at'} ${byAbbr[opp]?.place ?? opp}`),
                   el('span', 'l-sub', info && info.calls ? `How the ${info.rebuilt ? 'rebuilt ' : ''}preview held up: ${info.held} of ${info.calls} calls held, ${info.partly} partly` : 'The numbers, the surprises and the goalies'));
          lbox.append(c);
        }
        document.getElementById('upcoming').replaceChildren(...mine.filter((g) => !g.final && g !== next).slice(0, 5).map((g) => row(g, me)));
        document.getElementById('recent').replaceChildren(...mine.filter((g) => g.final).slice(-5).reverse().map((g) => row(g, me)));
      }
      const key = (d) => d.toDateString();
      let slate = games.filter((g) => key(g.t) === key(now));
      let label = 'Today around the league';
      if (!slate.length) {
        const nxt = games.find((g) => g.t > now);
        slate = nxt ? games.filter((g) => key(g.t) === key(nxt.t)) : [];
        label = nxt ? `Around the league, ${day.format(nxt.t)}` : 'Around the league';
      }
      document.getElementById('slate-h').textContent = label;
      const lastDay = [...games].reverse().find((g) => g.final)?.date;
      const results = lastDay ? games.filter((g) => g.final && g.date === lastDay) : [];
      document.getElementById('results-h').hidden = !results.length;
      if (results.length) document.getElementById('results-h').textContent = `Latest results, ${day.format(results[0].t)}`;
      document.getElementById('results').replaceChildren(...results.map((g) => row(g, null)));
      document.getElementById('slate').replaceChildren(...slate.map((g) => row(g, null)));
    };
    render();
    document.addEventListener('prefs', (e) => { if (e.detail.key === 'team') render(); });
  })();
</script>

<style is:global>
  /* Same look as a section heading on every other page. */
  #home h2 { font: 700 34px/1.05 var(--display); letter-spacing: -0.01em; border-bottom: 5px solid var(--line-blue); padding-bottom: 10px; margin: 56px 0 16px; }
  #home .latest { display: grid; gap: 4px; margin-top: 14px; padding: 16px 18px; text-decoration: none; color: var(--ink); }
  #home .latest:hover { border-color: var(--ink); }
  #home .l-score { font: 600 22px/1.2 var(--display); }
  #home .l-sub { font: 400 14px var(--ui); color: var(--ink-2); }
  #home .more-link { margin-top: 12px; font: 600 14px var(--ui); }
  #home .mine-meta { font: 600 13px var(--ui); color: var(--ink-2); margin: 24px 0 10px; }
  .teamgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; margin-top: 22px; }
  .teambtn { width: 100%; display: flex; align-items: baseline; gap: 10px; text-align: left; cursor: pointer; color: var(--ink); font: inherit; }
  .teambtn:hover { border-color: var(--ink); }
  .tb-abbr { font: 700 20px/1 var(--ui); letter-spacing: -0.03em; min-width: 46px; }
  .tb-name { font: 400 14px var(--ui); color: var(--ink-2); }
  .cols { display: grid; gap: 0 28px; }
  @media (min-width: 820px) { .cols { grid-template-columns: 1fr 1fr; } }
  .games { display: grid; gap: 8px; }
  .games.slate { grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .game { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; align-items: baseline; }
  .g-when { grid-column: 1 / -1; font: 400 12px var(--ui); color: var(--ink-3); }
  .g-title { font-weight: 600; }
  .g-score { font: 700 16px var(--ui); white-space: nowrap; }
  .g-soon { font: 400 12px var(--ui); color: var(--ink-3); text-align: right; }
  .g-link { font: 600 13px var(--ui); }
</style>
