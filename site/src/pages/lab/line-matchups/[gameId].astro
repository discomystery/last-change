---
// PROTOTYPE (Sora, 2026-10-29, thread "Design post-game line matchup visuals"): three ways to show, for one finished
// game, who was on the ice against whom, with whom, at what strength, and what happened while they were out. Reads
// data/lab/linematch/{id}.json (pipeline/lab/line_matchups.py): the game cut into stretches where nobody changed,
// every skater's 5-on-5 rating going in, the shots, and the league's quintiles for a trio's, a pair's and a five's
// summed rating (shown as the site's five pips). Not linked from anywhere; draws everything in the browser.
import Base from '../../../layouts/Base.astro';
import Section from '../../../components/Section.astro';
import '../../../styles/blocks.css';
import { matchupPaint } from '../../../lib/teams';
import teamsData from '../../../../public/data/teams.json';
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

export async function getStaticPaths() {
  const files = import.meta.glob<{ default: { game_id: number } }>('../../../../public/data/lab/linematch/*.json', { eager: true });
  return Object.values(files).map((f) => ({ params: { gameId: String(f.default.game_id) }, props: { lab: f.default } }));
}
const { lab } = Astro.props as { lab: any };
const rp = resolve(process.cwd(), 'public/data/recaps', `${lab.game_id}.json`);
const r = existsSync(rp) ? JSON.parse(readFileSync(rp, 'utf8')) : { away: '?', home: '?', score: {} };
const T = Object.fromEntries(teamsData.map((t: any) => [t.abbr, t]));
const c = matchupPaint(r.away, r.home);
const css = `:root{--away:${c.away};--home:${c.home}}.t-away{--team:var(--away)}.t-home{--team:var(--home)}`;
const meta = { away: r.away, home: r.home, an: T[r.away]?.nick ?? r.away, hn: T[r.home]?.nick ?? r.home, ap: T[r.away]?.place ?? r.away, hp: T[r.home]?.place ?? r.home };
---
<Base section="games" title={`Line matchups lab: ${r.away} at ${r.home}`} description="Prototype: who played against whom.">
  <style is:inline set:html={css}></style>
  <section class="hero lab-hero">
    <p class="eyebrow">Prototype · not on the site</p>
    <h1 class="lab-h1">{meta.an} {r.score[r.away]}, {meta.hn} {r.score[r.home]}{r.end && r.end !== 'REG' ? ` (${r.end})` : ''}</h1>
    <p class="lab-lede">Three ways to see who was on the ice against whom. Each is drawn from the same data: every stretch of the game where nobody changed, the shots, and each skater’s 5-on-5 rating going into the game. Pips show how strong a group is against every line, pair or five that has played at 5-on-5 this season.</p>
  </section>

  <Section id="tape" title="A. The shift tape" placeholder={false} lead takeaway="Every line and pair as a row, in game time, visitors above and the home team below. Goals cut across both teams. Tap a goal to see who was out for it, or a row to see who that group faced.">
    <div class="pick lm-pick"><span>Show</span><select id="tp-when" aria-label="Part of the game"><option value="0">the whole game</option><option value="1">the first period</option><option value="2">the second period</option><option value="3">the third period</option><option value="4">overtime</option></select></div>
    <div class="card lm-card">
      <div id="tp" class="tp"></div>
      <div id="tp-cap" class="tp-cap" aria-live="polite"></div>
      <p class="note lm-key">Solid bars are 5-on-5; open bars are the same group out at other strengths. Tinted bands are a team’s power plays. Pips beside each row: how strong that group is, from its players’ 5-on-5 ratings going in.</p>
    </div>
  </Section>

  <Section id="goals" title="B. Goal by goal" placeholder={false} lead takeaway="Every goal with the two groups on the ice, how strong each was going in, and whether the stronger one won the moment.">
    <div id="gl" class="gl"></div>
  </Section>

  <Section id="player" title="C. One player’s night" placeholder={false} lead takeaway="Pick a player: his ice time by strength, who he played with, who he played against, and every shift with the goals and chances while he was out.">
    <div class="pick lm-pick"><span>Show</span><select id="pl-team" aria-label="Team"><option value="0">{meta.an}</option><option value="1">{meta.hn}</option></select><select id="pl-who" aria-label="Player"></select></div>
    <div id="pl" class="card pl"></div>
  </Section>

  <script type="application/json" id="lm-data" set:html={JSON.stringify({ ...lab, meta }).replace(/</g, '\\u003c')}></script>
</Base>

<script>
  const D: any = JSON.parse(document.getElementById('lm-data')!.textContent!);
  const M = D.meta;
  const ABBR = [M.away, M.home], NICK = [M.an, M.hn];
  const P = new Map<number, any>(D.players.map((p: any) => [p.id, p]));
  const LAB = ['L1', 'L2', 'L3', 'L4', 'P1', 'P2', 'P3'];
  const sets: Record<string, Set<number>>[] = [{}, {}];
  for (const p of D.players) if (/^[LP]\d$/.test(p.grp)) (sets[p.h][p.grp] ??= new Set()).add(p.id);

  const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;
  const per = (t: number) => Math.min(4, Math.floor(Math.max(t - 1, 0) / 1200) + 1);
  const PER = ['', '1st', '2nd', '3rd', 'OT'];
  const when = (t: number) => `${clock(t - (per(t) - 1) * 1200)} of the ${PER[per(t)]}`;
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const nm = (id: number) => esc(P.get(id)?.n ?? '?');
  const isD = (id: number) => !!P.get(id)?.d;

  function labelOf(side: number, ids: number[], kind: 'L' | 'P'): string | null {
    let best: string | null = null, n = 0;
    for (const [lab, mem] of Object.entries(sets[side])) {
      if (lab[0] !== kind) continue;
      const k = ids.filter((i) => mem.has(i)).length;
      if (k > n) { best = lab; n = k; }
    }
    return n >= (kind === 'L' ? 2 : 1) ? best : null;
  }
  // Strength for one side: ev (5-on-5), pp, pk, or other (4-on-4, 3-on-3, an empty net).
  const sideStr = (str: string, h: number) => str === '5v5' ? 'ev' : str === `PP${h}` ? 'pp' : str === `PP${1 - h}` ? 'pk' : 'oth';
  const segs = D.segs.map(([s, e, str, a, h]: any) => {
    const on = [a, h];
    return { s, e, dur: e - s, str, on, F: [0, 1].map((k) => labelOf(k, on[k].filter((i: number) => !isD(i)), 'L')), Dp: [0, 1].map((k) => labelOf(k, on[k].filter(isD), 'P')) };
  });
  const segAt = (t: number) => segs.find((g: any) => g.s < t && t <= g.e) ?? segs.find((g: any) => g.s <= t && t < g.e);
  const shots = D.shots.map(([t, h, xg, goal, , , shooter, en]: any) => ({ t, h, xg, goal: !!goal, shooter, en: !!en, seg: segAt(t) }));
  let sc = [0, 0];
  const goals = shots.filter((s: any) => s.goal).map((g: any) => { sc = [...sc]; sc[g.h]++; return { ...g, score: sc }; });
  const END = Math.max(D.len, ...segs.map((g: any) => g.e));

  // Strength of a group from its players' 5-on-5 ratings: 1 to 5 pips against the league's quintiles.
  const rate = (ids: number[]) => ids.reduce((a, i) => a + (P.get(i)?.r ?? 0), 0);
  const pipsOf = (v: number, cuts: number[]) => 1 + cuts.filter((c) => v > c).length;
  const groupPips = (side: number, lab: string) => pipsOf(rate([...(sets[side][lab] ?? [])]), lab[0] === 'L' ? D.cuts.trio : D.cuts.pair);
  const PIPWORD = ['', 'one of the weakest', 'below average', 'about average', 'above average', 'one of the strongest'];
  const pips = (n: number, what: string) => `<span class="pips" role="img" aria-label="${what}: ${PIPWORD[n]}" data-tip="${what}: ${PIPWORD[n]} at 5-on-5 this season">${[1, 2, 3, 4, 5].map((i) => `<i class="${i <= n ? 'on' : ''}"></i>`).join('')}</span>`;
  const names = (side: number, lab: string) => {
    const mem = [...(sets[side][lab] ?? [])];
    const order = D.players.filter((p: any) => mem.includes(p.id));
    return order.map((p: any) => esc(p.n)).join(' · ');
  };
  const strWord = (g: any) => {
    const k = sideStr(g.seg?.str ?? '5v5', g.h);
    if (k === 'pp') return 'Power play';
    if (k === 'pk') return 'Shorthanded';
    if (g.seg?.str === '3v3') return '3-on-3';
    if (g.seg?.str === '4v4') return '4-on-4';
    if (g.seg?.str === 'EN') return g.en ? 'Empty net' : 'Extra attacker';
    return '5-on-5';
  };

  // The two fives on the ice for a goal, and who had the edge going in.
  function goalHtml(g: any, i: number, compact = false) {
    const seg = g.seg, h = g.h;
    const hi = g.score[0] > g.score[1] ? 0 : 1, lead = g.score[0] === g.score[1] ? `Tied ${g.score[0]}–${g.score[1]}` : `${ABBR[hi]} ${g.t > 3600 ? 'wins' : 'leads'} ${g.score[hi]}–${g.score[1 - hi]}`;
    const side = (k: number) => {
      const on = seg.on[k] as number[];
      const f = seg.F[k], d = seg.Dp[k];
      const kind = sideStr(seg.str, k);
      const tag = kind === 'pp' ? 'Power-play unit' : kind === 'pk' ? 'Penalty killers' : seg.str === '3v3' ? '3-on-3' : seg.str === 'EN' ? (on.length > 5 ? 'Extra attacker' : 'Empty net') : [f ?? 'Mixed F', d ?? 'Mixed D'].join(' + ');
      const fwd = on.filter((x) => !isD(x)).map(nm).join(' · '), dd = on.filter(isD).map(nm).join(' · ');
      return `<div class="gl-side t-${k ? 'home' : 'away'} ${k === h ? 'sc' : 'cn'}"><p class="gl-who"><i class="tdot"></i><b>${ABBR[k]}</b> <span class="gl-tag">${tag}</span>${pips(pipsOf(rate(on), D.cuts.five), 'This five')}</p><p class="gl-names">${fwd}${dd ? `<span class="gl-d">${dd}</span>` : ''}</p></div>`;
    };
    const even = ['5v5', '4v4', '3v3'].includes(seg.str);
    let verdict = '';
    if (even) {
      const gap = rate(seg.on[h]) - rate(seg.on[1 - h]);
      verdict = gap <= -0.35 ? '<span class="verdict v-up">Scored against a stronger group</span>' : gap >= 0.35 ? '<span class="verdict v-down">The stronger group scored</span>' : '<span class="verdict v-even">Evenly matched</span>';
    }
    return `<div class="gl-row${compact ? ' compact' : ''}" data-g="${i}">
      <div class="gl-when"><p class="gl-score t-${h ? 'home' : 'away'}"><b>${g.score[0]}–${g.score[1]}</b> <span>${ABBR[h]} goal</span></p><p class="gl-time">${when(g.t)}</p><p><span class="chip phrase">${strWord(g)}</span></p></div>
      <div class="gl-body"><p class="gl-scorer">${nm(g.shooter)} scored${g.xg != null ? ` on a ${Math.round(g.xg * 100)}% chance` : ''}. ${lead}.</p>
      <div class="gl-pair">${side(h)}${side(1 - h)}</div>${verdict}</div></div>`;
  }

  // ---------- B. Goal by goal ----------
  document.getElementById('gl')!.innerHTML = goals.map((g: any, i: number) => `<div class="card gl-card">${goalHtml(g, i)}</div>`).join('');

  // ---------- A. Shift tape ----------
  const tp = document.getElementById('tp')!, cap = document.getElementById('tp-cap')!;
  let sel: any = null;
  type Iv = { s: number; e: number; ev: boolean };
  const rows: Record<string, Iv[]>[] = [{}, {}];
  for (const g of segs) for (const k of [0, 1]) for (const lab of [g.F[k], g.Dp[k]]) {
    if (!lab) continue;
    const ev = g.str === '5v5', list = (rows[k][lab] ??= []), last = list[list.length - 1];
    if (last && last.e === g.s && last.ev === ev) last.e = g.e; else list.push({ s: g.s, e: g.e, ev });
  }
  const ppBands: Iv[][] = [[], []];
  for (const g of segs) for (const k of [0, 1]) if (sideStr(g.str, k) === 'pp') {
    const l = ppBands[k], last = l[l.length - 1];
    if (last && last.e === g.s) last.e = g.e; else l.push({ s: g.s, e: g.e, ev: false });
  }
  function rangeOf(): [number, number] {
    const v = +(document.getElementById('tp-when') as HTMLSelectElement).value;
    return v === 0 ? [0, END] : [(v - 1) * 1200, v === 4 ? END : v * 1200];
  }
  function drawTape() {
    const W = tp.clientWidth, wide = W > 640;
    const LW = wide ? 272 : 74, RH = wide ? 13 : 12, GAP = 5, SPLIT = 9, AX = 26, HD = 20;
    const [t0, t1] = rangeOf();
    const x = (t: number) => LW + ((Math.min(Math.max(t, t0), t1) - t0) / (t1 - t0)) * (W - LW - 4);
    const halfH = 7 * RH + 6 * GAP + SPLIT;
    const top = (k: number) => k === 0 ? HD : HD + halfH + AX;
    const rowY = (k: number, i: number) => {
      // Visitors read down from L1 to P3 above the axis; the home team mirrors it, L1 nearest the axis.
      const j = k === 0 ? 6 - i : i;
      const extra = (k === 0 ? j >= 3 : j >= 4) ? SPLIT : 0;
      return top(k) + j * (RH + GAP) + extra;
    };
    const H = HD + 2 * halfH + AX;
    let s = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" class="tp-svg" role="img" aria-label="Shift tape">`;
    s += `<defs><pattern id="hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="5" stroke="currentColor" stroke-width="1.6"/></pattern></defs>`;
    for (const k of [0, 1]) for (const b of ppBands[k]) if (b.e > t0 && b.s < t1)
      s += `<rect class="tp-pp t-${k ? 'home' : 'away'}" x="${x(b.s)}" y="${top(k) - 3}" width="${Math.max(1, x(b.e) - x(b.s))}" height="${halfH + 6}"/>`;
    // A row picked: the moments that group was out, as a column over the other team.
    if (sel?.type === 'row') for (const iv of rows[sel.k][sel.lab] ?? []) if (iv.ev && iv.e > t0 && iv.s < t1)
      s += `<rect class="tp-col" x="${x(iv.s)}" y="${top(1 - sel.k) - 3}" width="${Math.max(1, x(iv.e) - x(iv.s))}" height="${halfH + 6}"/>`;
    const onGoal = sel?.type === 'goal' ? goals[sel.i].seg : null;
    for (const k of [0, 1]) LAB.forEach((lab, i) => {
      const y = rowY(k, i);
      const lit = onGoal ? (onGoal.F[k] === lab || onGoal.Dp[k] === lab) : sel?.type === 'row' ? (sel.k === k && sel.lab === lab) || sel.k !== k : true;
      s += `<g class="tp-row t-${k ? 'home' : 'away'}${lit ? '' : ' dim'}${sel?.type === 'row' && sel.k === k && sel.lab === lab ? ' on' : ''}" data-k="${k}" data-lab="${lab}" tabindex="0" role="button" aria-label="${ABBR[k]} ${lab}">`;
      s += `<rect class="tp-hit" x="0" y="${y - GAP / 2}" width="${W}" height="${RH + GAP}"/>`;
      s += `<line class="tp-base" x1="${LW}" x2="${W - 4}" y1="${y + RH / 2}" y2="${y + RH / 2}"/>`;
      for (const iv of rows[k][lab] ?? []) if (iv.e > t0 && iv.s < t1) {
        const w = Math.max(1, x(iv.e) - x(iv.s));
        s += iv.ev ? `<rect class="tp-bar" x="${x(iv.s)}" y="${y}" width="${w}" height="${RH}" rx="2"/>` : `<rect class="tp-bar st" x="${x(iv.s) + 0.5}" y="${y + 0.5}" width="${Math.max(0.5, w - 1)}" height="${RH - 1}" rx="2"/>`;
      }
      s += `</g>`;
    });
    // Labels last, so goal lines never run over them.
    let lbl = '';
    for (const k of [0, 1]) LAB.forEach((lab, i) => {
      const y = rowY(k, i) + RH / 2;
      const n = groupPips(k, lab);
      const lit = onGoal ? (onGoal.F[k] === lab || onGoal.Dp[k] === lab) : sel?.type === 'row' ? (sel.k === k && sel.lab === lab) || sel.k !== k : true;
      lbl += `<div class="tp-lbl${wide ? '' : ' narrow'}${lit ? '' : ' dim'}" style="top:${y}px;width:${LW - 8}px"><b>${lab}</b>${wide ? `<span class="tp-names">${names(k, lab)}</span>` : ''}${pips(n, `${ABBR[k]} ${lab}`)}</div>`;
    });
    // Axis: periods and team names.
    const ay = HD + halfH + AX / 2;
    for (let p = 1; p <= (END > 3600 ? 4 : 3); p++) {
      const a = (p - 1) * 1200, b = p === 4 ? END : p * 1200;
      if (b <= t0 || a >= t1) continue;
      if (a > t0) s += `<line class="tp-per" x1="${x(a)}" x2="${x(a)}" y1="0" y2="${H}"/>`;
      s += `<text class="tp-ax" x="${x(Math.max(a, t0)) + 4}" y="11">${p === 4 ? 'OT' : wide || t1 - t0 < 1300 ? `${PER[p]} period` : PER[p]}</text>`;
    }
    if (t1 - t0 <= 1300) for (let m = Math.ceil(t0 / 300) * 300; m < t1; m += 300) if (m > t0 && m % 1200) s += `<line class="tp-tick" x1="${x(m)}" x2="${x(m)}" y1="14" y2="18"/><text class="tp-ax sm" x="${x(m)}" y="11" text-anchor="middle">${clock(m % 1200)}</text>`;
    lbl += `<div class="tp-team t-away" style="top:${ay - 13}px;width:${LW - 8}px"><i class="tdot"></i>${wide ? NICK[0] : ABBR[0]} ↑</div><div class="tp-team t-home" style="top:${ay + 1}px;width:${LW - 8}px"><i class="tdot"></i>${wide ? NICK[1] : ABBR[1]} ↓</div>`;
    // Goals: a line through both teams, the puck on the scoring side of the axis.
    goals.forEach((g: any, i: number) => {
      if (g.t < t0 || g.t > t1) return;
      const gx = x(g.t), on = sel?.type === 'goal' && sel.i === i;
      const py = g.h === 0 ? ay - 6 : ay + 6;
      s += `<g class="tp-goal t-${g.h ? 'home' : 'away'}${on ? ' on' : ''}${sel && !on ? ' dim' : ''}" data-g="${i}" tabindex="0" role="button" aria-label="Goal, ${ABBR[g.h]}, ${when(g.t)}">`;
      s += `<rect class="tp-hit" x="${gx - 8}" y="0" width="16" height="${H}"/><line x1="${gx}" x2="${gx}" y1="0" y2="${H}"/><circle cx="${gx}" cy="${py}" r="6"/></g>`;
    });
    s += `</svg>`;
    tp.innerHTML = `<div class="tp-wrap" style="height:${H}px">${s}${lbl}</div>`;
    tp.querySelectorAll<SVGGElement>('.tp-goal').forEach((el) => el.addEventListener('click', () => pick({ type: 'goal', i: +el.dataset.g! })));
    tp.querySelectorAll<SVGGElement>('.tp-row').forEach((el) => el.addEventListener('click', () => pick({ type: 'row', k: +el.dataset.k!, lab: el.dataset.lab! })));
    tp.querySelectorAll<SVGGElement>('.tp-goal, .tp-row').forEach((el) => el.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') (el as any).dispatchEvent(new Event('click')); }));
  }
  // What a group did at 5-on-5: time, time against each opposing line and pair, chances and goals.
  function groupStats(k: number, test: (g: any) => boolean) {
    let sec = 0, xf = 0, xa = 0, gf = 0, ga = 0;
    const vs: Record<string, { sec: number; xf: number; xa: number; gf: number; ga: number }> = {};
    const add = (key: string) => (vs[key] ??= { sec: 0, xf: 0, xa: 0, gf: 0, ga: 0 });
    for (const g of segs) if (g.str === '5v5' && test(g)) {
      sec += g.dur;
      add(g.F[1 - k] ?? 'other F').sec += g.dur; add(g.Dp[1 - k] ?? 'other D').sec += g.dur;
    }
    for (const sh of shots) if (sh.seg && sh.seg.str === '5v5' && test(sh.seg)) {
      const mine = sh.h === k;
      for (const key of [sh.seg.F[1 - k] ?? 'other F', sh.seg.Dp[1 - k] ?? 'other D']) { const v = add(key); if (mine) { v.xf += sh.xg; v.gf += +sh.goal; } else { v.xa += sh.xg; v.ga += +sh.goal; } }
      if (mine) { xf += sh.xg; gf += +sh.goal; } else { xa += sh.xg; ga += +sh.goal; }
    }
    return { sec, xf, xa, gf, ga, vs };
  }
  const goalsWord = (gf: number, ga: number) => gf || ga ? ` · goals ${gf}–${ga}` : '';
  function vsBars(k: number, vs: any, total: number, keys: string[]) {
    return keys.filter((key) => vs[key]?.sec > 0).map((key) => {
      const v = vs[key], opp = 1 - k, real = /^[LP]\d$/.test(key);
      return `<li><span class="vb-lab">${real ? `<b>${key}</b>` : key === 'other F' ? 'Mixed' : 'Mixed'}${real ? pips(groupPips(opp, key), `${ABBR[opp]} ${key}`) : ''}</span><span class="vb-track"><i class="t-${opp ? 'home' : 'away'}" style="width:${(100 * v.sec / total).toFixed(1)}%"></i></span><span class="vb-num">${clock(v.sec)}</span><span class="vb-res">${v.xf.toFixed(1)}–${v.xa.toFixed(1)}${v.gf || v.ga ? ` <b>${v.gf}–${v.ga}</b>` : ''}</span></li>`;
    }).join('');
  }
  function caption() {
    if (!sel) {
      const big = goals.map((g: any, i: number) => ({ i, gap: ['5v5', '4v4', '3v3'].includes(g.seg.str) ? rate(g.seg.on[g.h]) - rate(g.seg.on[1 - g.h]) : 0 })).sort((a: any, b: any) => a.gap - b.gap)[0];
      cap.innerHTML = `<p class="tp-hint">Tap a goal or a row.${big && big.gap <= -0.35 ? ` The biggest mismatch: <button type="button" class="tp-jump" data-g="${big.i}">${ABBR[goals[big.i].h]}’s goal at ${when(goals[big.i].t)}</button>.` : ''}</p>`;
      cap.querySelector<HTMLButtonElement>('.tp-jump')?.addEventListener('click', (e) => pick({ type: 'goal', i: +(e.currentTarget as HTMLElement).dataset.g! }));
      return;
    }
    if (sel.type === 'goal') { cap.innerHTML = goalHtml(goals[sel.i], sel.i, true); return; }
    const { k, lab } = sel;
    const st = groupStats(k, (g) => (lab[0] === 'L' ? g.F[k] : g.Dp[k]) === lab);
    const oppF = ['L1', 'L2', 'L3', 'L4', 'other F'], oppD = ['P1', 'P2', 'P3', 'other D'];
    cap.innerHTML = `<div class="tp-grp t-${k ? 'home' : 'away'}"><p class="gl-who"><i class="tdot"></i><b>${ABBR[k]} ${lab}</b> <span class="gl-tag">${names(k, lab)}</span>${pips(groupPips(k, lab), `${ABBR[k]} ${lab}`)}</p>
      <p class="tp-sum">${clock(st.sec)} at 5-on-5 · chances ${st.xf.toFixed(1)}–${st.xa.toFixed(1)} in expected goals${goalsWord(st.gf, st.ga)}</p>
      <div class="vb2"><div><p class="mini-h">Against ${NICK[1 - k]} lines</p><ul class="vb">${vsBars(k, st.vs, st.sec, oppF)}</ul></div><div><p class="mini-h">Against ${NICK[1 - k]} pairs</p><ul class="vb">${vsBars(k, st.vs, st.sec, oppD)}</ul></div></div></div>`;
  }
  function pick(s: any) {
    sel = sel && JSON.stringify(sel) === JSON.stringify(s) ? null : s;
    drawTape(); caption();
  }
  document.getElementById('tp-when')!.addEventListener('change', drawTape);

  // ---------- C. One player's night ----------
  const plTeam = document.getElementById('pl-team') as HTMLSelectElement, plWho = document.getElementById('pl-who') as HTMLSelectElement, pl = document.getElementById('pl')!;
  const toi = (id: number) => segs.filter((g: any) => g.on[P.get(id).h].includes(id)).reduce((a: number, g: any) => a + g.dur, 0);
  function fillWho() {
    const k = +plTeam.value;
    const list = D.players.filter((p: any) => p.h === k).sort((a: any, b: any) => (a.grp > b.grp ? 1 : a.grp < b.grp ? -1 : toi(b.id) - toi(a.id)));
    plWho.innerHTML = list.map((p: any) => `<option value="${p.id}">${esc(p.n)}${/^[LP]\d$/.test(p.grp) ? ` (${p.grp})` : ''}</option>`).join('');
  }
  function drawPlayer() {
    const id = +plWho.value, p = P.get(id), k = p.h, me = (g: any) => g.on[k].includes(id);
    const t: Record<string, number> = { ev: 0, pp: 0, pk: 0, oth: 0 };
    for (const g of segs) if (me(g)) t[sideStr(g.str, k)] += g.dur;
    const tot = t.ev + t.pp + t.pk + t.oth;
    const parts = [['ev', '5-on-5'], ['pp', 'Power play'], ['pk', 'Penalty kill'], ['oth', 'Other']].filter(([key]) => t[key] > 0);
    // Who he played with at 5-on-5: his forward linemates (or his partner), and the group behind or in front of him.
    const combos: Record<string, { sec: number; xf: number; xa: number; gf: number; ga: number }> = {}, other: typeof combos = {};
    const keyMates = (g: any) => g.on[k].filter((x: number) => x !== id && isD(x) === p.d).sort().join('-') || 'alone';
    const keyOther = (g: any) => (p.d ? g.F[k] : g.Dp[k]) ?? 'mixed';
    for (const g of segs) if (me(g) && g.str === '5v5') { (combos[keyMates(g)] ??= { sec: 0, xf: 0, xa: 0, gf: 0, ga: 0 }).sec += g.dur; (other[keyOther(g)] ??= { sec: 0, xf: 0, xa: 0, gf: 0, ga: 0 }).sec += g.dur; }
    for (const sh of shots) if (sh.seg && me(sh.seg) && sh.seg.str === '5v5') for (const [m, key] of [[combos, keyMates(sh.seg)], [other, keyOther(sh.seg)]] as const) {
      const v = m[key]; if (sh.h === k) { v.xf += sh.xg; v.gf += +sh.goal; } else { v.xa += sh.xg; v.ga += +sh.goal; }
    }
    const top = (m: typeof combos, n: number) => Object.entries(m).sort((a, b) => b[1].sec - a[1].sec).slice(0, n);
    const row = (label: string, v: any, of: number, cls: string) => `<li><span class="vb-lab">${label}</span><span class="vb-track"><i class="${cls}" style="width:${(100 * v.sec / of).toFixed(1)}%"></i></span><span class="vb-num">${clock(v.sec)}</span><span class="vb-res">${v.xf.toFixed(1)}–${v.xa.toFixed(1)}${v.gf || v.ga ? ` <b>${v.gf}–${v.ga}</b>` : ''}</span></li>`;
    const mine = `t-${k ? 'home' : 'away'}`;
    const withRows = top(combos, 3).map(([key, v]) => row(key === 'alone' ? 'Mixed' : key.split('-').map((x) => nm(+x)).join(' · '), v, t.ev, mine)).join('');
    const otherRows = top(other, 3).map(([key, v]) => row(/^[LP]\d$/.test(key) ? `<b>${key}</b> ${names(k, key)}` : 'Mixed', v, t.ev, mine)).join('');
    const st = groupStats(k, me);
    // Every shift in game time: solid at 5-on-5, full colour on the power play, hatched on the kill; goals for above, against below.
    const W = pl.clientWidth - 36 || 600, H = 64, y0 = 22, bh = 18;
    const x = (s: number) => (s / END) * W;
    let svg = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" class="pl-svg" role="img" aria-label="His shifts"><defs><pattern id="hatch2" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="5" stroke="currentColor" stroke-width="1.6"/></pattern></defs>`;
    svg += `<line class="tp-base" x1="0" x2="${W}" y1="${y0 + bh / 2}" y2="${y0 + bh / 2}"/>`;
    for (let q = 1200; q < END; q += 1200) svg += `<line class="tp-per" x1="${x(q)}" x2="${x(q)}" y1="4" y2="${H - 4}"/>`;
    const runs: { s: number; e: number; kind: string }[] = [];
    for (const g of segs) if (me(g)) { const kind = sideStr(g.str, k), last = runs[runs.length - 1]; if (last && last.e === g.s && last.kind === kind) last.e = g.e; else runs.push({ s: g.s, e: g.e, kind }); }
    for (const r of runs) svg += `<rect class="pl-sh ${mine} ${r.kind}" x="${x(r.s)}" y="${y0}" width="${Math.max(0.8, x(r.e) - x(r.s))}" height="${bh}" rx="1.5"/>`;
    for (const g of goals) if (g.seg && me(g.seg)) { const up = g.h === k; svg += `<circle class="pl-g t-${g.h ? 'home' : 'away'}" cx="${x(g.t)}" cy="${up ? y0 - 9 : y0 + bh + 9}" r="5.5"><title>${up ? 'Goal for' : 'Goal against'}, ${when(g.t)}</title></circle>`; }
    svg += `</svg>`;
    pl.innerHTML = `<div class="pl-head ${mine}"><p class="gl-who"><i class="tdot"></i><b>${nm(id)}</b> <span class="gl-tag">${/^[LP]\d$/.test(p.grp) ? `${p.grp}, ${ABBR[k]}` : ABBR[k]}</span></p><p class="tp-sum">${clock(tot)} on the ice · at 5-on-5, chances ${st.xf.toFixed(1)}–${st.xa.toFixed(1)}${goalsWord(st.gf, st.ga)}</p></div>
      <div class="pl-split ${mine}">${parts.map(([key]) => `<span class="ps ${key}" style="flex:${t[key]}"></span>`).join('')}</div>
      <p class="pl-parts ${mine}">${parts.map(([key, w]) => `<span><i class="kk ${key}"></i>${w} <b>${clock(t[key])}</b></span>`).join('')}</p>
      <p class="mini-h pl-mh">Every shift</p>${svg}<p class="note pl-key">Pucks above the shifts are goals for while he was out, below are goals against.</p>
      <div class="vb2"><div><p class="mini-h">${p.d ? 'Partners' : 'Linemates'}, 5-on-5</p><ul class="vb">${withRows}</ul></div><div><p class="mini-h">${p.d ? 'Forwards in front of him' : 'Defense behind him'}</p><ul class="vb">${otherRows}</ul></div></div>
      <div class="vb2"><div><p class="mini-h">Against ${NICK[1 - k]} lines</p><ul class="vb">${vsBars(k, st.vs, st.sec, ['L1', 'L2', 'L3', 'L4', 'other F'])}</ul></div><div><p class="mini-h">Against ${NICK[1 - k]} pairs</p><ul class="vb">${vsBars(k, st.vs, st.sec, ['P1', 'P2', 'P3', 'other D'])}</ul></div></div>
      <p class="note">Bars are his 5-on-5 time. At the right, chances for and against while he was out, in expected goals, then goals in bold.</p>`;
  }
  plTeam.addEventListener('change', () => { fillWho(); drawPlayer(); });
  plWho.addEventListener('change', drawPlayer);
  // Opens on the home player with the most ice time on the wrong end of the biggest mismatch, if there was one.
  {
    const worst = goals.filter((g: any) => ['5v5', '4v4', '3v3'].includes(g.seg.str)).map((g: any) => ({ g, gap: rate(g.seg.on[g.h]) - rate(g.seg.on[1 - g.h]) })).sort((a: any, b: any) => a.gap - b.gap)[0];
    const k = worst ? 1 - worst.g.h : 1;
    plTeam.value = String(k); fillWho();
    if (worst) plWho.value = String([...worst.g.seg.on[k]].sort((a: number, b: number) => toi(b) - toi(a))[0]);
  }

  const redraw = () => { drawTape(); caption(); drawPlayer(); };
  redraw();
  let rt = 0; addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(redraw, 120); });
</script>

<style is:global>
  .lab-hero { padding: 28px 0 8px; }
  .lab-h1 { font: 600 34px/1.15 var(--display); margin: 6px 0 10px; }
  .lab-lede { font: 400 18px/1.55 var(--body); color: var(--ink-2); max-width: 760px; margin: 0; }
  .lm-pick { margin-top: 4px; }
  .lm-card { padding: 18px 18px 14px; }
  .tdot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--team); margin-right: 6px; vertical-align: 1px; }

  /* A. tape */
  .tp-wrap { position: relative; }
  .tp-svg { display: block; overflow: visible; }
  .tp-pp { fill: color-mix(in oklab, var(--team) 12%, transparent); }
  .tp-col { fill: color-mix(in oklab, var(--ink) 8%, transparent); }
  .tp-hit { fill: transparent; cursor: pointer; }
  .tp-base { stroke: var(--rule); stroke-width: 1; }
  .tp-bar { fill: var(--team); }
  .tp-bar.st { fill: var(--sheet); stroke: var(--team); stroke-width: 1; }
  .tp-row { transition: opacity 0.2s; }
  .tp-row.dim { opacity: 0.22; }
  .tp-row:focus-visible { outline: none; }
  .tp-row:focus-visible .tp-base { stroke: var(--ink); }
  .tp-per { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0.6; }
  .tp-tick { stroke: var(--ink-3); }
  .tp-ax { font: 600 11px var(--ui); fill: var(--ink-3); letter-spacing: 0.07em; text-transform: uppercase; }
  .tp-ax.sm { font-size: 10px; letter-spacing: 0.02em; }
  .tp-goal line { stroke: var(--team); stroke-width: 1.5; opacity: 0.55; }
  .tp-goal circle { fill: var(--team); stroke: var(--sheet); stroke-width: 2; }
  .tp-goal { cursor: pointer; transition: opacity 0.2s; }
  .tp-goal.on line { opacity: 1; stroke-width: 2.5; }
  .tp-goal.dim { opacity: 0.35; }
  .tp-lbl { position: absolute; left: 0; transform: translateY(-50%); display: flex; align-items: center; gap: 8px; font: 500 13px var(--ui); color: var(--ink-2); pointer-events: none; white-space: nowrap; }
  .tp-lbl b { font-weight: 700; color: var(--ink); width: 20px; }
  .tp-lbl .tp-names { flex: 1; overflow: hidden; text-overflow: ellipsis; }
  .tp-lbl .pips { gap: 2px; }
  .tp-lbl .pips i { width: 7px; height: 7px; }
  .tp-lbl.narrow { gap: 4px; } .tp-lbl.narrow .pips { gap: 1px; } .tp-lbl.narrow .pips i { width: 6px; height: 6px; }
  .tp-lbl { transition: opacity 0.2s; } .tp-lbl.dim { opacity: 0.3; }
  .tp-team { position: absolute; left: 0; white-space: nowrap; font: 700 12px var(--ui); color: var(--ink); text-transform: uppercase; letter-spacing: 0.06em; }
  .tp-team .tdot { width: 8px; height: 8px; }
  .tp-cap { margin-top: 14px; border-top: 1px solid var(--rule); padding-top: 14px; min-height: 40px; }
  .tp-hint { font: 400 16px/1.5 var(--body); color: var(--ink-2); margin: 0; }
  .tp-jump { font: inherit; color: var(--ink); background: none; border: 0; padding: 0; border-bottom: 1px solid var(--ink-3); cursor: pointer; }
  .tp-sum { font: 500 14px/1.5 var(--ui); color: var(--ink-2); margin: 4px 0 0; }
  .lm-key { margin: 12px 0 0; }

  /* B. goals */
  .gl { display: grid; gap: 12px; }
  .gl-card { padding: 16px 18px; }
  .gl-row { display: grid; grid-template-columns: 150px 1fr; gap: 18px; }
  .gl-when p { margin: 0 0 4px; }
  .gl-score b { font: 600 26px/1 var(--display); color: var(--ink); }
  .gl-score span { font: 600 12px var(--ui); color: var(--team); text-transform: uppercase; letter-spacing: 0.06em; margin-left: 4px; }
  .gl-time { font: 500 13px var(--ui); color: var(--ink-3); }
  .gl-scorer { font: 400 16px/1.45 var(--body); margin: 0 0 10px; color: var(--ink); }
  .gl-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .gl-side { border-radius: 12px; padding: 10px 12px; background: var(--ice); }
  .gl-side.sc { background: color-mix(in oklab, var(--team) 10%, var(--sheet)); }
  .gl-who { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; margin: 0; font: 500 14px var(--ui); color: var(--ink-2); }
  .gl-who b { color: var(--ink); font-weight: 700; }
  .gl-tag { font-weight: 600; }
  .gl-who .pips { margin-left: auto; }
  .gl-names { font: 400 14px/1.45 var(--ui); color: var(--ink-2); margin: 6px 0 0; }
  .gl-d { display: block; color: var(--ink-3); }
  .gl-row .verdict { display: inline-block; margin-top: 10px; }
  .verdict { font: 600 12px var(--ui); padding: 4px 10px; border-radius: 999px; }
  .v-up { background: var(--ink); color: var(--sheet); }
  .v-down { border: 1px solid var(--ink-3); color: var(--ink); }
  .v-even { border: 1px dashed var(--ink-3); color: var(--ink-2); }
  .gl-row.compact { grid-template-columns: 130px 1fr; }

  /* bars shared by A's caption and C */
  .vb2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 28px; margin-top: 14px; }
  .vb { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 6px; }
  .vb li { display: grid; grid-template-columns: minmax(70px, auto) 1fr 40px 66px; align-items: center; gap: 8px; font: 500 13px var(--ui); color: var(--ink-2); }
  .vb-lab { display: flex; align-items: center; gap: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 210px; }
  .vb-lab b { color: var(--ink); }
  .vb-lab .pips { gap: 2px; } .vb-lab .pips i { width: 7px; height: 7px; }
  .vb-track { height: 8px; background: var(--track); border-radius: 999px; overflow: hidden; }
  .vb-track i { display: block; height: 100%; background: var(--team); border-radius: 999px; }
  .vb-num { text-align: right; font-variant-numeric: tabular-nums; color: var(--ink); }
  .vb-res { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .vb-res b { color: var(--ink); }

  /* C. player */
  .pl { padding: 18px; }
  .pl-split { display: flex; gap: 2px; margin-top: 14px; border-radius: 8px; overflow: hidden; }
  .pl-parts { display: flex; flex-wrap: wrap; gap: 4px 18px; margin: 8px 0 0; font: 500 13px var(--ui); color: var(--ink-2); }
  .pl-parts b { color: var(--ink); font-variant-numeric: tabular-nums; }
  .pl-parts .kk { margin: 0 6px 0 0; vertical-align: -1px; }
  .kk.oth { background: var(--track); }
  .ps { min-width: 0; height: 14px; padding: 0; font: 500 12px var(--ui); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ps.ev { background: color-mix(in oklab, var(--team) 55%, var(--sheet)); color: var(--ink); }
  .ps.pp { background: var(--team); color: var(--sheet); }
  .ps.pk { background: repeating-linear-gradient(45deg, color-mix(in oklab, var(--team) 30%, var(--sheet)) 0 3px, var(--sheet) 3px 6px); color: var(--ink); }
  .ps.oth { background: var(--track); color: var(--ink-2); }
  .pl-mh { margin: 18px 0 2px; }
  .pl-svg { display: block; color: var(--team); }
  .pl-sh.ev { fill: color-mix(in oklab, var(--team) 55%, var(--sheet)); }
  .pl-sh.pp { fill: var(--team); }
  .pl-sh.pk { fill: url(#hatch2); }
  .pl-sh.oth { fill: var(--ink-3); }
  .pl-g { fill: var(--team); stroke: var(--sheet); stroke-width: 2; }
  .pl-key { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; margin: 2px 0 0; }
  .kk { display: inline-block; width: 14px; height: 10px; border-radius: 2px; margin-left: 6px; }
  .kk.ev { background: color-mix(in oklab, var(--team) 55%, var(--sheet)); }
  .kk.pp { background: var(--team); }
  .kk.pk { background: repeating-linear-gradient(45deg, var(--team) 0 1.5px, transparent 1.5px 4px); }

  @media (max-width: 719px) {
    .gl-row, .gl-row.compact { grid-template-columns: 1fr; gap: 8px; }
    .gl-when { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
    .gl-pair, .vb2 { grid-template-columns: 1fr; }
    .vb li { grid-template-columns: minmax(60px, auto) 1fr 34px 76px; gap: 6px; }
    .vb-lab { max-width: 150px; }
    .lab-h1 { font-size: 27px; }
  }
</style>
