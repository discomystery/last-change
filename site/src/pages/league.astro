  .uranks li { display: grid; grid-template-columns: 2.2em 1fr auto; gap: 4px 16px; align-items: center; padding: 9px 8px; margin-inline: -8px; border-top: 1px solid var(--rule); }
  .uwho { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; min-width: 0; }
