  .tb thead .tb-name { z-index: 3; }
  .tb tbody .tb-name { font: 600 14px var(--ui); white-space: nowrap; padding: 0 12px; }
  .tb .ab { display: none; }
  .tb-pts { text-align: right; padding: 0 10px !important; white-space: nowrap; font-weight: 600; }
  .tb [data-sort] { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 2px; width: 100%; min-height: 64px; padding: 8px 4px; font: 600 11px/1.15 var(--ui); color: var(--ink-2); background: none; border: 0; cursor: pointer; text-align: center; }
