  .unit-card[data-stat='share'] .rk .v-share, .unit-card[data-stat='xgf60'] .rk .v-xgf60, .unit-card[data-stat='xga60'] .rk .v-xga60, .unit-card[data-stat='sec_pg'] .rk .v-sec_pg { display: inline; }

  /* Goalies */
