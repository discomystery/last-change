---
// The League page now lives under Teams (Teams > Rankings, 2026-10-16). Old links and bookmarks land here and move on,
// keeping any #section.
const to = `${import.meta.env.BASE_URL}teams/rankings/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Team rankings · Spare Line Change</title>
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
  </head>
  <body><p>The League page has moved to <a href={to}>Teams › Rankings</a>.</p></body>
</html>
