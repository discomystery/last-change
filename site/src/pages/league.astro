  /* Goal sources: reuses the team page's line, band and dot. */
  .sranks li { display: grid; grid-template-columns: 2.2em minmax(150px, 210px) 1fr 220px; gap: 0 16px; align-items: center; padding: 9px 8px; margin-inline: -8px; border-top: 1px solid var(--rule); order: var(--ob); }
