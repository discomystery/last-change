---
// Methods: how the numbers are made, as one read from the raw data to the pages built on it. The arena and blending
// sections are the deep ones; every figure in them is read from the exported data, so the page stays true each night.
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionNav from '../components/SectionNav.astro';
import data from '../../public/data/arena_factors.json';
import fp from '../../public/data/fingerprints.json';
import teamsData from '../../public/data/teams.json';
import { fpInfo, ordinal } from '../lib/traits';
import '../styles/blocks.css';

const base = import.meta.env.BASE_URL;
const nav: [string, string][] = [['sources', 'Data'], ['xg', 'Chances'], ['score', 'Score effects'], ['arena', 'Arenas'], ['blend', 'Blending'], ['lines', 'Lines'], ['players', 'Players'], ['games', 'Previews'], ['limits', 'Blind spots']];

// ---------- Arenas ----------
const SHRINK_GAMES = 20; // pipeline/metrics/rink_bias.py
const events = [['hits', 'Hits'], ['gives', 'Giveaways'], ['takes', 'Takeaways'], ['blocks', 'Blocked shots']] as const;
type Row = (typeof data.arenas)[number] & Record<string, number | string>;
const arenas = (data.arenas as Row[]).filter((a) => (a.home_games as number) >= 82);
const pct = (f: number) => { const p = Math.round((f - 1) * 100); return p === 0 ? 'even' : `${p > 0 ? '+' : '−'}${Math.abs(p)}%`; };
const byHits = [...arenas].sort((a, b) => (b.hits as number) - (a.hits as number));
const ex = byHits[0], stingy = byHits[byHits.length - 1];
const keep = Math.round((100 * (ex.home_games as number)) / ((ex.home_games as number) + SHRINK_GAMES));
const sample = 30;
const hr = (data as any).home_road as Record<string, { home_rate: number; away_rate: number }>;
const tilt = (e: string) => Math.round(100 * Math.abs(hr[e].home_rate / hr[e].away_rate - 1));
type Team = { abbr: string; name: string; place: string; nick: string };
const teamBy = Object.fromEntries((teamsData as Team[]).map((t) => [t.abbr, t]));
const nick = (abbr: string) => teamBy[abbr]?.nick ?? abbr;
const exPlace = teamBy[ex.team as string]?.place ?? ex.team;

// ---------- Blending ----------
const stab = fp.stabilization as Record<string, { r: number; k_games: number }>;
const label = (k: string) => fpInfo[k]?.label ?? k;
const settle = (fp.ready as string[]).filter((k) => stab[k]).map((k) => [k, stab[k].k_games] as const).sort((a, b) => a[1] - b[1]);
const N = 10, LAST = 82;
// Shares of a blended number N games in: this season, last season (itself pulled toward the league), league average.
const shares = (k: number) => {
  const now = N / (N + k), prior = 1 - now;
  return { now: Math.round(100 * now), last: Math.round(100 * prior * (LAST / (LAST + k))), league: Math.round(100 * prior * (k / (LAST + k))) };
};
const kOf = (key: string) => stab[key]?.k_games ?? 0;
const vol = shares(kOf('volume')), pk = shares(kOf('pk'));
const gNow = Math.round((100 * N) / (N + kOf('goalie')));
// Tonight's example: the team whose this-season and blended ranks are furthest apart on a trait that settles slowly.
type Est = { rank: number | null };
const fpTeams = fp.teams as Record<string, { games: number; dims: Record<string, { blend: Est; season: Est }> }>;
const example = (() => {
  let best: { abbr: string; key: string; s: number; b: number; games: number } | null = null;
  for (const [abbr, t] of Object.entries(fpTeams)) {
    for (const [key, k] of settle) {
      if (k < 40 || !t.dims[key]) continue;
      const s = t.dims[key].season.rank, b = t.dims[key].blend.rank;
      if (s == null || b == null) continue;
      if (!best || Math.abs(s - b) > Math.abs(best.s - best.b)) best = { abbr, key, s, b, games: t.games };
    }
  }
  return best && Math.abs(best.s - best.b) >= 8 ? best : null;
})();
const asOf = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(fp.generated_at));
---
<Base section="methods" title="Methods">
  <h1 class="page-top">How the numbers are made</h1>
  <p class="lede">This site is about how teams play, not who’s going to win. Everything here is built from the NHL’s own public data, and four things set it apart from most stats sites: we <a href="#arena">correct for each arena’s scorers</a>, we <a href="#blend">blend this season with last</a> by an amount that depends on the trait, we rate every chance with <a href="#xg">our own model</a>, and player ratings <a href="#players">account for linemates and opponents</a>. This page walks through all of it, in the order the numbers are built. The site is in beta, so some methods may still be refined.</p>

  <SectionNav items={nav} />

  <Section id="sources" title="Where the numbers come from" placeholder={false} lead takeaway="The NHL’s public game data, refreshed twice a day, with a few things left out on purpose.">
    <div class="card explain">
      <p><strong>Games.</strong> Play-by-play, shifts, boxscores, rosters, standings and the schedule come from the NHL’s public game data, pulled every morning and afternoon. When the shift feed is missing a game, the NHL’s official time-on-ice reports fill the gap, and every player’s ice time is checked against the boxscore.</p>
      <p><strong>Skating and shot speed.</strong> Player pages use NHL EDGE, the league’s puck and player tracking.</p>
      <p><strong>Who is out.</strong> Injury news comes from NHL.com’s daily Status Report. Roster moves (injured reserve, the injured non-roster list, suspensions, players sent to or called up from the minors) come from ESPN’s league-wide transactions list, because the NHL doesn’t publish one, and ESPN’s injury list fills in injuries neither of those mentions. None of these is complete, so when none says why a player is missing we only say what the rosters show.</p>
    </div>
  </Section>

  <Section id="xg" title="Rating every chance" placeholder={false} lead takeaway="Every shot gets a rating: how often shots like it go in.">
    <div class="card explain">
      <p>Goals are rare and streaky, so most of this site works from expected goals: every shot that gets past the shot blockers gets a chance of going in, and adding those up says how many goals a team’s chances were worth. The model is our own, trained on about 360,000 shots from three seasons. For each shot it looks at where it came from, what kind of shot it was, what happened just before (a save, a turnover, a faceoff win) and how long before, the manpower, the score and the period. It deliberately doesn’t know who shot or who was in net, so a goalie or a sniper is judged against the shot, not against himself.</p>
      <div class="try" id="try-xg" data-src={`${base}data/xg_grid.json`} hidden>
        <p class="try-pick"><span>Try</span>
          <select id="try-type" aria-label="Shot type"><option value="wrist">a wrist shot</option><option value="snap">a snap shot</option><option value="slap">a slap shot</option><option value="backhand">a backhand</option><option value="tip">a tip or deflection</option></select>
        </p>
        <div class="try-body">
          <svg id="try-rink" viewBox="-1 -1 87 78" role="img" aria-label="Half rink: drag the puck to see the chance of scoring from there">
            <path class="rk-board" d="M0 75 V26 A26 26 0 0 1 26 0 H59 A26 26 0 0 1 85 26 V75 Z" />
            <g id="try-heat"></g>
            <line class="rk-blue" x1="0" x2="85" y1="75" y2="75" />
            <line class="rk-red" x1="4.2" x2="80.8" y1="11" y2="11" />
            <circle class="rk-thin" cx="20.5" cy="31" r="15" /><circle class="rk-thin" cx="64.5" cy="31" r="15" />
            <path class="rk-crease" d="M36.5 11 A6 6 0 0 0 48.5 11" />
            <rect class="rk-net" x="39.5" y="8" width="6" height="3" />
            <circle id="try-puck" class="try-puck" cx="30" cy="34" r="2.2" tabindex="0" />
          </svg>
          <div class="try-read" aria-live="polite">
            <p class="try-big"><strong id="try-pct">–</strong></p>
            <p id="try-say" class="try-say">Drag the puck anywhere in the zone.</p>
            <p id="try-avg" class="note"></p>
          </div>
        </div>
        <p class="note">The average rating our model gave real 5-on-5 shots of that kind from that spot, <span id="try-n"></span>. Darker means more dangerous. A spot with few shots of one kind leans on all shots from there.</p>
      </div>
      <p>Tested on a full season it had never seen, it was about as sharp as the best public models on the same shots, and well calibrated: shots it rated around 10% went in about 10% of the time. Because one model rates every season, a team’s numbers from different years can be compared fairly.</p>
    </div>
  </Section>

  <Section id="score" title="Score effects" placeholder={false} lead takeaway="Teams that are behind shoot more, and so do home teams. Shot numbers are corrected for both.">
    <div class="card explain">
      <p>A team protecting a lead sits back; a team chasing one throws everything at the net. Raw shot totals would reward teams for trailing. So each 5-on-5 shot is weighted by the score when it was taken and by whether the shooter was at home, with weights set so that across three seasons the home and away totals come out even in every score situation. Behavior that depends on the score, like hitting, is measured only while the game is close.</p>
      <p><strong>Why it’s a score.</strong> After weighting, a team’s shot rate is no longer something anyone counted. So, like the arena-scored stats, shot volume, shots against and pace are shown as a score where 100 is the league average: 118 means 18% more than average once the score and home ice are allowed for. Flip “Adjusted stats” to Recorded in the settings to see the rates as recorded. Previews also say what a call looks like as recorded (shot attempts in a normal game, about 49 minutes of 5-on-5, and shots on goal on the scoreboard), and post-game pages show each game’s real counts.</p>
    </div>
  </Section>

  <Section id="arena" title="The arena correction" placeholder={false} lead takeaway="Hits, giveaways, takeaways and blocked shots are counted by people, and some buildings count a lot more than others.">
    <div class="card explain">
      <p>Every arena has its own off-ice scorers, and they don’t agree on what a hit is. At {ex.venue} scorers log about <strong>{Math.round(ex.hits_here as number)}</strong> hits per 60; when the {nick(ex.team as string)} and their opponents play anywhere else, the same kind of games produce about <strong>{Math.round(ex.hits_elsewhere as number)}</strong>. Teams don't regularly hit more just because they're at home. Leave that alone and every team looks more physical for the nights they play in a generous building, and the home team looks like bruisers when they may be ordinary.</p>
      <p><strong>How we measure it.</strong> For each arena we compare two sets of games from the last three seasons ({data.seasons}): the home team’s games in their own building, and the same team’s road games. Both sets have the same team in them, so that team’s own style cancels out, and what’s left is the building. The opponents differ, but over 120-odd road games the home team visits every other arena, so those quirks wash out. Dividing one rate by the other gives the arena’s factor: {ex.hits_here} ÷ {ex.hits_elsewhere} = <strong>{(ex.hits_raw as number).toFixed(2)}</strong> for hits at {ex.venue}.</p>
      <p><strong>Not taking it at face value.</strong> Even three seasons is a limited sample, so each factor is pulled part of the way back toward “no difference”, as if we’d also watched {SHRINK_GAMES} perfectly ordinary games there. With {ex.home_games} home games that keeps about {keep}% of the gap, and {ex.venue} settles at <strong>{(ex.hits as number).toFixed(2)}</strong>. A building with only a season of games behind it is pulled harder toward neutral and earns its factor as games come in.</p>
      <p><strong>Applying it.</strong> Each event is divided by the factor of the building it happened in, for both teams. Thirty hits at {ex.venue} count as about <strong>{(sample / (ex.hits as number)).toFixed(0)}</strong>; thirty at {stingy.venue}, where scorers are stingy, count as about <strong>{(sample / (stingy.hits as number)).toFixed(0)}</strong>. That feeds Physicality and Forecheck pressure on team pages, and hits, blocks, takeaways and giveaways on player pages and post-game report cards.</p>
      <div class="arena-count" role="img" aria-label={`Thirty recorded hits count as ${(sample / (ex.hits as number)).toFixed(0)} at ${ex.venue} and ${(sample / (stingy.hits as number)).toFixed(0)} at ${stingy.venue}`}>
        {[ex, stingy].map((a) => (
          <div class="ac">
            <p class="ac-venue">{a.venue}<span>{(a.hits as number) > 1 ? 'generous scorers' : 'stingy scorers'}</span></p>
            <div class="ac-nums">
              <p><strong data-to={sample}>{sample}</strong><span>hits recorded</span></p>
              <p class="ac-arrow" aria-hidden="true">→</p>
              <p><strong data-to={Math.round(sample / (a.hits as number))} data-from={sample}>{Math.round(sample / (a.hits as number))}</strong><span>after the correction</span></p>
            </div>
          </div>
        ))}
      </div>
      <p><strong>Home teams get more everywhere.</strong> Separately from any one building, home teams across the league are credited with about {tilt('hits')}% more hits, {tilt('gives')}% more giveaways and {tilt('takes')}% more takeaways than visitors, and {tilt('blocks')}% fewer blocks. It might be scorers watching the home side more closely, or teams really having the puck more at home; public data can’t tell the two apart. Either way it would flatter a team in the middle of a long homestand, so events are reweighted to put home and road games on the same footing.</p>
      <p><strong>What we tried and threw out.</strong> We tested whether some buildings tilt toward their own team more than others. In any one season it looks that way, but the arenas that tilted one year weren’t the ones that tilted the next, so it’s the bounces of a season rather than a habit of the scorers. Correcting for it would make the numbers worse, so we don’t.</p>
      <p><strong>Why it’s a score, not a count.</strong> We never show an adjusted count of “real hits” because that is, in the end, just another subjective number. We take arena-scored stats and turn them into a <em>score</em> where 100 is the league average. Flipping the switch at the top of every page switches the score to the numbers as recorded, so you can see how arena scoring impacts your team and use the site with the league’s official numbers if it suits you.</p>
    </div>
    <h3 class="sub">Every arena’s factors</h3>
    <p class="note">How much more or less each building records than its home team’s road games do, after the pull toward neutral. “+19%” means 19% more.</p>
    <div class="card tablecard">
      <table class="at">
        <thead><tr><th scope="col">Arena</th><th scope="col">Home team</th>{events.map(([, l]) => <th scope="col">{l}</th>)}</tr></thead>
        <tbody>
          {arenas.map((a) => (
            <tr><th scope="row">{a.venue}</th><td>{a.team}</td>{events.map(([k]) => <td data-tip={`${a[`${k}_here`]} per 60 here, ${a[`${k}_elsewhere`]} in ${a.team}’s road games. Factor ${(a[k] as number).toFixed(2)}.`}>{pct(a[k] as number)}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
    {!arenas.some((a) => a.team === 'UTA') && <p class="note">Utah’s arena doesn’t appear in this table because there’s not enough data to go on. We’ll see you next year, Mammoth.</p>}
  </Section>

  <Section id="blend" title="Blending this season with last" placeholder={false} lead takeaway={`${N} games in, some things about a team are already clear and some are still mostly bounces. Each trait gets its own answer.`}>
    <div class="card explain">
      <p>Early in a season, a team’s shot volume already tells you a lot about them, while their goaltending numbers barely tell you anything yet. Most sites either show the raw season numbers, which swing wildly in October, or lean on last season, which misses real change. We do something in between, and how far each number leans depends on the trait.</p>
      <p><strong>How long each trait takes to settle.</strong> We took three full seasons, split every team’s games into odd and even nights, and checked how well one half predicted the other. Shot volume barely changes from one half to the other, so it’s a habit. Second chances in one half say almost nothing about the other. From that comparison we get, for each trait, the number of games at which this season’s results and what we knew before count equally:</p>
      <ul class="settle">{settle.map(([k, g]) => <li><span>{label(k)}</span><strong>{g >= 300 ? 'over 300' : Math.round(g)} games</strong></li>)}</ul>
      <p><strong>What “what we knew before” means.</strong> It’s last season, but not last season raw: last season gets the same treatment, pulled toward league average by the same number of games. So for a trait that settles quickly, last season counts almost in full; for a slow one, even a whole season doesn’t move far from average.</p>
      <p><strong>What that does {N} games in.</strong> A team’s shot volume is about {vol.now}% this season and {vol.last}% last season. Their penalty kill is {pk.now}% this season, {pk.last}% last season and {pk.league}% league average. Their goaltending is only {gNow}% this season, which is why a hot two weeks in net barely shows on the blended view.</p>
      <div class="settle-try">
        <p class="try-pick"><span>Watch</span>
          <select id="st-trait" aria-label="Trait">
            <option value={kOf('volume')} data-name="shot volume">shot volume</option>
            <option value={kOf('pp')} data-name="the power play" selected>the power play</option>
            <option value={kOf('goalie')} data-name="goaltending">goaltending</option>
          </select>
          <span>settle</span>
        </p>
        <p class="note">Say a team ranked near the bottom last season but has played like a top-quarter team since. Slide through the season.</p>
        <div class="st-lane" aria-hidden="true">
          <span class="st-avg" style="left:50%"></span>
          <span class="st-whisk"></span>
          <span class="st-last" style="left:22%" data-tip="Last season"></span>
          <span class="st-now" style="left:78%" data-tip="This season so far"></span>
          <span class="st-blend"></span>
        </div>
        <div class="st-ends"><span>Bottom of the league</span><span>Top</span></div>
        <label class="st-slide"><span>Games played: <strong id="st-n">10</strong></span><input type="range" id="st-games" min="0" max="82" value="10" /></label>
        <p class="st-say" id="st-say"></p>
        <p class="note st-key"><span><i class="k-last"></i>Last season</span> <span><i class="k-now"></i>This season so far</span> <span><i class="k-blend"></i>What the site shows, with its likely range</span></p>
      </div>
      <p><strong>Goaltending follows the goalies.</strong> A team’s system carries over from one season to the next and pulls new players into it; their goaltending belongs to whoever is in net. So for goaltending, “what we knew before” is the goalies who have actually played for the team this season, each on his own last season wherever he played it (pulled toward league average the same way), weighted by his time in net. We tested it on the last two seasons: a team’s goaltending one season says almost nothing about the next, even when the starter stays the same, and we get better results relying on a goalie’s own records.</p>
      {example && <p><strong>An example from today.</strong> As of {asOf}, the {nick(example.abbr)} rank {ordinal(example.s)} in {label(example.key).toLowerCase()} on this season alone but {ordinal(example.b)} blended. After only {example.games} games that’s still mostly bounces, so the blend leans on what we knew before.</p>}
      <p><strong>The likely range.</strong> Every number carries a whisker: the middle 80% of results when a team’s games are reshuffled at random and the whole calculation is redone. Early in a season, or for a slow trait, it’s wide.</p>
      <p><strong>This season.</strong> The switch at the top of every page turns blending off: “This season” shows this season’s numbers on their own, swings and all. Player ratings blend the same way, measured in ice time rather than games (see <a href="#players">Player ratings</a>).</p>
    </div>
  </Section>

  <Section id="lines" title="Lines, power plays and penalty kills" placeholder={false} lead takeaway="First line, second line and so on are decided by ice time, not reputation.">
    <div class="card explain">
      <p><strong>Lines and pairs</strong> are picked by how much 5-on-5 time each group has played together over the team’s last ten games, with each older game counting half as much as the one after it. It’s not perfect, but relying heavily on the latest combinations gives us the best guess for the next game: tested on the last two seasons, lines picked this way covered about 45% of the next game’s forward ice time, against about 30% when all ten games counted equally. They are then numbered by how much the coach leans on their players: each player’s average 5-on-5 and power-play ice time a game (penalty-kill time is left out, since it lifts checking lines), so the first line is the one whose players play most. Checked against NHL.com’s projected first lines in 102 previews, our first line matched 81 times; most misses were two top lines with almost the same minutes. A group’s ice time is its average in the games it was one of that night’s lines, our best guess for its time together next game. We count how many of the past ten games this season that line played, with “in 3 of last 5” when it wasn’t a line every game. A group that was a line for the first time in ten games the previous game is marked “New.” When a team’s four most-used trios cover under a third of their forwards’ 5-on-5 time (a typical team’s cover about half), the page lets you know that their lines keep changing. Each line is rated against the same-numbered line on the other 31 teams: first lines with first lines, third pairs with third pairs.</p>
      <p><strong>Power-play units</strong> are built around the defenseman running them, because that’s how fans tell units apart: the first unit is the quarterback with the most power-play time plus the four skaters most often out with him, the second is built the same way around the next one. Forwards who stay out for both are listed on both. When one player takes the draw and then changes for someone else, he’s shown as the faceoff specialist and his time goes to whoever replaces him (looking at you, Jordan Staal). Special teams units use the current season only, no blending. A player’s role tags are awarded based only on a player’s games with his current team.</p>
      <p><strong>Penalty kills</strong> are too loose for fixed units: the most common foursome covers only about a tenth of a typical team’s shorthanded time. So penalty killers are grouped by when they go on: the ones who start most kills (usually for the defensive-zone draw), the second wave who come on after the first change, and spot duty. Most teams work this way.</p>
      <p><strong>Matchups</strong> are split by home and road, because the home coach has the last change. Each line’s share of time against each opposing line is shown beside the share it would get with no line matching, where each group faces an opposing line about as often as that line is on the ice.</p>
    </div>
  </Section>

  <Section id="players" title="Player ratings" placeholder={false} lead takeaway="Each player is compared with others who play his position, after accounting for who he plays with and against.">
    <div class="card explain">
      <p><strong>Settling, for players.</strong> Ratings blend the same way team traits do, but the yardstick is ice time (or shots, or faceoffs) rather than games, and a short sample is pulled toward the average for his position. Shot volume and hitting settle within a few games; finishing and power-play scoring take seasons, so they barely move early on. “Blended” also leans on his own previous season. Even “This season” keeps the pull toward the position average, or five-game players would fill the top of every list.</p>
      <p><strong>Who he’s compared with.</strong> Forwards are compared with forwards and defensemen with defensemen, among regulars (20+ games over two seasons, or 3 this season). Centers and wingers are split only where they really play different games: shooting volume, creating their own chances, shot blocking, hardest shot and distance skated. We checked every rating and split only where the gap was large; defense showed none. Three ratings only count players who do enough of that thing, so their group is smaller and the page names it: power play (60+ minutes on it over two seasons, or 10+ this season), shorthanded threat (30+ minutes killing penalties, or 5+) and faceoffs (200+ draws, or 40+). That’s why a forward can rank 1st of 193 penalty-killing forwards but 9th of 381 forwards at creating chances. A player is listed as better or worse than most only when even the cautious end of his likely range is clearly away from the middle.</p>
      <p><strong>Creating and preventing chances</strong> isolate what a player adds at 5-on-5. Every shift goes into one model that rates all players at once, starting from where each player stood at the end of last season (back to 2023-24, so a long track record counts and a few games can only move him so far), so each player gets credit or blame only for what’s left after his linemates, the opponents on the ice, where the shift started and the score are accounted for. A shutdown center who faces top lines every night isn’t punished for their chances, and a winger riding with a star doesn’t take the star’s credit. This is regularized adjusted plus-minus (RAPM); it pulls everyone toward average, harder the less he has played. It measures chances, so it can’t see good stick work that stops a pass before a shot.</p>
      <p><strong>Competition</strong> on a player’s Role section is how dangerous his 5-on-5 opponents are, from those same ratings, split by home and road.</p>
      <p><strong>Players who changed teams.</strong> Last season still counts, but not equally for everything. Over three seasons, personal habits (shooting volume, the danger of his shots, hitting, shot blocking, penalties) carried to a new team almost as well as for players who stayed put. Setting up goals, finishing, faceoffs and power-play chances carried far less, because they depend on linemates and role, so for a player on a new team those lean on last season only 35% to 60% as much.</p>
    </div>
  </Section>

  <Section id="games" title="Previews and post-game pages" placeholder={false} lead takeaway="Every preview call is written down before puck drop and graded afterwards, never rewritten.">
    <div class="card explain">
      <p><strong>Previews</strong> are procedurally generated, looking out for a few things: two of a team’s traits meeting head on, a coach’s matching habit at home, a team playing unlike their usual selves, and a few more. Each prediction is saved as a checkable claim (meaning specific numbers that will clearly happen or not happen) and frozen at puck drop. When we change how calls are made or how the numbers behind them work, the previews of games already played are rebuilt with the current methods, using only the games before each one, so the Track record always grades today’s methods; what was really said before puck drop is kept on file. After the game, the same rule grades it from that game’s data: held, partly, or didn’t happen. The <a href={`${base}record/`}>Track record</a> keeps the season’s tally.</p>
      <p><strong>Report cards</strong> judge each player only against earlier games, so a card never changes. The scoresheet isn’t everything, and we want to know if a player fulfilled the responsibilities he normally shoulders for his team on a given night, AKA “doing his job.” We assigned jobs based on what a player is relied on for (power play, penalty kill, faceoffs) and what he’s better at than most other players. A player did his job when he had a typical night for him, not an average one: single games are lopsided, so most players fall short of their own average more often than not.</p>
      <p><strong>Swing</strong> puts each player’s night into one number: his scoresheet, his 5-on-5 play, his special teams, and the company he kept. It leans on 5-on-5 play over points, and leaves out hits and blocks, which mostly follow the score.</p>
      <p><strong>Run it back</strong> replays every regulation shot from the game at its expected-goal rating, exactly rather than by random draws, so the answer never changes. A flurry of rebounds counts as one chance. Played out shot by shot, the team with the better chances wins too often, because a team that’s ahead sits back while the other chases. So the share is corrected by how games with chances like these really ended over the last three seasons: replays that came out 85 to 15 read about 70 to 30.</p>
      <p><strong>No odds before games.</strong> We’ll tell you what to look out for when watching the game, never who to put money on.</p>
    </div>
  </Section>

  <Section id="limits" title="Blind spots" placeholder={false} lead takeaway="We don’t pretend to know this, because we use free data and free data won’t help us here.">
    <ul class="limits">
      <li><strong>Passes before a shot</strong> aren’t in public data, so expected goals can’t see a cross-ice pass. Goalies behind teams that allow those will look worse than they are.</li>
      <li><strong>Rush chances</strong> can’t be picked out from the league’s public data, which records too little between the blue lines. We tried approximating a “rush” shot based on timing, but those shots were inordinately few and somehow scored <em>less</em> than ordinary shots, which would make our information less accurate. Good rush counts come from real-person trackers and cameras we don’t pretend to have access to.</li>
      <li><strong>Defender positions</strong> aren’t tracked publicly, so breakdowns are inferred from dangerous chances within five seconds of a team losing the puck.</li>
      <li><strong>Which penalties a team takes</strong> is shown for one kind only: rough stuff (roughing, boarding, elbowing and the like). Over three seasons, a team’s hooking, slashing or tripping calls in half its games said almost nothing about the other half, so those counts are mostly bounces and we leave them out.</li>
      <li><strong>Why a player is out</strong> isn’t in the data. When a regular stops dressing, the site says he hasn’t played, never why.</li>
    </ul>
  </Section>
</Base>

<script is:inline>
  // Drag a puck: read the chance map, shade it for the chosen shot type, and say the chance under the puck.
  (async () => {
    const box = document.getElementById('try-xg');
    let g;
    try { g = await (await fetch(box.dataset.src)).json(); } catch { return; }
    box.hidden = false;
    const svg = document.getElementById('try-rink'), heat = document.getElementById('try-heat'), puck = document.getElementById('try-puck');
    const type = document.getElementById('try-type');
    const NS = 'http://www.w3.org/2000/svg';
    const words = { wrist: 'wrist shot', snap: 'snap shot', slap: 'slap shot', backhand: 'backhand', tip: 'tip or deflection' };
    // Rink drawing: the net at the top, seen from the shooter's side. x toward the net (89 at the goal line), y across.
    const toSvg = (x, y) => [42.5 - y, 11 + (g.net_x - x)];
    const fromSvg = (sx, sy) => [g.net_x - (sy - 11), 42.5 - sx];
    const cellOf = (x, y) => { const cx = Math.floor((x - g.x0) / g.cell), cy = Math.floor(Math.abs(y) / g.cell); return cx >= 0 && cx < g.nx && cy >= 0 && cy < g.ny ? [cx, cy] : null; };
    document.getElementById('try-n').textContent = `${g.shots.toLocaleString()} shots over ${g.seasons}`;
    const shade = () => {
      const rows = g.grid[type.value];
      heat.replaceChildren();
      rows.forEach((row, cy) => row.forEach((v, cx) => {
        if (v == null) return;
        [1, -1].forEach((side) => {
          const x0 = g.x0 + cx * g.cell, y0 = side * cy * g.cell, y1 = side * (cy + 1) * g.cell;
          const [ax, ay] = toSvg(x0 + g.cell, Math.max(y0, y1)), [bx, by] = toSvg(x0, Math.min(y0, y1));
          const r = document.createElementNS(NS, 'rect');
          r.setAttribute('x', Math.min(ax, bx).toFixed(2)); r.setAttribute('y', Math.min(ay, by).toFixed(2));
          r.setAttribute('width', Math.abs(bx - ax).toFixed(2)); r.setAttribute('height', Math.abs(by - ay).toFixed(2));
          r.setAttribute('class', 'try-cell'); r.style.setProperty('--v', Math.min(1, v / 30).toFixed(3));
          heat.append(r);
        });
      }));
      heat.setAttribute('clip-path', 'url(#try-clip)');
      heat.setAttribute('filter', 'url(#try-soft)');
      document.getElementById('try-avg').textContent = `The average ${words[type.value]} at 5-on-5 goes in ${g.types[type.value].avg}% of the time.`;
      read();
    };
    const clip = document.createElementNS(NS, 'clipPath'); clip.id = 'try-clip';
    const cp = document.createElementNS(NS, 'path'); cp.setAttribute('d', 'M0 75 V26 A26 26 0 0 1 26 0 H59 A26 26 0 0 1 85 26 V75 Z'); clip.append(cp);
    // A slight blur turns the squares into a smooth wash.
    const soft = document.createElementNS(NS, 'filter'); soft.id = 'try-soft'; soft.setAttribute('color-interpolation-filters', 'sRGB');
    const blur = document.createElementNS(NS, 'feGaussianBlur'); blur.setAttribute('stdDeviation', '1.1'); soft.append(blur);
    const defs = document.createElementNS(NS, 'defs'); defs.append(clip, soft); svg.prepend(defs);
    const read = () => {
      const [x, y] = fromSvg(+puck.getAttribute('cx'), +puck.getAttribute('cy'));
      const c = cellOf(x, y);
      const v = c ? g.grid[type.value][c[1]][c[0]] : null;
      document.getElementById('try-pct').textContent = v == null ? '–' : `${v < 1 ? '<1' : Math.round(v)}%`;
      const ft = Math.round(Math.hypot(x - g.net_x, y));
      document.getElementById('try-say').textContent = v == null ? 'Too few shots from here to say.' : x > g.net_x ? `A ${words[type.value]} from behind the goal line, ${ft} ft from the net.` : `Chance that a ${words[type.value]} from here, ${ft} ft out, goes in.`;
    };
    const move = (e) => {
      const pt = svg.createSVGPoint(); pt.x = e.clientX; pt.y = e.clientY;
      const p = pt.matrixTransform(svg.getScreenCTM().inverse());
      puck.setAttribute('cx', Math.max(1, Math.min(84, p.x)).toFixed(2));
      puck.setAttribute('cy', Math.max(1, Math.min(74, p.y)).toFixed(2));
      read();
    };
    let drag = false;
    svg.addEventListener('pointerdown', (e) => { drag = true; svg.setPointerCapture(e.pointerId); move(e); });
    svg.addEventListener('pointermove', (e) => { if (drag) move(e); });
    svg.addEventListener('pointerup', () => { drag = false; });
    puck.addEventListener('keydown', (e) => {
      const d = { ArrowUp: [0, -1.5], ArrowDown: [0, 1.5], ArrowLeft: [-1.5, 0], ArrowRight: [1.5, 0] }[e.key];
      if (!d) return;
      e.preventDefault();
      puck.setAttribute('cx', Math.max(1, Math.min(84, +puck.getAttribute('cx') + d[0])));
      puck.setAttribute('cy', Math.max(1, Math.min(74, +puck.getAttribute('cy') + d[1])));
      read();
    });
    type.addEventListener('change', shade);
    shade();
  })();

  // Arena counter: when it comes into view, both buildings count up to thirty recorded hits, then each slides to what
  // those thirty count as after the correction. Without motion the final numbers simply show.
  (() => {
    const box = document.querySelector('.arena-count');
    if (!box || !document.documentElement.classList.contains('motion') || !('IntersectionObserver' in window)) return;
    const tween = (el, a, b, ms, done) => { const t0 = performance.now(); const f = (t) => { const k = Math.min(1, (t - t0) / ms); el.textContent = String(Math.round(a + (b - a) * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(f); else done && done(); }; requestAnimationFrame(f); };
    const nums = [...box.querySelectorAll('strong')];
    nums.forEach((n) => { n.textContent = '0'; });
    box.classList.add('ac-wait');
    const io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const rec = nums.filter((n) => !n.dataset.from), adj = nums.filter((n) => n.dataset.from);
      rec.concat(adj).forEach((n) => { n.textContent = '0'; });
      rec.forEach((n) => tween(n, 0, +n.dataset.to, 900));
      adj.forEach((n) => tween(n, 0, 30, 900, () => setTimeout(() => { box.classList.remove('ac-wait'); tween(n, 30, +n.dataset.to, 900); }, 350)));
    }, { threshold: 0.6 });
    io.observe(box);
  })();

  // Watch a blend settle: the same arithmetic as the site's blending, for a made-up team on a real trait's settling speed.
  (() => {
    const sel = document.getElementById('st-trait'), slider = document.getElementById('st-games');
    if (!sel || !slider) return;
    const LAST = 82, lastV = 22, nowV = 78, avg = 50;
    const blend = document.querySelector('.st-blend'), whisk = document.querySelector('.st-whisk');
    const update = () => {
      const k = +sel.value, n = +slider.value;
      const prior = (LAST * lastV + k * avg) / (LAST + k);
      const v = (n * nowV + k * prior) / (n + k);
      const hw = 30 * Math.sqrt(k / (n + k));
      blend.style.left = `${v}%`;
      whisk.style.left = `${Math.max(0, v - hw)}%`; whisk.style.width = `${Math.min(100, v + hw) - Math.max(0, v - hw)}%`;
      document.getElementById('st-n').textContent = String(n);
      const now = n / (n + k), rest = 1 - now;
      const pc = (x) => `${Math.round(100 * x)}%`;
      document.getElementById('st-say').textContent = `After ${n} ${n === 1 ? 'game' : 'games'}, ${sel.selectedOptions[0].dataset.name} is ${pc(now)} this season, ${pc(rest * LAST / (LAST + k))} last season and ${pc(rest * k / (LAST + k))} league average. It settles halfway at ${Math.round(k)} games.`;
    };
    sel.addEventListener('change', update);
    slider.addEventListener('input', update);
    update();
  })();
</script>

<style is:global>
  .try { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--rule); }
  .try-pick { margin: 0 0 12px; }
  .try-body { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 18px 28px; align-items: center; }
  #try-rink { width: 100%; height: auto; display: block; touch-action: none; cursor: grab; user-select: none; }
  .try-cell { fill: var(--ink); fill-opacity: calc(var(--v) * 0.75); }
  .try-puck { fill: var(--ink); stroke: var(--sheet); stroke-width: 0.8; cursor: grab; outline: none; }
  .try-puck:focus-visible { stroke: var(--line-red); stroke-width: 1.2; }
  .explain .try .try-read p.try-big { margin: 0; font: 700 56px/1 var(--display); font-variation-settings: 'SOFT' 100; font-variant-numeric: tabular-nums; }
  .explain .try .try-read p.try-say { margin: 6px 0; font: 500 15px var(--ui); color: var(--ink-2); }
  @media (max-width: 640px) { .try-body { grid-template-columns: 1fr; } .try-big { font-size: 44px; } }

  .arena-count { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 6px 0 18px; }
  .ac { background: var(--ice); border-radius: 14px; padding: 14px 16px; }
  .ac-venue { margin: 0 0 6px; font: 600 14px var(--ui); display: grid; }
  .ac-venue span { font-weight: 400; font-size: 12px; color: var(--ink-3); }
  .ac-nums { display: flex; align-items: flex-end; gap: 14px; }
  .ac-nums p { margin: 0; display: grid; }
  .ac-nums strong { font: 700 36px/1 var(--display); font-variant-numeric: tabular-nums; }
  .ac-nums span { font: 500 12px var(--ui); color: var(--ink-3); }
  .ac-arrow { font: 400 22px var(--ui); color: var(--ink-3); padding-bottom: 14px; }
  .arena-count.ac-wait .ac-arrow { opacity: 0.25; }
  @media (max-width: 560px) { .arena-count { grid-template-columns: 1fr; } }

  .settle-try { margin: 6px 0 18px; padding: 16px; background: var(--ice); border-radius: 14px; }
  .st-lane { position: relative; height: 26px; margin: 16px 8px 4px; }
  .st-lane::before { content: ''; position: absolute; left: -8px; right: -8px; top: 12px; height: 2px; background: var(--track); }
  .st-avg { position: absolute; top: 4px; width: 1px; height: 18px; background: var(--ink-3); }
  .st-whisk { position: absolute; top: 10px; height: 6px; border-radius: 3px; background: color-mix(in oklab, var(--ink) 22%, var(--track)); }
  .st-last, .st-now, .st-blend { position: absolute; top: 6px; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; }
  .st-last { border: 2px dashed var(--ink-3); background: var(--ice); }
  .st-now { border: 2px solid var(--ink-2); background: var(--ice); }
  .st-blend { background: var(--ink); border: 2px solid var(--ice); top: 5px; width: 16px; height: 16px; margin-left: -8px; }
  html.motion .st-blend { transition: left 0.25s ease; } html.motion .st-whisk { transition: left 0.25s ease, width 0.25s ease; }
  .st-ends { display: flex; justify-content: space-between; font: 500 12px var(--ui); color: var(--ink-3); }
  .st-slide { display: grid; gap: 4px; margin-top: 14px; font: 500 14px var(--ui); color: var(--ink-2); }
  .st-slide input { width: 100%; accent-color: var(--ink); appearance: auto; border: 0; padding: 0; background: none; box-shadow: none; }
  .explain .settle-try p.st-say.st-say { margin: 10px 0 6px; font: 500 15px var(--ui); }
  .st-key i { display: inline-block; width: 11px; height: 11px; border-radius: 50%; margin: 0 5px 0 12px; vertical-align: -1px; }
  .st-key span { white-space: nowrap; }
  .st-key span:first-child i { margin-left: 0; }
  .st-key .k-last { border: 2px dashed var(--ink-3); } .st-key .k-now { border: 2px solid var(--ink-2); } .st-key .k-blend { background: var(--ink); }
</style>

