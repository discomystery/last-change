---
// Temporary comparison page: ways to style player names as links. Not linked from the site.
import Base from '../layouts/Base.astro';
const line = ['S. Aho', 'J. Martinook', 'J. Blake'];
const unit = [['C. McDavid', 'Trigger'], ['L. Draisaitl', 'Distributor'], ['V. Podkolzin', 'Net-front']];
const opts = [
  { id: 'a', name: 'A. Hairline underline', why: 'The same idea, much quieter: a thin, pale line set a little lower. It darkens when you point at it.' },
  { id: 'b', name: 'B. Nothing until you point', why: 'Names look like plain text. The underline only appears on hover or tap, so the page stays calm. The risk is people not realising names are clickable.' },
  { id: 'c', name: 'C. Small arrow', why: 'No underline. A small arrow after each name signals “this goes somewhere”, and nudges right on hover.' },
  { id: 'd', name: 'D. Soft tags', why: 'Each name sits in a pale rounded tag, like a name bar on a jersey. Very clearly tappable, and good on phones; a little heavier on the page.' },
  { id: 'e', name: 'E. Team colour', why: 'No underline. Names take their team’s colour, so the colour itself says “link”. Underline appears on hover.' },
  { id: 'now', name: 'What’s live now', why: 'For comparison.' },
];
---
<Base title="Player name styles">
  <h1 class="page-h">Ways to show that a player’s name is a link</h1>
  <p class="lede">The same line card and power-play list, six ways. Point at the names to see the hover.</p>
  {opts.map((o) => (
    <section class={`opt v-${o.id}`}>
      <h2>{o.name}</h2>
      <p class="why">{o.why}</p>
      <div class="pair">
        <div class="card t-CAR">
          <p class="top"><span class="lbl">L1</span><span class="chip">Shutdown</span></p>
          <p class="names">{line.map((n) => <a href="#" class="nm" onclick="return false">{n}</a>)}</p>
        </div>
        <div class="card t-EDM">
          <p class="top"><span class="lbl">PP1</span></p>
          <ul class="rows">{unit.map(([n, r]) => <li><a href="#" class="nm" onclick="return false">{n}</a><span class="chip">{r}</span></li>)}</ul>
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .page-h { font: 700 clamp(30px, 6vw, 44px) / 1.1 var(--display); margin-top: 24px; }
  .lede { color: var(--ink-2); margin-top: 8px; }
  .opt { margin-top: 44px; padding-top: 18px; border-top: 5px solid var(--line-blue); }
  .opt h2 { font: 700 24px/1.1 var(--display); }
  .why { font: 400 15px/1.45 var(--ui); color: var(--ink-2); margin-top: 6px; }
  .pair { display: grid; gap: 14px; margin-top: 16px; }
  @media (min-width: 720px) { .pair { grid-template-columns: 1fr 1fr; align-items: start; } }
  .top { display: flex; align-items: center; gap: 10px; }
  .lbl { font: 700 19px/1 var(--display); color: var(--team); }
  .names { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px 16px; font-weight: 600; }
  .rows { margin-top: 10px; display: grid; gap: 8px; }
  .rows li { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .nm { color: var(--ink); text-decoration: none; }

  .v-a .nm { text-decoration: underline; text-decoration-thickness: 1px; text-decoration-color: var(--ink-3); text-underline-offset: 5px; }
  .v-a .nm:hover { text-decoration-color: var(--ink); }

  .v-b .nm:hover, .v-b .nm:focus-visible { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }

  .v-c .nm::after { content: '›'; display: inline-block; margin-left: 5px; color: var(--ink-3); font-family: var(--ui); transition: transform 0.15s; }
  .v-c .nm:hover::after { transform: translateX(3px); color: var(--ink); }

  .v-d .nm { background: var(--ice); border-radius: 8px; padding: 3px 10px; }
  .v-d .names { gap: 6px 8px; }
  .v-d .nm:hover { background: var(--ink); color: var(--sheet); }

  .v-e .nm { color: var(--team); }
  .v-e .nm:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }

  .v-now .nm { text-decoration: underline; text-decoration-color: var(--ink-3); text-underline-offset: 3px; }
  .v-now .nm:hover { text-decoration-color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .v-c .nm::after { transition: none; } }
</style>
