---
// Player page. Skaters: role first, then what he does better or worse than others at his position, every rating,
// his shots, and NHL EDGE tracking. Goalies: role, the goalie card and where the shots he faces come from.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Portrait from '../../components/Portrait.astro';
import AreaMap from '../../components/AreaMap.astro';
import AreaShapes from '../../components/AreaShapes.astro';
import { AREA_NAME } from '../../lib/areaShapes';
import SectionNav from '../../components/SectionNav.astro';
import Pips from '../../components/Pips.astro';
import Marker from '../../components/Marker.astro';
import Histogram from '../../components/Histogram.astro';
import Rank from '../../components/Rank.astro';
import PlayerLoad from '../../components/PlayerLoad.astro';
import PlayerReport from '../../components/PlayerReport.astro';
import { cardsFor } from '../../lib/reportCards';
import Intro from '../../components/Intro.astro';
import { playerIntro, nextGame } from '../../lib/intros';
import teams from '../../../public/data/teams.json';
import goalieData from '../../../public/data/goalies.json';
import { clock, compared } from '../../lib/format';
import { teamPaint } from '../../lib/teams';
import { TRAITS, EDGE, GROUPS, groupWord, peerWord, peerOf, posWord, ordinal, most, standouts, roleTip, pkRoleWord, pkRoleTip, rankTag, rankTip, type Skater, type Mode, type Area } from '../../lib/players';
import { goalieTraitInfo } from '../../data/mock';
import rosterData from '../../../public/data/roster.json';
import { describe, type RosterPlayer } from '../../lib/roster';
import '../../styles/blocks.css';

export function getStaticPaths() {
  const files = import.meta.glob('../../../public/data/players/*.json', { eager: true, import: 'default' }) as Record<string, any>;
  return Object.entries(files).filter(([f]) => /\/\d+\.json$/.test(f)).map(([, p]) => ({ params: { id: String(p.id) }, props: { p } }));
}
const { p } = Astro.props as { p: any };
const base = import.meta.env.BASE_URL;
const index = Object.values(import.meta.glob('../../../public/data/players/index.json', { eager: true, import: 'default' }))[0] as { id: number }[];
const known = new Set(index.map((x) => x.id));
// Every percentile opens the skater rankings for that rating, with this player picked out.
const rankHref = (key: string, vs?: string) => `${base}players/rankings/?t=${key}&g=${vs ?? p.group}&p=${p.id}`;
const href = (id: number) => (known.has(id) ? `${base}player/${id}/` : undefined);
const team = teams.find((t) => t.abbr === p.team);
const intro = playerIntro(p.id);
const introNext = nextGame(intro?.game, base);
const modes: [Mode, string][] = [['blend', 'this season and last'], ['season', 'this season']];
// A rank tag is glued to the label's last word so it never drops onto a line of its own.
const headOf = (label: string) => label.slice(0, label.lastIndexOf(' ') + 1);
const lastOf = (label: string) => label.slice(label.lastIndexOf(' ') + 1);
const cap = (x: string) => x[0].toUpperCase() + x.slice(1);
const tough = (p: number) => (p > 55 ? `tougher than ${p}%` : p < 45 ? `easier than ${100 - p}%` : 'about average');
const asOf = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(p.generated_at));
const isG = p.group === 'G';
const s = p as Skater;
// A player his club holds who has not dressed this season (injured, in the minors): why, in the roster's words.
const unplayed = !!p.unplayed;
const listed = unplayed ? (((rosterData as any).teams[p.team] ?? []) as RosterPlayer[]).find((x) => x.id === p.id) : undefined;
const out = listed ? describe(listed) : { tag: '', tip: '', out: false };
const outTag = out.tag || 'Not playing yet';
const outTip = out.tip || 'With the club, but has not dressed for a game this season.';
const hasStats = Object.keys((p as any).stats ?? {}).length > 0;
const lastStats = (p as any).stats?.last as { gp: number; g: number; a: number; p: number; toi: number } | undefined;
const words = isG ? 'goalies' : groupWord[s.group];
const posName = posWord[p.pos] ?? p.pos;
const shoots = p.shoots === 'L' ? (isG ? 'Catches left' : 'Shoots left') : p.shoots === 'R' ? (isG ? 'Catches right' : 'Shoots right') : null;
const areaName = AREA_NAME;

// ---- Skater role sentences ----
const role = isG ? null : s.role;
const nameLink = (m: { id: number; name: string }) => ({ ...m, href: href(m.id) });
const unitWord = (label: string) => (label.endsWith('1') ? 'first' : 'second');
const games = (n: number) => `${n} ${n === 1 ? 'game' : 'games'}`;
// Penalty kill in one short line: how many of the team's recent kills he was in, then detail in grey.
const pkSpan = `over the last ${games(Math.min(role?.team_games ?? 0, 10))}`;
const pk = (() => {
  const k = role?.pk;
  if (!k || !k.kills) return { main: 'No kills in this stretch', more: [] as string[], tip: '' };
  if (!k.role) return { main: 'Rarely kills penalties', more: [`not a regular in ${k.kills} kills`], tip: `Not a regular in ${team?.place ?? p.team}’s ${k.kills} kills ${pkSpan}.` };
  const more = [`${clock(k.per_kill!)} a kill`];
  if (k.role === 'starter') { more.push(`starts ${k.starts}`); if (k.draw) more.push('takes the draw'); }
  if (k.role === 'second' && k.starts) more.push(`starts only ${k.starts}`);
  return { main: `${k.kills_in} of ${k.kills} kills`, more, tip: `On the ice for ${k.kills_in} of ${team?.place ?? p.team}’s ${k.kills} kills ${pkSpan}.` };
})();
let strengths: ReturnType<typeof standouts> | null = null;
const strengthsBy = isG || !s.traits ? null : Object.fromEntries(modes.map(([m]) => [m, standouts(s, m)])) as Record<Mode, ReturnType<typeof standouts>>;

// ---- Goalie ----
type GMode = { starts: number; games: number; shots: number; goals: number; gsax: number; gsax60: number | null; sv: number | null; sa60: number | null; danger: number | null; bd60: number | null; reb?: number | null; reb_exp?: number | null; gap: number | null; long_wait: number | null; qs: number | null; rbs: number | null; bins: number[]; tiers: Record<string, { shots: number; sv: number | null }>; pct: Record<string, number | null> };
const g = isG ? (p.goalie as { name: string; blend: GMode; season: GMode | null }) : null;
const sgn = (v: number) => (Math.abs(v) < 0.05 ? '0.0' : `${v > 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`);
const svp = (v: number | null) => (v === null ? '–' : v.toFixed(3).replace(/^0/, ''));
const gSay: Record<string, (x: GMode) => string> = {
  gsax: (x) => `${sgn(x.gsax)} goals saved above expected in ${x.starts} ${x.starts === 1 ? 'start' : 'starts'}`,
  rebounds: (x) => (x.reb == null ? '–' : `a rebound after ${x.reb} of every 100 saves, where the same saves usually give ${x.reb_exp}`),
  busy: (x) => `${x.sa60} shots faced per 60`,
  danger: (x) => (x.danger ? `the average shot he faces has a ${(100 * x.danger).toFixed(1)}% chance of going in` : '–'),
  breakdowns: (x) => `${x.bd60} defensive breakdowns in front of him per 60`,
  gaps: (x) => `a typical wait of ${x.gap} seconds between shots; ${x.long_wait}% come after three quiet minutes`,
  steady: (x) => `a quality start ${x.qs}% of the time`,
};
const goalieAreas = (mode: Mode) => {
  const raw = (p.shots_against?.[mode] ?? {}) as Record<string, { shots: number; goals: number; xg: number }>;
  const total = Object.values(raw).reduce((a, b) => a + b.shots, 0);
  return Object.fromEntries(Object.entries(raw).map(([k, v]) => [k, { shots: v.shots, goals: v.goals, share: total ? (100 * v.shots) / total : 0, avg: v.xg }])) as Record<string, Area>;
};
const shadeBy = (areas: Record<string, Area>) => {
  const top = Math.max(1, ...Object.values(areas).map((a) => a.share));
  return (a: Area) => Math.sqrt(a.share / top);
};
const nav = isG ? [['role', 'Role'], ['card', 'Goalie card'], ['faced', 'Shots faced']] : !s.traits ? [] : [['role', 'Role'], ...(p.carries ? [['carries', 'Carries']] : []), ...(cardsFor(p.id, p.team).length ? [['counted', 'Counted on'], ['recent', 'Recent games']] : []), ['standout', 'Stands out'], ['ratings', 'Ratings'], ['shots', 'Shots'], ['edge', 'Skating']]
// Season line: full words on wide screens, hockey's usual abbreviations on phones.
const cols: [string, string, string?][] = [['Games', 'GP'], ['Goals', 'G'], ['Assists', 'A'], ['Points', 'P'], ['Shots', 'SOG'], ['Ice time', 'TOI', 'Average ice time per game, all situations.']];
const statRow = (x: any) => (isG ? null : x);
---
<Base section="players" title={`${p.name} · ${p.team}`} description={`${p.name}: role, strengths and weak spots against other ${words}, shots and skating.`}>
  <AreaShapes />
  <div class="player" style={`--team:${teamPaint(p.team)}`}>
    {/* Name card: name, season line and stats on the left; his photo standing on the card's bottom edge (on phones,
        on the stats table's top line), with his jersey number faint behind it. */}
    <div class:list={['card', 'phead', (isG || !hasStats) && 'no-stats', unplayed && 'unplayed']}>
      {p.number !== null && <div class="pnum-box" aria-hidden="true"><span class="pnum">{p.number}</span></div>}
      <header class="team-top">
        <h1>{p.name}</h1>
        <p class="rec">{p.number !== null && `#${p.number} · `}{posName} · <a href={`${base}team/${p.team}/`}>{team?.name ?? p.team}</a></p>
      </header>
      <p class="pmeta">{[shoots, p.age ? `${p.age} years old` : null].filter(Boolean).join(' · ')}{unplayed && <>{(shoots || p.age) && <br />}<span class="pout">Hasn’t played this season <span class="chip tag pout-tag" tabindex="0" data-tip={outTip}>{outTag}</span></span></>}</p>
      {!isG && hasStats && (
        <div class="pstats-in">
          <table class="pstats">
            <thead><tr><th></th>{cols.map(([full, short, tip]) => <th>{tip ? <span class="term" tabindex="0" data-tip={tip}><span class="full">{full}</span><span class="short">{short}</span></span> : <><span class="full">{full}</span><abbr class="short" title={full}>{short}</abbr></>}</th>)}</tr></thead>
            <tbody>
              {([['season', 'This season'], ['last', 'Last season']] as const).map(([k, label]) => { const x = s.stats[k]; return x && <tr><th>{label}</th><td>{x.gp}</td><td>{x.g}</td><td>{x.a}</td><td>{x.p}</td><td>{x.sog}</td><td>{clock(x.toi)}</td></tr>; })}
            </tbody>
          </table>
        </div>
      )}
      <Portrait id={p.id} size={230} class="phead-photo" />
    </div>
    <Intro text={intro?.text ?? []} next={intro?.next} nextLabel={introNext.label} nextHref={introNext.href} colour={teamPaint(p.team)} class="pstory" />
    <SectionNav items={nav as [string, string][]} pinned />

    {!isG && !s.traits && (
      <Section id="role" title="Role" placeholder={false}>
        <div class="card prole">
          <dl class="rl">
            <div><dt>Status</dt><dd><p><span class="chip tag">{outTag}</span> {outTip}</p></dd></div>
          </dl>
        </div>
        <p class="note">He has not played in the NHL this season or last, so there is nothing to rate him on yet. His page fills in once he dresses.</p>
      </Section>
    )}

    {!isG && s.traits && (
      <>
        {!role && (
          <Section id="role" title="Role" placeholder={false} takeaway={`He hasn’t played for ${team?.place ?? p.team} this season.`} lead>
            <div class="card prole">
              <dl class="rl">
                <div><dt>Status</dt><dd><p><span class="chip tag">{outTag}</span> {outTip}</p></dd></div>
                {lastStats && <div><dt>Last season</dt><dd><p><strong>{lastStats.gp}</strong> games, {lastStats.g} goals and {lastStats.a} assists<span class="n"> · {clock(lastStats.toi)} a game</span></p></dd></div>}
              </dl>
            </div>
            <p class="note">Until he plays, his ratings below come from last season alone.</p>
          </Section>
        )}
        {role && (
        <Section id="role" title="Role" placeholder={false} takeaway={`Where he fits on ${team?.place ?? p.team} right now.`}>
          <div class="card prole">
            <dl class="rl">
              <div>
                <dt>Line</dt>
                <dd>
                  {role.line ? (
                    <>
                      <p><span class="chip tag" tabindex="0" data-tip={`${role.line.label}: ${s.group === 'D' ? 'pairs' : 'lines'} are picked by recent 5-on-5 time together, with the latest games counting most, and numbered by their players’ ice time. Taken from who has actually played together lately, not the announced lineup.`}>{role.line.label}</span> with {role.line.mates.map(nameLink).map((m, i) => <>{i > 0 && ' and '}{m.href ? <a class="plink" href={m.href}>{m.name}</a> : m.name}</>)}{role.line.toi_sec != null && <span class="n"> · {clock(role.line.toi_sec)} a game together</span>}</p>
                    </>
                  ) : (
                    <p>Not part of one of the team’s usual {s.group === 'D' ? 'pairs' : 'lines'} over the last {Math.min(role.team_games, 10)} games{role.gp !== undefined ? `; has played ${role.gp} of the team’s ${role.team_games} games this season` : ''}.</p>
                  )}
                </dd>
              </div>
              <div>
                <dt>Power play</dt>
                <dd>
                  {role.pp ? (
                    <p><span class="chip tag" tabindex="0" data-tip={`The ${unitWord(role.pp.label)} power-play unit.`}>{role.pp.label}</span>{role.pp.role && <> <span class="chip tag" tabindex="0" data-tip={roleTip[role.pp.role]}>{role.pp.role}</span></>}{role.pp.both && <span class="n"> · often stays on for the second unit</span>}</p>
                  ) : <p>Not on either unit</p>}
                  {role.faceoff && <p class="n">{role.faceoff}</p>}
                  {role.pp && s.moved_from && !role.pp.role && <p class="n">Power-play role tags count only games with his current team, and he has too few power-play shots with {team?.place ?? p.team} yet to earn one.</p>}
                </dd>
              </div>
              <div>
                <dt>Penalty kill</dt>
                <dd><p>{role.pk?.role && <><span class="chip tag" tabindex="0" data-tip={pkRoleTip[role.pk.role]}>{pkRoleWord[role.pk.role]}</span> </>}<span class:list={{ term: !!pk.tip }} tabindex={pk.tip ? 0 : undefined} data-tip={pk.tip || undefined}>{pk.main}</span>{pk.more.length > 0 && <span class="n"> · {pk.more.join(' · ')}</span>}</p></dd>
              </div>
              {role.toi && (
                <div>
                  <dt>Ice time</dt>
                  <dd>
                    <p><strong>{clock(role.toi.toi)}</strong> a game{role.toi_rank !== undefined && role.toi_of !== undefined && role.toi_of > 1 && <>, <span class="term" tabindex="0" data-tip={`Among the ${role.toi_of} ${team?.place ?? p.team} ${groupWord[s.group]} who have played at least half the games.`}>{most(role.toi_rank)} among {team?.place ?? p.team} {groupWord[s.group]}</span></>}<span class="n"> · {[`${clock(role.toi.toi5)} 5-on-5`, role.toi.toi_pp >= 15 && `${clock(role.toi.toi_pp)} PP`, role.toi.toi_pk >= 15 && `${clock(role.toi.toi_pk)} PK`].filter(Boolean).join(' · ')}</span></p>
                  </dd>
                </div>
              )}
              {s.competition && (
                <div>
                  <dt>Competition</dt>
                  <dd>
                    {modes.map(([m, mw]) => {
                      const c = s.competition![m];
                      if (!c?.all) return null;
                      const split = [c.home && `${tough(c.home.pct)} at home, where his coach has the last change`, c.road && `${tough(c.road.pct)} on the road`].filter(Boolean);
                      // Home and road in grey: just the percentage when it reads from the same side as the main line.
                      const side = (q: number) => (q > 55 ? 1 : q < 45 ? -1 : 0);
                      const short = (q: number) => (side(q) !== 0 && side(q) === side(c.all!.pct) ? `${side(q) > 0 ? q : 100 - q}%` : tough(q));
                      const hr = [c.home && `home ${short(c.home.pct)}`, c.road && `road ${short(c.road.pct)}`].filter(Boolean);
                      return (
                        <div class={`gmode m-${m}`}>
                          <p>{compared(c.all.pct, 'tougher opponents than', 'easier opponents than', groupWord[s.group])} <Marker pct={c.all.pct} tip={`How dangerous the opponents he faces at 5-on-5 are, ${mw}${split.length ? `: ${split.join('; ')}` : ''}. Not good or bad in itself; it is the job he is given, and his “Creating chances” and “Preventing chances” ratings already account for it.`} />{hr.length > 0 && <span class="n"> · {hr.join(', ')}</span>}</p>
                        </div>
                      );
                    })}
                  </dd>
                </div>
              )}
            </dl>
          </div>
          {role.notes.length > 0 && (
            <div class="card worth"><p class="mini-h">What’s changed</p><ul>{role.notes.map((n) => <li>{n}</li>)}</ul></div>
          )}
        </Section>
        )}

        <PlayerLoad p={p} place={team?.place ?? p.team} moved={(p as Skater).moved_from ? (teams.find((t) => t.abbr === (p as Skater).moved_from)?.place ?? (p as Skater).moved_from) : undefined} />
        <PlayerReport p={p} place={team?.place ?? p.team} />

        <Section id="standout" title="Where he stands out" placeholder={false} takeaway="What he does better or worse than most players at his position.">
          <Fragment slot="explain">{modes.map(([m, mw]) => <p class={`note m-${m}`}>Listed only when we can be confident he is above or below average. Numbers from {mw}, through {asOf}. Compared with {groupWord[s.group]} who have played at least {m === 'blend' ? 20 : 3} games{m === 'blend' ? ' over the two seasons' : ''}.</p>)}</Fragment>
          {modes.map(([m, mw]) => {
            const x = strengthsBy![m];
            const say = (it: (typeof x.best)[number]) => it.est?.raw !== undefined
              ? <><span class="a-adj">{it.info.short(it.est.index ?? 100)}</span><span class="a-raw">{it.info.rawShort!(it.est.raw!)}</span></>
              : <>{it.info.short(it.v)}</>;
            const tagOf = (it: (typeof x.best)[number]) => rankTag(it.rank) && <span class="rk" tabindex="0" data-tip={rankTip(it.rank!, it.of, it.info.label, it.vs)}>{rankTag(it.rank)}</span>;
            const cmpTip = (it: (typeof x.best)[number], lower = false) => it.edge ? compared(it.pct, it.info.up ?? 'more than', it.info.down ?? 'less than', it.vs, lower) : compared(it.pct, 'better than', 'behind', it.vs, lower);
            const cmpOf = (it: (typeof x.best)[number]) => it.est?.raw !== undefined
              ? <><span class="a-adj">{cmpTip(it, true)}</span><span class="a-raw">{compared(it.est.raw_pct!, 'more than', 'fewer than', it.vs, true)}</span></>
              : <>{cmpTip(it, true)}</>;
            if (unplayed && m === 'season') return <div class="gmode m-season"><p class="note">He hasn’t played this season. Pick “Blended” in the settings to see what he did last season.</p></div>;
            return (
              <div class={`gmode m-${m}`}>
                <div class="two sw">
                  <div class="card">
                    <p class="mini-h">Better than most at his position</p>
                    {x.best.length ? <ul class="swl">{x.best.map((it) => <li><p class="sw-h"><span class="term" tabindex="0" data-tip={it.info.tip}>{headOf(it.info.label)}<span class="nw">{lastOf(it.info.label)}{tagOf(it)}</span></span><Pips pct={it.pct} tip={`${cmpTip(it)}.`} /></p><p class="sw-l"><span>{say(it)}</span><em>{cmpOf(it)}</em></p></li>)}</ul>
                      : <p class="n">Nothing yet where we can be confident he is above most {groupWord[s.group]}.</p>}
                  </div>
                  <div class="card">
                    <p class="mini-h">Behind most at his position</p>
                    {x.worst.length ? <ul class="swl">{x.worst.map((it) => <li><p class="sw-h"><span><span class="term" tabindex="0" data-tip={it.info.tip}>{it.info.label}</span></span><Pips pct={it.pct} tip={`${cmpTip(it)}.`} /></p><p class="sw-l"><span>{say(it)}</span><em>{cmpOf(it)}</em></p></li>)}</ul>
                      : <p class="n">Nothing yet where we can be confident he is below most {groupWord[s.group]}.</p>}
                  </div>
                </div>
              </div>
            );
          })}
        </Section>

        <Section id="ratings" title="All ratings" placeholder={false} takeaway={`Every rating, against other ${groupWord[s.group]}.`}>
          <Fragment slot="explain">
            {unplayed
              ? <p class="note m-blend">He hasn’t played this season, so these come from last season’s {s.games_last} games alone, pulled toward the average {s.group === 'D' ? 'defenseman' : 'forward'} by an amount that depends on how quickly each rating settles.</p>
              : <p class="note m-blend">This season’s {s.games} {s.games === 1 ? 'game' : 'games'} blended with last season’s {s.games_last}, and pulled toward the average {s.group === 'D' ? 'defenseman' : 'forward'} by an amount that depends on how quickly each rating settles.</p>}
            {s.moved_from && <p class="note m-blend">He played for {(teams.find((t) => t.abbr === s.moved_from)?.name) ?? s.moved_from} last season. Habits that travel with a player (shooting, hitting, penalties) still use that season in full; setting up goals, finishing, faceoffs and power-play chances depend more on linemates and role, so they lean on it less. We measured how much each one carries over for players who change teams.</p>}
            {s.group === 'F' && <p class="note">Shooting volume, creating his own chances, shot blocking, hardest shot and distance skated compare {s.sub === 'C' ? 'centers with centers' : 'wingers with wingers'}, because centers and wingers really differ there. Everything else compares all forwards.</p>}
            {unplayed
              ? <p class="note m-season">He hasn’t played this season, so there is nothing to rate yet. The gray dots show last season.</p>
              : <p class="note m-season">This season’s {s.games} {s.games === 1 ? 'game' : 'games'} only, pulled toward the average {s.group === 'D' ? 'defenseman' : 'forward'}. Expect wide ranges this early.</p>}
            <p class="note">Hitting, shot blocking and takeaways are arena-adjusted scores (100 is the average {s.group === 'D' ? 'defenseman' : 'forward'}); switch “Adjusted stats” to Recorded in the settings to see the numbers as recorded. <a href={`${base}methods/#players`}>How the ratings work</a>.</p>
          </Fragment>
          <div class="key"><span class="one"><i></i>{p.name}</span><span class="avg">Average {s.group === 'D' ? 'defenseman' : 'forward'}</span><span class="rng">Likely range</span></div>
          {GROUPS.map((grp) => (
            <>
              <h3 class="sub">{grp}</h3>
              <ul class="fpgrid">
                {Object.entries(TRAITS).filter(([, t]) => t.group === grp).filter(([k]) => s.traits[k]).map(([k, t]) => {
                  const e = s.traits[k];
                  // No games this season (or no this-season rating): the season lane keeps last season's dot, greyed.
                  const cur = unplayed || !e.season ? e.blend : e.season;
                  return (
                    <li class:list={['card', 'fpc', 'mini', { thin: !e.blend.ok && !e.season?.ok }]}>
                      <span class="fpc-name"><span class="term" tabindex="0" data-tip={t.tip}>{headOf(t.label)}<span class="nw">{lastOf(t.label)}{modes.map(([m]) => { const x = e[m]; const tag = x && rankTag(x.rank, x.ok); return tag && <a class={`rk rk-${m}`} href={rankHref(k, x.vs)} data-tip={rankTip(x.rank, x.of, t.label, peerOf(k, x.vs ?? s.group))}>{tag}</a>; })}</span></span></span>
                      <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
                      <div class="lanes"><div class:list={['lane', { noseason: cur !== e.season }]} style={`--b:${e.blend.pct};--blo:${e.blend.lo};--bhi:${e.blend.hi};--c:${cur.pct};--clo:${cur.lo};--chi:${cur.hi}`}><span class="whisk"></span><span class="dot"></span></div></div>
                      {modes.map(([m]) => (
                        <p class={`fpc-line m-${m}`}>
                          {m === 'season' && cur !== e.season ? <span class="n">{unplayed ? 'No games this season' : 'Not rated this season'}</span> : e[m].raw === undefined
                            ? <><span tabindex="0" data-tip={`${cap(t.say(e[m].v))}.`}>{t.short(e[m].v)}</span><Rank href={rankHref(k, e[m].vs)} ok={e[m].ok} pct={e[m].pct} words={compared(e[m].pct, 'better than', 'behind', peerOf(k, e[m].vs ?? s.group))} /></>
                            : <><span class="a-adj" tabindex="0" data-tip={`${cap(t.say(e[m].index ?? 100))}.`}>{t.short(e[m].index ?? 100)}</span><Rank href={rankHref(k, e[m].vs)} ok={e[m].ok} pct={e[m].pct} words={compared(e[m].pct, 'better than', 'behind', peerOf(k, e[m].vs ?? s.group))} class='a-adj' />
                                <span class="a-raw" tabindex="0" data-tip={`${cap(t.raw!(e[m].raw!))}.`}>{t.rawShort!(e[m].raw!)}</span><Rank href={rankHref(k, e[m].vs)} ok={e[m].ok} pct={e[m].raw_pct!} words={compared(e[m].raw_pct!, 'more than', 'fewer than', peerOf(k, e[m].vs ?? s.group))} class='a-raw' /></>}
                        </p>
                      ))}
                    </li>
                  );
                })}
              </ul>
            </>
          ))}
        </Section>

        <Section id="shots" title="Shots" placeholder={false} takeaway="Where his shots come from, and how his misses miss.">
          <Fragment slot="explain">
            <p class="note">The NHL’s game data records how a shot missed, but not where in the net a goal or save went (glove side, blocker, five-hole). That needs paid camera tracking, so we don’t show it.</p>
          </Fragment>
          <div class="pick"><span>Show</span>
            <select class="map-pick" aria-label="Map view"><option value="areas">where his shots come from</option><option value="dots">every shot, goals in black</option></select>
          </div>
          <div class="st2">
            <div class="card">
              {modes.map(([m, mw]) => {
                const a = s.areas[m];
                const shade = shadeBy(a.areas);
                return (
                  <div class={`gmode m-${m}`}>
                    <AreaMap id={`am-${m}`} areas={a.areas} shots={s.shots}
                      tip={(k, x) => x ? `${areaName[k]}: ${x.shots} ${x.shots === 1 ? 'shot' : 'shots'}, ${x.goals} ${x.goals === 1 ? 'goal' : 'goals'}. ${Math.round(x.share)}% of his shots come from here; the average ${s.group === 'D' ? 'defenseman' : 'forward'} takes ${Math.round(x.avg)}% from here.` : areaName[k]}
                      label={(x) => String(x.shots)} shade={shade} />
                    <p class="n mapcap">{a.n} unblocked shots, {mw}, from his point of view. {a.areas.outside.shots > 0 && `${a.areas.outside.shots} more from outside the zone.`} Empty nets left out.</p>
                  </div>
                );
              })}
            </div>
            <div class="card">
              <p class="chart-title">How his misses miss</p>
              {modes.map(([m]) => {
                const x = s.misses[m];
                // The net frame, from his point of view: each kind of miss is a puck where it went (wide of either post,
                // over the bar, off the iron, short), sized by count, flying in from his spot below the net. The inside
                // of the net stays empty: the data never says where a goal or save went.
                const fx = 120, fy = 50, fw = 120, fh = 80;
                const spots = x ? [
                  { k: 'Wide left', n: x.left, x: 60, y: 92, lab: 'below' },
                  { k: 'Wide right', n: x.right, x: 300, y: 92, lab: 'below' },
                  { k: 'Over the net', n: x.high, x: 180, y: 22, lab: 'left' },
                  { k: 'Off the post or crossbar', n: x.post, x: fx + fw, y: fy, lab: 'right' },
                  { k: 'Short or other', n: x.short + x.other, x: 180, y: 166, lab: 'below' },
                ] : [];
                const r = (n: number) => +(5 + Math.sqrt(n) * 2.6).toFixed(1);
                return (
                  <div class={`gmode m-${m}`}>
                    {x && x.n > 0 ? (
                      <>
                        <svg class="netf" viewBox="0 0 360 206" role="img" aria-label={`${x.n} missed shots: ${spots.map((o) => `${o.k.toLowerCase()} ${o.n}`).join(', ')}`}>
                          <line class="nf-goal" x1="16" x2="344" y1={fy + fh + 3} y2={fy + fh + 3} />
                          {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((i) => <line class="nf-mesh" x1={fx + i * 12} x2={fx + i * 12} y1={fy + 3} y2={fy + fh} />)}
                          {[1, 2, 3, 4, 5, 6].map((i) => <line class="nf-mesh" x1={fx + 3} x2={fx + fw - 3} y1={fy + i * 12} y2={fy + i * 12} />)}
                          <path class="nf-frame" d={`M${fx} ${fy + fh} V${fy} H${fx + fw} V${fy + fh}`} />
                          {spots.map((o, i) => {
                            const R = r(o.n);
                            const L = o.lab === 'below' ? { x: o.x, y: o.y + R + 15, a: 'middle' } : o.lab === 'left' ? { x: o.x - R - 8, y: o.y + 4, a: 'end' } : { x: o.x + R + 8, y: o.y + 4, a: 'start' };
                            return (
                              <g class="nf-spot" tabindex="0" data-tip={`${o.k}: ${o.n} of his ${x.n} missed shots.`} style={`--i:${i};--dx:${180 - o.x}px;--dy:${200 - o.y}px`}>
                                <circle class:list={['nf-puck', { none: o.n === 0 }]} cx={o.x} cy={o.y} r={R} />
                                <text class:list={['nf-n', { small: R < 12 }]} x={o.x} y={o.y + (R < 12 ? 3.8 : 4.6)}>{o.n}</text>
                                <text class="nf-lab" x={L.x} y={L.y} text-anchor={L.a}>{o.k === 'Off the post or crossbar' ? 'Off the iron' : o.k}</text>
                              </g>
                            );
                          })}
                        </svg>
                        <p class="n">{x.n} missed shots, from his point of view: “wide left” is to his left. Pucks are sized by count.</p>
                      </>
                    ) : <p class="n">No missed shots yet.</p>}
                  </div>
                );
              })}
            </div>
          </div>
        </Section>

        <Section id="edge" title="Skating and shot" placeholder={false} takeaway={`Speed, bursts, shot power and where he spends his shifts, from the NHL’s own tracking (NHL EDGE).`}>
          <Fragment slot="explain">
            {s.edge && <p class="note">Top speed and hardest shot are his best single moments{' '}<span class="inl m-blend">over this season and last</span><span class="inl m-season">this season</span>; bursts and distance are per 60 minutes of his ice time. Tracking data: NHL EDGE.</p>}
          </Fragment>
          {s.edge ? (
            <>
              <ul class="fpgrid">
                {Object.entries(EDGE).map(([k, t]) => {
                  const b = s.edge!.blend?.[k], c = s.edge!.season?.[k];
                  if (!b && !c) return null;
                  const bp = b?.pct ?? 50, cp = c?.pct ?? 50;
                  return (
                    <li class:list={['card', 'fpc', 'mini', { thin: !(b?.ok || c?.ok) }]}>
                      <span class="fpc-name"><span class="term" tabindex="0" data-tip={t.tip}>{headOf(t.label)}<span class="nw">{lastOf(t.label)}{modes.map(([m]) => { const e = s.edge![m]?.[k]; const tag = rankTag(e?.rank, e?.ok); return tag && <a class={`rk rk-${m}`} href={rankHref(k, e!.vs)} data-tip={rankTip(e!.rank!, e!.of, t.label, peerWord[e!.vs ?? s.group])}>{tag}</a>; })}</span></span></span>
                      <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
                      <div class="lanes"><div class="lane" style={`--b:${bp};--blo:${bp};--bhi:${bp};--c:${cp};--clo:${cp};--chi:${cp}`}><span class="whisk"></span><span class="dot"></span></div></div>
                      {modes.map(([m]) => { const e = s.edge![m]?.[k]; return (
                        <p class={`fpc-line m-${m}`}>{e ? <><span tabindex="0" data-tip={`${cap(t.say(e.v))}.`}>{t.short(e.v)}</span><Rank href={rankHref(k, e.vs)} ok={e.ok} pct={e.pct} words={compared(e.pct, t.up ?? 'more than', t.down ?? 'less than', peerWord[e.vs ?? s.group])} /></> : <span class="n">No tracking data yet.</span>}</p>
                      ); })}
                    </li>
                  );
                })}
              </ul>
            </>
          ) : <p class="note">No NHL EDGE tracking data for him yet.</p>}
        </Section>
      </>
    )}

    {isG && g && (
      <>
        <Section id="role" title="Role" placeholder={false} takeaway={`How much ${team?.place ?? p.team} leans on him.`}>
          <div class="card prole">
            <dl class="rl">
              {g.season
                ? <div><dt>This season</dt><dd><p>Started <strong>{g.season.starts}</strong> of the team’s {p.team_games} games{p.team_games ? ` (${Math.round((100 * g.season.starts) / p.team_games)}%)` : ''}.</p></dd></div>
                : <div><dt>This season</dt><dd><p><span class="chip tag">{outTag}</span> {outTip}</p></dd></div>}
              <div><dt>Over two seasons</dt><dd><p>{g.blend.starts} starts and {g.blend.shots} shots faced, this season and last.</p></dd></div>
            </dl>
          </div>
        </Section>
        <Section id="card" title="Goalie card" placeholder={false} takeaway="Is he stopping more than he should, and what is his team asking him to face?">
          <Fragment slot="explain">
            <p class="note">Ratings compare him with goalies who have at least {goalieData.min_starts.blend} starts over two seasons, or {goalieData.min_starts.season} this season. Expected-goal models can’t see passes before a shot, so a goalie whose team gives up a lot of cross-ice passes will look worse here than he really is.</p>
          </Fragment>
          {modes.map(([m, mw]) => {
            const x = g[m];
            if (!x) return <div class={`gmode m-${m}`}><p class="note">He hasn’t played this season. Pick “Blended” in the settings to see last season.</p></div>;
            const few = x.pct.gsax === null;
            return (
              <div class={`gmode m-${m}`}>
                <div class="g2">
                  <div class="card gcard">
                    <p class="gname"><span>{p.name}</span><span class="n">{x.starts} {x.starts === 1 ? 'start' : 'starts'} · {x.shots} shots faced, {mw}</span></p>
                    <p class="gbig"><strong>{sgn(x.gsax)}</strong> <span class="term" tabindex="0" data-tip="Goals saved above expected: how many goals he has prevented compared with an average goalie facing the same shots. Positive is good.">goals saved above expected</span> {few ? <span class="n">too few starts to rate</span> : <Pips pct={x.pct.gsax!} tip={`Stopping more than expected, per 60, pulled toward average until he has faced enough shots: ${compared(x.pct.gsax!, 'better than', 'worse than', 'goalies', true)}.`} />}</p>
                    <dl class="gkv">
                      {(['low', 'medium', 'high'] as const).map((t) => <div><dt>{t[0].toUpperCase() + t.slice(1)}-danger save %</dt><dd>{svp(x.tiers[t].sv)} <span class="n">{x.tiers[t].shots} shots</span></dd></div>)}
                      <div><dt>Overall save %</dt><dd>{svp(x.sv)}</dd></div>
                      <div><dt><span class="term" tabindex="0" data-tip="Shots on goal he faces per 60.">Shots faced per 60</span></dt><dd>{x.sa60 ?? '–'} {!few && <Marker pct={x.pct.busy!} tip={`${compared(x.pct.busy!, 'busier than', 'quieter than', 'goalies')}.`} />}</dd></div>
                      <div><dt><span class="term" tabindex="0" data-tip="Share of starts where he gave his team a fair chance to win: a save percentage at or above league average, or at least .885 on a light night.">Quality starts</span></dt><dd>{x.qs === null ? '–' : `${x.qs}%`} {!few && <Pips pct={x.pct.steady!} tip={`${compared(x.pct.steady!, 'steadier than', 'streakier than', 'goalies')}.`} />}</dd></div>
                    </dl>
                  </div>
                  <div class="card gmid">
                    <p class="chart-title">Night to night</p>
                    <p class="n gn-say">His starts by goals saved above expected: rough nights (more than a goal below), about what was expected, and strong nights (a goal or more above).</p>
                    <Histogram wide team="one" bins={x.bins.map((n, k) => ({ lo: k - 3, n }))} name={p.name} />
                  </div>
                </div>
                <ul class="fpgrid gtraits">
                  {goalieTraitInfo.map((t) => (
                    <li class="card fpc">
                      <span class="term fpc-name" role="heading" aria-level="3" tabindex="0" data-tip={t.tip}>{t.label}</span>
                      <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
                      <div class="lanes">{x.pct[t.key] !== null ? <div class="lane" style={`--b:${x.pct[t.key]};--blo:${x.pct[t.key]};--bhi:${x.pct[t.key]};--c:${x.pct[t.key]};--clo:${x.pct[t.key]};--chi:${x.pct[t.key]}`}><span class="whisk"></span><span class="dot"></span></div> : <div class="lane empty"></div>}</div>
                      <p class="gline"><span>{gSay[t.key](x)}</span>{x.pct[t.key] === null && <em>too few starts to place him</em>}</p>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </Section>
        <Section id="faced" title="Shots he faces" placeholder={false} takeaway="Where the shots on goal against him come from, seen from the shooter’s side.">
          <div class="st2">
            {modes.map(([m, mw]) => {
              const a = goalieAreas(m);
              const shade = shadeBy(a);
              return (
                <div class={`card gmode m-${m}`}>
                  <AreaMap id={`gm-${m}`} areas={a}
                    tip={(k, x) => x ? `${areaName[k]}: ${x.shots} shots on goal, ${x.goals} ${x.goals === 1 ? 'goal' : 'goals'} (${x.shots ? svp((x.shots - x.goals) / x.shots) : '–'} save %). An average goalie would have allowed ${x.avg.toFixed(1)}.` : areaName[k]}
                    label={(x) => String(x.shots)} shade={shade} />
                  <p class="n mapcap">Shots on goal against him, {mw}. Point at an area for goals and save %.</p>
                </div>
              );
            })}
          </div>
        </Section>
      </>
    )}
  </div>
</Base>

<script is:inline>
  // Name card: his sweater number spins up like a scoreboard and lands, while the stats count up to their totals.
  // Motion only; the number and stats are already on the page if this never runs. The real number stays where it is,
  // hidden, while one rolling column sits exactly over each of its digits (same spot, same width, same baseline), so
  // the number neither moves nor changes its spacing when the roll is swapped back for the plain text.
  (() => {
    const root = document.documentElement;
    const pn = document.querySelector('.phead .pnum');
    if (!root.classList.contains('motion') || !pn) return;
    const num = pn.textContent.trim();
    const text = pn.firstChild;
    if (!/^\d+$/.test(num) || !text || text.nodeType !== 3) return;
    const cells = [...document.querySelectorAll('.phead .pstats tbody td')].filter((td) => /^\d+$/.test(td.textContent.trim()));
    const final = cells.map((td) => +td.textContent.trim());
    pn.style.visibility = 'hidden';
    cells.forEach((td) => { td.textContent = '0'; });
    // Digits are measured once the display font is in, or the columns would sit where the fallback font put them.
    // This script runs before the font has even been asked for, so ask for it by name rather than trusting fonts.ready.
    // (The computed `font` shorthand comes back empty here because of the variation settings, so it is spelled out.)
    const cs = getComputedStyle(pn);
    const fonts = document.fonts ? document.fonts.load(`${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`, num).then(() => document.fonts.ready) : Promise.resolve();
    fonts.catch(() => {}).then(() => {
      const box = pn.getBoundingClientRect();
      const start = text.textContent.indexOf(num);
      const range = document.createRange();
      const at = [...num].map((_, i) => { range.setStart(text, start + i); range.setEnd(text, start + i + 1); return range.getBoundingClientRect(); });
      const roll = document.createElement('span');
      roll.style.cssText = 'position:absolute;inset:0;visibility:visible;letter-spacing:0';
      let longest = 0;
      const cols = [...num].map((d, i) => {
        // A window one line tall over the digit, clipped top and bottom only, so wider digits rolling past are not cut.
        const w = document.createElement('span');
        w.style.cssText = `position:absolute;top:0;height:1em;left:${at[i].left - box.left}px;width:${at[i].width}px;clip-path:inset(0 -1em);line-height:1`;
        const c = document.createElement('span');
        c.style.cssText = 'display:block;transition:transform 1.2s cubic-bezier(0.2, 0.75, 0.2, 1)';
        const loops = 1 + i;
        for (let l = 0; l <= loops; l++) for (let k = 0; k < 10; k++) { const s = document.createElement('span'); s.textContent = k; s.style.cssText = 'display:block;height:1em;white-space:nowrap'; c.append(s); }
        const dur = 1.1 + i * 0.35;
        longest = Math.max(longest, dur);
        c.style.transitionDuration = dur + 's';
        c.dataset.to = String(loops * 10 + +d);
        w.append(c);
        roll.append(w);
        return c;
      });
      pn.append(roll);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        cols.forEach((c) => { c.style.transform = `translateY(-${c.dataset.to}em)`; });
        const t0 = performance.now();
        const step = (t) => {
          const k = Math.min(1, (t - t0) / 1300);
          const e = 1 - Math.pow(1 - k, 3);
          cells.forEach((td, i) => { td.textContent = String(Math.round(final[i] * e)); });
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
        setTimeout(() => { roll.remove(); pn.style.visibility = ''; }, longest * 1000 + 100);
      }));
    });
  })();
</script>

<script>
  document.querySelectorAll<HTMLSelectElement>('.map-pick').forEach((sel) => {
    const apply = () => document.querySelectorAll('.areamap').forEach((m) => m.classList.toggle('dots', sel.value === 'dots'));
    sel.addEventListener('change', apply);
    apply();
  });
</script>

<style>
  /* The header stands on a rule like a section heading's; his photo stands on the same rule at the right. */
  .phead { position: relative; overflow: hidden; margin-top: 22px; padding: 0 24px 0 28px; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: 16px; isolation: isolate; }
  /* Everything else in the card sits on a layer above the number. Explicit, rather than a negative z-index on the
     number, because Safari can lift the rolling digits (moving, clipped layers) above content when they sit below zero. */
  .phead > :not(.pnum-box), .phead .team-top > * { position: relative; z-index: 1; }
  /* The number's frame covers the card down to the stats table's top line on phones (the whole card on computers),
     so the number stands on the same line as the photo and never runs into the table. Only its foot is clipped. */
  .phead .pnum-box { position: relative; z-index: 0; grid-column: 1 / -1; grid-row: 1 / 4; align-self: stretch; margin: 0 -24px 0 -28px; clip-path: inset(-100vh -100vw 0 -100vw); pointer-events: none; }
  /* Painted under everything else in the card but above its background, big enough to fill the card's right side,
     its foot cut off by the bottom of its frame. */
  .phead .pnum { position: absolute; z-index: 0; right: 8px; bottom: -118px; font: 700 440px/1 var(--display); font-variation-settings: 'SOFT' 100, 'WONK' 0; letter-spacing: -0.04em; white-space: nowrap; color: color-mix(in oklab, var(--team) 20%, var(--sheet)); pointer-events: none; user-select: none; }
  .phead .team-top { grid-column: 1; grid-row: 1; margin-top: 26px; }
  .phead .pmeta { grid-column: 1; grid-row: 2; }
  .pstats-in { grid-column: 1; grid-row: 3; margin: 22px 0 16px; }
  .phead.no-stats .pmeta { padding-bottom: 26px; }
  .phead :global(.phead-photo) { grid-column: 2; grid-row: 1 / 4; width: 290px; height: 290px; margin-right: 18px; }
  .phead.no-stats :global(.phead-photo) { width: 210px; height: 210px; }
  .phead.no-stats .pnum { font-size: 340px; bottom: -88px; }
  @media (max-width: 719px) {
    /* Phones: the name runs the full width over the number; the photo stands on the stats table's top line. */
    .phead { padding: 0 16px; column-gap: 8px; grid-template-rows: auto 1fr auto auto; } /* the photo's extra height goes above the team line */
    .phead .pnum-box { margin: 0 -16px; }
    .phead .pnum { font-size: 240px; right: 6px; bottom: -46px; }
    .phead .team-top { display: contents; }
    .phead h1 { grid-column: 1 / -1; grid-row: 1; margin-top: 20px; }
    .phead .rec { grid-column: 1; grid-row: 2; margin-top: 6px; align-self: end; }
    .phead .pmeta { grid-row: 3; padding-bottom: 18px; }
    .phead :global(.phead-photo) { grid-row: 2 / 4; width: 112px; height: 112px; margin: 0 -6px 0 0; }
    .phead.unplayed :global(.phead-photo) { width: 140px; height: 140px; } /* the status lines make room for a bigger photo */
    .pstats-in { grid-column: 1 / -1; grid-row: 4; margin-top: 0; border-top: 1px solid var(--rule); }
    .pstats { width: 100%; }
    .phead.no-stats .pmeta { padding-bottom: 22px; }
    .phead.no-stats :global(.phead-photo) { width: 112px; height: 112px; }
    .phead.no-stats .pnum { font-size: 240px; bottom: -46px; }
    .pout-tag { display: table; margin: 10px 0 0 !important; }
  }
  .pmeta { font: 400 15px var(--ui); color: var(--ink-2); margin-top: 6px; }
  .pout { display: inline-block; margin-top: 10px; color: var(--ink); }
  /* The status pill gets room of its own: a little air beside the words and around its label. */
  .pout-tag { margin-left: 8px; padding: 4px 11px; }
  /* No games this season: the season lane shows last season's dot, faded, with no range. */
  :global(html[data-mode='season']) .lane.noseason .dot { opacity: 0.35; }
  :global(html[data-mode='season']) .lane.noseason .whisk { display: none; }
  /* The intro is the name card's second half: joined below the stats, the story on the left and the next game on the right. */
