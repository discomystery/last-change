---
// Player page. Skaters: role first, then what he does better or worse than others at his position, every rating,
// his shots, and NHL EDGE tracking. Goalies: role, the goalie card and where the shots he faces come from.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import AreaMap from '../../components/AreaMap.astro';
import AreaShapes from '../../components/AreaShapes.astro';
import SectionNav from '../../components/SectionNav.astro';
import Pips from '../../components/Pips.astro';
import Marker from '../../components/Marker.astro';
import Histogram from '../../components/Histogram.astro';
import Rank from '../../components/Rank.astro';
import Intro from '../../components/Intro.astro';
import { playerIntro, nextGame } from '../../lib/intros';
import teams from '../../../public/data/teams.json';
import goalieData from '../../../public/data/goalies.json';
import { clock, compared } from '../../lib/format';
import { teamColour } from '../../lib/teams';
import { TRAITS, EDGE, GROUPS, groupWord, peerWord, posWord, ordinal, most, standouts, roleTip, pkRoleWord, pkRoleTip, rankTag, rankTip, type Skater, type Mode, type Area } from '../../lib/players';
import { goalieTraitInfo } from '../../data/mock';
import '../../styles/blocks.css';

export function getStaticPaths() {
  const files = import.meta.glob('../../../public/data/players/*.json', { eager: true, import: 'default' }) as Record<string, any>;
  return Object.entries(files).filter(([f]) => /\/\d+\.json$/.test(f)).map(([, p]) => ({ params: { id: String(p.id) }, props: { p } }));
}
const { p } = Astro.props as { p: any };
const base = import.meta.env.BASE_URL;
const index = Object.values(import.meta.glob('../../../public/data/players/index.json', { eager: true, import: 'default' }))[0] as { id: number }[];
const known = new Set(index.map((x) => x.id));
const href = (id: number) => (known.has(id) ? `${base}player/${id}/` : undefined);
const team = teams.find((t) => t.abbr === p.team);
const intro = playerIntro(p.id);
const introNext = nextGame(intro?.game, base);
const modes: [Mode, string][] = [['blend', 'this season and last'], ['season', 'this season']];
// A rank tag is glued to the label's last word so it never drops onto a line of its own.
const headOf = (label: string) => label.slice(0, label.lastIndexOf(' ') + 1);
const lastOf = (label: string) => label.slice(label.lastIndexOf(' ') + 1);
const cap = (x: string) => x[0].toUpperCase() + x.slice(1);
const tough = (p: number) => (p > 55 ? `tougher than ${p}%` : p < 45 ? `easier than ${100 - p}%` : 'about average');
const asOf = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(p.generated_at));
const isG = p.group === 'G';
const s = p as Skater;
const words = isG ? 'goalies' : groupWord[s.group];
const posName = posWord[p.pos] ?? p.pos;
const shoots = p.shoots === 'L' ? (isG ? 'Catches left' : 'Shoots left') : p.shoots === 'R' ? (isG ? 'Catches right' : 'Shoots right') : null;
const areaName: Record<string, string> = {
  crease: 'Crease', lowSlot: 'Low slot', netSideL: 'Left of the net', netSideR: 'Right of the net', highSlot: 'High slot', circleL: 'Left circle', circleR: 'Right circle',
  behind: 'Behind the net', cornerL: 'Left corner', cornerR: 'Right corner', outerL: 'Left side, high', outerR: 'Right side, high', point: 'Middle of the blue line',
  pointL: 'Left point', pointR: 'Right point', outside: 'Outside the zone',
};

// ---- Skater role sentences ----
const role = isG ? null : s.role;
const nameLink = (m: { id: number; name: string }) => ({ ...m, href: href(m.id) });
const unitWord = (label: string) => (label.endsWith('1') ? 'first' : 'second');
const games = (n: number) => `${n} ${n === 1 ? 'game' : 'games'}`;
// Penalty kill in one short line: how many of the team's recent kills he was in, then detail in grey.
const pkSpan = `over the last ${games(Math.min(role?.team_games ?? 0, 10))}`;
const pk = (() => {
  const k = role?.pk;
  if (!k || !k.kills) return { main: 'No kills in this stretch', more: [] as string[], tip: '' };
  if (!k.role) return { main: 'Rarely kills penalties', more: [`not a regular in ${k.kills} kills`], tip: `Not a regular in ${team?.place ?? p.team}’s ${k.kills} kills ${pkSpan}.` };
  const more = [`${clock(k.per_kill!)} a kill`];
  if (k.role === 'starter') { more.push(`starts ${k.starts}`); if (k.draw) more.push('takes the draw'); }
  if (k.role === 'second' && k.starts) more.push(`starts only ${k.starts}`);
  return { main: `${k.kills_in} of ${k.kills} kills`, more, tip: `On the ice for ${k.kills_in} of ${team?.place ?? p.team}’s ${k.kills} kills ${pkSpan}.` };
})();
let strengths: ReturnType<typeof standouts> | null = null;
const strengthsBy = isG ? null : Object.fromEntries(modes.map(([m]) => [m, standouts(s, m)])) as Record<Mode, ReturnType<typeof standouts>>;

// ---- Goalie ----
type GMode = { starts: number; games: number; shots: number; goals: number; gsax: number; gsax60: number | null; sv: number | null; sa60: number | null; danger: number | null; bd60: number | null; gap: number | null; long_wait: number | null; qs: number | null; rbs: number | null; bins: number[]; tiers: Record<string, { shots: number; sv: number | null }>; pct: Record<string, number | null> };
const g = isG ? (p.goalie as { name: string; blend: GMode; season: GMode }) : null;
const sgn = (v: number) => (Math.abs(v) < 0.05 ? '0.0' : `${v > 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`);
const svp = (v: number | null) => (v === null ? '–' : v.toFixed(3).replace(/^0/, ''));
const gSay: Record<string, (x: GMode) => string> = {
  gsax: (x) => `${sgn(x.gsax)} goals saved above expected in ${x.starts} ${x.starts === 1 ? 'start' : 'starts'}`,
  busy: (x) => `${x.sa60} shots faced per 60`,
  danger: (x) => (x.danger ? `the average shot he faces has a ${(100 * x.danger).toFixed(1)}% chance of going in` : '–'),
  breakdowns: (x) => `${x.bd60} defensive breakdowns in front of him per 60`,
  gaps: (x) => `a typical wait of ${x.gap} seconds between shots; ${x.long_wait}% come after three quiet minutes`,
  steady: (x) => `a quality start ${x.qs}% of the time`,
};
const goalieAreas = (mode: Mode) => {
  const raw = (p.shots_against?.[mode] ?? {}) as Record<string, { shots: number; goals: number; xg: number }>;
  const total = Object.values(raw).reduce((a, b) => a + b.shots, 0);
  return Object.fromEntries(Object.entries(raw).map(([k, v]) => [k, { shots: v.shots, goals: v.goals, share: total ? (100 * v.shots) / total : 0, avg: v.xg }])) as Record<string, Area>;
};
const shadeBy = (areas: Record<string, Area>) => {
  const top = Math.max(1, ...Object.values(areas).map((a) => a.share));
  return (a: Area) => Math.sqrt(a.share / top);
};
const nav = isG ? [['role', 'Role'], ['card', 'Goalie card'], ['faced', 'Shots faced']] : [['role', 'Role'], ['standout', 'Stands out'], ['ratings', 'Ratings'], ['shots', 'Shots'], ['edge', 'Skating']]
// Season line: full words on wide screens, hockey's usual abbreviations on phones.
const cols: [string, string, string?][] = [['Games', 'GP'], ['Goals', 'G'], ['Assists', 'A'], ['Points', 'P'], ['Shots', 'SOG'], ['Ice time', 'TOI', 'Average ice time per game, all situations.']];
const statRow = (x: any) => (isG ? null : x);
---
<Base section="players" title={`${p.name} · ${p.team}`} mock={false} description={`${p.name}: role, strengths and weak spots against other ${words}, shots and skating.`}>
  <AreaShapes />
  <div class="player" style={`--team:${teamColour(p.team)}`}>
    <header class="team-top">
      <h1>{p.name}</h1>
      <p class="rec">{p.number !== null && `#${p.number} · `}{posName} · <a href={`${base}team/${p.team}/`}>{team?.name ?? p.team}</a></p>
    </header>
    <p class="pmeta">{[shoots, p.age ? `${p.age} years old` : null].filter(Boolean).join(' · ')}</p>
    <SectionNav items={nav as [string, string][]} />
    <Intro text={intro?.text ?? []} next={intro?.next} nextLabel={introNext.label} nextHref={introNext.href} colour={teamColour(p.team)} />
    {!isG && (
      <table class="pstats">
        <thead><tr><th></th>{cols.map(([full, short, tip]) => <th>{tip ? <span class="term" tabindex="0" data-tip={tip}><span class="full">{full}</span><span class="short">{short}</span></span> : <><span class="full">{full}</span><abbr class="short" title={full}>{short}</abbr></>}</th>)}</tr></thead>
        <tbody>
          {([['season', 'This season'], ['last', 'Last season']] as const).map(([k, label]) => { const x = s.stats[k]; return x && <tr><th>{label}</th><td>{x.gp}</td><td>{x.g}</td><td>{x.a}</td><td>{x.p}</td><td>{x.sog}</td><td>{clock(x.toi)}</td></tr>; })}
        </tbody>
      </table>
    )}

    {!isG && role && (
      <>
        <Section id="role" title="Role" placeholder={false} takeaway={`Where he fits on ${team?.place ?? p.team} right now.`}>
          <div class="card prole">
            <dl class="rl">
              <div>
                <dt>Line</dt>
                <dd>
                  {role.line ? (
                    <>
                      <p><span class="chip tag" tabindex="0" data-tip={`${role.line.label}: ${s.group === 'D' ? 'pairs' : 'lines'} are numbered by recent 5-on-5 time together, with the latest games counting most. Taken from who has actually played together lately, not the announced lineup.`}>{role.line.label}</span> with {role.line.mates.map(nameLink).map((m, i) => <>{i > 0 && ' and '}{m.href ? <a class="plink" href={m.href}>{m.name}</a> : m.name}</>)}{role.line.toi_sec != null && <span class="n"> · {clock(role.line.toi_sec)} a game together</span>}</p>
                    </>
                  ) : (
                    <p>Not part of one of the team’s usual {s.group === 'D' ? 'pairs' : 'lines'} over the last {Math.min(role.team_games, 10)} games{role.gp !== undefined ? `; has played ${role.gp} of the team’s ${role.team_games} games this season` : ''}.</p>
                  )}
                </dd>
              </div>
              <div>
                <dt>Power play</dt>
                <dd>
                  {role.pp ? (
                    <p><span class="chip tag" tabindex="0" data-tip={`The ${unitWord(role.pp.label)} power-play unit.`}>{role.pp.label}</span>{role.pp.role && <> <span class="chip tag" tabindex="0" data-tip={roleTip[role.pp.role]}>{role.pp.role}</span></>}{role.pp.both && <span class="n"> · often stays on for the second unit</span>}</p>
                  ) : <p>Not on either unit</p>}
                  {role.faceoff && <p class="n">{role.faceoff}</p>}
                  {role.pp && s.moved_from && !role.pp.role && <p class="n">Power-play role tags count only games with his current team, and he has too few power-play shots with {team?.place ?? p.team} yet to earn one.</p>}
                </dd>
              </div>
              <div>
                <dt>Penalty kill</dt>
                <dd><p>{role.pk?.role && <><span class="chip tag" tabindex="0" data-tip={pkRoleTip[role.pk.role]}>{pkRoleWord[role.pk.role]}</span> </>}<span class:list={{ term: !!pk.tip }} tabindex={pk.tip ? 0 : undefined} data-tip={pk.tip || undefined}>{pk.main}</span>{pk.more.length > 0 && <span class="n"> · {pk.more.join(' · ')}</span>}</p></dd>
              </div>
              {role.toi && (
                <div>
                  <dt>Ice time</dt>
                  <dd>
                    <p><strong>{clock(role.toi.toi)}</strong> a game{role.toi_rank !== undefined && role.toi_of !== undefined && role.toi_of > 1 && <>, <span class="term" tabindex="0" data-tip={`Among the ${role.toi_of} ${team?.place ?? p.team} ${groupWord[s.group]} who have played at least half the games.`}>{most(role.toi_rank)} among {team?.place ?? p.team} {groupWord[s.group]}</span></>}<span class="n"> · {[`${clock(role.toi.toi5)} 5-on-5`, role.toi.toi_pp >= 15 && `${clock(role.toi.toi_pp)} PP`, role.toi.toi_pk >= 15 && `${clock(role.toi.toi_pk)} PK`].filter(Boolean).join(' · ')}</span></p>
                  </dd>
                </div>
              )}
              {s.competition && (
                <div>
                  <dt>Competition</dt>
                  <dd>
                    {modes.map(([m, mw]) => {
                      const c = s.competition![m];
                      if (!c?.all) return null;
                      const split = [c.home && `${tough(c.home.pct)} at home, where his coach has the last change`, c.road && `${tough(c.road.pct)} on the road`].filter(Boolean);
                      // Home and road in grey: just the percentage when it reads from the same side as the main line.
                      const side = (q: number) => (q > 55 ? 1 : q < 45 ? -1 : 0);
                      const short = (q: number) => (side(q) !== 0 && side(q) === side(c.all!.pct) ? `${side(q) > 0 ? q : 100 - q}%` : tough(q));
                      const hr = [c.home && `home ${short(c.home.pct)}`, c.road && `road ${short(c.road.pct)}`].filter(Boolean);
                      return (
                        <div class={`gmode m-${m}`}>
                          <p>{compared(c.all.pct, 'tougher opponents than', 'easier opponents than', groupWord[s.group])} <Marker pct={c.all.pct} tip={`How dangerous the opponents he faces at 5-on-5 are, ${mw}${split.length ? `: ${split.join('; ')}` : ''}. Not good or bad in itself; it is the job he is given, and his “Creating chances” and “Preventing chances” ratings already account for it.`} />{hr.length > 0 && <span class="n"> · {hr.join(', ')}</span>}</p>
                        </div>
                      );
                    })}
                  </dd>
                </div>
              )}
            </dl>
          </div>
          {role.notes.length > 0 && (
            <div class="card worth"><p class="mini-h">What’s changed</p><ul>{role.notes.map((n) => <li>{n}</li>)}</ul></div>
          )}
        </Section>

        <Section id="standout" title="Where he stands out" placeholder={false} takeaway="What he does better or worse than most players at his position.">
          {modes.map(([m, mw]) => {
            const x = strengthsBy![m];
            const say = (it: (typeof x.best)[number]) => it.est?.raw !== undefined
              ? <><span class="a-adj">{it.info.short(it.est.index ?? 100)}</span><span class="a-raw">{it.info.rawShort!(it.est.raw!)}</span></>
              : <>{it.info.short(it.v)}</>;
            const tagOf = (it: (typeof x.best)[number]) => rankTag(it.rank) && <span class="rk" tabindex="0" data-tip={rankTip(it.rank!, it.of, it.info.label, it.vs)}>{rankTag(it.rank)}</span>;
            const cmpTip = (it: (typeof x.best)[number], lower = false) => it.edge ? compared(it.pct, it.info.up ?? 'more than', it.info.down ?? 'less than', it.vs, lower) : compared(it.pct, 'better than', 'behind', it.vs, lower);
            const cmpOf = (it: (typeof x.best)[number]) => it.est?.raw !== undefined
              ? <><span class="a-adj">{cmpTip(it, true)}</span><span class="a-raw">{compared(it.est.raw_pct!, 'more than', 'fewer than', it.vs, true)}</span></>
              : <>{cmpTip(it, true)}</>;
            return (
              <div class={`gmode m-${m}`}>
                <div class="two sw">
                  <div class="card">
                    <p class="mini-h">Better than most at his position</p>
                    {x.best.length ? <ul class="swl">{x.best.map((it) => <li><p class="sw-h"><span class="term" tabindex="0" data-tip={it.info.tip}>{headOf(it.info.label)}<span class="nw">{lastOf(it.info.label)}{tagOf(it)}</span></span><Pips pct={it.pct} tip={`${cmpTip(it)}.`} /></p><p class="sw-l"><span>{say(it)}</span><em>{cmpOf(it)}</em></p></li>)}</ul>
                      : <p class="n">Nothing yet where we can be confident he is above most {groupWord[s.group]}.</p>}
                  </div>
                  <div class="card">
                    <p class="mini-h">Behind most at his position</p>
                    {x.worst.length ? <ul class="swl">{x.worst.map((it) => <li><p class="sw-h"><span><span class="term" tabindex="0" data-tip={it.info.tip}>{it.info.label}</span></span><Pips pct={it.pct} tip={`${cmpTip(it)}.`} /></p><p class="sw-l"><span>{say(it)}</span><em>{cmpOf(it)}</em></p></li>)}</ul>
                      : <p class="n">Nothing yet where we can be confident he is below most {groupWord[s.group]}.</p>}
                  </div>
                </div>
                <p class="note">Listed only when we can be confident he is above or below average. Numbers from {mw}, through {asOf}. Compared with {groupWord[s.group]} who have played at least {m === 'blend' ? 20 : 3} games{m === 'blend' ? ' over the two seasons' : ''}.</p>
              </div>
            );
          })}
        </Section>

        <Section id="ratings" title="All ratings" placeholder={false} takeaway={`Every rating, against other ${groupWord[s.group]}.`}>
          <div class="key"><span class="one"><i></i>{p.name}</span><span class="avg">Average {s.group === 'D' ? 'defenseman' : 'forward'}</span><span class="rng">Likely range</span></div>
          <p class="note m-blend">This season’s {s.games} {s.games === 1 ? 'game' : 'games'} blended with last season’s {s.games_last}, and pulled toward the average {s.group === 'D' ? 'defenseman' : 'forward'} by an amount that depends on how quickly each rating settles.</p>
          {s.moved_from && <p class="note m-blend">He played for {(teams.find((t) => t.abbr === s.moved_from)?.name) ?? s.moved_from} last season. Habits that travel with a player (shooting, hitting, penalties) still use that season in full; setting up goals, finishing, faceoffs and power-play chances depend more on linemates and role, so they lean on it less. We measured how much each one carries over for players who change teams.</p>}
          {s.group === 'F' && <p class="note">Shooting volume, creating his own chances, shot blocking, hardest shot and distance skated compare {s.sub === 'C' ? 'centers with centers' : 'wingers with wingers'}, because centers and wingers really differ there. Everything else compares all forwards.</p>}
          <p class="note m-season">This season’s {s.games} {s.games === 1 ? 'game' : 'games'} only, pulled toward the average {s.group === 'D' ? 'defenseman' : 'forward'}. Expect wide ranges this early.</p>
          {GROUPS.map((grp) => (
            <>
              <h3 class="sub">{grp}</h3>
              <ul class="fpgrid">
                {Object.entries(TRAITS).filter(([, t]) => t.group === grp).filter(([k]) => s.traits[k]).map(([k, t]) => {
                  const e = s.traits[k];
                  return (
                    <li class:list={['card', 'fpc', 'mini', { thin: !e.blend.ok && !e.season.ok }]}>
                      <span class="fpc-name"><span class="term" tabindex="0" data-tip={t.tip}>{headOf(t.label)}<span class="nw">{lastOf(t.label)}{modes.map(([m]) => { const tag = rankTag(e[m].rank, e[m].ok); return tag && <span class={`rk rk-${m}`} tabindex="0" data-tip={rankTip(e[m].rank, e[m].of, t.label, peerWord[e[m].vs ?? s.group])}>{tag}</span>; })}</span></span></span>
                      <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
                      <div class="lanes"><div class="lane" style={`--b:${e.blend.pct};--blo:${e.blend.lo};--bhi:${e.blend.hi};--c:${e.season.pct};--clo:${e.season.lo};--chi:${e.season.hi}`}><span class="whisk"></span><span class="dot"></span></div></div>
                      {modes.map(([m]) => (
                        <p class={`fpc-line m-${m}`}>
                          {e[m].raw === undefined
                            ? <><span tabindex="0" data-tip={`${cap(t.say(e[m].v))}.`}>{t.short(e[m].v)}</span><Rank ok={e[m].ok} pct={e[m].pct} words={compared(e[m].pct, 'better than', 'behind', peerWord[e[m].vs ?? s.group])} /></>
                            : <><span class="a-adj" tabindex="0" data-tip={`${cap(t.say(e[m].index ?? 100))}.`}>{t.short(e[m].index ?? 100)}</span><Rank ok={e[m].ok} pct={e[m].pct} words={compared(e[m].pct, 'better than', 'behind', peerWord[e[m].vs ?? s.group])} class='a-adj' />
                                <span class="a-raw" tabindex="0" data-tip={`${cap(t.raw!(e[m].raw!))}.`}>{t.rawShort!(e[m].raw!)}</span><Rank ok={e[m].ok} pct={e[m].raw_pct!} words={compared(e[m].raw_pct!, 'more than', 'fewer than', peerWord[e[m].vs ?? s.group])} class='a-raw' /></>}
                        </p>
                      ))}
                    </li>
                  );
                })}
              </ul>
            </>
          ))}
          <p class="note">Hitting, shot blocking and takeaways are arena-adjusted scores (100 is the average {s.group === 'D' ? 'defenseman' : 'forward'}); switch “Hits and takeaways” to Raw in the settings to see the numbers as recorded. <a href={`${base}methods/#players`}>How the ratings work</a>.</p>
        </Section>

        <Section id="shots" title="Shots" placeholder={false} takeaway="Where his shots come from, and how his misses miss.">
          <div class="pick"><span>Show</span>
            <select class="map-pick" aria-label="Map view"><option value="areas">where his shots come from</option><option value="dots">every shot, goals in black</option></select>
          </div>
          <div class="st2">
            <div class="card">
              {modes.map(([m, mw]) => {
                const a = s.areas[m];
                const shade = shadeBy(a.areas);
                return (
                  <div class={`gmode m-${m}`}>
                    <AreaMap id={`am-${m}`} areas={a.areas} shots={s.shots}
                      tip={(k, x) => x ? `${areaName[k]}: ${x.shots} ${x.shots === 1 ? 'shot' : 'shots'}, ${x.goals} ${x.goals === 1 ? 'goal' : 'goals'}. ${Math.round(x.share)}% of his shots come from here; the average ${s.group === 'D' ? 'defenseman' : 'forward'} takes ${Math.round(x.avg)}% from here.` : areaName[k]}
                      label={(x) => String(x.shots)} shade={shade} />
                    <p class="n mapcap">{a.n} unblocked shots, {mw}, from his point of view. {a.areas.outside.shots > 0 && `${a.areas.outside.shots} more from outside the zone.`} Empty nets left out.</p>
                  </div>
                );
              })}
            </div>
            <div class="card">
              <p class="chart-title">How his misses miss</p>
              {modes.map(([m]) => {
                const x = s.misses[m];
                const rows = x ? [['Wide left', x.left], ['Wide right', x.right], ['Over the net', x.high], ['Off the post or crossbar', x.post], ['Short or other', x.short + x.other]] as [string, number][] : [];
                const top = Math.max(1, ...rows.map((r) => r[1]));
                return (
                  <div class={`gmode m-${m}`}>
                    {x ? (
                      <>
                        <ul class="mbars">{rows.map(([label, n]) => <li><span>{label}</span><span class="mbar"><i style={`width:${(100 * n) / top}%`}></i></span><strong>{n}</strong></li>)}</ul>
                        <p class="n">{x.n} missed shots. “Wide left” is from his point of view.</p>
                      </>
                    ) : <p class="n">No missed shots yet.</p>}
                  </div>
                );
              })}
              <p class="note">The NHL’s game data records how a shot missed, but not where in the net a goal or save went (glove side, blocker, five-hole). That needs paid camera tracking, so we don’t show it.</p>
            </div>
          </div>
        </Section>

        <Section id="edge" title="Skating and shot" placeholder={false} takeaway={`Speed, bursts, shot power and where he spends his shifts, from the NHL’s own tracking (NHL EDGE).`}>
          {s.edge ? (
            <>
              <ul class="fpgrid">
                {Object.entries(EDGE).map(([k, t]) => {
                  const b = s.edge!.blend?.[k], c = s.edge!.season?.[k];
                  if (!b && !c) return null;
                  const bp = b?.pct ?? 50, cp = c?.pct ?? 50;
                  return (
                    <li class:list={['card', 'fpc', 'mini', { thin: !(b?.ok || c?.ok) }]}>
                      <span class="fpc-name"><span class="term" tabindex="0" data-tip={t.tip}>{headOf(t.label)}<span class="nw">{lastOf(t.label)}{modes.map(([m]) => { const e = s.edge![m]?.[k]; const tag = rankTag(e?.rank, e?.ok); return tag && <span class={`rk rk-${m}`} tabindex="0" data-tip={rankTip(e!.rank!, e!.of, t.label, peerWord[e!.vs ?? s.group])}>{tag}</span>; })}</span></span></span>
                      <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
                      <div class="lanes"><div class="lane" style={`--b:${bp};--blo:${bp};--bhi:${bp};--c:${cp};--clo:${cp};--chi:${cp}`}><span class="whisk"></span><span class="dot"></span></div></div>
                      {modes.map(([m]) => { const e = s.edge![m]?.[k]; return (
                        <p class={`fpc-line m-${m}`}>{e ? <><span tabindex="0" data-tip={`${cap(t.say(e.v))}.`}>{t.short(e.v)}</span><Rank ok={e.ok} pct={e.pct} words={compared(e.pct, t.up ?? 'more than', t.down ?? 'less than', peerWord[e.vs ?? s.group])} /></> : <span class="n">No tracking data yet.</span>}</p>
                      ); })}
                    </li>
                  );
                })}
              </ul>
              <p class="note">Top speed and hardest shot are his best single moments{' '}<span class="inl m-blend">over this season and last</span><span class="inl m-season">this season</span>; bursts and distance are per 60 minutes of his ice time. Tracking data: NHL EDGE.</p>
            </>
          ) : <p class="note">No NHL EDGE tracking data for him yet.</p>}
        </Section>
      </>
    )}

    {isG && g && (
      <>
        <Section id="role" title="Role" placeholder={false} takeaway={`How much ${team?.place ?? p.team} leans on him.`}>
          <div class="card prole">
            <dl class="rl">
              <div><dt>This season</dt><dd><p>Started <strong>{g.season.starts}</strong> of the team’s {p.team_games} games{p.team_games ? ` (${Math.round((100 * g.season.starts) / p.team_games)}%)` : ''}.</p></dd></div>
              <div><dt>Over two seasons</dt><dd><p>{g.blend.starts} starts and {g.blend.shots} shots faced, this season and last.</p></dd></div>
            </dl>
          </div>
        </Section>
        <Section id="card" title="Goalie card" placeholder={false} takeaway="Is he stopping more than he should, and what is his team asking him to face?">
          {modes.map(([m, mw]) => {
            const x = g[m];
            const few = x.pct.gsax === null;
            return (
              <div class={`gmode m-${m}`}>
                <div class="g2">
                  <div class="card gcard">
                    <p class="gname"><span>{p.name}</span><span class="n">{x.starts} {x.starts === 1 ? 'start' : 'starts'} · {x.shots} shots faced, {mw}</span></p>
                    <p class="gbig"><strong>{sgn(x.gsax)}</strong> <span class="term" tabindex="0" data-tip="Goals saved above expected: how many goals he has prevented compared with an average goalie facing the same shots. Positive is good.">goals saved above expected</span> {few ? <span class="n">too few starts to rate</span> : <Pips pct={x.pct.gsax!} tip={`Stopping more than expected, per 60: ${compared(x.pct.gsax!, 'better than', 'worse than', 'goalies', true)}.`} />}</p>
                    <dl class="gkv">
                      {(['low', 'medium', 'high'] as const).map((t) => <div><dt>{t[0].toUpperCase() + t.slice(1)}-danger save %</dt><dd>{svp(x.tiers[t].sv)} <span class="n">{x.tiers[t].shots} shots</span></dd></div>)}
                      <div><dt>Overall save %</dt><dd>{svp(x.sv)}</dd></div>
                      <div><dt><span class="term" tabindex="0" data-tip="Shots on goal he faces per 60.">Shots faced per 60</span></dt><dd>{x.sa60 ?? '–'} {!few && <Marker pct={x.pct.busy!} tip={`${compared(x.pct.busy!, 'busier than', 'quieter than', 'goalies')}.`} />}</dd></div>
                      <div><dt><span class="term" tabindex="0" data-tip="Share of starts where he gave his team a fair chance to win: a save percentage at or above league average, or at least .885 on a light night.">Quality starts</span></dt><dd>{x.qs === null ? '–' : `${x.qs}%`} {!few && <Pips pct={x.pct.steady!} tip={`${compared(x.pct.steady!, 'steadier than', 'streakier than', 'goalies')}.`} />}</dd></div>
                    </dl>
                  </div>
                  <div class="card gmid">
                    <div class="gh"><p class="mini-h">Night to night: goals saved above expected in each start</p><Histogram wide team="one" bins={x.bins.map((n, k) => ({ lo: k - 3, n }))} name={p.name} /></div>
                  </div>
                </div>
                <ul class="fpgrid gtraits">
                  {goalieTraitInfo.map((t) => (
                    <li class="card fpc">
                      <span class="term fpc-name" tabindex="0" data-tip={t.tip}>{t.label}</span>
                      <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
                      <div class="lanes">{x.pct[t.key] !== null ? <div class="lane" style={`--b:${x.pct[t.key]};--blo:${x.pct[t.key]};--bhi:${x.pct[t.key]};--c:${x.pct[t.key]};--clo:${x.pct[t.key]};--chi:${x.pct[t.key]}`}><span class="whisk"></span><span class="dot"></span></div> : <div class="lane empty"></div>}</div>
                      <p class="gline"><span>{gSay[t.key](x)}</span>{x.pct[t.key] === null && <em>too few starts to place him</em>}</p>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
          <p class="note">Ratings compare him with goalies who have at least {goalieData.min_starts.blend} starts over two seasons, or {goalieData.min_starts.season} this season. Expected-goal models can’t see passes before a shot, so a goalie whose team gives up a lot of cross-ice passes will look worse here than he really is.</p>
        </Section>
        <Section id="faced" title="Shots he faces" placeholder={false} takeaway="Where the shots on goal against him come from, seen from the shooter’s side.">
          <div class="st2">
            {modes.map(([m, mw]) => {
              const a = goalieAreas(m);
              const shade = shadeBy(a);
              return (
                <div class={`card gmode m-${m}`}>
                  <AreaMap id={`gm-${m}`} areas={a}
                    tip={(k, x) => x ? `${areaName[k]}: ${x.shots} shots on goal, ${x.goals} ${x.goals === 1 ? 'goal' : 'goals'} (${x.shots ? svp((x.shots - x.goals) / x.shots) : '–'} save %). An average goalie would have allowed ${x.avg.toFixed(1)}.` : areaName[k]}
                    label={(x) => String(x.shots)} shade={shade} />
                  <p class="n mapcap">Shots on goal against him, {mw}. Point at an area for goals and save %.</p>
                </div>
              );
            })}
          </div>
        </Section>
      </>
    )}
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLSelectElement>('.map-pick').forEach((sel) => {
    const apply = () => document.querySelectorAll('.areamap').forEach((m) => m.classList.toggle('dots', sel.value === 'dots'));
    sel.addEventListener('change', apply);
    apply();
  });
</script>

