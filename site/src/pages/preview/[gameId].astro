  .gsays i { width: 10px; height: 10px; border-radius: 50%; background: var(--team); }
  .gsays em { color: var(--ink-3); font-style: normal; }
  .gnights { margin-top: 14px; }
  .two-n { gap: 14px; }
  .two-n > span { display: inline-flex; align-items: center; gap: 5px; min-width: 52px; font-weight: 600; }
  .two-n i { width: 10px; height: 10px; border-radius: 50%; background: var(--team); }
  .notes { margin-top: 14px; display: grid; gap: 10px; font: 400 15px/1.5 var(--ui); }
  .team-h { margin-top: 8px; }
  .units { display: grid; gap: 14px; }
  .opp-key { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 22px; font: 400 14px var(--ui); margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
  .opp-key .mini-h { margin: 0; flex-basis: 100%; }
  .opp-key b { color: var(--team); margin-right: 4px; }
</style>

<script is:inline>
  // Special teams: "Show [team] [on the power play / on the penalty kill]". The penalty kill shows the other team's power play.
  (() => {
    const team = document.getElementById('st-team'), sit = document.getElementById('st-sit');
    if (!team) return;
    const mine = [...team.options].find((o) => o.value === window.lcPrefs?.get('team'));
    if (mine) team.value = mine.value;
    const other = () => [...team.options].find((o) => o.value !== team.value).value;
    const show = () => { const pp = sit.value === 'pp' ? team.value : other(); document.querySelectorAll('.stblock').forEach((p) => { p.hidden = p.dataset.pp !== pp; }); };
    team.addEventListener('change', show);
    sit.addEventListener('change', show);
    show();
  })();

  // Pointing at a power-play name lights up his shots on that panel's map.
  document.querySelectorAll('.stblock').forEach((panel) => {
    const map = panel.querySelector('.ppmap');
    if (!map) return;
    const who = map.querySelector('.map-who');
    let pinned = null;
    const show = (el) => {
      const id = el?.dataset.shooter;
      map.classList.toggle('focus', !!id);
      map.querySelectorAll('[data-p]').forEach((d) => d.classList.toggle('on', d.dataset.p === id));
      const n = id ? map.querySelectorAll(`[data-p="${id}"]`).length / (map.querySelectorAll('svg').length || 1) : 0;
      who.textContent = id ? `${el.textContent}: ${n} of these shots` : ' ';
    };
    panel.querySelectorAll('[data-shooter]').forEach((el) => {
      el.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') show(el); });
      el.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') show(pinned); });
      el.addEventListener('focus', () => show(el));
      el.addEventListener('blur', () => show(pinned));
      el.addEventListener('click', () => { pinned = pinned === el ? null : el; show(pinned); });
    });
  });

  // Goalies: one from each team; everything tagged with a goalie follows the two menus.
  (() => {
    const menus = [document.getElementById('g-away'), document.getElementById('g-home')];
    if (!menus[0]) return;
    const show = () => {
      const on = new Set(menus.map((x) => x.value));
      document.querySelectorAll('#goalies [data-goalie]').forEach((el) => { el.hidden = !on.has(el.dataset.goalie); });
    };
    menus.forEach((x) => x.addEventListener('change', show));
    show();
  })();

  // Goal sources: scored or allowed.
  (() => {
    const sel = document.getElementById('src-side');
    if (!sel) return;
    sel.addEventListener('change', () => document.querySelectorAll('[data-src]').forEach((b) => { b.hidden = b.dataset.src !== sel.value; }));
  })();
</script>
