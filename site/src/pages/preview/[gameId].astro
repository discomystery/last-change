<script is:inline>
  // Keep the section links in view and show which section is being read.
  (() => {
    const bar = document.querySelector('.mockbar');
    const setBar = () => document.documentElement.style.setProperty('--bar-h', bar.offsetHeight + 'px');
    setBar();
    addEventListener('resize', setBar);
    const links = [...document.querySelectorAll('#jump a')];
    const byId = Object.fromEntries(links.map((a) => [a.getAttribute('href').slice(1), a]));
    const seen = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.classList.remove('here'));
        const a = byId[e.target.id];
        if (a) { a.classList.add('here'); a.scrollIntoView({ block: 'nearest', inline: 'nearest' }); }
      });
    }, { rootMargin: '-25% 0px -70% 0px' });
    document.querySelectorAll('main section.sec').forEach((s) => seen.observe(s));
  })();

  // Special-teams picker: "Show [team] [situation]". "On the penalty kill" shows the other team's power play against them.
  (() => {
    const team = document.getElementById('st-team');
    const sit = document.getElementById('st-sit');
    const mine = [...team.options].find((o) => o.dataset.abbr === window.lcPrefs?.get('team'));
    if (mine) team.value = mine.value;
    const show = () => {
      const otherTeam = team.value === 'away' ? 'home' : 'away';
      const id = sit.value === 'all' ? team.value : sit.value === 'pp' ? `${team.value}-pp` : `${otherTeam}-pp`;
      document.querySelectorAll('.stblock').forEach((p) => { p.hidden = p.id !== `stpanel-${id}`; });
    };
    team.addEventListener('change', show);
    sit.addEventListener('change', show);
    show();
  })();

  // Goalie picker: one goalie from each team; everything tagged with a goalie follows the two menus.
  (() => {
    const menus = [document.getElementById('g-away'), document.getElementById('g-home')];
    const show = () => {
      const on = new Set(menus.map((x) => x.value));
      document.querySelectorAll('#goalies [data-goalie]').forEach((el) => { el.hidden = !on.has(el.dataset.goalie); });
    };
    menus.forEach((x) => x.addEventListener('change', show));
    show();
  })();
</script>
