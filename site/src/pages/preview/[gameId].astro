---
import { srcInfo } from '../../lib/goalSources';
import NoteText from '../../components/NoteText.astro';
// Real preview, one page per upcoming game. Everything comes from the same JSON as the team pages, set side by side;
// the "What to watch" calls come from the game's snapshot, which the pipeline freezes at puck drop.
import Base from '../../layouts/Base.astro';
import { previewOg } from '../../lib/og';
import Explain from '../../components/Explain.astro';
import Section from '../../components/Section.astro';
import Rink from '../../components/Rink.astro';
import CallCard from '../../components/CallCard.astro';
import GameTrail from '../../components/GameTrail.astro';
import AreaShapes from '../../components/AreaShapes.astro';
import ShotMap from '../../components/ShotMap.astro';
import Quadrant from '../../components/Quadrant.astro';
import Histogram from '../../components/Histogram.astro';
import Pips from '../../components/Pips.astro';
import Portrait from '../../components/Portrait.astro';
import PLink from '../../components/PLink.astro';
import SectionNav from '../../components/SectionNav.astro';
import GameStory, { type Story } from '../../components/GameStory.astro';
import PkRoles from '../../components/PkRoles.astro';
import { roleTip, pkRoleWord, pkRoleTip } from '../../lib/players';
import Marker from '../../components/Marker.astro';
import Deployment from '../../components/Deployment.astro';
import UnitToi from '../../components/UnitToi.astro';
import FpPair from '../../components/FpPair.astro';
import FpRow from '../../components/FpRow.astro';
import { twoColumns } from '../../lib/masonry';
import { clock as mmss, compared } from '../../lib/format';
import { matchupPaint } from '../../lib/teams';
import '../../styles/blocks.css';
import teamsData from '../../../public/data/teams.json';
import fpAll from '../../../public/data/fingerprints.json';
import linesAll from '../../../public/data/lines.json';
import goalieAll from '../../../public/data/goalies.json';
import srcAll from '../../../public/data/goal_sources.json';
import schedule from '../../../public/data/schedule.json';
import { fpInfo, fpGroups, ordinal, goalieTraitInfo } from '../../lib/traits';

type Claim = { id: string; kind: string; head: string; body: string; call?: string; nums?: string; cite: string; check: object | null };
// `pregame` holds the slice of each data file the page reads, as it stood when the preview was made, so a preview can
// still be shown unchanged after the game. Previews for games played before snapshots began are made from the data before
// each game and shown exactly like the rest.
type Pregame = { fingerprints: typeof fpAll; lines: typeof linesAll; goalies: typeof goalieAll; goal_sources: typeof srcAll; records: Record<string, string> };
type Snap = { game_id: number; start: string; away: string; home: string; venue: string; snapshot_at: string; data_as_of: string; claims: Claim[]; pregame?: Pregame; rebuilt?: boolean; data_through?: string | null; outlook?: Record<string, { head: string; body: string }>; story?: Story; starters?: Record<string, number[]>; projected?: Record<string, { id: number; from: 'nhl' | 'model' }> };

export async function getStaticPaths() {
  const files = import.meta.glob<{ default: Snap }>('../../../public/data/previews/2*.json', { eager: true });
  const final = new Set(schedule.games.filter((g) => g.final).map((g) => g.id));
  return Object.values(files).map((f) => f.default).filter((s) => !final.has(s.game_id) || s.pregame).map((s) => ({ params: { gameId: String(s.game_id) }, props: { snap: s } }));
}
const { snap } = Astro.props as { snap: Snap };
const pre = snap.pregame;
const fpData = pre?.fingerprints ?? fpAll;
const linesData = pre?.lines ?? linesAll;
const goalieData = pre?.goalies ?? goalieAll;
const srcData = pre?.goal_sources ?? srcAll;
const played = schedule.games.find((g) => g.id === snap.game_id && g.final);
const base = import.meta.env.BASE_URL;
const { away, home } = snap;
const order = [away, home] as const;
const side = (a: string) => (a === away ? 'away' : 'home');
const T = Object.fromEntries(teamsData.map((t) => [t.abbr, t]));
const place = (a: string) => T[a]?.place ?? a;
const full = (a: string) => T[a]?.name ?? a;
const rec = (a: string) => pre?.records?.[a] ?? (T[a] ? `${T[a].w}-${T[a].l}-${T[a].otl}` : '');
const colours = matchupPaint(away, home);
const start = new Date(snap.start);
const dateStr = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/New_York' }).format(start);
const timeStr = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }).format(start);

// Style fingerprints
type Est = { v: number; pct: number; lo: number; hi: number; rank: number; index: number; raw?: number; raw_rank?: number };
const fpT = fpData.teams as unknown as Record<string, { games: number; dims: Record<string, { blend: Est; season: Est }> }>;
// Older frozen snapshots can carry a retired trait (point shots); show only traits the site still describes.
const traits = fpData.ready.filter((key) => fpInfo[key]).map((key) => ({ key, ...fpInfo[key], [away]: fpT[away].dims[key], [home]: fpT[home].dims[key] })) as any[];
const gap = (c: any) => Math.abs(c[away].blend.pct - c[home].blend.pct);
const fpSides = order.map((a) => ({ abbr: a, cls: `t-${side(a)}`, place: place(a) }));
const biggest = [...traits].sort((x, y) => gap(y) - gap(x)).slice(0, 6);

// Lines and matchups
type Unit = { label: string; players: string[]; gp?: number; new?: boolean; seconds: number; toi_sec: number | null; xgf60: number; xga60: number; share: number; oz: number | null; pct: Record<string, number | null> };
type MRow = { label: string; minutes: number; seconds: number; share: (number | null)[]; expected: number[] };
type SUnit = { label: string; players: { id: number; name: string; role: string | null; both?: boolean; after?: string | null }[]; seconds: number; share: number; rate: number; pct?: number };
type LT = { games: number; settled?: { shuffled?: boolean }; units: Unit[]; notes: { text: string }[]; matchups?: Record<'all' | 'home' | 'road', { games: number; rows: MRow[] }>; special?: { pp: SUnit[]; pk: SUnit[]; faceoff: { text: string } | null; shots: { x: number; y: number; xg: number; p?: number }[] } };
const LN = linesData.teams as unknown as Record<string, LT>;
const peer: Record<string, string> = { L1: 'first lines', L2: 'second lines', L3: 'third lines', L4: 'fourth lines', P1: 'top defense pairs', P2: 'second defense pairs', P3: 'third defense pairs' };
const lastName = (n: string) => n.split(' ').slice(1).join(' ');
const awayLine = (j: number) => LN[away]?.units.find((u) => u.label === `L${j + 1}`);
const homeUnit = (label: string) => LN[home]?.units.find((u) => u.label === label);
// Box shading lives in blocks.css (it differs between light and dark mode); the page only passes the share.
const heat = (v: number | null) => (v === null ? '' : `--h:${v}`);
const hot = (v: number | null) => ({ hot: (v ?? 0) >= 36, hotter: (v ?? 0) >= 46 });
const homeMu = LN[home]?.matchups?.home;
// With a story at the top, the lineup notes move down into Lines (the faceoff note already shows in Special teams).
const lineNotes = order.flatMap((a) => (LN[a]?.notes ?? []).map((n) => ({ a, text: n.text, names: (n as any).names as string[] | undefined })));
const notes = order.flatMap((a) => [...(LN[a]?.notes ?? []).map((n) => ({ a, text: n.text, names: (n as any).names as string[] | undefined })), ...(LN[a]?.special?.faceoff ? [{ a, text: LN[a].special!.faceoff!.text, names: (LN[a].special!.faceoff as any).names as string[] | undefined }] : [])]);

// Special teams
const stPanels = order.map((pp) => ({ pp, pk: pp === away ? home : away }));

// Goalies
type GMode = { starts: number; shots: number; gsax: number; gsax60: number | null; xga60: number | null; sv: number | null; sa60: number | null; danger: number | null; bd60: number | null; reb?: number | null; reb_exp?: number | null; gap: number | null; long_wait: number | null; qs: number | null; rbs: number | null; bins: number[]; tiers: Record<string, { shots: number; sv: number | null }>; pct: Record<string, number | null> };
type Goalie = { id: number; name: string; blend: GMode; season: GMode };
const G = goalieData.teams as unknown as Record<string, Goalie[]>;
const lg = goalieData.league as { x: number; y: number }[];
const gx = lg.map((p) => p.x), gy = lg.map((p) => Math.abs(p.y));
const xDom: [number, number] = [Math.min(...gx) - 0.1, Math.max(...gx) + 0.1];
const yMax = Math.max(...gy) + 0.1;
const xMid = [...gx].sort((a, b) => a - b)[Math.floor(gx.length / 2)];
const sgn = (v: number) => (Math.abs(v) < 0.05 ? '0.0' : `${v > 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`);
const svp = (v: number | null) => (v === null ? '–' : v.toFixed(3).replace(/^0/, ''));
const gModes = [['blend', 'this season and last'], ['season', 'this season']] as const;
const gSay: Record<string, (g: GMode) => string> = {
  gsax: (g) => `${sgn(g.gsax)} goals saved above expected in ${g.starts} ${g.starts === 1 ? 'start' : 'starts'}`,
  rebounds: (g) => (g.reb == null ? '–' : `a rebound after ${g.reb} of every 100 saves, where the same saves usually give ${g.reb_exp}`),
  busy: (g) => `${g.sa60} shots faced per 60`,
  danger: (g) => (g.danger ? `the average shot he faces has a ${(100 * g.danger).toFixed(1)}% chance of going in` : '–'),
  breakdowns: (g) => `${g.bd60} defensive breakdowns in front of him per 60`,
  gaps: (g) => `a typical wait of ${g.gap} seconds between shots`,
  steady: (g) => `a quality start ${g.qs}% of the time`,
};
// The likely starter first (saved with the preview, from who has started lately), then most starts this season.
const likelyRank = (a: string, id: number) => { const i = snap.starters?.[a]?.indexOf(id) ?? -1; return i < 0 ? 99 : i; };
const goaliesOf = (a: string) => [...(G[a] ?? [])].sort((x, y) => likelyRank(a, x.id) - likelyRank(a, y.id) || y.season.starts - x.season.starts || y.blend.starts - x.blend.starts);
const guessed = [away, home].some((t) => (snap.starters?.[t]?.length ?? 0) > 0);
// The goalie each team is expected to start: NHL.com's projection once its game-day preview is up, else our own guess when it is fairly sure.
const projected = [away, home].flatMap((t) => {
  const p = snap.projected?.[t];
  const g = p && (G[t] ?? []).find((x) => x.id === p.id);
  return p && g ? [{ team: t, name: g.name, from: p.from }] : [];
});

// Goal sources
type Src = { n: number; share: number | null };
type SrcSide = { goals: number; sources: Record<string, Src> };
const SR = srcData.teams as unknown as Record<string, { sources: Record<'blend' | 'season', Record<'for' | 'against', SrcSide>> | null }>;
const lgSrc = srcData.league_sources as Record<string, number>;
const srcMax = (k: string, mode: 'blend' | 'season', side: 'for' | 'against') => Math.max(lgSrc[k] * 2, ...order.map((a) => SR[a]?.sources?.[mode]?.[side]?.sources[k]?.share ?? 0)) * 1.08;

const story = snap.story;
const sides = { [away]: 'away', [home]: 'home' } as Record<string, 'away' | 'home'>;
const nav = [['watch', 'Short version'], ['style', 'Style'], ['lines', 'Lines'], ['special', 'Special teams'], ['goalies', 'Goalies'], ['sources', 'Goal sources'], ['notes', 'Data notes']];
// The matchup note is written for both teams: the home team's shows unless the visitor's own team is the away side.
const povCss = `.pov-away{display:none}html[data-team="${away}"] .pov-away{display:block}html[data-team="${away}"] .pov-home{display:none}`;
const colourCss = `:root{--away:${colours.away};--home:${colours.home}}.t-away{--team:var(--away)}.t-home{--team:var(--home)}`;
const _ = ordinal;
import SharePreview from '../../components/SharePreview.astro';
import ShareButton from '../../components/ShareButton.astro';
---
<Base section="games" title={`${away} at ${home} preview`} description={snap.story?.head ? `${snap.story.head}. What to watch when the ${full(away)} visit the ${full(home)}.` : `What to watch when the ${full(away)} visit the ${full(home)}.`} og={previewOg(snap as any)}>
  <AreaShapes />
  <style is:inline set:html={colourCss + povCss}></style>
  <section class="hero" aria-label="Matchup">
    <GameTrail id={snap.game_id} part="crumbs" />
    <Rink sides={order.map((a) => ({ abbr: a, cls: `t-${side(a)}`, full: full(a), rec: rec(a), home: a === home, href: `${import.meta.env.BASE_URL}team/${a}/` }))} />
    <GameTrail id={snap.game_id} part="around"><p class="when-day" data-local="day">{dateStr}</p><p><strong data-local="time">{timeStr}</strong> · {snap.venue}</p>{!played && <p><ShareButton kind="preview" label="Share this preview" /></p>}</GameTrail>
    {played && (
      <p class="card banner">
        This is the preview as it stood at puck drop.
        Final: {played.away} {played.as}, {played.home} {played.hs}{played.end && played.end !== 'REG' ? ` (${played.end})` : ''}. <a href={`${base}recap/${snap.game_id}/`}>See how it held up</a>.
      </p>
    )}
  </section>
  <SectionNav items={nav as [string, string][]} />

  <section class="sec top" id="watch" aria-label="The short version">
    {story && <GameStory story={story} sides={sides} />}
    {!story && snap.outlook && (
      <div class="card outlook">
        {order.filter((a) => snap.outlook![a]).map((a) => (
          <div class={`pov pov-${side(a)}`}>
            <p class="mini-h">How it looks for {place(a)}</p>
            <h3>{snap.outlook![a].head}</h3>
            <p>{snap.outlook![a].body}</p>
          </div>
        ))}
        <p class="cite">From this site’s win model, which rates each team on how well they have controlled the chances lately, who is in their lineup (including the league’s injury news), home ice and rest. We don’t publish the number before the game; the post-game page shows it and what went into it.</p>
      </div>
    )}
    <ol class="watch">
      {snap.claims.map((c) => <CallCard c={c as any} side={side} />)}
    </ol>
    {!story && notes.length > 0 && (
      <div class="card worth">
        <p class="mini-h">Worth knowing</p>
        <ul>{notes.map((n) => <li><a class={`teampill t-${side(n.a)}`} href={`${base}team/${n.a}/`}>{place(n.a)}</a> <NoteText text={n.text} names={n.names} /></li>)}</ul>
      </div>
    )}
    <p class="note">These calls are written by fixed rules from the numbers below, and saved as they stand at puck drop. After the game, each one will be checked against what happened.{snap.rebuilt && ' Rebuilt with our current methods, from the games before it.'}</p>
  </section>

  <Section id="style" title="Style fingerprints" placeholder={false} takeaway={`How ${place(away)} and ${place(home)} play, trait by trait, on the same scales.`}>
    <Fragment slot="explain">
      <p class="note m-blend">Each scale runs from the league’s lowest team on the left to its highest on the right. Numbers blend last season with the {fpT[away].games} and {fpT[home].games} games played so far; traits that take longer to settle lean more on last season.</p>
      <p class="note m-season">This season only: {fpT[away].games} games for {place(away)}, {fpT[home].games} for {place(home)}. Expect these to swing a lot, which is why the likely ranges are so wide.</p>
      <p class="note">Shot volume, shots against and pace are weighted for the score and home ice, and forecheck pressure and physicality for each arena’s scorer, so all five are shown as scores; switch “Adjusted stats” to Recorded in the settings to see the numbers as recorded. <a href={`${base}methods/`}>How the arena adjustment works</a>.</p>
    </Fragment>
    <div class="key">
      {order.map((a) => <span class={`t-${side(a)}`}><i></i>{full(a)}</span>)}
      <span class="avg">League average</span>
      <span class="rng">Likely range</span>
    </div>
    <h3 class="sub">The biggest differences</h3>
    <ul class="fpgrid">{biggest.map((c) => <FpPair c={c} sides={fpSides} />)}</ul>
    <details class="fold">
      <summary><span class="closed">Show all {traits.length} traits</span><span class="opened">Hide the full set</span></summary>
      <p class="note fpr-hint">Tap a trait for the numbers behind it.</p>
      <div class="fpr-groups"><div class="fpr-cols">
        {twoColumns(fpGroups.map((g) => ({ g, cs: traits.filter((c) => c.group === g) })).filter((x) => x.cs.length), (x) => x.cs.length + 1).map((col) => (
          <div class="fpr-col">
            {col.map(({ item: { g, cs }, order }) => (
              <div class="card fpr-grp" style={`order: ${order}`}>
                <h3>{g}</h3>
                {cs.map((c) => <FpRow c={c} sides={fpSides} />)}
              </div>
            ))}
          </div>
        ))}
      </div></div>
    </details>
  </Section>

  <Section id="lines" title="Lines and deployment" placeholder={false} takeaway={`${place(home)} is at home, so their coach changes last and chooses who plays against whom.`}>
    <Fragment slot="explain">
      <p class="note">Lines and pairs are picked by 5-on-5 ice time together over each team’s last {linesData.window} games ({LN[away]?.games ?? 0} and {LN[home]?.games ?? 0} so far), with each older game counting half as much as the one after it, so the latest combinations come first. They are numbered by their players’ 5-on-5 and power-play ice time, so the first line is the one the coach leans on most. With so few games, each group’s results are pulled toward the average for its line number.</p>
    </Fragment>
    <div class="key">
      <span><span class="pips demo"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></span>How good, against the same line or pair on other teams</span>
      <span><span class="marker demo"><i style="--p:65"></i></span>How much, low to high (not good or bad)</span>
    </div>
    <div class="two">
      {order.map((a) => (
        <div class={`t-${side(a)}`}>
          <h3 class="team-h"><a class="tlink" href={`${base}team/${a}/`}>{full(a)}</a></h3>
          <ul class="units">
            {(LN[a]?.units ?? []).map((u) => (
              <li class="card unit">
                <div class="unit-top">
                  <span class="unit-label">{u.label}</span>
                  <UnitToi toi_sec={u.toi_sec} seconds={u.seconds} gp={u.gp} isNew={u.new} games={LN[a].games} pct={u.pct.sec_pg} peers={peer[u.label]} />
                </div>
                <p class="unit-names">{u.players.map((n, i) => <PLink id={(u as any).ids?.[i]} name={n} />)}</p>
                <dl class="stats">
                  <div><dt><span class="term" tabindex="0" data-tip="Expected goals for per 60: how much offense the team creates with this group on the ice.">Creates</span></dt><dd>{u.xgf60.toFixed(2)}</dd><Pips pct={u.pct.xgf60 ?? 50} tip={`${compared(u.pct.xgf60 ?? 50, 'creates more than', 'creates less than', peer[u.label])}.`} /></div>
                  <div><dt><span class="term" tabindex="0" data-tip="Expected goals against per 60: how much the team gives up with this group on the ice. Lower is better.">Allows</span></dt><dd>{u.xga60.toFixed(2)}</dd><Pips pct={u.pct.xga60 ?? 50} tip={`${compared(u.pct.xga60 ?? 50, 'stingier than', 'leakier than', peer[u.label])}.`} /></div>
                  <div><dt><span class="term" tabindex="0" data-tip="This group’s share of all expected goals while on the ice. Above 50% means they out-chance opponents.">Share</span></dt><dd>{u.share.toFixed(1)}%</dd><Pips pct={u.pct.share ?? 50} tip={`${compared(u.pct.share ?? 50, 'a better share than', 'a worse share than', peer[u.label])}.`} /></div>
                  <div><dt><span class="term" tabindex="0" data-tip="Of the faceoffs this group is on the ice for at either end, the share in the offensive zone.">Off. zone draws</span></dt><dd>{u.oz === null ? '–' : `${u.oz}%`}</dd>{u.oz !== null && <Marker pct={u.pct.oz ?? 50} tip={`${compared(u.pct.oz ?? 50, 'more offensive-zone faceoffs than', 'fewer offensive-zone faceoffs than', peer[u.label])}.`} />}</div>
                </dl>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {story && lineNotes.length > 0 && (
      <div class="card worth lines-worth">
        <p class="mini-h">Worth knowing</p>
        <ul>{lineNotes.map((n) => <li><a class={`teampill t-${side(n.a)}`} href={`${base}team/${n.a}/`}>{place(n.a)}</a> <NoteText text={n.text} names={n.names} /></li>)}</ul>
      </div>
    )}

    {((LN[away] as any)?.deploy || (LN[home] as any)?.deploy) && (
      <div class="two deploy2">
        {[away, home].map((a) => (LN[a] as any)?.deploy && <Deployment d={(LN[a] as any).deploy} abbr={a} title={`Offensive-zone faceoffs: ${place(a)}`} tonight={a === home ? 'home' : 'road'} cls={`t-${side(a)}`} />)}
      </div>
    )}

    <Explain id="pv-mu" title={`Who ${place(home)} is likely to send against whom`}>
      <p class="xp-lead">Each strip shows how one {place(home)} group’s 5-on-5 time at home has been split across opponents’ four forward lines. Tonight those lines are {place(away)}’s, named in each box.</p>
      {homeMu && homeMu.games > 0 && <p class="note">Based on {homeMu.games} {place(home)} home {homeMu.games === 1 ? 'game' : 'games'} this season, so treat it as a habit forming, not a certainty. Faded rows have under ten minutes. <strong>With no line matching</strong>, each group would face an opposing line about as often as that line is on the ice; a number well above that means the coach is sending that group out against it on purpose.</p>}
    </Explain>
    {homeMu && homeMu.games > 0 ? (
      <>
        {LN[away]?.settled?.shuffled && <p class="note">{place(away)} keeps changing their forward lines, so the four named here (from their latest games) may not be the ones they send out tonight.</p>}
        <div class="card stripcard">
          <p class="opp-key t-away"><span class="mini-h">{place(away)}’s lines tonight</span>{[0, 1, 2, 3].map((j) => <span><b>L{j + 1}</b> {(awayLine(j)?.players ?? []).map(lastName).join(' · ') || '–'}</span>)}</p>
          {[['L', 'Forward lines'], ['P', 'Defense pairs']].map(([kind, title]) => (
            <>
              <h4 class="mini-h">{place(home)} {title.toLowerCase()} against {place(away)} forward lines</h4>
              <ul class="strips">
                {homeMu.rows.filter((r) => r.label[0] === kind).map((r) => {
                  const mine = (homeUnit(r.label)?.players ?? []).map(lastName);
                  return (
                    <li class:list={{ thin: r.minutes < 10 }}>
                      <span class="lab t-home" data-tip={`${(homeUnit(r.label)?.players ?? []).join(', ')}. ${mmss(r.seconds)} of 5-on-5 at home.`}><b>{r.label}</b>{mine.join(' · ')}</span>
                      <span class="strip">
                        {r.share.map((v, j) => {
                          const opp = (awayLine(j)?.players ?? []).map(lastName);
                          return <span class:list={hot(v)} style={`--f:${Math.max(v ?? 0, 1)};${heat(v)}`} data-tip={v === null ? 'No ice time yet.' : `At home, ${mine.join(', ')} (${r.label}) have spent ${v}% of their 5-on-5 time against opponents’ ${['first', 'second', 'third', 'fourth'][j]} lines. With no line matching it would be about ${r.expected[j]}%. Tonight that line is ${opp.join(', ') || `${place(away)}’s L${j + 1}`}.`}><i>{away} L{j + 1}</i>{v === null ? '–' : `${v}%`}</span>;
                        })}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </>
          ))}
        </div>
      </>
    ) : <p class="note">{place(home)} has not played at home yet this season, so there is no matching habit to show.</p>}
  </Section>

  <Section id="special" title="Special teams" placeholder={false} takeaway="Each power play set against the penalty killers it will face.">
    <Fragment slot="explain">
      <p class="note">Units and penalty-kill roles use each team’s last {linesData.window} games; power-play role tags use this season and last, counting only games with the player’s current team; the map shows the last 140 power-play shots. Point at a power-play name to see his shots on the map.</p>
    </Fragment>
    <div class="stpick">
      <span>Show</span>
      <select id="st-team" aria-label="Team">{order.map((a) => <option value={a} data-abbr={a}>{place(a)}</option>)}</select>
      <select id="st-sit" aria-label="Situation"><option value="pp" selected>on the power play</option><option value="pk">on the penalty kill</option></select>
    </div>
    {stPanels.map(({ pp, pk }, i) => {
      const P = LN[pp]?.special, K = LN[pk]?.special;
      const ppE = fpT[pp].dims.pp.blend, pkE = fpT[pk].dims.pk.blend;
      return (
        <div class="stblock" data-pp={pp} hidden={i !== 0}>
          <h3 class="sub">{place(pp)} power play against {place(pk)} penalty kill</h3>
          <ul class="tiles">
            <li class:list={['card', 'tile', `t-${side(pp)}`]}>
              <p class="tile-h"><i></i><span class="term" tabindex="0" data-tip="Expected goals per 60 minutes of 5-on-4 play, this season blended with last.">{place(pp)} power play</span></p>
              <p class="tile-v"><strong>{ppE.v.toFixed(1)}</strong> <span class="n">expected goals per 60 · {ordinal(ppE.rank)} of 32</span></p>
            </li>
            <li class:list={['card', 'tile', `t-${side(pk)}`]}>
              <p class="tile-h"><i></i><span class="term" tabindex="0" data-tip="Expected goals allowed per 60 minutes of 4-on-5 play, this season blended with last. Lower is better.">{place(pk)} penalty kill</span></p>
              <p class="tile-v"><strong>{pkE.v.toFixed(1)}</strong> <span class="n">expected goals allowed per 60 · {ordinal(pkE.rank)} of 32</span></p>
            </li>
          </ul>
          {P?.faceoff && <div class="card worth"><p class="mini-h">Worth knowing</p><ul><li><NoteText text={P.faceoff.text} names={(P.faceoff as any).names} /></li></ul></div>}
          <div class="st3">
            <div class:list={['card', `t-${side(pp)}`]}>
              <h4 class="st-h"><i></i>{place(pp)} power play</h4>
              {(P?.pp ?? []).map((u, k) => (
                <div class="stunit">
                  <p class="stunit-h"><span class="unit-label">{u.label}</span><span class="n term" tabindex="0" data-tip="Share of the team’s power-play time with this unit’s quarterback on the ice.">{u.share}% of the time</span></p>
                  <p class="stunit-rate"><span>Creates <strong>{u.rate.toFixed(1)}</strong> expected goals per 60</span><Pips pct={u.pct ?? 50} tip={`${compared(u.pct ?? 50, 'more than', 'less than', `${k ? 'second' : 'top'} power-play units`)}. ${mmss(u.seconds)} on the ice.`} /></p>
                  <ul class="roles-list">{u.players.map((pl) => <li><span><span class="plink" tabindex="0" data-shooter={pl.id}>{pl.name}</span>{pl.after && <span class="n both term" tabindex="0" data-tip={`${pl.after} usually takes the faceoff, then changes for ${pl.name}. Their ice time is counted together here.`}>({pl.after})</span>}{pl.both && <span class="n both term" tabindex="0" data-tip="He regularly stays out when the units change, so he is listed on both.">both units</span>}</span>{pl.role && <span class="chip tag" tabindex="0" data-tip={roleTip[pl.role]}>{pl.role}</span>}</li>)}</ul>
                </div>
              ))}
            </div>
            <div class="card mapcard ppmap">
              <p class="map-who" aria-live="polite">&nbsp;</p>
              {P && P.shots.length > 0 && <ShotMap long team={side(pp)} shots={P.shots} title={`Where ${place(pp)}’s last ${P.shots.length} power-play shots came from.`} />}
            </div>
            <div class:list={['card', `t-${side(pk)}`]}>
              <h4 class="st-h"><i></i>{place(pk)} penalty kill</h4>
              <PkRoles roles={(K as any)?.pk_roles} />
            </div>
          </div>
        </div>
      );
    })}
  </Section>

  <Section id="goalies" title="Goalies" placeholder={false} takeaway="Is each goalie stopping more than he should, and what is his team asking him to face?">
    <Fragment slot="explain">
      <p class="note">{guessed ? 'The menus list every goalie on each team and open on the one we expect to start: NHL.com’s projected starter once its game-day preview is up (right about 9 times in 10 this season), otherwise our own guess from who has started lately and whether it is the second night of a back-to-back (right about 7 times in 10 in past seasons).' : 'The menus list every goalie on each team, busiest this season first; the site does not yet know who will start.'} Expected-goal models can’t see passes before a shot, so a goalie whose team gives up many cross-ice passes looks worse here than he really is.</p>
    </Fragment>
    <div class="stpick">
      <span>Show</span>
      <select id="g-away" aria-label={`${place(away)} goalie`}>{goaliesOf(away).map((g) => <option value={String(g.id)}>{g.name}</option>)}</select>
      <span>against</span>
      <select id="g-home" aria-label={`${place(home)} goalie`}>{goaliesOf(home).map((g) => <option value={String(g.id)}>{g.name}</option>)}</select>
    </div>
    {projected.length > 0 && (
      <p class="projected">
        <span class="lbl">Projected starters</span>
        {projected.map((p, i) => (
          <span class={`t-${side(p.team)}`}>{i > 0 && ' · '}<i></i><b>{p.name}</b> <span class="term" tabindex="0" data-tip={p.from === 'nhl' ? 'From NHL.com’s game-day preview. Its projected starter has started about 9 times in 10 this season.' : 'Our guess from who has started lately and whether it is the second night of a back-to-back. Right about 3 times in 4 when we are this sure; NHL.com’s projection replaces it once its game-day preview is up.'}>{p.from === 'nhl' ? 'NHL.com' : 'likely'}</span></span>
        ))}
      </p>
    )}
    {gModes.map(([mode, words]) => (
      <div class={`gmode m-${mode}`}>
        <div class="g3">
          {[away, null, home].map((a) => a === null ? (
            <div class="card gmid">
              <p class="chart-title"><span class="term" tabindex="0" data-tip="Higher means the goalie is stopping more than expected. Further right means his team gives up more in front of him. Gray dots are every goalie with at least ten starts over this season and last; point at one to see who it is.">Helping, or hung out to dry?</span></p>
              {lg.length === 0 ? <p class="note">No goalie has played yet this season.</p> : <Quadrant tall league={lg} xDomain={xDom} yDomain={[-yMax, yMax]} xMid={xMid} highlights={order.flatMap((t) => goaliesOf(t).filter((o) => o.blend.xga60 !== null && o.blend.gsax60 !== null).map((o) => ({ team: side(t), name: o.name, probable: o.blend.starts >= goalieData.min_starts.blend, x: o.blend.xga60!, y: o.blend.gsax60! })))} />}
            </div>
          ) : goaliesOf(a).map((g, gi) => {
            const x = g[mode];
            const few = x.pct.gsax === null;
            return (
              <div class:list={['card', 'gcard', `t-${side(a)}`]} data-goalie={g.id} hidden={gi !== 0}>
                <div class="ghead">
                  <div class="ghead-text">
                    <p class="gname"><i></i><PLink id={g.id} name={g.name} /><span class="n">{x.starts} {x.starts === 1 ? 'start' : 'starts'} · {x.shots} shots, {words}</span></p>
                    <p class="gbig"><strong>{sgn(x.gsax)}</strong> <span class="term" tabindex="0" data-tip="Goals saved above expected: how many goals he has prevented compared with an average goalie facing the same shots. Positive is good.">goals saved above expected</span> {few ? <span class="n">too few starts to rate</span> : <Pips pct={x.pct.gsax!} tip={`Saving more than expected, per 60, pulled toward average until he has faced enough shots: ${compared(x.pct.gsax!, 'better than', 'worse than', 'goalies', true)}.`} />}</p>
                  </div>
                  <Portrait id={g.id} size={96} class="g-photo" />
                </div>
                <dl class="gkv">
                  {(['low', 'medium', 'high'] as const).map((t) => <div><dt>{t[0].toUpperCase() + t.slice(1)}-danger save %</dt><dd>{svp(x.tiers[t].sv)} <span class="n">{x.tiers[t].shots} shots</span></dd></div>)}
                  <div><dt><span class="term" tabindex="0" data-tip="Shots on goal he faces per 60.">Shots faced per 60</span></dt><dd>{x.sa60 ?? '–'} {!few && <Marker pct={x.pct.busy!} tip={`${compared(x.pct.busy!, 'busier than', 'quieter than', 'goalies')}.`} />}</dd></div>
                  <div><dt><span class="term" tabindex="0" data-tip="Dangerous chances his team gives up in front of him within seconds of losing the puck, per 60. Public data cannot see where defenders are.">Defensive breakdowns per 60</span></dt><dd>{x.bd60 ?? '–'} {!few && <Marker pct={x.pct.breakdowns!} tip={`${x.pct.breakdowns! > 55 ? `His team breaks down in front of him more often than ${x.pct.breakdowns}% of goalies’ teams do` : x.pct.breakdowns! < 45 ? `His team breaks down in front of him less often than ${100 - x.pct.breakdowns!}% of goalies’ teams do` : 'His team breaks down in front of him about as often as most'}.`} />}</dd></div>
                  <div><dt><span class="term" tabindex="0" data-tip="Share of starts where he gave his team a fair chance to win: a save percentage at or above league average, or at least .885 on a light night.">Quality starts</span></dt><dd>{x.qs === null ? '–' : `${x.qs}%`} {!few && <Pips pct={x.pct.steady!} tip={`${compared(x.pct.steady!, 'steadier than', 'streakier than', 'goalies')}.`} />}</dd></div>
                </dl>
              </div>
            );
          }))}
        </div>
        <details class="fold">
          <summary><span class="closed">Show the full goalie comparison</span><span class="opened">Hide the full goalie comparison</span></summary>
          <ul class="fpgrid">
            {goalieTraitInfo.map((t) => (
              <li class="card fpc">
                <span class="term fpc-name" role="heading" aria-level="3" tabindex="0" data-tip={t.tip}>{t.label}</span>
                <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
                <div class="lanes">
                  {order.flatMap((a) => goaliesOf(a).map((g, gi) => {
                    const p = g[mode].pct[t.key];
                    return p === null ? <div class:list={['lane', 'empty', `t-${side(a)}`]} data-goalie={g.id} hidden={gi !== 0}></div> : <div class:list={['lane', `t-${side(a)}`]} data-goalie={g.id} hidden={gi !== 0} style={`--b:${p};--blo:${p};--bhi:${p};--c:${p};--clo:${p};--chi:${p}`}><span class="whisk"></span><span class="dot"></span></div>;
                  }))}
                </div>
                <ul class="gsays">
                  {order.flatMap((a) => goaliesOf(a).map((g, gi) => <li class={`t-${side(a)}`} data-goalie={g.id} hidden={gi !== 0}><i></i><span><b>{g.name}:</b> {gSay[t.key](g[mode])}{g[mode].pct[t.key] === null && <em> (too few starts to place)</em>}</span></li>))}
                </ul>
              </li>
            ))}
          </ul>
          <div class="two gnights">
            {order.flatMap((a) => goaliesOf(a).map((g, gi) => (
              <div class:list={['card', `t-${side(a)}`]} data-goalie={g.id} hidden={gi !== 0}>
                <p class="mini-h">{g.name}, night to night: rough, about expected and strong starts</p>
                <Histogram wide team={side(a)} bins={g[mode].bins.map((n, k) => ({ lo: k - 3, n }))} name={g.name} />
              </div>
            )))}
          </div>
        </details>
      </div>
    ))}
  </Section>

  <Section id="sources" title="Where the goals come from" placeholder={false} takeaway="How each team’s goals are scored, or allowed, against the league average.">
    <Fragment slot="explain">
      <p class="note">These mixes are mostly luck: over three seasons, teams’ goals came from much the same places, and most of the differences here didn’t last. Each team page shows how much luck alone can move each row.</p>
      <p class="note">Each row has its own scale, so a small source is not squeezed against the left edge.</p>
    </Fragment>
    <div class="stpick">
      <span>Show goals</span>
      <select id="src-side" aria-label="Scored or allowed"><option value="for">scored</option><option value="against">allowed</option></select>
    </div>
    <div class="key">
      {order.map((a) => <span class={`t-${side(a)}`}><i></i>{place(a)}</span>)}
      <span class="avg">League average</span>
    </div>
    {(['for', 'against'] as const).map((sd, si) => (
      <div data-src={sd} hidden={si !== 0}>
        {gModes.map(([mode, words]) => {
          const got = order.map((a) => SR[a]?.sources?.[mode]?.[sd]);
          return (
            <div class={`gmode m-${mode}`}>
              <div class="card">
                <ul class="srows">
                  {srcInfo.map(([k, label, tip]) => {
                    const max = srcMax(k, mode, sd), at = (v: number) => (v / max) * 100;
                    const vals = got.map((x) => x?.sources[k]?.share ?? null);
                    const [va, vh] = vals;
                    return (
                      <li>
                        <span class="term srow-name" tabindex="0" data-tip={tip}>{label}</span>
                        <span class="sline" tabindex="0" data-tip={`${order.map((a, i) => `${place(a)} ${vals[i] ?? '–'}% (${got[i]?.sources[k]?.n ?? 0} of ${got[i]?.goals ?? 0})`).join(', ')} of goals ${sd === 'for' ? 'scored' : 'allowed'} ${words}. League average ${lgSrc[k]}%.`}>
                          <span class="slg" style={`left:${at(lgSrc[k])}%`}></span>
                          {va !== null && vh !== null && <span class="sspan" style={`left:${at(Math.min(va, vh))}%;width:${at(Math.abs(va - vh))}%`}></span>}
                          {order.map((a, i) => vals[i] !== null && <span class={`sdot t-${side(a)}`} style={`left:${at(vals[i]!)}%`}></span>)}
                        </span>
                        <span class="snums two-n">{order.map((a, i) => <span class={`t-${side(a)}`}><i></i>{vals[i] ?? '–'}%</span>)}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
              <p class="note">{order.map((a, i) => `${got[i]?.goals ?? 0} ${place(a)} goals`).join(' and ')} {sd === 'for' ? 'scored' : 'allowed'} {words}.</p>
            </div>
          );
        })}
      </div>
    ))}
  </Section>

  <Section id="notes" title="Data notes" placeholder={false}>
    <ul class="notes">
      <li><strong>Sources.</strong> Game data from the NHL; expected goals from this site’s own model.</li>
      <li><strong>Early season.</strong> {place(away)} has played {fpT[away].games} games and {place(home)} {fpT[home].games}, so most numbers blend this season with last. The season switch at the top shows this season alone.</li>
      <li><strong>Percentiles and ranks</strong> compare a team or player with the rest of the league: 90 means better than 90% of the league at that thing.</li>
      <li><strong>Blind spots.</strong> Public game data doesn’t record passes before a shot, where defenders are standing, or rushes up the ice, so the site shows none of those.</li>
      <li><strong>Hits, giveaways and takeaways</strong> depend on each arena’s scorer; anything built on them is arena-adjusted. <a href={`${base}methods/`}>How it works</a>.</li>
      <li><strong>Key players</strong> for each side are on the team pages.</li>
    </ul>
    <p class="note">Team pages: <a href={`${base}team/${away}/`}>{full(away)}</a> · <a href={`${base}team/${home}/`}>{full(home)}</a></p>
  </Section>
  {!played && <SharePreview snap={snap as any} records={{ [away]: rec(away), [home]: rec(home) }} />}
</Base>

<script is:inline define:vars={{ startIso: start.toISOString() }}>
  // The page is built with Eastern times; the browser swaps in the visitor's own day and time, like every other page.
  const t = new Date(startIso);
  const fmt = { day: { weekday: 'long', month: 'long', day: 'numeric' }, time: { hour: 'numeric', minute: '2-digit' } };
  document.querySelectorAll('[data-local]').forEach((n) => { n.textContent = new Intl.DateTimeFormat(undefined, fmt[n.dataset.local]).format(t); });
</script>

<style>
  /* The short version opens the page without a heading, like the post-game overview. */
  .top { margin-top: 28px; }
  .hero { margin-top: 0; }
  .banner { margin-top: 16px; padding: 12px 16px; }
  .outlook { margin-bottom: 16px; }
  .outlook h3 { margin: 4px 0 6px; }
  .watch { display: grid; gap: 16px; margin-top: 22px; }
  @media (min-width: 720px) { .watch { grid-template-columns: 1fr 1fr; } }
  .cite { font: 400 12px var(--ui); color: var(--ink-3); }
  .watch + .worth { margin-top: 16px; }
  .lines-worth { margin: 20px 0 8px; }
  .stpick { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 22px; font: 600 20px var(--display); }
  .projected { margin: 12px 0 0; font: 400 15px/1.6 var(--ui); color: var(--ink); }
  .projected .lbl { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); margin-right: 10px; }
  .projected i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--team); margin-right: 6px; }
  .projected .term { color: var(--ink-2); }
  .projected > span:not(.lbl) { white-space: nowrap; }
  .stpick select { font: 600 17px var(--ui); color: var(--ink); background: var(--sheet); border: 0; border-bottom: 3px solid var(--ink); border-radius: 8px 8px 0 0; padding: 8px 10px; max-width: 100%; cursor: pointer; }
  .stblock .sub { margin-top: 26px; }
  .tiles { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); margin: 14px 0 12px; }
  .tile { display: grid; gap: 6px; }
  .tile-h { display: flex; align-items: center; gap: 8px; font: 600 14px var(--ui); }
  .tile-h i, .st-h i, .gname i { width: 10px; height: 10px; border-radius: 50%; background: var(--team); flex: none; }
  .tile-v strong { font: 700 28px/1 var(--display); }
  .st-h { display: flex; align-items: center; gap: 8px; }
  .g3 { display: grid; gap: 12px; margin-top: 18px; }
  @media (min-width: 900px) { .g3 { grid-template-columns: 1fr 1.15fr 1fr; } }
  .g3 > [hidden], .gnights > [hidden], .fpc [hidden] { display: none; }
  .gmid { display: flex; flex-direction: column; justify-content: center; }
  .gname { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .gsays { display: grid; gap: 6px; font: 400 14px/1.4 var(--ui); }
