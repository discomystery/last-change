  .goalie { margin-bottom: 14px; }
  .explain { margin-top: 18px; }
  .explain p { margin-top: 10px; font: 400 15px/1.5 var(--ui); }
  .after { margin-top: 28px; font-weight: 600; }
  .goalie header { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .goalie h4 { font: 700 24px/1 var(--display); margin: 0; }
  .gsax { margin-top: 8px; font-size: 14px; }
  .gsax strong { font: 700 38px/1 var(--display); margin-right: 4px; }
  .tiers { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 13px; }
  .tiers th, .tiers td { padding: 5px 0; border-bottom: 1px solid var(--rule); text-align: right; font-weight: 500; }
  .tiers thead th { font-size: 11px; color: var(--ink-3); font-weight: 600; }
  .tiers tbody th { text-align: left; }
