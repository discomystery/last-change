</style>

<style is:global>
  /* Season switch: the page carries both sets of numbers and shows one. */
  .m-season { display: none; }
  html[data-mode='season'] .m-season { display: revert; }
  html[data-mode='season'] .m-blend { display: none; }
  .mode-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 20px; font-family: var(--ui); font-size: 13px; color: var(--ink-2); }
  .mode-label { font-weight: 600; }
  .mode { display: inline-flex; border: 1px solid var(--ink); border-radius: 999px; padding: 2px; background: var(--sheet); }
  .mode button { font: 600 13px var(--ui); color: var(--ink); background: none; border: 0; border-radius: 999px; padding: 6px 12px; cursor: pointer; }
  .mode button[aria-pressed='true'] { background: var(--ink); color: var(--sheet); }

  /* Fingerprint cards */
  .fpgrid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); }
  .fpc { display: grid; gap: 10px; align-content: start; }
  .fpc-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .fpc-name { font: 600 20px/1.15 var(--display); font-variation-settings: 'SOFT' 100; }
  .ends { display: flex; justify-content: space-between; gap: 8px; font: italic 400 14px var(--body); color: var(--ink-2); margin-bottom: -4px; }
  .lanes { position: relative; display: grid; gap: 4px; padding: 4px 7px; }
  .lanes::after { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--ink); opacity: 0.5; border-radius: 1px; }
  .lane { position: relative; height: 14px; --v: var(--b); --w: var(--bb); }
  html[data-mode='season'] .lane { --v: var(--c); --w: var(--cb); }
  .lane::before { content: ''; position: absolute; left: -7px; right: -7px; top: 5px; height: 4px; border-radius: 2px; background: var(--track); }
  .whisk { position: absolute; top: 5px; height: 4px; border-radius: 2px; background: color-mix(in oklab, var(--team) 45%, var(--track)); left: calc(max(0, var(--v) - var(--w)) * 1%); width: calc((min(100, var(--v) + var(--w)) - max(0, var(--v) - var(--w))) * 1%); transition: left 0.35s, width 0.35s; }
  .dot { position: absolute; top: 0; left: calc(var(--v) * 1%); width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--team); box-shadow: 0 0 0 2px var(--sheet); z-index: 1; transition: left 0.35s; }
  @media (prefers-reduced-motion: reduce) { .dot, .whisk { transition: none; } }
  .fpc-stats { display: grid; gap: 6px; font: 400 14px/1.4 var(--ui); }
  .fpc-stats li { display: grid; grid-template-columns: 10px 1fr; gap: 8px; align-items: baseline; }
  .fpc-stats li > span { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 12px; }
  html[data-mode='season'] .fpc-stats li > .m-blend, html:not([data-mode='season']) .fpc-stats li > .m-season { display: none; }
  .fpc-stats i { width: 10px; height: 10px; border-radius: 50%; background: var(--team); }
  .fpc-stats em { font-style: normal; color: var(--ink-3); white-space: nowrap; }
</style>
<script is:inline>
  (() => {
    const set = (mode) => {
      document.documentElement.dataset.mode = mode;
      document.querySelectorAll('[data-mode-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBtn === mode)));
      try { localStorage.setItem('mode', mode); } catch {}
    };
    let saved = 'blend';
    try { saved = localStorage.getItem('mode') || 'blend'; } catch {}
    set(saved);
    document.querySelectorAll('[data-mode-btn]').forEach((b) => b.addEventListener('click', () => set(b.dataset.modeBtn)));
  })();
</script>
