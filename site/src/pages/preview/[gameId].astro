---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Bar from '../../components/Bar.astro';
import ShotMap from '../../components/ShotMap.astro';
import Histogram from '../../components/Histogram.astro';
import Quadrant from '../../components/Quadrant.astro';
import Rink from '../../components/Rink.astro';
import FpCard from '../../components/FpCard.astro';
import Pips from '../../components/Pips.astro';
import Marker from '../../components/Marker.astro';
import * as m from '../../data/mock';

export function getStaticPaths() {
  return [{ params: { gameId: String(m.game.id) } }];
}

const { away, home, teams, order } = m;
const start = new Date(m.game.startTimeUTC);
const dateStr = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/New_York' }).format(start);
const timeStr = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }).format(start) + ' ET';
const asOf = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }).format(new Date(m.fetchedAt)) + ' ET';
const rec = (a: m.Abbr) => `${teams[a].record.w}-${teams[a].record.l}-${teams[a].record.otl}`;
const full = (a: m.Abbr) => `${teams[a].place} ${teams[a].name}`;
const heat = (v: number) => `background: color-mix(in oklab, var(--ink) ${Math.round(v * 1.7)}%, var(--sheet)); color: ${v >= 32 ? 'var(--sheet)' : 'var(--ink)'}`;
const maxSource = Math.max(...m.goalSources.flatMap((s) => [s.CAR, s.EDM, s.lg]));
const quadHighlights = order.flatMap((a) => m.goalies[a].map((g) => ({ team: a, name: g.name, probable: g.probable, x: g.xga60, y: g.gsax60 })));
const signed = (v: number) => (v > 0 ? `+${v}` : v < 0 ? `−${Math.abs(v)}` : '0');
const biggest = [...m.fpCards].sort((x, y) => Math.abs(y.CAR.blend.pct - y.EDM.blend.pct) - Math.abs(x.CAR.blend.pct - x.EDM.blend.pct)).slice(0, 6);
const other = (a: m.Abbr): m.Abbr => (a === 'CAR' ? 'EDM' : 'CAR');
const stEnds: Record<string, [string, string]> = { 'Power play': ['Harmless', 'Lethal'], 'Penalty kill': ['Leaky', 'Airtight'], 'Power kill': ['Bunkered', 'Predatory'], Discipline: ['Reckless', 'Clean'] };
const stName: Record<string, string> = { 'Power play': 'power play', 'Penalty kill': 'penalty kill', 'Power kill': 'shorthanded threat', Discipline: 'discipline' };
const stViews = [
  { id: 'away', label: teams[away].place, pp: away, pk: away },
  { id: 'home', label: teams[home].place, pp: home, pk: home },
  { id: 'away-pp', label: `${teams[away].place} power play vs ${teams[home].place} penalty kill`, pp: away, pk: home },
  { id: 'home-pp', label: `${teams[home].place} power play vs ${teams[away].place} penalty kill`, pp: home, pk: away },
];
const stDefault = 2;
const neutralSig = new Set(['Hits', 'Defensive-zone starts', 'Shorthanded ice time', 'Rush shots', 'Competition faced']);
const nav = [
  ['watch', 'Short version'], ['style', 'Style'], ['lines', 'Lines'], ['special', 'Special teams'],
  ['goalies', 'Goalies'], ['win', 'How they win'], ['players', 'Key players'], ['notes', 'Data notes'],
];
---
<Base title={`${away} at ${home} preview`}>
  <section class="hero" aria-label="Matchup">
    <Rink />
    <dl class="meta">
      <div><dt>When</dt><dd>{dateStr}, {timeStr}</dd></div>
      <div><dt>Where</dt><dd>{m.game.venue}</dd></div>
      <div><dt>Probable goalies</dt><dd>{m.goalies[away][0].name} · {m.goalies[home][0].name}</dd></div>
      <div><dt>Data as of</dt><dd>{asOf}</dd></div>
    </dl>
  </section>
  <nav class="jump sticky" id="jump" aria-label="Sections">
    {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
  </nav>

  <Section id="watch" title="The short version">
    <ol class="watch">
      {m.insights.map((i) => (
        <li class="card">
          <h3>{i.head}</h3>
          <p>{i.body}</p>
          <p class="cite">{i.cite}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="style" title="Style fingerprints" takeaway="Carolina floods the net with shots from everywhere; Edmonton takes fewer and better ones, especially off the rush.">
    <div class="key">
      {order.map((a) => <span class={`t-${a}`}><i></i>{full(a)}</span>)}
      <span class="avg">League average</span>
      <span class="rng">Likely range</span>
    </div>
    <p class="note m-blend">Each scale runs from the league’s lowest team on the left to its highest on the right. Numbers blend last season with the {teams[away].record.gp} or {teams[home].record.gp} games played so far.</p>
    <p class="note m-season">This season only: {teams[away].record.gp} games for {teams[away].place}, {teams[home].record.gp} for {teams[home].place}. Expect these to swing a lot, which is why the likely ranges are so wide.</p>
    <h3 class="sub">The biggest differences</h3>
    <ul class="fpgrid">
      {biggest.map((c) => <FpCard c={c} />)}
    </ul>
    <details class="fold">
      <summary><span class="closed">Show all {m.fpCards.length} traits</span><span class="opened">Hide the full set</span></summary>
      {m.fpGroups.map((g) => (
        <>
          <h3 class="sub">{g}</h3>
          <ul class="fpgrid">
            {m.fpCards.filter((c) => c.group === g).map((c) => <FpCard c={c} />)}
          </ul>
        </>
      ))}
    </details>
    <h3 class="sub">Where the styles collide</h3>
    <ul class="clashes">
      {m.clashes.map((c) => (
        <li class="card">
          <p><strong>{teams[c.attacker].place}</strong> {c.phrase.split(' against ')[0]} <span class="big">{c.o}</span></p>
          <p class="vs">against</p>
          <p><strong>{teams[c.defender].place}</strong> {c.phrase.split(' against ')[1]} <span class="big">{c.d}</span></p>
        </li>
      ))}
    </ul>
    <p class="note">The big numbers are league percentiles: 90 means better than 90% of the league at that thing.</p>
  </Section>

  <Section id="lines" title="Lines and deployment" takeaway={`${teams[home].place} is at home, so ${teams[home].coach ?? 'its coach'} chooses who plays against whom.`}>
    <div class="key">
      <span><span class="pips demo"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></span>How good, against the same line or pair on other teams</span>
      <span><span class="marker demo"><i style="--p:65"></i></span>How much, low to high (not good or bad)</span>
    </div>
    <p class="note">Players are those who dressed in each team’s most recent game. How they are grouped here is a placeholder.</p>
    <div class="two">
      {order.map((a) => (
        <div class={`t-${a}`}>
          <h3 class="team-h">{full(a)}</h3>
          <ul class="units">
            {[...m.lines[a].fwd, ...m.lines[a].def].map((u) => {
              const pr = m.peers[a][u.label];
              const grp = m.peerName[u.label];
              return (
                <li class="card unit">
                  <div class="unit-top">
                    <span class="unit-label">{u.label}</span>
                    <span class="chip">{u.role}</span>
                    <span class="unit-toi"><strong>{u.toi.toFixed(1)}</strong> min a game <Marker pct={pr.toi} tip={`More 5-on-5 ice time than ${pr.toi}% of ${grp} around the league.`} /></span>
                  </div>
                  <p class="unit-names">{u.players.map((n) => <span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{n}</span>)}</p>
                  <dl class="stats">
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals for per hour: how much offense the team creates with this group on the ice.">Creates</span></dt><dd>{u.xgf.toFixed(2)}</dd><Pips pct={pr.xgf} tip={`Creates more than ${pr.xgf}% of ${grp}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals against per hour: how much the team gives up with this group on the ice. Lower is better.">Allows</span></dt><dd>{u.xga.toFixed(2)}</dd><Pips pct={pr.xga} tip={`Stingier than ${pr.xga}% of ${grp}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="This group’s share of all expected goals while on the ice. Above 50% means they out-chance opponents.">Share</span></dt><dd>{u.xgfPct.toFixed(1)}%</dd><Pips pct={pr.share} tip={`A better share than ${pr.share}% of ${grp}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Of the shifts the coach starts with a faceoff at either end, the share that start in the offensive zone.">Off. starts</span></dt><dd>{u.ozs}%</dd><Marker pct={pr.ozs} tip={`More offensive-zone starts than ${pr.ozs}% of ${grp}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="How tough the opponents they face are.">Competition</span></dt><dd>{u.qoc}</dd><Marker pct={pr.qoc} tip={`Tougher opponents than ${pr.qoc}% of ${grp}.`} /></div>
                  </dl>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <h3 class="sub">Who {teams[home].place} is likely to send against whom</h3>
    <p class="takeaway">Each row shows how one {teams[home].place} group’s 5-on-5 time is split across {teams[away].place}’s four forward lines, based on {teams[home].coach ?? 'the coach'}’s habits at home.</p>
    <div class="two">
      {[{ title: 'forward lines', rows: m.lines[home].fwd, data: m.matchupMatrix }, { title: 'defense pairs', rows: m.lines[home].def, data: m.pairMatrix }].map((h) => (
        <div class="card">
          <h4 class="mini-h">{teams[home].place} {h.title} against {teams[away].place} forward lines</h4>
          <table class="heat">
            <thead><tr><td></td>{m.lines[away].fwd.map((l) => <th scope="col">{away} {l.label}</th>)}</tr></thead>
            <tbody>
              {h.rows.map((r, i) => (
                <tr>
                  <th scope="row">{home} {r.label}</th>
                  {h.data[i].map((v, j) => <td style={heat(v)} data-tip={`${home} ${r.label} (${r.players.join(', ')}) spends ${v}% of its 5-on-5 time against ${away} ${m.lines[away].fwd[j].label} (${m.lines[away].fwd[j].players.join(', ')})`}>{v}%</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>
    <details class="fold">
      <summary><span class="closed">Show previous meetings</span><span class="opened">Hide previous meetings</span></summary>
      <ul class="two meet">
        {m.meetings.map((g) => <li class="card"><p><strong>{g.score}</strong> <span class="n">{g.date}, {g.site}</span></p><p class="note">{g.note}</p></li>)}
      </ul>
    </details>
  </Section>

  <Section id="special" title="Special teams" takeaway="Edmonton’s power play is the most dangerous unit in the game, but Carolina’s penalty killers attack rather than sit back.">
    <div class="stpick">
      <span>Show</span>
      <select id="st-team" aria-label="Team">
        {order.map((a) => <option value={a === away ? 'away' : 'home'} data-abbr={a}>{teams[a].place}</option>)}
      </select>
      <select id="st-sit" aria-label="Situation">
        <option value="all">across all special teams</option>
        <option value="pp" selected>on the power play</option>
        <option value="pk">on the penalty kill</option>
      </select>
    </div>
    {stViews.map((v, i) => {
      const pp = m.specialTeams[v.pp];
      const pk = m.specialTeams[v.pk];
      const solo = v.pp === v.pk;
      const tiles = solo
        ? pp.rates.map((r) => ({ team: v.pp, r }))
        : [{ team: v.pp, r: pp.rates[0] }, { team: v.pk, r: pk.rates[1] }, { team: v.pk, r: pk.rates[2] }, { team: v.pk, r: pk.rates[3] }];
      return (
        <div class="stblock" id={`stpanel-${v.id}`} hidden={i !== stDefault}>
          <h3 class="sub">{solo ? `${teams[v.pp].place}’s special teams` : `${teams[v.pp].place} power play against ${teams[v.pk].place} penalty kill`}</h3>
          <p class="note">Projected {teams[v.pp].place} power plays in this game: <strong>{pp.projectedOpps.toFixed(1)}</strong></p>
          <ul class="tiles">
            {tiles.map(({ team, r }) => (
              <li class:list={['card', 'tile', `t-${team}`]}>
                <p class="tile-h"><i></i><span class="term" tabindex="0" data-tip={r.tip}>{teams[team].place} {stName[r.label]}</span></p>
                <p class="tile-v"><strong>{r.value}</strong> <span class="n">{r.unit}</span></p>
                <div class="ends"><span>{stEnds[r.label][0]}</span><span>{stEnds[r.label][1]}</span></div>
                <div class="lanes"><div class="lane" style={`--b:${r.pct};--bb:10;--c:${r.pct};--cb:10`} data-tip={`${teams[team].place}: ${r.pct}th percentile`}><span class="whisk"></span><span class="dot"></span></div></div>
              </li>
            ))}
          </ul>
          <div class="st3">
            <div class:list={['card', `t-${v.pp}`]}>
              <h4 class="st-h"><i></i>{teams[v.pp].place} power play</h4>
              {pp.pp.map((u, k) => (
                <div class="stunit">
                  <p class="stunit-h"><span class="unit-label">{u.label}</span><span class="n">{u.share}% of the time</span><span class="stunit-v">{m.ppUnitStats[v.pp][k].xgf.toFixed(1)} <Pips pct={m.ppUnitStats[v.pp][k].pct} tip={`Creates ${m.ppUnitStats[v.pp][k].xgf.toFixed(1)} expected goals per hour, more than ${m.ppUnitStats[v.pp][k].pct}% of ${k ? 'second' : 'top'} power-play units.`} /></span></p>
                  <ul class="roles-list">{u.players.map((pl) => <li><span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{pl.name}</span><span class="chip">{pl.role}</span></li>)}</ul>
                </div>
              ))}
            </div>
            <div class="card mapcard">
              <ShotMap long team={v.pp} shots={pp.shots} title={`Where ${teams[v.pp].place}’s power play shoots from. Bigger dots are more dangerous shots.`} />
            </div>
            <div class:list={['card', `t-${v.pk}`]}>
              <h4 class="st-h"><i></i>{teams[v.pk].place} penalty kill</h4>
              {pk.pk.map((u, k) => (
                <div class="stunit">
                  <p class="stunit-h"><span class="unit-label">{u.label}</span><span class="n">{u.share}% of the time</span><span class="stunit-v">{m.pkUnitStats[v.pk][k].xga.toFixed(1)} <Pips pct={m.pkUnitStats[v.pk][k].pct} tip={`Allows ${m.pkUnitStats[v.pk][k].xga.toFixed(1)} expected goals per hour, stingier than ${m.pkUnitStats[v.pk][k].pct}% of ${k ? 'second' : 'top'} penalty-kill units.`} /></span></p>
                  <ul class="roles-list">{u.players.map((n, q) => <li><span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{n}</span><span class="chip">{q < 2 ? 'Forward' : 'Defense'}</span></li>)}</ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      );
    })}
    <p class="note">Role tags are rules of thumb based on where each player shoots and passes from. The number beside each unit is expected goals per hour: created, for a power play; allowed, for a penalty kill.</p>
  </Section>

  <Section id="goalies" title="Goaltending" takeaway="Carolina’s goalies see fewer shots, but the ones that get through are more dangerous and arrive after long quiet stretches.">
    <div class="stpick">
      <span>Show</span>
      <select id="g-away" aria-label={`${teams[away].place} goalie`}>{m.goalies[away].map((g, i) => <option value={`${away}-${i}`}>{g.name}{g.probable ? '' : ' (backup)'}</option>)}</select>
      <span>against</span>
      <select id="g-home" aria-label={`${teams[home].place} goalie`}>{m.goalies[home].map((g, i) => <option value={`${home}-${i}`}>{g.name}{g.probable ? '' : ' (backup)'}</option>)}</select>
    </div>
    <div class="g3">
      {[away, null, home].map((a) => a === null ? (
        <div class="card gmid">
          <p class="mini-h"><span class="term" tabindex="0" data-tip="Higher means the goalie is stopping more than expected. Further right means his team gives up more in front of him. Grey dots are the rest of the league; filled dots are probable starters, outlined dots are backups.">Helping, or hung out to dry?</span></p>
          <Quadrant tall league={m.leagueGoalies} highlights={quadHighlights} />
        </div>
      ) : m.goalies[a].map((g, i) => (
        <div class:list={['card', 'gcard', `t-${a}`]} data-goalie={`${a}-${i}`} hidden={i !== 0}>
          <p class="gname"><i></i><span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{g.name}</span><span class="chip">{g.probable ? 'Probable starter' : 'Backup'}</span></p>
          <p class="gbig"><strong>{signed(g.gsax)}</strong> <span class="term" tabindex="0" data-tip={m.goalieTraits[0].tip}>goals saved above expected</span> <Pips pct={m.goalieTraits[0].pct(g)} tip={`Better than ${m.goalieTraits[0].pct(g)}% of goalies at stopping more than expected.`} /></p>
          <dl class="gkv">
            {g.tiers.map((t) => <div><dt>{t.tier} save %</dt><dd>{t.sv.toFixed(3).slice(1)}</dd></div>)}
            <div><dt><span class="term" tabindex="0" data-tip={m.goalieTraits[1].tip}>Shots faced per hour</span></dt><dd>{g.workload[0].value} <Marker pct={m.goalieTraits[1].pct(g)} tip={`Busier than ${m.goalieTraits[1].pct(g)}% of goalies.`} /></dd></div>
            <div><dt><span class="term" tabindex="0" data-tip={m.goalieTraits[3].tip}>Breakdown chances per hour</span></dt><dd>{g.workload[2].value} <Marker pct={m.goalieTraits[3].pct(g)} tip={`Faces more breakdowns than ${m.goalieTraits[3].pct(g)}% of goalies.`} /></dd></div>
            <div><dt><span class="term" tabindex="0" data-tip={m.goalieTraits[5].tip}>Quality starts</span></dt><dd>{g.consistency.qs}% <Pips pct={m.goalieTraits[5].pct(g)} tip={`Steadier than ${m.goalieTraits[5].pct(g)}% of goalies.`} /></dd></div>
          </dl>
        </div>
      )))}
    </div>
    <details class="fold">
      <summary><span class="closed">Show the full goalie comparison</span><span class="opened">Hide the full goalie comparison</span></summary>
      <ul class="fpgrid">
        {m.goalieTraits.map((t) => (
          <li class="card fpc">
            <span class="term fpc-name" tabindex="0" data-tip={t.tip}>{t.label}</span>
            <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
            <div class="lanes">
              {order.flatMap((a) => m.goalies[a].map((g, i) => <div class:list={['lane', `t-${a}`]} data-goalie={`${a}-${i}`} hidden={i !== 0} style={`--b:${t.pct(g)};--bb:11;--c:${t.pct(g)};--cb:11`}><span class="whisk"></span><span class="dot"></span></div>))}
            </div>
            <ul class="fpc-stats">
              {order.flatMap((a) => m.goalies[a].map((g, i) => <li class={`t-${a}`} data-goalie={`${a}-${i}`} hidden={i !== 0}><i></i><span class="gsay"><b>{g.name}:</b> {t.say(g)}</span></li>))}
            </ul>
          </li>
        ))}
      </ul>
      <div class="two gmore">
        {order.flatMap((a) => m.goalies[a].map((g, i) => (
          <div class:list={['card', `t-${a}`]} data-goalie={`${a}-${i}`} hidden={i !== 0}>
            <p class="gname"><i></i>{g.name}</p>
            <div class="cons">
              <div><p class="mini-h">Night-to-night consistency</p><Histogram team={a} bins={g.bins} name={g.name} /></div>
              <dl class="work tight">
                <div><dt><span class="term" tabindex="0" data-tip="Share of starts with a save percentage under .850.">Really bad starts</span></dt><dd>{g.consistency.rbs}%</dd></div>
                <div><dt>Disasters / steals</dt><dd>{g.consistency.disasters} / {g.consistency.steals}</dd></div>
                <div><dt><span class="term" tabindex="0" data-tip={g.workload[5].tip}>Rebounds above expected</span></dt><dd>{g.workload[5].value}</dd></div>
              </dl>
            </div>
            <aside class="scout"><p class="mini-h">Scout’s note</p><p>Puck handling: no note yet. This space is for what you see watching him, since public data doesn’t track it.</p></aside>
          </div>
        )))}
      </div>
    </details>
    <p class="note">Expected-goal models can’t see passes before a shot. A goalie whose team gives up a lot of cross-ice passes will look worse here than he really is.</p>
  </Section>

  <Section id="win" title="How they win" takeaway="Carolina grinds goals out of zone time and second chances; Edmonton scores on the power play and off the rush.">
    <h3 class="sub">Where the goals come from</h3>
    <div class="key">
      {order.map((a) => <span class={`t-${a}`}><i></i>{teams[a].place}</span>)}
      <span class="avg">League average</span>
    </div>
    <div class="card">
      <ul class="srows">
        {m.goalSources.map((s) => (
          <li>
            <span class="term srow-name" tabindex="0" data-tip={s.tip}>{s.label}</span>
            <span class="sline" data-tip={`${teams[away].place} ${s[away]}%, ${teams[home].place} ${s[home]}%. League average ${s.lg}%.`}>
              <span class="slg" style={`left:${(s.lg / maxSource) * 100}%`}></span>
              <span class="sspan" style={`left:${(Math.min(s.CAR, s.EDM) / maxSource) * 100}%;width:${(Math.abs(s.CAR - s.EDM) / maxSource) * 100}%`}></span>
              {order.map((a) => <span class={`sdot t-${a}`} style={`left:${(s[a] / maxSource) * 100}%`}></span>)}
            </span>
            <span class="snums">{order.map((a) => <span class={`t-${a}`}><i></i>{s[a]}%</span>)}</span>
          </li>
        ))}
      </ul>
    </div>
    <p class="note">Share of each team’s goals that come from each source. The further apart the dots, the more the two teams differ.</p>
    <h3 class="sub">What tends to be true when they win</h3>
    <div class="two wins">
      {order.map((a) => (
        <div class:list={['card', `t-${a}`]}>
          <p class="gname"><i></i>When {teams[a].place} wins</p>
          <ul class="rec">{m.recipes[a].map((r) => <li><p>{r.text}</p><p class="cite">{r.sample}</p></li>)}</ul>
        </div>
      ))}
    </div>
    <p class="note">These are patterns, not causes. They describe what has gone along with winning, not what makes it happen.</p>
  </Section>

  <Section id="players" title="Key players" takeaway="What each team’s most-used players do, shown by the things they do more than almost anyone at their position.">
    <div class="key">
      <span><span class="pips demo"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></span>How good, against others at his position</span>
      <span><span class="marker demo"><i style="--p:65"></i></span>How much, low to high (not good or bad)</span>
    </div>
    {order.map((a) => (
      <div class:list={['kp', `t-${a}`]}>
        <h3 class="team-h">{full(a)}</h3>
        <ul class="kpgrid">
          {m.keyPlayers_[a].map((p) => {
            const peers = p.pos === 'Defense' ? 'defensemen' : p.pos === 'Center' ? 'centers' : 'wingers';
            return (
              <li class="card kpcard">
                <p class="kp-name"><span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{p.name}</span></p>
                <p class="kp-role"><span class="chip">{p.pos}</span><span class="term" tabindex="0" data-tip={`His numbers look ${p.roles[0].pct}% like a typical ${p.roles[0].name.toLowerCase()} and ${p.roles[1].pct}% like a ${p.roles[1].name.toLowerCase()}. Role names are rules of thumb.`}>Mostly a {p.roles[0].name.toLowerCase()}, part {p.roles[1].name.toLowerCase()}</span></p>
                <dl class="kp-sig">
                  {p.signature.map((sg) => (
                    <div>
                      <dt><span class="term" tabindex="0" data-tip={sg.tip}>{sg.label}</span></dt>
                      <dd>{neutralSig.has(sg.label)
                        ? <Marker pct={sg.pct} tip={`More than ${sg.pct}% of ${peers}.`} />
                        : <Pips pct={sg.pct} tip={`Better than ${sg.pct}% of ${peers}.`} />}</dd>
                    </div>
                  ))}
                </dl>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
    <p class="note">Each player shows the three things that most set him apart from others at his position.</p>
  </Section>

  <Section id="notes" title="Data notes" placeholder={false}>
    <ul class="notes">
      <li><strong>This page is a mock-up.</strong> Team names, records, the date, venue, coaches and the players listed are real. Every statistic, percentile, line grouping, role tag and written insight is invented to test the layout.</li>
      <li><strong>Early season.</strong> Each team has played only {teams[away].record.gp} or {teams[home].record.gp} games, so the real page will blend this season with last season and show wide ranges until samples grow.</li>
      <li><strong>Percentiles</strong> compare a team or player with the rest of the league: 90 means better than 90% of the league at that thing.</li>
      <li><strong>Blind spot.</strong> Public shot data doesn’t record passes before a shot or where defenders are standing.</li>
      <li><strong>Hits, giveaways, takeaways and blocks</strong> are counted by each arena’s scorer, and some arenas count more generously than others. Anything marked “arena-adjusted” corrects for that.</li>
    </ul>
    <details class="card explain">
      <summary>How the arena adjustment works, with an example</summary>
      <p>Take {m.arenaExample.event} at {m.arenaExample.arena}. Over three seasons, games played there averaged <strong>{m.arenaExample.here}</strong> {m.arenaExample.event} per hour for both teams combined. The same teams, in every other building, averaged <strong>{m.arenaExample.elsewhere}</strong>.</p>
      <p>{m.arenaExample.here} ÷ {m.arenaExample.elsewhere} = <strong>{m.arenaExample.raw.toFixed(2)}</strong>, so this scorer counts about 20% more {m.arenaExample.event} than those teams get elsewhere. Because a few seasons is still a limited sample, that figure is pulled part of the way back toward 1.00, landing at <strong>{m.arenaExample.shrunk.toFixed(2)}</strong>.</p>
      <p>Every {m.arenaExample.event.slice(0, -1)} recorded in that building is then divided by {m.arenaExample.shrunk.toFixed(2)}. A night with {m.arenaExample.rawCount} recorded {m.arenaExample.event} counts as <strong>{(m.arenaExample.rawCount / m.arenaExample.shrunk).toFixed(1)}</strong>.</p>
      <p class="note">These numbers are invented. The real site will have a page listing all 32 arenas with their actual figures for hits, giveaways, takeaways and blocks.</p>
    </details>
    <p class="after"><a href={`${import.meta.env.BASE_URL}recap/${m.game.id}/`}>After the game: see how this preview held up (mock-up)</a></p>
  </Section>
</Base>

