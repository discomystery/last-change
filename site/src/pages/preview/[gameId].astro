---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Bar from '../../components/Bar.astro';
import ShotMap from '../../components/ShotMap.astro';
import Histogram from '../../components/Histogram.astro';
import Quadrant from '../../components/Quadrant.astro';
import Rink from '../../components/Rink.astro';
import * as m from '../../data/mock';

export function getStaticPaths() {
  return [{ params: { gameId: String(m.game.id) } }];
}

const { away, home, teams, order } = m;
const start = new Date(m.game.startTimeUTC);
const dateStr = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/New_York' }).format(start);
const timeStr = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }).format(start) + ' ET';
const asOf = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }).format(new Date(m.fetchedAt)) + ' ET';
const rec = (a: m.Abbr) => `${teams[a].record.w}-${teams[a].record.l}-${teams[a].record.otl}`;
const full = (a: m.Abbr) => `${teams[a].place} ${teams[a].name}`;
const heat = (v: number) => `background: color-mix(in oklab, var(--ink) ${Math.round(v * 1.7)}%, var(--sheet)); color: ${v >= 32 ? 'var(--sheet)' : 'var(--ink)'}`;
const maxSource = Math.max(...m.goalSources.flatMap((s) => [s.CAR, s.EDM, s.lg]));
const quadHighlights = order.flatMap((a) => m.goalies[a].map((g) => ({ team: a, name: g.name, probable: g.probable, x: g.xga60, y: g.gsax60 })));
const signed = (v: number) => (v > 0 ? `+${v}` : v < 0 ? `−${Math.abs(v)}` : '0');
const nav = [
  ['watch', 'Short version'], ['style', 'Style'], ['lines', 'Lines'], ['special', 'Special teams'],
  ['goalies', 'Goalies'], ['win', 'How they win'], ['players', 'Key players'], ['notes', 'Data notes'],
];
---
<Base title={`${away} at ${home} preview`}>
  <section class="hero" aria-label="Matchup">
    <Rink />
    <dl class="meta">
      <div><dt>When</dt><dd>{dateStr}, {timeStr}</dd></div>
      <div><dt>Where</dt><dd>{m.game.venue}</dd></div>
      <div><dt>Probable goalies</dt><dd>{m.goalies[away][0].name} · {m.goalies[home][0].name}</dd></div>
      <div><dt>Data as of</dt><dd>{asOf}</dd></div>
    </dl>
    <div class="mode-row">
      <span class="mode-label">Numbers based on</span>
      <div class="mode" role="group" aria-label="Which seasons the numbers use">
        <button type="button" data-mode-btn="blend" aria-pressed="true">This season and last</button>
        <button type="button" data-mode-btn="season" aria-pressed="false">This season only</button>
      </div>
      <span class="mode-note">In this mock-up the switch changes the style fingerprints only.</span>
    </div>
    <nav class="jump" aria-label="Sections">
      {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </nav>
  </section>

  <Section id="watch" title="The short version">
    <ol class="watch">
      {m.insights.map((i) => (
        <li class="card">
          <h3>{i.head}</h3>
          <p>{i.body}</p>
          <p class="cite">{i.cite}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="style" title="Style fingerprints" takeaway="Carolina floods the net with shots from everywhere; Edmonton takes fewer and better ones, especially off the rush.">
    <div class="key">
      {order.map((a) => <span class={`t-${a}`}><i></i>{full(a)}</span>)}
      <span class="avg">League average</span>
      <span class="rng">Likely range</span>
    </div>
    <p class="note m-blend">Each scale runs from the league’s lowest team on the left to its highest on the right. Numbers blend last season with the {teams[away].record.gp} or {teams[home].record.gp} games played so far.</p>
    <p class="note m-season">This season only: {teams[away].record.gp} games for {teams[away].place}, {teams[home].record.gp} for {teams[home].place}. Expect these to swing a lot, which is why the likely ranges are so wide.</p>
    {m.fpGroups.map((g) => (
      <>
        <h3 class="sub">{g}</h3>
        <ul class="fpgrid">
          {m.fpCards.filter((c) => c.group === g).map((c) => (
            <li class="card fpc">
              <div class="fpc-top">
                <span class="term fpc-name" tabindex="0" data-tip={c.tip}>{c.label}</span>
                {c.clash && <span class="chip solid">Clash</span>}
              </div>
              <div class="ends"><span>{c.lo}</span><span>{c.hi}</span></div>
              <div class="lanes">
                {order.map((a) => (
                  <div class:list={['lane', `t-${a}`]} style={`--b:${c[a].blend.pct};--bb:${c[a].blend.band};--c:${c[a].season.pct};--cb:${c[a].season.band}`}>
                    <span class="whisk"></span><span class="dot"></span>
                  </div>
                ))}
              </div>
              <ul class="fpc-stats">
                {order.map((a) => (
                  <li class={`t-${a}`}>
                    <i></i>
                    <span class="m-blend"><span><b>{teams[a].place}:</b> {c[a].blend.text}</span><em>{c[a].blend.rank} of 32</em></span>
                    <span class="m-season"><span><b>{teams[a].place}:</b> {c[a].season.text}</span><em>{c[a].season.rank} of 32</em></span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </>
    ))}
    <h3 class="sub">Where the styles collide</h3>
    <ul class="clashes">
      {m.clashes.map((c) => (
        <li class="card">
          <p><strong>{teams[c.attacker].place}</strong> {c.phrase.split(' against ')[0]} <span class="big">{c.o}</span></p>
          <p class="vs">against</p>
          <p><strong>{teams[c.defender].place}</strong> {c.phrase.split(' against ')[1]} <span class="big">{c.d}</span></p>
        </li>
      ))}
    </ul>
    <p class="note">The big numbers are league percentiles: 90 means better than 90% of the league at that thing.</p>
  </Section>

  <Section id="lines" title="Lines and deployment" takeaway={`${teams[home].place} is at home, so ${teams[home].coach ?? 'its coach'} chooses who plays against whom.`}>
    <p class="note">Players are those who dressed in each team’s most recent game. How they are grouped here is a placeholder.</p>
    <div class="two">
      {order.map((a) => (
        <div class={`t-${a}`}>
          <h3 class="team-h">{full(a)}</h3>
          <ul class="units">
            {[...m.lines[a].fwd, ...m.lines[a].def].map((u) => (
              <li class="card unit">
                <div class="unit-top">
                  <span class="unit-label">{u.label}</span>
                  <span class="unit-names">{u.players.join(' · ')}</span>
                  <span class="chip">{u.role}</span>
                </div>
                <dl class="stats">
                  <div><dt><span class="term" tabindex="0" data-tip="Average 5-on-5 minutes per game for this group.">Ice time</span></dt><dd>{u.toi.toFixed(1)}</dd></div>
                  <div><dt><span class="term" tabindex="0" data-tip="Expected goals for per hour: how much offense the team creates with this group on the ice.">Creates</span></dt><dd>{u.xgf.toFixed(2)}</dd></div>
                  <div><dt><span class="term" tabindex="0" data-tip="Expected goals against per hour: how much the team gives up with this group on the ice.">Allows</span></dt><dd>{u.xga.toFixed(2)}</dd></div>
                  <div><dt><span class="term" tabindex="0" data-tip="This group’s share of all expected goals while on the ice. Above 50% means they out-chance opponents.">Share</span></dt><dd>{u.xgfPct.toFixed(1)}%</dd></div>
                  <div><dt><span class="term" tabindex="0" data-tip="Of the shifts the coach starts with a faceoff at either end, the share that start in the offensive zone.">Off. starts</span></dt><dd>{u.ozs}%</dd></div>
                  <div><dt><span class="term" tabindex="0" data-tip="How tough their opponents are, as a league percentile. The spread between players is naturally narrow.">Competition</span></dt><dd>{u.qoc}</dd></div>
                </dl>
                <p class="n">{u.minutes} minutes together this season</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <h3 class="sub">Who {teams[home].place} is likely to send against whom</h3>
    <p class="takeaway">Each row shows how one {teams[home].place} group’s 5-on-5 time is split across {teams[away].place}’s four forward lines, based on {teams[home].coach ?? 'the coach'}’s habits at home.</p>
    <div class="two">
      {[{ title: 'Forward lines', rows: m.lines[home].fwd, data: m.matchupMatrix }, { title: 'Defense pairs', rows: m.lines[home].def, data: m.pairMatrix }].map((h) => (
        <div class="card">
          <table class="heat">
            <caption>{home} {h.title.toLowerCase()} against {away} forward lines</caption>
            <thead><tr><td></td>{m.lines[away].fwd.map((l) => <th scope="col">{away} {l.label}</th>)}</tr></thead>
            <tbody>
              {h.rows.map((r, i) => (
                <tr>
                  <th scope="row">{home} {r.label}</th>
                  {h.data[i].map((v, j) => <td style={heat(v)} data-tip={`${home} ${r.label} (${r.players.join(', ')}) spends ${v}% of its 5-on-5 time against ${away} ${m.lines[away].fwd[j].label} (${m.lines[away].fwd[j].players.join(', ')})`}>{v}%</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>

    <h3 class="sub">Previous meetings</h3>
    <ul class="meet">
      {m.meetings.map((g) => <li class="card"><p><strong>{g.score}</strong> <span class="n">{g.date}, {g.site}</span></p><p class="note">{g.note}</p></li>)}
    </ul>
  </Section>

  <Section id="special" title="Special teams" takeaway="Edmonton’s power play is the most dangerous unit in the game, but Carolina’s penalty killers attack rather than sit back.">
    <div class="two">
      {order.map((a) => {
        const s = m.specialTeams[a];
        return (
          <div class={`t-${a}`}>
            <h3 class="team-h">{full(a)}</h3>
            <div class="card">
              {s.rates.map((r) => (
                <div class="rate">
                  <div class="rate-top"><span class="term" tabindex="0" data-tip={r.tip}>{r.label}</span><span><strong>{r.value}</strong> <span class="n">{r.unit}</span></span></div>
                  <Bar team={a} pct={r.pct} band={12} label={`${teams[a].place}, ${r.label.toLowerCase()}`} />
                </div>
              ))}
              <p class="note">Projected power plays in this game: <strong>{s.projectedOpps.toFixed(1)}</strong></p>
            </div>
            <div class="st-grid">
              <div class="card">
                <ShotMap team={a} shots={s.shots} title={`Where ${teams[a].place}’s power play shoots from. Bigger dots are more dangerous shots.`} />
              </div>
              <div class="card">
                {s.pp.map((u) => (
                  <div class="ppunit">
                    <p class="unit-label">{u.label} <span class="n">{u.share}% of power-play time</span></p>
                    <ul>{u.players.map((p) => <li><span>{p.name}</span><span class="chip">{p.role}</span></li>)}</ul>
                  </div>
                ))}
                <details>
                  <summary>Penalty killers</summary>
                  {s.pk.map((u) => (
                    <div class="ppunit">
                      <p class="unit-label">{u.label} <span class="n">{u.share}% of penalty-kill time</span></p>
                      <ul class="pk-names">{u.players.map((n) => <li>{n}</li>)}</ul>
                    </div>
                  ))}
                </details>
              </div>
            </div>
            <p class="note">Role tags are rules of thumb based on where each player shoots and passes from.</p>
          </div>
        );
      })}
    </div>
  </Section>

  <Section id="goalies" title="Goaltending" takeaway="Carolina’s goalies see fewer shots, but the ones that get through are more dangerous and arrive after long quiet stretches.">
    <div class="quad-wrap card">
      <div>
        <h3 class="sub first">Is he helping, or being hung out to dry?</h3>
        <p class="note">Higher on the chart means the goalie is stopping more than expected. Further right means his team gives up more in front of him. Grey dots are the rest of the league.</p>
        <div class="key">
          {order.map((a) => <span class={`t-${a}`}><i></i>{a}</span>)}
          <span>Filled: probable starter. Outlined: backup.</span>
        </div>
      </div>
      <Quadrant league={m.leagueGoalies} highlights={quadHighlights} />
    </div>
    <div class="two">
      {order.map((a) => (
        <div class={`t-${a}`}>
          <h3 class="team-h">{full(a)}</h3>
          {m.goalies[a].map((g) => (
            <article class="card goalie">
              <header>
                <h4>{g.name}</h4>
                <span class:list={['chip', { solid: g.probable }]}>{g.probable ? 'Probable starter' : 'Backup'}</span>
              </header>
              <p class="gsax"><strong>{signed(g.gsax)}</strong> <span class="term" tabindex="0" data-tip="Goals saved above expected: how many goals he has prevented compared with an average goalie facing the same shots. Positive is good.">goals saved above expected</span> <span class="n">in {g.starts} starts</span></p>
              <details open={g.probable}>
              <summary>{g.probable ? 'His numbers' : 'Show his numbers'}</summary>
              <table class="tiers">
                <thead><tr><td></td><th scope="col">Save %</th><th scope="col">Saved above expected</th></tr></thead>
                <tbody>{g.tiers.map((t) => <tr><th scope="row">{t.tier}</th><td>{t.sv.toFixed(3).slice(1)}</td><td>{signed(t.gsax)}</td></tr>)}</tbody>
              </table>
              <dl class="work">
                {g.workload.map((w) => <div><dt><span class="term" tabindex="0" data-tip={w.tip}>{w.label}</span></dt><dd>{w.value}</dd></div>)}
              </dl>
              <div class="cons">
                <div>
                  <p class="mini-h">Night-to-night consistency</p>
                  <Histogram team={a} bins={g.bins} name={g.name} />
                </div>
                <dl class="work tight">
                  <div><dt><span class="term" tabindex="0" data-tip="Share of starts where he gave his team a fair chance to win.">Quality starts</span></dt><dd>{g.consistency.qs}%</dd></div>
                  <div><dt><span class="term" tabindex="0" data-tip="Share of starts with a save percentage under .850.">Really bad starts</span></dt><dd>{g.consistency.rbs}%</dd></div>
                  <div><dt>Disasters / steals</dt><dd>{g.consistency.disasters} / {g.consistency.steals}</dd></div>
                </dl>
              </div>
              <aside class="scout">
                <p class="mini-h">Scout’s note</p>
                <p>Puck handling: no note yet. This space is for what you see watching him, since public data doesn’t track it.</p>
              </aside>
              </details>
            </article>
          ))}
        </div>
      ))}
    </div>
    <p class="note">Expected-goal models can’t see passes before a shot. A goalie whose team gives up a lot of cross-ice passes will look worse here than he really is.</p>
  </Section>

  <Section id="win" title="How they win" takeaway="Carolina grinds goals out of zone time and second chances; Edmonton scores on the power play and off the rush.">
    <h3 class="sub">Where the goals come from</h3>
    <div class="key">
      {order.map((a) => <span class={`t-${a}`}><i></i>{a}</span>)}
      <span class="avg">League average</span>
    </div>
    <ul class="src card">
      {m.goalSources.map((s) => (
        <li>
          <span class="term src-label" tabindex="0" data-tip={s.tip}>{s.label}</span>
          <div class="src-bars">
            {order.map((a) => (
              <div class:list={['srcbar', `t-${a}`]} data-tip={`${teams[a].place}: ${s[a]}% of goals. League average: ${s.lg}%.`}>
                <span class="bar-team">{a}</span>
                <span class="src-track"><span class="src-fill" style={`width:${(s[a] / maxSource) * 100}%`}></span><span class="src-lg" style={`left:${(s.lg / maxSource) * 100}%`}></span></span>
                <span class="bar-val">{s[a]}%</span>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ul>
    <h3 class="sub">What tends to be true when they win</h3>
    <div class="two">
      {order.map((a) => (
        <div class={`t-${a}`}>
          <h3 class="team-h">{full(a)}</h3>
          <ul class="recipe">
            {m.recipes[a].map((r) => <li class="card"><p>{r.text}</p><p class="cite">{r.sample}</p></li>)}
          </ul>
        </div>
      ))}
    </div>
    <p class="note">These are patterns, not causes. They describe what has gone along with winning, not what makes it happen.</p>
  </Section>

  <Section id="players" title="Key players" takeaway="What each team’s most-used players do, shown by the things they do more than almost anyone at their position.">
    <div class="two">
      {order.map((a) => (
        <div class={`t-${a}`}>
          <h3 class="team-h">{full(a)}</h3>
          <ul class="players">
            {m.keyPlayers_[a].map((p) => (
              <li class="card">
                <div class="unit-top"><span class="unit-names">{p.name}</span><span class="n">{p.pos}</span></div>
                <p class="roles">{p.roles.map((r) => <span class="chip">{r.pct}% {r.name}</span>)}</p>
                {p.signature.map((s) => (
                  <div class="rate">
                    <div class="rate-top"><span class="term" tabindex="0" data-tip={s.tip}>{s.label}</span></div>
                    <Bar team={a} pct={s.pct} label={`${p.name}, ${s.label.toLowerCase()}`} />
                  </div>
                ))}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Section id="notes" title="Data notes" placeholder={false}>
    <ul class="notes">
      <li><strong>This page is a mock-up.</strong> Team names, records, the date, venue, coaches and the players listed are real. Every statistic, percentile, line grouping, role tag and written insight is invented to test the layout.</li>
      <li><strong>Early season.</strong> Each team has played only {teams[away].record.gp} or {teams[home].record.gp} games, so the real page will blend this season with last season and show wide ranges until samples grow.</li>
      <li><strong>Percentiles</strong> compare a team or player with the rest of the league: 90 means better than 90% of the league at that thing.</li>
      <li><strong>Blind spot.</strong> Public shot data doesn’t record passes before a shot or where defenders are standing.</li>
      <li><strong>Hits, giveaways, takeaways and blocks</strong> are counted by each arena’s scorer, and some arenas count more generously than others. Anything marked “arena-adjusted” corrects for that.</li>
    </ul>
    <details class="card explain">
      <summary>How the arena adjustment works, with an example</summary>
      <p>Take {m.arenaExample.event} at {m.arenaExample.arena}. Over three seasons, games played there averaged <strong>{m.arenaExample.here}</strong> {m.arenaExample.event} per hour for both teams combined. The same teams, in every other building, averaged <strong>{m.arenaExample.elsewhere}</strong>.</p>
      <p>{m.arenaExample.here} ÷ {m.arenaExample.elsewhere} = <strong>{m.arenaExample.raw.toFixed(2)}</strong>, so this scorer counts about 20% more {m.arenaExample.event} than those teams get elsewhere. Because a few seasons is still a limited sample, that figure is pulled part of the way back toward 1.00, landing at <strong>{m.arenaExample.shrunk.toFixed(2)}</strong>.</p>
      <p>Every {m.arenaExample.event.slice(0, -1)} recorded in that building is then divided by {m.arenaExample.shrunk.toFixed(2)}. A night with {m.arenaExample.rawCount} recorded {m.arenaExample.event} counts as <strong>{(m.arenaExample.rawCount / m.arenaExample.shrunk).toFixed(1)}</strong>.</p>
      <p class="note">These numbers are invented. The real site will have a page listing all 32 arenas with their actual figures for hits, giveaways, takeaways and blocks.</p>
    </details>
    <p class="after"><a href={`${import.meta.env.BASE_URL}recap/${m.game.id}/`}>After the game: see how this preview held up (mock-up)</a></p>
  </Section>
</Base>

<style>
  .hero { margin-top: 10px; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px 20px; margin-top: 16px; }
  .meta dt { font-family: var(--ui); font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); font-weight: 600; }
  .meta dd { font-weight: 500; }
  @media (min-width: 820px) { .meta { display: flex; flex-wrap: wrap; gap: 10px 48px; } .meta dd { white-space: nowrap; } }
  .jump { font-family: var(--ui); display: flex; gap: 6px; overflow-x: auto; margin: 18px -16px 0; padding: 2px 16px 6px; scrollbar-width: none; }
  .jump a { flex: none; font-size: 13px; font-weight: 500; text-decoration: none; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--rule); background: var(--sheet); }
  .jump a:hover { border-color: var(--ink); }

  .n, .cite { font-size: 12px; color: var(--ink-3); font-weight: 400; }
  .watch { display: grid; gap: 16px; margin-top: 22px; }
  @media (min-width: 720px) { .watch { grid-template-columns: 1fr 1fr; } }
  .watch h3 { font: 600 22px/1.15 var(--display); margin-bottom: 8px; }
  .watch .cite { margin-top: 8px; }

  .clashes { display: grid; gap: 12px; }
  @media (min-width: 720px) { .clashes { grid-template-columns: repeat(3, 1fr); } }
  .clashes p { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 14px; }
  .clashes p strong { margin-right: 4px; }
  .clashes .vs { font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); margin: 2px 0; }
  .big { font: 700 30px/1 var(--display); margin-left: auto; }

  .units, .players, .recipe, .meet { display: grid; gap: 14px; }
  .unit-top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .unit-label { font: 700 19px/1 var(--display); color: var(--team, var(--ink)); }
  .unit-names { font-weight: 600; flex: 1 1 auto; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px 10px; margin-top: 10px; }
  @media (min-width: 480px) { .stats { grid-template-columns: repeat(6, 1fr); } }
  .stats dt, .work dt { font-size: 12px; color: var(--ink-2); }
  .stats dd { font-weight: 600; font-size: 15px; }
  .unit .n { margin-top: 8px; }

  .heat { width: 100%; border-collapse: separate; border-spacing: 2px; font-size: 13px; table-layout: fixed; }
  .heat caption { text-align: left; font-weight: 600; font-size: 14px; margin-bottom: 8px; }
  .heat th { font-weight: 600; font-size: 11px; color: var(--ink-2); padding: 4px 2px; white-space: nowrap; }
  .heat tbody th { text-align: left; width: 58px; }
  .heat tbody td { text-align: center; padding: 11px 0; border-radius: 4px; font-weight: 600; }

  .rate { margin-bottom: 12px; }
  .rate-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 14px; margin-bottom: 4px; }
  .st-grid { display: grid; gap: 12px; margin-top: 12px; grid-template-columns: 1fr; }
