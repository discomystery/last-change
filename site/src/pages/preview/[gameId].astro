  .work div { display: flex; justify-content: space-between; gap: 12px; padding: 5px 0; border-bottom: 1px solid var(--rule); font-size: 13px; }
  .work dd { font-weight: 600; white-space: nowrap; }
  .work.tight { margin-top: 0; }
