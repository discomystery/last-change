---
// Post-game page, one per finished game. What happened (the short version with the game's basic numbers, then run it
// back), what the preview expected (the win chance kept hidden before the game, the preview's calls exactly as saved
// at puck drop, each graded by the rule stored with it, and what it didn't see coming), then the players.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Rink from '../../components/Rink.astro';
import GameTrail from '../../components/GameTrail.astro';
import PLink from '../../components/PLink.astro';
import PlayerJobs from '../../components/PlayerJobs.astro';
import GameSwing from '../../components/GameSwing.astro';
import GameFlow from '../../components/GameFlow.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import SectionNav from '../../components/SectionNav.astro';
import GameStory, { type Story } from '../../components/GameStory.astro';
import Gloss from '../../components/Gloss.astro';
import ChanceStory, { type Beat } from '../../components/ChanceStory.astro';
import '../../styles/blocks.css';
import { matchupColours } from '../../lib/teams';
import teamsData from '../../../public/data/teams.json';
import recapIndex from '../../../public/data/recaps/index.json';

type Call = { id: string; kind: string; head: string; body: string; call?: string | null; nums?: string | null; cite: string; verdict: 'held' | 'partly' | 'missed' | 'na' | 'pending' | null; happened?: string; beyond?: string; usual?: string; tonight?: string; league?: string };
type Nums = { shots: number; xg: number; cf5: number | null; pp_goals: number; pp_opps: number };
type Goalie = { id: number; name: string; team: string; started: boolean; toi: string; shots: number; saves: number; ga: number; xga: number; gsax: number; sv: number | null; high: { shots: number; goals: number } };
type Replays = { share: Record<string, number>; regulation: Record<string, number>; xg: Record<string, number>; chances: Record<string, number> };
type Recap = { game_id: number; date: string; start: string; away: string; home: string; venue: string; score: Record<string, number>; end: string; preview: boolean; rebuilt?: boolean; preview_page?: boolean; snapshot_at: string | null; calls: Call[]; numbers: Record<string, Nums>; goalies: Goalie[]; surprises: { kind?: string; tag?: string; mild?: boolean; head: string; body: string; flipped?: string }[]; replays?: Replays | null; story?: Story; pending?: boolean;
  reveal?: { p_home: number; p_home_puck: number | null; steps: { input: string; label: string; shift: number }[]; sides: Record<string, { head: string; chance: number }>;
    inputs?: Record<string, { xgd: number; b2b: number; roster?: number; lineup?: number }>;
    players?: Record<string, { missing: Named[]; out: Named[]; in: Named[]; stars?: Star[] } | null> } | null };
// A star who missed the game without moving the number: the rating had stopped counting on him, or rates his 5-on-5
// play modestly.
type Star = { id: number; name: string; why: 'priced' | 'small' };
// A skater a lineup step was about, most valuable first; `big` marks the top tenth of absences.
type Named = { id: number; name: string; xg: number; big: boolean };

export async function getStaticPaths() {
  const files = import.meta.glob<{ default: Recap }>('../../../public/data/recaps/2*.json', { eager: true });
  return Object.values(files).map((f) => ({ params: { gameId: String(f.default.game_id) }, props: { r: f.default } }));
}
const { r } = Astro.props as { r: Recap };
const { away, home } = r;
const order = [away, home];
const T = Object.fromEntries(teamsData.map((t) => [t.abbr, t]));
const place = (a: string) => T[a]?.place ?? a;
const poss = (n: string) => (n.endsWith('s') ? `${n}’` : `${n}’s`);  // "NY Rangers’ lineup"
const side = (a: string) => (a === away ? 'away' : 'home');
const colours = matchupColours(away, home);
// The reveal is told from the visitor's own team's side when it played, otherwise the home team's.
const povCss = `.pov-away{display:none}html[data-team="${away}"] .pov-away{display:block}html[data-team="${away}"] .pov-home{display:none}`;
const rv = r.reveal;
// Each input's shift, told from one team's side, with the running chance after it.
const ladder = (a: string) => {
  if (!rv) return [];
  const sign = a === home ? 1 : -1;
  let run = 50;
  return rv.steps.map((s) => {
    const pts = Math.round(100 * s.shift * sign);
    const before = run;
    run += 100 * s.shift * sign;
    return { label: s.label, input: s.input, pts, before, end: run, after: Math.round(run) };
  });
};
// Who each lineup step was about: "Jordan Staal (a big loss), Seth Jarvis and Sean Walker".
const names = (xs: Named[] | undefined, big = false) => {
  const w = (xs ?? []).map((x) => (big && x.big ? `${x.name} (a big loss)` : x.name));
  return w.length < 2 ? (w[0] ?? '') : `${w.slice(0, -1).join(', ')} and ${w[w.length - 1]}`;
};
const named = (t: string, k: 'missing' | 'out' | 'in') => rv?.players?.[t]?.[k] ?? [];
const without = (big: boolean) => [away, home].filter((t) => named(t, 'missing').length).map((t) => `${place(t)} were without ${names(named(t, 'missing'), big)}.`).join(' ');
const starsOut = (long: boolean) => [away, home].flatMap((t) => (rv?.players?.[t]?.stars ?? []).map((x) => {
  const also = named(t, 'missing').length ? ' also' : '';
  if (!long) return `${x.name} was out for ${place(t)}${also ? ' too' : ''}, ${x.why === 'priced' ? 'but he had been out long enough that it was already in the numbers' : 'though by our ratings that barely moves this'}.`;
  return x.why === 'priced'
    ? `${place(t)} were${also} without ${x.name}. He had been out long enough that the rating above had already stopped counting on him, so his absence barely moves this step.`
    : `${place(t)} were${also} without ${x.name}. Our ratings of his 5-on-5 play are more modest than his name, so his absence barely moves this step.`;
})).join(' ');
const late = () => [away, home].flatMap((t) => [
  named(t, 'out').length ? `${names(named(t, 'out'))} sat out for ${place(t)}` : '',
  named(t, 'in').length ? `${names(named(t, 'in'))} ${named(t, 'in').length > 1 ? 'were' : 'was'} in for ${place(t)}` : '',
]).filter(Boolean);
// What each step was for, in a sentence, told from team a's side.
const other = (a: string) => (a === home ? away : home);
const xgWord = (v: number) => `${Math.abs(v).toFixed(2)} expected goals a game`;
const recent = (t: string, v: number) => Math.abs(v) < 0.05 ? `${place(t)} have broken about even on chances` : v > 0 ? `${place(t)} have outchanced their opponents by ${xgWord(v)}` : `${place(t)} have been outchanced by ${xgWord(v)}`;
// Each step in two lengths: a short note for the scroll story, and a fuller one for "every step at once".
const why = (a: string, input: string, pts: number): { short: string; long: string } => {
  const o = other(a), inp = rv?.inputs, gainer = place(pts > 0 ? a : o), loser = place(pts > 0 ? o : a);
  if (input === 'home') return { short: `${place(home)} were at home, and home teams win a bit more often.`,
    long: `${place(home)} were at home. Over the last three seasons, home teams won about ${50 + Math.round(Math.abs(pts))}% of games.` };
  if (input === 'xgd') {
    const gap = inp ? inp[a].xgd - inp[o].xgd : 0;
    const short = !inp ? 'How each team’s chances have compared with their opponents’ lately.'
      : Math.abs(gap) < 0.15 ? 'Both teams have been getting about the same share of the chances lately.'
      : `${place(gap > 0 ? a : o)} have been getting ${Math.abs(gap) >= 0.8 ? 'much ' : ''}better chances than their opponents lately.`;
    return { short, long: inp ? `Lately, ${recent(a, inp[a].xgd)}, and ${recent(o, inp[o].xgd)}. The latest games count most, and last season still counts a little.` : short };
  }
  if (input === 'roster') {
    const how = 'We look at who each team dressed in their last game, plus any injury news since, and compare those players with the ones who played in the games behind the rating above.';
    const lost = named(pts > 0 ? o : a, 'missing');
    const extra = (t: string) => (t ? ` ${t}` : '');
    if (pts === 0) return { short: (without(false) || 'Both teams played their usual players last time out.') + extra(starsOut(false)),
      long: `${how} ${[without(true), starsOut(true)].filter(Boolean).join(' ')} Both teams’ lineups were about as strong as usual, so this step changes nothing.`.replace('  ', ' ') };
    return { short: (lost.length ? `${loser} were without ${names(lost)}.` : `${poss(gainer)} lineup stacked up better against their usual than ${poss(loser)} did.`) + extra(starsOut(false)),
      long: `${how} ${without(true) || `${loser}’s last lineup was weaker than usual (someone important out, or a call-up in).`}${extra(starsOut(true))} That leaves ${loser}’s recent chances flattering them a little. This way an injury counts straight away, instead of waiting for results to catch up.` };
  }
  if (input === 'b2b') { const tired = inp ? [a, o].filter((t) => inp[t].b2b) : []; const t = tired.map(place).join(' and ');
    return tired.length ? { short: `${t} played last night, so tired legs.`, long: `${t} played the night before. Teams on the second night of a back-to-back win less often.` }
      : { short: 'Neither team played last night.', long: 'Neither team played the night before, so nothing changes here.' }; }
  if (input === 'lineup') {
    const gIn = named(pts > 0 ? a : o, 'in'), lOut = named(pts > 0 ? o : a, 'out'), changes = late();
    return { short: gIn.length ? `When the lineups came out, ${names(gIn)} ${gIn.length > 1 ? 'were' : 'was'} in for ${gainer}.`
        : lOut.length ? `When the lineups came out, ${loser} were without ${names(lOut)}.`
        : `When the lineups came out, ${gainer}’s was stronger than we expected that morning.`,
      long: `The same check as “Who’s been playing”, done again with the players who actually dressed tonight. It only moves when someone came in or went out after the morning: here ${gainer} looked stronger, or ${loser} weaker, than we had expected.${changes.length ? ` ${changes.join('; ')}.` : ''}` };
  }
  return { short: '', long: '' };
};
// The steps for one team's side, ready for the story: start at 50, each input, the morning figure, and the puck-drop
// figure when tonight's lineups moved it.
const beatsFor = (a: string): Beat[] => {
  const steps = ladder(a).filter((x) => !(x.input === 'lineup' && x.pts === 0));
  const out: Beat[] = [{ key: 'start', label: 'Start at even', short: 'Two evenly matched teams on neutral ice: 50–50.', pts: 0, before: 50, end: 50 }];
  for (const x of steps) out.push({ key: x.input, label: x.label, ...why(a, x.input, x.pts), pts: x.pts, before: x.before, end: x.end });
  const last = out[out.length - 1].end;
  out.push({ key: 'end', label: 'Our final number', sum: true, short: '', pts: 0, before: last, end: last });
  return out;
};
// The reveal headline without the number the page already shows big: "We gave Carolina a 76% chance, and Carolina
// delivered." reads "Carolina delivered."
const outcome = (head: string) => { const t = head.replace(/^We (gave|had) .*?(chance|\)), (and|but) /, ''); return t.charAt(0).toUpperCase() + t.slice(1); };
const signed = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${-n}` : '0');
const colourCss = `:root{--away:${colours.away};--home:${colours.home}}.t-away{--team:var(--away)}.t-home{--team:var(--home)}@media (prefers-color-scheme: dark){.t-away{--team:color-mix(in oklab,var(--away) 55%,white)}.t-home{--team:color-mix(in oklab,var(--home) 55%,white)}}`;
const dateStr = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(r.start));
const endWord = r.end === 'OT' ? 'Final in overtime' : r.end === 'SO' ? 'Final in a shootout' : 'Final';
const label = { held: 'Held up', partly: 'Partly', missed: 'Didn’t happen', na: 'Can’t judge', pending: 'Still coming in' } as const;
const mark = { held: '✓', partly: '≈', missed: '✕', na: '–', pending: '…' } as const;
const graded = r.calls.filter((c) => c.verdict && c.verdict !== 'na' && c.verdict !== 'pending');
const count = (v: string) => graded.filter((c) => c.verdict === v).length;
const sayCount = (n: number, one: string) => `${n} ${one}`;
const takeaway = r.pending && r.calls.length
  ? 'The calls are checked once the NHL finishes filling in who was on the ice.'
  : graded.length
  ? `Of the ${graded.length} calls the preview made, ${count('held')} held up, ${count('partly')} partly did, and ${count('missed')} didn’t happen.`
  : r.preview ? 'None of the preview’s calls could be judged from this game.' : 'No preview was saved for this game.';
const season = recapIndex.tally as Record<string, number>;
const seasonTotal = season.held + season.partly + season.missed;
const sgn = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(1)}`;
// Each row also says how far its bar leans: the share of the row's total each team had.
const rows: [string, string, (n: Nums) => string, (n: Nums) => number][] = [
  ['Shots on goal', 'Every shot that reached the net, including goals. The bar splits them between the teams.', (n) => String(n.shots), (n) => n.shots],
  ['Expected goals', 'How many goals the chances were worth, by this site’s model. Empty nets left out. The bar splits them between the teams.', (n) => n.xg.toFixed(1), (n) => n.xg],
  ['Shot attempts at 5-on-5', 'Every attempt at even strength with both goalies in: on goal, missed or blocked. The bar splits them between the teams.', (n) => (n.cf5 === null ? '…' : String(n.cf5)), (n) => n.cf5 ?? 0],
  ['Power plays', 'Power-play goals, out of times on the power play. The bar splits the times on the power play.', (n) => `${n.pp_goals} of ${n.pp_opps}`, (n) => n.pp_opps],
];
// Run it back: 100 replays of the game's chances, split by largest remainder so the dots always add to 100.
const dw = r.replays ?? null;
const replays = (() => {
  if (!dw) return null;
  // The saved shares are rounded, so they can add to 99.9 or 100.1: scale them to exactly 100 first.
  const raw0 = [dw.regulation[away], dw.regulation.tie, dw.regulation[home]];
  const tot = raw0.reduce((a, b) => a + b, 0) || 1;
  const raw = raw0.map((p) => (100 * p) / tot);
  const n = raw.map(Math.floor);
  // Dots still owed, counted once: recounting inside the loop stopped it early and left games a dot or two short.
  const owed = 100 - n.reduce((a, b) => a + b, 0);
  const order = raw.map((v, i) => [v - Math.floor(v), i] as const).sort((a, b) => b[0] - a[0]);
  for (let k = 0; k < owed; k++) n[order[k % 3][1]] += 1;
  return { away: n[0], tie: n[1], home: n[2] };
})();
const winner = r.score[home] > r.score[away] ? home : away;
const loser = winner === home ? away : home;
const pct = (a: string) => Math.round(100 * (dw?.share[a] ?? 0));
const replayHead = !dw ? '' : pct(winner) >= 60 ? `${place(winner)} earned this one`
  : pct(loser) >= 60 ? `${place(loser)} usually wins this one` : 'Too close to call on chances';
const replayBody = !dw ? '' : pct(loser) >= 60
  ? `With chances like these, ${place(loser)} would win about ${pct(loser)} games in 100. The goals went the other way.`
  : pct(winner) >= 60 ? `With chances like these, ${place(winner)} would win about ${pct(winner)} games in 100.`
  : `With chances like these, ${place(away)} would win about ${pct(away)} games in 100 and ${place(home)} ${pct(home)}, close to a coin flip.`;
// Section order tells the story: what we expected, what happened, then the detail.
// Report cards exist for this game when the pipeline wrote jobs/{id}.json (PlayerJobs renders nothing otherwise).
const jobFiles = import.meta.glob<{ default: { game_id: number; players: { pos: string }[] } }>('../../../public/data/jobs/2*.json', { eager: true });
const jobs = Object.values(jobFiles).find((f) => f.default.game_id === r.game_id)?.default;
const hasJobs = !!jobs?.players.some((c) => c.pos !== 'G');
const hasGoalieCards = !!jobs?.players.some((c) => c.pos === 'G');
const scoreFiles = import.meta.glob<{ default: { game_id: number; players: unknown[] } }>('../../../public/data/scores/2*.json', { eager: true });
const hasImpact = !!Object.values(scoreFiles).find((f) => f.default.game_id === r.game_id)?.default.players.length;
const story = r.story;
// How it unfolded: the shots and shifts are read in the browser from data/flow/{id}.json when the file exists.
const hasFlow = existsSync(resolve(process.cwd(), 'public/data/flow', `${r.game_id}.json`));
const nav = [
  ['story', 'Overview'], ...(dw ? [['replays', 'Run it back']] : []), ...(hasFlow ? [['flow', 'How it went']] : []), ['preview', 'The preview'],
  ...(hasImpact ? [['swing', 'Swing']] : []), ...(hasJobs ? [['jobs', 'Players']] : []), ['goalies', 'In net'],
];
const dots = replays ? [...Array(replays.away).fill('away'), ...Array(replays.tie).fill('tie'), ...Array(replays.home).fill('home')] : [];
---
<Base section="games" title={`${away} at ${home}, final`}>
  <style is:inline set:html={colourCss + povCss}></style>
  <section class="hero" aria-label="Final score">
    <GameTrail id={r.game_id} part="crumbs" />
    <Rink centre="final" sides={order.map((a) => ({ abbr: a, cls: `t-${side(a)}`, full: T[a]?.name ?? a, score: r.score[a], home: a === home, href: `${import.meta.env.BASE_URL}team/${a}/` }))} />
    <GameTrail id={r.game_id} part="around"><p class="when-day">{dateStr}</p><p><strong>{endWord}</strong> · {r.venue}</p></GameTrail>
  </section>

  <SectionNav items={nav as [string, string][]} />

  <section class="sec top" id="story" aria-label="Overview">
    {r.pending && (
      <div class="card pending" role="status">
        <p class="mini-h">Still coming in</p>
        <p>The score, goals, shots and goalies are final. The NHL is still filling in who was on the ice, so the checked calls, Swing, report cards and the shift-by-shift replay will appear here once it has, usually later tonight.</p>
      </div>
    )}
    {story ? (
      <GameStory story={story} kicker={false}>
        <div class="tug">
          <p class="tug-head">{order.map((a) => <span class={`t-${side(a)}`}><i></i>{a}</span>)}</p>
          {rows.map(([name, tip, f, v]) => {
            const [x, y] = order.map((a) => Math.max(0, v(r.numbers[a])));
            const g = x + y > 0 ? [x, y] : [1, 1];
            return (
              <div class="tug-row">
                <p class="tug-top"><strong>{f(r.numbers[order[0]])}</strong><span class="term" tabindex="0" data-tip={tip}>{name}</span><strong>{f(r.numbers[order[1]])}</strong></p>
                <div class="rope" aria-hidden="true"><b class="t-away" style={`--g:${g[0]}`}></b><b class="t-home" style={`--g:${g[1]}`}></b></div>
              </div>
            );
          })}
        </div>
        {r.end === 'SO' && <p class="note small">The shootout decides the result but is left out of every other number on this site.</p>}
      </GameStory>
    ) : (
      <div class="card">
        <div class="tug">
          <p class="tug-head">{order.map((a) => <span class={`t-${side(a)}`}><i></i>{a}</span>)}</p>
          {rows.map(([name, tip, f, v]) => {
            const [x, y] = order.map((a) => Math.max(0, v(r.numbers[a])));
            const g = x + y > 0 ? [x, y] : [1, 1];
            return (
              <div class="tug-row">
                <p class="tug-top"><strong>{f(r.numbers[order[0]])}</strong><span class="term" tabindex="0" data-tip={tip}>{name}</span><strong>{f(r.numbers[order[1]])}</strong></p>
                <div class="rope" aria-hidden="true"><b class="t-away" style={`--g:${g[0]}`}></b><b class="t-home" style={`--g:${g[1]}`}></b></div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    {dw && replays && (
      <div class="card meter" id="replays">
        <p class="mini-h">Run it back</p>
        <h3 class="h">{replayHead}</h3>
        <div class="rp-head">
          <div class="rp-counts">
            <span class="t-away"><b data-k="t-away">{replays.away}</b> {place(away)}</span>
            <span class="rp-tie"><b data-k="tie">{replays.tie}</b> even</span>
            <span class="t-home"><b data-k="t-home">{replays.home}</b> {place(home)}</span>
          </div>
          <button type="button" class="rp-again" aria-label="Run it again: replay the 100 games" data-tip="Run it again"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9" /><path d="M12.6 1.6v3.1H9.5" /></svg></button>
        </div>
        <div class="replays" role="img" aria-label={`Of 100 games like this, ${place(away)} wins ${replays.away}, ${place(home)} wins ${replays.home}, and ${replays.tie} are tied after regulation.`}>
          {dots.map((d) => <i class={d === 'tie' ? 'tie' : `t-${d}`}></i>)}
        </div>
        <div class="meter-text">
          <p>{replayBody}</p>
          <p class="detail">{order.map((a, i) => `${i ? ' ' : ''}${place(a)} had ${dw.chances[a]} chances worth ${dw.xg[a].toFixed(1)} expected goals.`).join('')}</p>
          <Gloss label="How the replays work">
            <p class="note">Every shot in regulation that was on target or missed the net goes in as often as our <span class="term" tabindex="0" data-tip="How often a shot like this one becomes a goal, by this site’s model, judged on where it came from and what happened just before it.">expected-goals</span> model says it should, and the game is played out 100 times. A rebound scramble counts as one chance, and empty-net shots are left out. A replay tied after regulation counts as half a win each, since overtime and shootouts are close to coin flips.</p>
            <p class="note">Played out shot by shot, the team with the better chances wins too often: a team with a lead tends to sit back while the other chases, and the replays don’t know about goalies, finishing skill or passes before a shot. So the share is corrected by how games with chances like these really ended over the last three seasons. Replays that came out 85 to 15 read about 70 to 30, and teams given 60% to 70% have won about 65% of the time.</p>
          </Gloss>
        </div>
      </div>
    )}
  </section>

  {hasFlow && (
    <Section id="flow" title="How it unfolded" placeholder={false} takeaway="Every shot on goal or wide of the net, in game time. Press play, or tap the chart to stop at a moment and see who was on the ice.">
      <GameFlow id={r.game_id} away={away} home={home} awayName={T[away]?.name ?? away} homeName={T[home]?.name ?? home} score={[r.score[away], r.score[home]]} end={r.end} />
    </Section>
  )}

  <Section id="preview" title="What the preview said" placeholder={false} takeaway={takeaway}>
    {rv && order.map((a) => (
      <div class={`pov pov-${side(a)}`}>
        <ChanceStory team={place(a)} teamCls={`t-${side(a)}`} other={place(other(a))} otherCls={`t-${side(other(a))}`}
          chance={rv.sides[a].chance} outcome={outcome(rv.sides[a].head)} beats={beatsFor(a)} />
      </div>
    ))}

    {r.calls.length > 0 ? (
      <ol class="claims">
        {r.calls.map((c) => (
          <li class="card claim">
            <div class="claim-said">
              <h3>{c.head}</h3>
              <p class="detail">{c.body}</p>
              {c.call && <p class="call"><span>The call</span> {c.call}</p>}
              {c.nums && <p class="nums">{c.nums}</p>}
            </div>
            <div class="claim-did">
              {c.verdict === null ? (
                <>
                  <p class="verdict na">– Can’t judge</p>
                  <p class="detail">This call has no rule to check it by.</p>
                </>
              ) : (
                <>
                  <p class:list={['verdict', c.verdict]}><span aria-hidden="true">{mark[c.verdict]}</span> {label[c.verdict]}</p>
                  <p>{c.happened}</p>
                  {c.beyond && <p class="beyond"><strong>Called it, and then some.</strong> {c.beyond}</p>}
                  {c.tonight && c.tonight !== '–' && (
                    <dl class="compare">
                      <div><dd>{c.usual}</dd><span>Coming in</span></div>
                      <div><dd>{c.tonight}</dd><span>In this game</span></div>
                      {c.league && <div><dd>{c.league}</dd><span>{c.kind === 'matchup' ? 'With no line matching' : 'League average'}</span></div>}
                    </dl>
                  )}
                </>
              )}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="note">No preview was saved for this game, so there were no calls to check.</p>
    )}
    {(r.preview_page || seasonTotal > 0) && (
      <p class="note small">
        {r.preview_page && <><a href={`${import.meta.env.BASE_URL}preview/${r.game_id}/`}>Read the full preview</a> as it stood at puck drop.</>}
        {seasonTotal > 0 && <> This season: {season.held} held up, {season.partly} partly, {season.missed} didn’t happen, out of {seasonTotal}. <a href={`${import.meta.env.BASE_URL}record/`}>Track record</a>.</>}
      </p>
    )}
    <Gloss label="How the calls are checked">
      <p class="note">Each call is checked by a rule set before the game. <strong>Held up</strong>: the team reached their usual level. <strong>Partly</strong>: they fell short of their usual level but still beat the league average. When a call says one team will come out ahead, held up means they won by at least half their usual gap, and partly means they won by less. One game is a small sample, so a miss doesn’t mean the preview was wrong about the team.</p>
    </Gloss>

    {r.surprises.length > 0 && (
      <>
        <h3 class="sub">What it didn’t see coming</h3>
        <ul class="two surp">{r.surprises.map((s) => <li class:list={['card', { mild: s.mild }]}><p class="eyebrow">{s.flipped ? 'Flipped a call' : s.mild && s.kind !== 'form' ? `Smaller twist · ${s.tag}` : s.tag}</p><h3 class="h">{s.head}</h3>{s.flipped && <p class="flipped">The preview said “{s.flipped}.”</p>}<p>{s.body}</p></li>)}</ul>
        <Gloss label="What the labels mean">
          <p class="note"><strong>Broke the pattern</strong>: a team did the opposite of their usual habit. <strong>Further than usual</strong>: a usual habit, taken much further. <strong>Closer than usual</strong>: a usual strength or weakness that mostly disappeared. <strong>Out of character</strong>: a usually average team, far from average. Each is measured against the teams’ numbers before the game.</p>
        </Gloss>
      </>
    )}
  </Section>

  <GameSwing gameId={r.game_id} place={place} side={side} />

  <PlayerJobs gameId={r.game_id} place={place} side={side} />

  <Section id="goalies" title="In net" placeholder={false} takeaway={hasGoalieCards ? "Each goalie’s night: the goals he stopped beyond what the shots were worth, and the dangerous and routine saves." : "How many goals each goalie stopped beyond what the shots he faced were worth."}>
    {hasGoalieCards ? <PlayerJobs gameId={r.game_id} place={place} side={side} goalies /> : (
    <ul class="two gl">
      {r.goalies.map((g) => (
        <li class:list={['card', `t-${side(g.team)}`]}>
          <div class="job-top"><span class="job-name"><i></i><PLink id={g.id} name={g.name} /></span><span class="gs"><strong>{sgn(g.gsax)}</strong> <span class="term" tabindex="0" data-tip="Goals saved above expected: the goals his shots were worth by this site’s model, minus the goals he let in. Positive is good.">goals saved above expected</span></span></div>
          <p>{g.saves} saves on {g.shots} shots{g.sv !== null ? ` (${g.sv.toFixed(3).replace(/^0/, '')})` : ''} in {g.toi}{g.started ? '' : ' in relief'}. The shots were worth {g.xga.toFixed(1)} expected goals; he allowed {g.ga}.{g.high.shots > 0 ? ` Stopped ${g.high.shots - g.high.goals} of ${g.high.shots} high-danger shots.` : ''}</p>
        </li>
      ))}
    </ul>
    )}
    {!hasGoalieCards && <Gloss label="What to keep in mind">
      <p class="note">Empty-net shots are left out. Expected-goal models can’t see passes before a shot, so a goalie beaten by cross-ice passes looks worse here than he really was.</p>
    </Gloss>}
  </Section>

  <p class="note foot">Team pages: <a href={`${import.meta.env.BASE_URL}team/${away}/`}>{T[away]?.name ?? away}</a> · <a href={`${import.meta.env.BASE_URL}team/${home}/`}>{T[home]?.name ?? home}</a></p>
<script is:inline>
  // The numbers: each bar starts even and leans to the team that had more once it is on screen. Without motion
  // (or before this runs) the bars simply show their split.
  (() => {
    const ropes = [...document.querySelectorAll('.rope')];
    if (!ropes.length || !document.documentElement.classList.contains('motion') || !('IntersectionObserver' in window)) return;
    ropes.forEach((r) => r.classList.add('mid'));
    const io = new IntersectionObserver((es) => {
      if (!es.some((e) => e.isIntersecting)) return;
      io.disconnect();
      ropes.forEach((r, i) => setTimeout(() => r.classList.remove('mid'), 150 + i * 140));
    }, { threshold: 0.4 });
    io.observe(ropes[0].closest('.tug'));
  })();

  // Run it again: deal the same 100 replays out in a random order, counting as they land, then let the dots slide back into their sorted seats.
  (() => {
    const btn = document.querySelector('.rp-again');
    const grid = document.querySelector('.replays');
    if (!btn || !grid) return;
    const dots = [...grid.children];
    const sorted = dots.map((d) => d.className);
    const nums = [...document.querySelectorAll('.rp-counts b')];
    const saved = nums.map((b) => b.textContent);
    const run = () => {
      if (!document.documentElement.classList.contains('motion') || btn.disabled) return;
      btn.disabled = true;
      // Close the button's tooltip so it doesn't sit over the dots while they land.
      setTimeout(() => document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' })));
      const deal = sorted.map((c, i) => [c, Math.random(), i]).sort((a, b) => a[1] - b[1]);
      dots.forEach((d) => { d.className = 'rp-empty'; });
      const count = { 't-away': 0, 't-home': 0, tie: 0 };
      const show = () => nums.forEach((b) => { b.textContent = count[b.dataset.k]; });
      show();
      let n = 0;
      const step = () => {
        for (let k = 0; k < 2 && n < deal.length; k++, n++) {
          dots[n].className = `${deal[n][0]} rp-pop`;
          count[deal[n][0]]++;
        }
        show();
        if (n < deal.length) setTimeout(step, 28);
        else setTimeout(settle, 350);
      };
      const settle = () => {
        // FLIP: remember where each outcome sits now, put the sorted order back, then slide each dot from there.
        const from = deal.map(([, , seat], i) => [seat, dots[i].getBoundingClientRect()]);
        dots.forEach((d, i) => { d.className = sorted[i]; });
        let left = from.length;
        from.forEach(([seat, r], i) => {
          const to = dots[seat].getBoundingClientRect();
          const a = dots[seat].animate({ translate: [`${r.left - to.left}px ${r.top - to.top}px`, '0 0'] },
            { duration: 700, delay: Math.min(i, 60) * 4, easing: 'cubic-bezier(0.5, 0, 0.2, 1)', fill: 'backwards' });
          a.finished.catch(() => {}).then(() => {
            if (--left) return;
            nums.forEach((b, j) => { b.textContent = saved[j]; });
            btn.disabled = false;
          });
        });
      };
      setTimeout(step, 120);
    };
    btn.addEventListener('click', run);
    // The first time the dots come into view they are dealt out the same way. Until then they simply show,
    // so nothing is hidden if this never runs.
    if (document.documentElement.classList.contains('motion') && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); run(); } }, { threshold: 0.6 });
      io.observe(grid);
    }
  })();
</script>
</Base>

