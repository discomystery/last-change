---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Rink from '../../components/Rink.astro';
import * as m from '../../data/mock';

export function getStaticPaths() {
  return [{ params: { gameId: String(m.game.id) } }];
}
const { teams, recap } = m;
const label = { held: 'Held up', partly: 'Partly', missed: 'Didn’t happen' } as const;
const mark = { held: '✓', partly: '≈', missed: '✕' } as const;
const tally = (v: m.Verdict) => recap.claims.filter((c) => c.verdict === v).length;
const dateStr = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(m.game.startTimeUTC));
---
<Base title={`${m.away} at ${m.home} recap`}>
  <section class="hero" aria-label="Final score">
    <Rink score={recap.score} centre="final" />
    <p class="when">{dateStr} · {m.game.venue} · <a href={`${import.meta.env.BASE_URL}preview/${m.game.id}/`}>Read the preview as it stood at puck drop</a></p>
  </section>

  <Section id="scorecard" title="What we said, and what happened" takeaway={`Of the ${recap.claims.length} things the preview told you to watch, ${tally('held')} held up, ${tally('partly')} partly did, and ${tally('missed')} didn’t happen.`}>
    <ol class="claims">
      {recap.claims.map((c) => (
        <li class="card claim">
          <div class="claim-said">
            <p class="eyebrow">Before the game</p>
            <h3>{c.said}</h3>
            <p class="detail">{c.detail}</p>
          </div>
          <div class="claim-did">
            <p class:list={['verdict', c.verdict]}><span aria-hidden="true">{mark[c.verdict]}</span> {label[c.verdict]}</p>
            <p>{c.happened}</p>
            <dl class="compare">
              <dt>{c.measure}</dt>
              <div><dd>{c.usual}</dd><span>Coming in</span></div>
              <div><dd>{c.tonight}</dd><span>In this game</span></div>
            </dl>
          </div>
        </li>
      ))}
    </ol>
    <p class="note">One game is a tiny sample. A miss doesn’t mean the preview was wrong about the team, and a hit doesn’t prove it right. The season-long record of how often these calls hold up is the real test.</p>
  </Section>

  <Section id="surprises" title="What the preview didn’t see coming" takeaway="The parts of this game that were furthest from how these teams usually play.">
    <ul class="two">
      {recap.surprises.map((s) => <li class="card"><h3 class="h">{s.head}</h3><p>{s.body}</p></li>)}
    </ul>
  </Section>

  <Section id="jobs" title="Did he do his job?" takeaway="Each player measured against what he normally does in the same amount of ice time.">
    <ul class="jobs">
      {recap.jobs.map((j) => (
        <li class:list={['card', `t-${j.team}`]}>
          <div class="job-top"><span class="job-name"><i></i>{j.name}</span><span class="chip">{j.role}</span><span class:list={['verdict', j.verdict]}><span aria-hidden="true">{mark[j.verdict]}</span> {j.verdict === 'held' ? 'Did his job' : j.verdict === 'partly' ? 'Mixed night' : 'Off night'}</span></div>
          <p>{j.line}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="goalies" title="In net">
    <ul class="two">
      {recap.goalies.map((g) => (
        <li class:list={['card', `t-${g.team}`]}>
          <div class="job-top"><span class="job-name"><i></i>{g.name}</span><span class="gs"><strong>{g.gsax}</strong> goals saved above expected</span></div>
          <p>{g.line}</p>
        </li>
      ))}
    </ul>
  </Section>
</Base>

<style>
  .hero { margin-top: 10px; }
  .when { margin-top: 14px; font: 400 14px var(--ui); color: var(--ink-2); }
  .claims { display: grid; gap: 16px; margin-top: 22px; }
  .claim { display: grid; gap: 16px; }
  @media (min-width: 760px) { .claim { grid-template-columns: 1fr 1fr; gap: 28px; } .claim-did { border-left: 5px solid var(--line-red); padding-left: 24px; } }
  .eyebrow { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); margin-bottom: 4px; }
  .claim h3, .h { font: 600 22px/1.15 var(--display); margin-bottom: 8px; }
  .detail { color: var(--ink-2); font-size: 15px; }
  .verdict { display: inline-flex; align-items: center; gap: 6px; font: 700 13px var(--ui); padding: 4px 11px; border-radius: 999px; border: 2px solid var(--ink); white-space: nowrap; margin-bottom: 8px; }
  .verdict.held { background: var(--ink); color: var(--sheet); }
  .verdict.missed { border-style: dashed; color: var(--ink-2); border-color: var(--ink-3); }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--rule); }
  .compare dt { grid-column: 1 / -1; font-size: 13px; color: var(--ink-2); }
  .compare dd { font: 700 24px/1.1 var(--display); }
  .compare span { font-size: 12px; color: var(--ink-3); }
  .jobs { display: grid; gap: 14px; margin-top: 22px; }
  @media (min-width: 760px) { .jobs { grid-template-columns: 1fr 1fr; } }
  .job-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-bottom: 8px; }
  .job-top .verdict { margin: 0 0 0 auto; }
  .job-name { font: 700 20px/1 var(--display); display: inline-flex; align-items: center; gap: 8px; }
  .job-name i { width: 11px; height: 11px; border-radius: 50%; background: var(--team); }
  .gs { margin-left: auto; font: 400 13px var(--ui); color: var(--ink-2); }
  .gs strong { font: 700 22px/1 var(--display); color: var(--ink); }
</style>
