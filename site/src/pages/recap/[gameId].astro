---
// Post-game page, one per finished game. What happened (the short version with the game's basic numbers, then run it
// back), what the preview expected (the win chance kept hidden before the game, the preview's calls exactly as saved
// at puck drop, each graded by the rule stored with it, and what it didn't see coming), then the players.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Rink from '../../components/Rink.astro';
import GameTrail from '../../components/GameTrail.astro';
import PLink from '../../components/PLink.astro';
import PlayerJobs from '../../components/PlayerJobs.astro';
import GameSwing from '../../components/GameSwing.astro';
import SectionNav from '../../components/SectionNav.astro';
import GameStory, { type Story } from '../../components/GameStory.astro';
import Gloss from '../../components/Gloss.astro';
import '../../styles/blocks.css';
import { matchupColours } from '../../lib/teams';
import teamsData from '../../../public/data/teams.json';
import recapIndex from '../../../public/data/recaps/index.json';

type Call = { id: string; kind: string; head: string; body: string; call?: string | null; nums?: string | null; cite: string; verdict: 'held' | 'partly' | 'missed' | 'na' | null; happened?: string; beyond?: string; usual?: string; tonight?: string; league?: string };
type Nums = { shots: number; xg: number; cf5: number; pp_goals: number; pp_opps: number };
type Goalie = { id: number; name: string; team: string; started: boolean; toi: string; shots: number; saves: number; ga: number; xga: number; gsax: number; sv: number | null; high: { shots: number; goals: number } };
type Replays = { share: Record<string, number>; regulation: Record<string, number>; xg: Record<string, number>; chances: Record<string, number> };
type Recap = { game_id: number; date: string; start: string; away: string; home: string; venue: string; score: Record<string, number>; end: string; preview: boolean; rebuilt?: boolean; preview_page?: boolean; snapshot_at: string | null; calls: Call[]; numbers: Record<string, Nums>; goalies: Goalie[]; surprises: { kind?: string; tag?: string; mild?: boolean; head: string; body: string; flipped?: string }[]; replays?: Replays | null; story?: Story;
  reveal?: { p_home: number; p_home_puck: number | null; steps: { input: string; label: string; shift: number }[]; sides: Record<string, { head: string; chance: number }>;
    inputs?: Record<string, { xgd: number; b2b: number; roster?: number; lineup?: number }> } | null };

export async function getStaticPaths() {
  const files = import.meta.glob<{ default: Recap }>('../../../public/data/recaps/2*.json', { eager: true });
  return Object.values(files).map((f) => ({ params: { gameId: String(f.default.game_id) }, props: { r: f.default } }));
}
const { r } = Astro.props as { r: Recap };
const { away, home } = r;
const order = [away, home];
const T = Object.fromEntries(teamsData.map((t) => [t.abbr, t]));
const place = (a: string) => T[a]?.place ?? a;
const side = (a: string) => (a === away ? 'away' : 'home');
const colours = matchupColours(away, home);
// The reveal is told from the visitor's own team's side when it played, otherwise the home team's.
const povCss = `.pov-away{display:none}html[data-team="${away}"] .pov-away{display:block}html[data-team="${away}"] .pov-home{display:none}`;
const rv = r.reveal;
// Each input's shift, told from one team's side, with the running chance after it.
const ladder = (a: string) => {
  if (!rv) return [];
  const sign = a === home ? 1 : -1;
  let run = 50;
  return rv.steps.map((s) => {
    const pts = Math.round(100 * s.shift * sign);
    const before = run;
    run += 100 * s.shift * sign;
    return { label: s.label, input: s.input, pts, before, end: run, after: Math.round(run) };
  });
};
// What each step was for, in a sentence, told from team a's side.
const other = (a: string) => (a === home ? away : home);
const xgWord = (v: number) => `${Math.abs(v).toFixed(2)} expected goals a game`;
const recent = (t: string, v: number) => Math.abs(v) < 0.05 ? `${place(t)} have broken about even on chances` : v > 0 ? `${place(t)} have outchanced their opponents by ${xgWord(v)}` : `${place(t)} have been outchanced by ${xgWord(v)}`;
const why = (a: string, input: string, pts: number) => {
  const o = other(a), inp = rv?.inputs;
  if (input === 'home') return `${place(home)} were at home. Over the last three seasons, home teams won about ${50 + Math.round(Math.abs(pts))}% of games.`;
  if (input === 'xgd') return inp ? `Lately, ${recent(a, inp[a].xgd)}, and ${recent(o, inp[o].xgd)}. The latest games count most, and last season still counts a little.` : 'How much better each team’s chances have been than their opponents’ lately, with the latest games counting most.';
  if (input === 'roster') return pts === 0 ? 'Both teams’ last lineups were about as strong as the ones behind their recent chances.'
    : `${place(pts < 0 ? a : o)}’s last lineup was weaker than the ones behind their recent chances, so their recent form flattered them a little.`;
  if (input === 'b2b') { const tired = inp ? [a, o].filter((t) => inp[t].b2b) : []; return tired.length ? `${tired.map(place).join(' and ')} played the night before. Teams on the second night win less often.` : 'Neither team played the night before.'; }
  if (input === 'lineup') return pts === 0 ? 'Nobody important came in or went out between the morning and puck drop.' : `The lineups at puck drop moved it ${Math.abs(pts)} points ${pts > 0 ? 'toward' : 'away from'} ${place(a)}.`;
  return '';
};
// The reveal headline without the number the page already shows big: "We gave Carolina a 76% chance, and Carolina
// delivered." reads "Carolina delivered."
const outcome = (head: string) => { const t = head.replace(/^We (gave|had) .*?(chance|\)), (and|but) /, ''); return t.charAt(0).toUpperCase() + t.slice(1); };
// Steps are drawn on a 20% to 80% scale so a few points still show; anything past the ends sits at the edge.
const at = (v: number) => Math.max(0, Math.min(100, ((v - 20) / 60) * 100));
const signed = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${-n}` : '0');
const colourCss = `:root{--away:${colours.away};--home:${colours.home}}.t-away{--team:var(--away)}.t-home{--team:var(--home)}@media (prefers-color-scheme: dark){.t-away{--team:color-mix(in oklab,var(--away) 55%,white)}.t-home{--team:color-mix(in oklab,var(--home) 55%,white)}}`;
const dateStr = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(r.start));
const endWord = r.end === 'OT' ? 'Final in overtime' : r.end === 'SO' ? 'Final in a shootout' : 'Final';
const label = { held: 'Held up', partly: 'Partly', missed: 'Didn’t happen', na: 'Can’t judge' } as const;
const mark = { held: '✓', partly: '≈', missed: '✕', na: '–' } as const;
const graded = r.calls.filter((c) => c.verdict && c.verdict !== 'na');
const count = (v: string) => graded.filter((c) => c.verdict === v).length;
const sayCount = (n: number, one: string) => `${n} ${one}`;
const takeaway = graded.length
  ? `Of the ${graded.length} calls the preview made, ${count('held')} held up, ${count('partly')} partly did, and ${count('missed')} didn’t happen.`
  : r.preview ? 'None of the preview’s calls could be judged from this game.' : 'No preview was saved for this game.';
const season = recapIndex.tally as Record<string, number>;
const seasonTotal = season.held + season.partly + season.missed;
const sgn = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(1)}`;
const rows: [string, string, (n: Nums) => string][] = [
  ['Shots on goal', 'Every shot that reached the net, including goals.', (n) => String(n.shots)],
  ['Expected goals', 'How many goals the chances were worth, by this site’s model. Empty nets left out.', (n) => n.xg.toFixed(1)],
  ['Shot attempts at 5-on-5', 'Every attempt at even strength with both goalies in: on goal, missed or blocked.', (n) => String(n.cf5)],
  ['Power plays', 'Power-play goals, out of times on the power play.', (n) => `${n.pp_goals} of ${n.pp_opps}`],
];
// Run it back: 100 replays of the game's chances, split by largest remainder so the dots always add to 100.
const dw = r.replays ?? null;
const replays = (() => {
  if (!dw) return null;
  // The saved shares are rounded, so they can add to 99.9 or 100.1: scale them to exactly 100 first.
  const raw0 = [dw.regulation[away], dw.regulation.tie, dw.regulation[home]];
  const tot = raw0.reduce((a, b) => a + b, 0) || 1;
  const raw = raw0.map((p) => (100 * p) / tot);
  const n = raw.map(Math.floor);
  // Dots still owed, counted once: recounting inside the loop stopped it early and left games a dot or two short.
  const owed = 100 - n.reduce((a, b) => a + b, 0);
  const order = raw.map((v, i) => [v - Math.floor(v), i] as const).sort((a, b) => b[0] - a[0]);
  for (let k = 0; k < owed; k++) n[order[k % 3][1]] += 1;
  return { away: n[0], tie: n[1], home: n[2] };
})();
const winner = r.score[home] > r.score[away] ? home : away;
const loser = winner === home ? away : home;
const pct = (a: string) => Math.round(100 * (dw?.share[a] ?? 0));
const replayHead = !dw ? '' : pct(winner) >= 60 ? `${place(winner)} earned this one`
  : pct(loser) >= 60 ? `${place(loser)} usually wins this one` : 'Too close to call on chances';
const replayBody = !dw ? '' : pct(loser) >= 60
  ? `Played out 100 times with these chances, ${place(loser)} wins ${pct(loser)}. The goals went the other way.`
  : pct(winner) >= 60 ? `Played out 100 times with these chances, ${place(winner)} wins ${pct(winner)}.`
  : `Played out 100 times with these chances, ${place(away)} wins ${pct(away)} and ${place(home)} ${pct(home)}, close to a coin flip.`;
// Section order tells the story: what we expected, what happened, then the detail.
// Report cards exist for this game when the pipeline wrote jobs/{id}.json (PlayerJobs renders nothing otherwise).
const jobFiles = import.meta.glob<{ default: { game_id: number; players: { pos: string }[] } }>('../../../public/data/jobs/2*.json', { eager: true });
const jobs = Object.values(jobFiles).find((f) => f.default.game_id === r.game_id)?.default;
const hasJobs = !!jobs?.players.some((c) => c.pos !== 'G');
const hasGoalieCards = !!jobs?.players.some((c) => c.pos === 'G');
const scoreFiles = import.meta.glob<{ default: { game_id: number; players: unknown[] } }>('../../../public/data/scores/2*.json', { eager: true });
const hasImpact = !!Object.values(scoreFiles).find((f) => f.default.game_id === r.game_id)?.default.players.length;
const story = r.story;
const nav = [
  ['story', 'Overview'], ...(dw ? [['replays', 'Run it back']] : []), ['preview', 'The preview'],
  ...(hasImpact ? [['swing', 'Swing']] : []), ...(hasJobs ? [['jobs', 'Players']] : []), ['goalies', 'In net'],
];
const dots = replays ? [...Array(replays.away).fill('away'), ...Array(replays.tie).fill('tie'), ...Array(replays.home).fill('home')] : [];
---
<Base section="games" title={`${away} at ${home}, final`} mock={false}>
  <style is:inline set:html={colourCss + povCss}></style>
  <section class="hero" aria-label="Final score">
    <GameTrail id={r.game_id} part="crumbs" />
    <Rink centre="final" sides={order.map((a) => ({ abbr: a, cls: `t-${side(a)}`, full: T[a]?.name ?? a, score: r.score[a], home: a === home, href: `${import.meta.env.BASE_URL}team/${a}/` }))} />
    <GameTrail id={r.game_id} part="around"><p class="when-day">{dateStr}</p><p><strong>{endWord}</strong> · {r.venue}</p></GameTrail>
  </section>

  <SectionNav items={nav as [string, string][]} />

  <section class="sec top" id="story" aria-label="Overview">
    {story ? (
      <GameStory story={story} kicker={false}>
        <table class="numbers">
          <thead><tr><td></td>{order.map((a) => <th scope="col" class={`t-${side(a)}`}><i></i>{a}</th>)}</tr></thead>
          <tbody>
            {rows.map(([name, tip, f]) => <tr><th scope="row"><span class="term" tabindex="0" data-tip={tip}>{name}</span></th>{order.map((a) => <td>{f(r.numbers[a])}</td>)}</tr>)}
          </tbody>
        </table>
        {r.end === 'SO' && <p class="note small">The shootout decides the result but is left out of every other number on this site.</p>}
      </GameStory>
    ) : (
      <div class="card">
        <table class="numbers">
          <thead><tr><td></td>{order.map((a) => <th scope="col" class={`t-${side(a)}`}><i></i>{a}</th>)}</tr></thead>
          <tbody>
            {rows.map(([name, tip, f]) => <tr><th scope="row"><span class="term" tabindex="0" data-tip={tip}>{name}</span></th>{order.map((a) => <td>{f(r.numbers[a])}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
    )}

    {dw && replays && (
      <div class="card meter" id="replays">
        <div class="replays" role="img" aria-label={`Of 100 replays, ${place(away)} wins ${replays.away}, ${place(home)} wins ${replays.home}, and ${replays.tie} are tied after regulation.`}>
          {dots.map((d, i) => <i class={d === 'tie' ? 'tie' : `t-${d}`} style={`--i:${i}`}></i>)}
        </div>
        <div class="meter-text">
          <p class="mini-h">Run it back</p>
          <h3 class="h">{replayHead}</h3>
          <p>{replayBody}</p>
          <dl class="compare">
            {order.map((a) => (
              <div class={`t-${side(a)}`}><dd><i></i>{pct(a)}%</dd><span>{place(a)}: {replays[side(a)]} wins, plus half of the {replays.tie} ties</span></div>
            ))}
          </dl>
          <p class="detail">{order.map((a, i) => `${i ? ' ' : ''}${place(a)} had ${dw.chances[a]} chances worth ${dw.xg[a].toFixed(1)} expected goals.`).join('')}</p>
          <Gloss label="How the replays work">
            <p class="note">Every shot in regulation that was on target or missed the net goes in as often as our <span class="term" tabindex="0" data-tip="How often a shot like this one becomes a goal, by this site’s model, judged on where it came from and what happened just before it.">expected-goals</span> model says it should, and the game is played out 100 times. A rebound scramble counts as one chance, and empty-net shots are left out. A replay tied after regulation counts as half a win each, since overtime and shootouts are close to coin flips.</p>
            <p class="note">It doesn’t know about goalies, finishing skill or passes before a shot. It also favours the team that was chasing, because a team with a lead tends to sit back. Over the last three seasons, teams it gave 80% or more won about two games in three.</p>
          </Gloss>
        </div>
      </div>
    )}
  </section>

  <Section id="preview" title="What the preview said" placeholder={false} takeaway={takeaway}>
    {rv && order.map((a) => {
      const steps = ladder(a);
      const lineupMoved = steps.some((y) => y.input === 'lineup' && y.pts !== 0);
      const track = (x: { before: number; end: number; pts: number }) => (
        <div class="st-t" aria-hidden="true">
          <i class="mid"></i>
          {x.pts !== 0 && <span class={`seg t-${side(x.pts > 0 ? a : other(a))}`} style={`left:${Math.min(at(x.before), at(x.end)).toFixed(1)}%;width:${Math.abs(at(x.end) - at(x.before)).toFixed(1)}%`}></span>}
          <i class="dot" style={`left:${at(x.end).toFixed(1)}%`}></i>
        </div>
      );
      return (
        <div class={`pov pov-${side(a)}`}><div class="card chance">
          <div class="chance-main">
            <p class="mini-h">Our win chance, kept hidden until the final</p>
            <p class="big"><span>{rv.sides[a].chance}%</span>for {place(a)} to win</p>
            <h3 class="h">{outcome(rv.sides[a].head)}</h3>
            <p class="note small">Worked out the morning of the game, from earlier games only. The preview could hint at it in words but never showed the number.</p>
          </div>
          <ol class="steps" aria-label={`How we got to ${rv.sides[a].chance}% for ${place(a)}`}>
            <li class="step start"><div class="st-l"><b>Two even teams on neutral ice</b></div>{track({ before: 50, end: 50, pts: 0 })}<div class="st-n"><b>50%</b></div></li>
            {steps.filter((x) => x.input !== 'lineup').map((x) => (
              <>
                <li class="step"><div class="st-l"><b>{x.label}</b><span>{why(a, x.input, x.pts)}</span></div>{track(x)}<div class="st-n">{signed(x.pts)}<b>{x.after}%</b></div></li>
                {x.input === 'b2b' && <li class="step sum"><div class="st-l"><b>{lineupMoved ? 'The morning of the game' : 'The morning of the game and at puck drop'}</b>{!lineupMoved && rv.p_home_puck !== null && <span>Nobody important came in or went out before puck drop.</span>}</div>{track({ before: x.end, end: x.end, pts: 0 })}<div class="st-n"><b>{rv.sides[a].chance}%</b></div></li>}
              </>
            ))}
            {steps.filter((x) => x.input === 'lineup' && x.pts !== 0).map((x) => (
              <>
                <li class="step"><div class="st-l"><b>{x.label}</b><span>{why(a, x.input, x.pts)}</span></div>{track(x)}<div class="st-n">{signed(x.pts)}<b>{x.after}%</b></div></li>
                <li class="step sum"><div class="st-l"><b>At puck drop</b></div>{track({ before: x.end, end: x.end, pts: 0 })}<div class="st-n"><b>{x.after}%</b></div></li>
              </>
            ))}
          </ol>
        </div></div>
      );
    })}

    {r.calls.length > 0 ? (
      <ol class="claims">
        {r.calls.map((c) => (
          <li class="card claim">
            <div class="claim-said">
              <h3>{c.head}</h3>
              <p class="detail">{c.body}</p>
              {c.call && <p class="call"><span>The call</span> {c.call}</p>}
              {c.nums && <p class="nums">{c.nums}</p>}
            </div>
            <div class="claim-did">
              {c.verdict === null ? (
                <>
                  <p class="verdict na">– Can’t judge</p>
                  <p class="detail">This call has no rule to check it by.</p>
                </>
              ) : (
                <>
                  <p class:list={['verdict', c.verdict]}><span aria-hidden="true">{mark[c.verdict]}</span> {label[c.verdict]}</p>
                  <p>{c.happened}</p>
                  {c.beyond && <p class="beyond"><strong>Called it, and then some.</strong> {c.beyond}</p>}
                  {c.tonight && c.tonight !== '–' && (
                    <dl class="compare">
                      <div><dd>{c.usual}</dd><span>Coming in</span></div>
                      <div><dd>{c.tonight}</dd><span>In this game</span></div>
                      {c.league && <div><dd>{c.league}</dd><span>{c.kind === 'matchup' ? 'With no line matching' : 'League average'}</span></div>}
                    </dl>
                  )}
                </>
              )}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="note">No preview was saved for this game, so there were no calls to check.</p>
    )}
    {(r.preview_page || seasonTotal > 0) && (
      <p class="note small">
        {r.preview_page && <><a href={`${import.meta.env.BASE_URL}preview/${r.game_id}/`}>Read the full preview</a> as it stood at puck drop.</>}
        {seasonTotal > 0 && <> This season: {season.held} held up, {season.partly} partly, {season.missed} didn’t happen, out of {seasonTotal}. <a href={`${import.meta.env.BASE_URL}record/`}>Track record</a>.</>}
      </p>
    )}
    <Gloss label="How the calls are checked">
      <p class="note">Each call is checked by a rule set before the game. <strong>Held up</strong>: the team reached their usual level. <strong>Partly</strong>: they fell short of their usual level but still beat the league average. When a call says one team will come out ahead, held up means they won by at least half their usual gap, and partly means they won by less. One game is a small sample, so a miss doesn’t mean the preview was wrong about the team.</p>
    </Gloss>

    {r.surprises.length > 0 && (
      <>
        <h3 class="sub">What it didn’t see coming</h3>
        <ul class="two surp">{r.surprises.map((s) => <li class:list={['card', { mild: s.mild }]}><p class="eyebrow">{s.flipped ? 'Flipped a call' : s.mild && s.kind !== 'form' ? `Smaller twist · ${s.tag}` : s.tag}</p><h3 class="h">{s.head}</h3>{s.flipped && <p class="flipped">The preview said “{s.flipped}.”</p>}<p>{s.body}</p></li>)}</ul>
        <Gloss label="What the labels mean">
          <p class="note"><strong>Broke the pattern</strong>: a team did the opposite of their usual habit. <strong>Further than usual</strong>: a usual habit, taken much further. <strong>Closer than usual</strong>: a usual strength or weakness that mostly disappeared. <strong>Out of character</strong>: a usually average team, far from average. Each is measured against the teams’ numbers before the game.</p>
        </Gloss>
      </>
    )}
  </Section>

  <GameSwing gameId={r.game_id} place={place} side={side} />

  <PlayerJobs gameId={r.game_id} place={place} side={side} />

  <Section id="goalies" title="In net" placeholder={false} takeaway={hasGoalieCards ? "Each goalie’s night: the goals he stopped beyond what the shots were worth, and the dangerous and routine saves." : "How many goals each goalie stopped beyond what the shots he faced were worth."}>
    {hasGoalieCards ? <PlayerJobs gameId={r.game_id} place={place} side={side} goalies /> : (
    <ul class="two gl">
      {r.goalies.map((g) => (
        <li class:list={['card', `t-${side(g.team)}`]}>
          <div class="job-top"><span class="job-name"><i></i><PLink id={g.id} name={g.name} /></span><span class="gs"><strong>{sgn(g.gsax)}</strong> <span class="term" tabindex="0" data-tip="Goals saved above expected: the goals his shots were worth by this site’s model, minus the goals he let in. Positive is good.">goals saved above expected</span></span></div>
          <p>{g.saves} saves on {g.shots} shots{g.sv !== null ? ` (${g.sv.toFixed(3).replace(/^0/, '')})` : ''} in {g.toi}{g.started ? '' : ' in relief'}. The shots were worth {g.xga.toFixed(1)} expected goals; he allowed {g.ga}.{g.high.shots > 0 ? ` Stopped ${g.high.shots - g.high.goals} of ${g.high.shots} high-danger shots.` : ''}</p>
        </li>
      ))}
    </ul>
    )}
    {!hasGoalieCards && <Gloss label="What to keep in mind">
      <p class="note">Empty-net shots are left out. Expected-goal models can’t see passes before a shot, so a goalie beaten by cross-ice passes looks worse here than he really was.</p>
    </Gloss>}
  </Section>

  <p class="note foot">Team pages: <a href={`${import.meta.env.BASE_URL}team/${away}/`}>{T[away]?.name ?? away}</a> · <a href={`${import.meta.env.BASE_URL}team/${home}/`}>{T[home]?.name ?? home}</a></p>
</Base>

<style>
  .nums { margin-top: 6px; font: 400 13px/1.45 var(--ui); color: var(--ink-3); }
  .top { margin-top: 28px; }
  .small { font-size: 13px; color: var(--ink-3); }
  .chance { display: grid; gap: 22px; margin-top: 22px; }
  @media (min-width: 900px) { .chance { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.45fr); gap: 40px; } }
  .big { display: flex; align-items: baseline; gap: 10px; margin: 8px 0 10px; font: 600 15px var(--ui); color: var(--ink-2); }
  .big span { font: 700 64px/0.9 var(--display); color: var(--ink); }
  .chance-main .h { font-size: 20px; margin-bottom: 4px; }
  .steps { list-style: none; padding: 0; margin: 0; }
