---
// Post-game page, one per finished game. The preview's calls are shown exactly as saved at puck drop, each graded by
// the rule stored with it; then the game's numbers, what nobody saw coming, and the goalies.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Rink from '../../components/Rink.astro';
import GameTrail from '../../components/GameTrail.astro';
import PLink from '../../components/PLink.astro';
import { matchupColours } from '../../lib/teams';
import teamsData from '../../../public/data/teams.json';
import recapIndex from '../../../public/data/recaps/index.json';

type Call = { id: string; kind: string; head: string; body: string; cite: string; verdict: 'held' | 'partly' | 'missed' | 'na' | null; happened?: string; usual?: string; tonight?: string; league?: string };
type Nums = { shots: number; xg: number; cf5: number; pp_goals: number; pp_opps: number };
type Goalie = { id: number; name: string; team: string; started: boolean; toi: string; shots: number; saves: number; ga: number; xga: number; gsax: number; sv: number | null; high: { shots: number; goals: number } };
type Recap = { game_id: number; date: string; start: string; away: string; home: string; venue: string; score: Record<string, number>; end: string; preview: boolean; rebuilt?: boolean; preview_page?: boolean; snapshot_at: string | null; calls: Call[]; numbers: Record<string, Nums>; goalies: Goalie[]; surprises: { head: string; body: string }[];
  reveal?: { p_home: number; p_home_puck: number | null; steps: { input: string; label: string; shift: number }[]; sides: Record<string, { head: string; chance: number }> } | null };

export async function getStaticPaths() {
  const files = import.meta.glob<{ default: Recap }>('../../../public/data/recaps/2*.json', { eager: true });
  return Object.values(files).map((f) => ({ params: { gameId: String(f.default.game_id) }, props: { r: f.default } }));
}
const { r } = Astro.props as { r: Recap };
const { away, home } = r;
const order = [away, home];
const T = Object.fromEntries(teamsData.map((t) => [t.abbr, t]));
const place = (a: string) => T[a]?.place ?? a;
const side = (a: string) => (a === away ? 'away' : 'home');
const colours = matchupColours(away, home);
// The reveal is told from the visitor's own team's side when it played, otherwise the home team's.
const povCss = `.pov-away{display:none}html[data-team="${away}"] .pov-away{display:block}html[data-team="${away}"] .pov-home{display:none}`;
const rv = r.reveal;
// Each input's shift, told from one team's side, with the running chance after it.
const ladder = (a: string) => {
  if (!rv) return [];
  const sign = a === home ? 1 : -1;
  let run = 50;
  return rv.steps.map((s) => {
    const pts = Math.round(100 * s.shift * sign);
    run += 100 * s.shift * sign;
    return { label: s.label, input: s.input, pts, after: Math.round(run) };
  });
};
const signed = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${-n}` : '0');
const colourCss = `:root{--away:${colours.away};--home:${colours.home}}.t-away{--team:var(--away)}.t-home{--team:var(--home)}@media (prefers-color-scheme: dark){.t-away{--team:color-mix(in oklab,var(--away) 55%,white)}.t-home{--team:color-mix(in oklab,var(--home) 55%,white)}}`;
const dateStr = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(r.start));
const endWord = r.end === 'OT' ? 'Final in overtime' : r.end === 'SO' ? 'Final in a shootout' : 'Final';
const label = { held: 'Held up', partly: 'Partly', missed: 'Didn’t happen', na: 'Can’t judge' } as const;
const mark = { held: '✓', partly: '≈', missed: '✕', na: '–' } as const;
const graded = r.calls.filter((c) => c.verdict && c.verdict !== 'na');
const count = (v: string) => graded.filter((c) => c.verdict === v).length;
const sayCount = (n: number, one: string) => `${n} ${one}`;
const takeaway = graded.length
  ? `Of the ${graded.length} calls the preview made, ${count('held')} held up, ${count('partly')} partly did, and ${count('missed')} didn’t happen.`
  : r.preview ? 'None of the preview’s calls could be judged from this game.' : 'No preview was saved for this game.';
const season = recapIndex.tally as Record<string, number>;
const seasonTotal = season.held + season.partly + season.missed;
const sgn = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(1)}`;
const rows: [string, string, (n: Nums) => string][] = [
  ['Shots on goal', 'Every shot that reached the net, including goals.', (n) => String(n.shots)],
  ['Expected goals', 'How many goals the chances were worth, by this site’s model. Empty nets left out.', (n) => n.xg.toFixed(1)],
  ['Shot attempts at 5-on-5', 'Every attempt at even strength with both goalies in: on goal, missed or blocked.', (n) => String(n.cf5)],
  ['Power plays', 'Power-play goals, out of times on the power play.', (n) => `${n.pp_goals} of ${n.pp_opps}`],
];
---
<Base section="games" title={`${away} at ${home}, final`} mock={false}>
  <style is:inline set:html={colourCss + povCss}></style>
  <section class="hero" aria-label="Final score">
    <Rink centre="final" sides={order.map((a) => ({ abbr: a, cls: `t-${side(a)}`, full: T[a]?.name ?? a, score: r.score[a], home: a === home, href: `${import.meta.env.BASE_URL}team/${a}/` }))} />
    <p class="when">{endWord} · {dateStr} · {r.venue}</p>
      <GameTrail id={r.game_id} />
  </section>

  <Section id="scorecard" title="What the preview said, and what happened" placeholder={false} takeaway={takeaway}>
    {r.calls.length > 0 ? (
      <ol class="claims">
        {r.calls.map((c) => (
          <li class="card claim">
            <div class="claim-said">
              <p class="eyebrow">Before the game</p>
              <h3>{c.head}</h3>
              <p class="detail">{c.body}</p>
            </div>
            <div class="claim-did">
              {c.verdict === null ? (
                <>
                  <p class="verdict note-only">Background, not a call</p>
                  <p class="detail">This was context about the two teams, not a prediction, so it isn’t graded.</p>
                </>
              ) : (
                <>
                  <p class:list={['verdict', c.verdict]}><span aria-hidden="true">{mark[c.verdict]}</span> {label[c.verdict]}</p>
                  <p>{c.happened}</p>
                  {c.tonight && c.tonight !== '–' && (
                    <dl class="compare">
                      <div><dd>{c.usual}</dd><span>Coming in</span></div>
                      <div><dd>{c.tonight}</dd><span>In this game</span></div>
                      {c.league && <div><dd>{c.league}</dd><span>{c.kind === 'matchup' ? 'With no line matching' : 'League average'}</span></div>}
                    </dl>
                  )}
                </>
              )}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="note">Previews are saved at puck drop, starting with games on October 10, so there were no calls to check for this one.</p>
    )}
    <p class="note">Each call is checked by the rule written down before the game: <strong>held up</strong> means the team reached its usual level or better; <strong>partly</strong> means it beat the league average (or, for a matchup, the share with no line matching) but fell short of its usual level. One game is a tiny sample, so a miss doesn’t mean the preview was wrong about the team.</p>
    {r.rebuilt && <p class="note">No preview was saved before this game, so this one was <a href={`${import.meta.env.BASE_URL}preview/${r.game_id}/`}>rebuilt afterwards</a> from the games played before it, by the same rules. Because nobody could read it beforehand, its calls are left out of the season count below.</p>}
    {r.preview_page && !r.rebuilt && <p class="note"><a href={`${import.meta.env.BASE_URL}preview/${r.game_id}/`}>Read the full preview</a> as it stood at puck drop.</p>}
    {seasonTotal > 0 && <p class="note">This season so far: {sayCount(season.held, 'held up')}, {season.partly} partly, {season.missed} didn’t happen, out of {seasonTotal} graded calls.</p>}
  </Section>

  <Section id="numbers" title="The numbers" placeholder={false} takeaway="How the game went, beyond the score.">
    <div class="card">
      <table class="numbers">
        <thead><tr><td></td>{order.map((a) => <th scope="col" class={`t-${side(a)}`}><i></i><a class="tlink" href={`${import.meta.env.BASE_URL}team/${a}/`}>{place(a)}</a></th>)}</tr></thead>
        <tbody>
          <tr><th scope="row">Goals</th>{order.map((a) => <td>{r.score[a]}</td>)}</tr>
          {rows.map(([name, tip, f]) => <tr><th scope="row"><span class="term" tabindex="0" data-tip={tip}>{name}</span></th>{order.map((a) => <td>{f(r.numbers[a])}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
    {r.end === 'SO' && <p class="note">The shootout decides the result but is left out of every other number on this site.</p>}
  </Section>

  {rv && (
    <Section id="chance" title="Our pre-game read" placeholder={false} takeaway="The win chance our model worked out before the game, kept off the site until now.">
      {order.map((a) => (
        <div class={`card pov pov-${side(a)} reveal`}>
          <h3>{rv.sides[a].head}</h3>
          <table class="ladder">
            <tbody>
              <tr><th scope="row">Two even teams on neutral ice</th><td></td><td>50%</td></tr>
              {ladder(a).map((x) => (
                <>
                  <tr><th scope="row">{x.label}</th><td>{signed(x.pts)} points</td><td>{x.input === 'lineup' ? '' : `${x.after}%`}</td></tr>
                  {x.input === 'b2b' && <tr class="sum"><th scope="row">Our chance for {place(a)} the morning of the game</th><td></td><td>{rv.sides[a].chance}%</td></tr>}
                  {x.input === 'lineup' && <tr class="sum"><th scope="row">At puck drop, once the lineups were known</th><td></td><td>{x.after}%</td></tr>}
                </>
              ))}
            </tbody>
          </table>
          <p class="note"><strong>Control of chances</strong> compares each team’s expected-goal difference over its recent games, with older games counting less. <strong>Back-to-back</strong> is a team playing for the second night in a row. <strong>Tonight’s lineup</strong> values the players who actually dressed against each team’s usual lineup. Only games played before this one went in, and the preview only hinted at the number in words.</p>
        </div>
      ))}
    </Section>
  )}

  {r.surprises.length > 0 && (
    <Section id="surprises" title="What the preview didn’t see coming" placeholder={false} takeaway="The parts of this game furthest from how these teams usually play.">
      <ul class="two surp">{r.surprises.map((s) => <li class="card"><h3 class="h">{s.head}</h3><p>{s.body}</p></li>)}</ul>
    </Section>
  )}

  <Section id="goalies" title="In net" placeholder={false} takeaway="How many goals each goalie stopped beyond what the shots he faced were worth.">
    <ul class="two gl">
      {r.goalies.map((g) => (
        <li class:list={['card', `t-${side(g.team)}`]}>
          <div class="job-top"><span class="job-name"><i></i><PLink id={g.id} name={g.name} /></span><span class="gs"><strong>{sgn(g.gsax)}</strong> <span class="term" tabindex="0" data-tip="Goals saved above expected: the goals his shots were worth by this site’s model, minus the goals he let in. Positive is good.">goals saved above expected</span></span></div>
          <p>{g.saves} saves on {g.shots} shots{g.sv !== null ? ` (${g.sv.toFixed(3).replace(/^0/, '')})` : ''} in {g.toi}{g.started ? '' : ' in relief'}. The shots were worth {g.xga.toFixed(1)} expected goals; he allowed {g.ga}.{g.high.shots > 0 ? ` Stopped ${g.high.shots - g.high.goals} of ${g.high.shots} high-danger shots.` : ''}</p>
        </li>
      ))}
    </ul>
    <p class="note">Empty-net shots are left out. Expected-goal models can’t see passes before a shot, so a goalie beaten by cross-ice passes looks worse here than he really was.</p>
  </Section>

  <p class="note foot">Team pages: <a href={`${import.meta.env.BASE_URL}team/${away}/`}>{T[away]?.name ?? away}</a> · <a href={`${import.meta.env.BASE_URL}team/${home}/`}>{T[home]?.name ?? home}</a></p>
</Base>

<style>
  .reveal h3 { margin: 0 0 10px; }
  .ladder { width: 100%; border-collapse: collapse; font-family: var(--ui); }
  .ladder th { text-align: left; font-weight: 400; padding: 6px 0; }
  .ladder td { text-align: right; padding: 6px 0 6px 12px; white-space: nowrap; }
  .ladder tr + tr { border-top: 1px solid var(--rule); }
  .ladder .sum th, .ladder .sum td { font-weight: 700; }
  .hero { margin-top: 10px; }
  .when { margin-top: 14px; font: 400 14px var(--ui); color: var(--ink-2); }
  .claims { display: grid; gap: 16px; margin-top: 22px; }
  .claim { display: grid; gap: 16px; }
  @media (min-width: 760px) { .claim { grid-template-columns: 1fr 1fr; gap: 28px; } .claim-did { border-left: 1px solid var(--rule); padding-left: 24px; } }
  .eyebrow { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); margin-bottom: 4px; }
  .claim h3, .h { font: 600 22px/1.15 var(--display); margin-bottom: 8px; }
  .detail { color: var(--ink-2); font-size: 15px; }
  .verdict { display: inline-flex; align-items: center; gap: 6px; font: 700 13px var(--ui); padding: 4px 11px; border-radius: 999px; border: 2px solid var(--ink); white-space: nowrap; margin-bottom: 8px; }
  .verdict.held { background: var(--ink); color: var(--sheet); }
  .verdict.missed, .verdict.na, .verdict.note-only { border-style: dashed; color: var(--ink-2); border-color: var(--ink-3); }
  .compare { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--rule); }
  .compare div { display: grid; gap: 2px; }
  .compare dd { font: 700 22px/1.1 var(--display); }
  .compare span { font: 400 12px var(--ui); color: var(--ink-3); }
  .numbers { width: 100%; border-collapse: collapse; font: 400 15px var(--ui); }
  .numbers th, .numbers td { padding: 10px 6px; border-top: 1px solid var(--rule); text-align: right; }
  .numbers thead th, .numbers thead td { border-top: 0; font-weight: 600; white-space: nowrap; }
  .numbers thead th i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--team); margin-right: 6px; }
  .numbers tbody th { text-align: left; font-weight: 500; }
  .numbers td { font-weight: 600; font-variant-numeric: tabular-nums; width: 22%; }
  .numbers tr:first-child td { font: 700 22px/1 var(--display); }
  .surp, .gl { margin-top: 18px; }
  .job-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 10px; margin-bottom: 8px; }
  .job-name { font: 700 20px/1 var(--display); display: inline-flex; align-items: center; gap: 8px; }
  .job-name i { width: 11px; height: 11px; border-radius: 50%; background: var(--team); }
  .gs { margin-left: auto; font: 400 13px var(--ui); color: var(--ink-2); }
  .gs strong { font: 700 22px/1 var(--display); color: var(--ink); }
  .foot { margin-top: 36px; }
  .tlink { color: inherit; text-decoration: none; }
  .tlink:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
