---
// Track record: how the previews' calls have held up this season, and how the win chances (never shown before a game, revealed on post-game pages) compare with the results.
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionNav from '../components/SectionNav.astro';
import '../styles/blocks.css';
import track from '../../public/data/track.json';
import { teamPaint } from '../lib/teams';

type Count = { held: number; partly: number; missed: number };
type Latest = { game_id: number; date: string; away: string; home: string; kind: string; head: string; call: string | null; verdict: keyof Count; usual: string | null; tonight: string | null };
type CallSet = { tally: Count; kinds: Record<string, Count>; weeks: ({ week: string } & Count)[]; games: number; latest: Latest[] };
type Band = { band: string; games: number; said: number; won: number; lo: number; hi: number };
type Win = { games: number; picked: number; hit_rate: number; home_rate: number; bands: Band[]; puck?: { games: number; picked: number }; seasons?: number[] };

const calls = track.calls as CallSet;
const win = track.win as { season: Win | null; past: Win | null };
const base = import.meta.env.BASE_URL;
const total = (c: Count) => c.held + c.partly + c.missed;
const pct = (n: number, d: number) => (d ? Math.round((100 * n) / d) : 0);
const day = (iso: string, opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' }) =>
  new Intl.DateTimeFormat('en-US', { ...opts, timeZone: 'UTC' }).format(new Date(iso + 'T12:00:00Z'));
const n = total(calls.tally);

const kindInfo: Record<string, { label: string; rule: string }> = {
  clash: { label: 'Strength meets weakness', rule: 'Held up if the team reached their usual level' },
  edge: { label: 'One team comes out ahead', rule: 'Held up if they won by half their usual margin' },
  contrast: { label: 'One team comes out ahead', rule: 'Held up if they won by half their usual margin' },
  duel: { label: 'Strength against strength', rule: 'Held up if the side we picked won out, judged against the league average' },
  changed: { label: 'Not the team you remember', rule: 'Held up if the team played more like this season than their two-season level' },
  history: { label: 'A goalie record that’s a coincidence', rule: 'Held up if his night was closer to his usual than to that record' },
  pace: { label: 'Pace of the game', rule: 'Held up if the game ran at the teams’ usual pace (newer previews: faster or slower than either team’s usual)' },
  physical: { label: 'A physical game', rule: 'Held up if the hit score reached the teams’ usual' },
  matchup: { label: 'Line matching', rule: 'Held up if the coach matched lines as usual at home' },
  rest: { label: 'Rested against tired', rule: 'Held up if the rested team got more of the 5-on-5 chances than they usually do' },
};
const kindRows = (s: CallSet) => {
  const merged: Record<string, Count> = {};
  for (const [k, c] of Object.entries(s.kinds)) {
    const label = kindInfo[k]?.label ?? k;
    const m = (merged[label] ??= { held: 0, partly: 0, missed: 0 });
    m.held += c.held; m.partly += c.partly; m.missed += c.missed;
  }
  return Object.entries(merged)
    .map(([label, c]) => ({ label, rule: Object.values(kindInfo).find((x) => x.label === label)?.rule ?? '', c }))
    .sort((a, b) => total(b.c) - total(a.c));
};
const V = ['held', 'partly', 'missed'] as const;
const mark = { held: '✓', partly: '≈', missed: '✕' } as const;
const word = { held: 'Held up', partly: 'Partly', missed: 'Didn’t happen' } as const;
const plural = (k: number, one: string, many = one + 's') => `${k} ${k === 1 ? one : many}`;
// One puck per call, held first: filled ink like the site's quality pips, partly half filled, missed an empty one.
const pucks = (c: Count) => V.flatMap((v) => Array.from({ length: c[v] }, () => v));
const THIN = 10; // fewer calls than this and a kind's rate is shown greyed, as too few to judge
const emptyText = `No graded calls yet.${track.waiting > 0 ? ` ${track.waiting} previews are waiting on their games.` : ''}`;
const seasonsLabel = (s: number[]) => `${s[0]}–${String(s[0] + 1).slice(2)} to ${s[s.length - 1]}–${String(s[s.length - 1] + 1).slice(2)}`;
const seasonLabel = `${track.season}–${String(track.season + 1).slice(2)}`;

// Latest calls, grouped by game (newest first), the first few games open and the rest behind a fold.
type Game = { game_id: number; date: string; away: string; home: string; calls: Latest[] };
const games: Game[] = [];
for (const c of calls.latest) {
  const g = games.find((x) => x.game_id === c.game_id);
  if (g) g.calls.push(c);
  else games.push({ game_id: c.game_id, date: c.date, away: c.away, home: c.home, calls: [c] });
}
const SHOW = 5;
const shown = (v: string | null | undefined) => v && v !== '–';

// Calibration scale: the favourite's chance runs from 50% up, results can fall below it.
const LO = 30, HI = 100;
const x = (p: number) => `${((100 * p - LO) / (HI - LO)) * 100}%`;
const nav: [string, string][] = [['calls', 'The score'], ['kinds', 'By kind'], ['weeks', 'Week by week'], ['latest', 'Latest calls'], ['chances', 'Win chances']];
---
<Base section="record" title="Track record" description="How often the previews’ calls hold up, all season, and how the win chances revealed after each game compare with the results.">
  <header class="team-top"><h1>Track record</h1></header>
  <p class="lede">Every preview makes a few calls before puck drop. After the game, each is checked by the rule written down with it. This is the running score.</p>
  <SectionNav items={nav} />

  <Section id="calls" title="How the calls are doing" placeholder={false} takeaway="Every graded call this season, one puck each.">
    {n > 0 ? (
      <div class="card score">
        <div class="sc-main">
          <p class="eyebrow">{seasonLabel} so far</p>
          <p class="hero">{pct(calls.tally.held, n)}<span class="pc">%</span></p>
          <p class="hero-sub">of the previews’ calls held up</p>
          <dl class="counts">
            {V.map((v) => <div><dt><i class:list={['pk', v]} aria-hidden="true"></i>{word[v]}</dt><dd>{calls.tally[v]}</dd></div>)}
          </dl>
          <p class="sub">{plural(n, 'call')} in {plural(calls.games, 'game')}{track.waiting > 0 && <> · {plural(track.waiting, 'preview')} waiting on {track.waiting === 1 ? 'its game' : 'their games'}</>}</p>
        </div>
        <div class="sc-grid" role="img" aria-label={`${calls.tally.held} held up, ${calls.tally.partly} partly, ${calls.tally.missed} didn’t happen`}>
          {pucks(calls.tally).map((v) => <i class:list={['pk', v]}></i>)}
        </div>
      </div>
    ) : <p class="note">{emptyText}</p>}
  </Section>

  <Section id="kinds" title="By kind of call" placeholder={false} takeaway="Some calls ask more of a team than others. Grayed rates rest on too few calls to judge.">
    {n > 0 ? (
      <ol class="kinds">
        {kindRows(calls).map(({ label, rule, c }) => {
          const t = total(c);
          return (
            <li class:list={['card', 'kind', { thin: t < THIN }]}>
              <div class="k-top">
                <h3>{label}</h3>
                <p class="k-pct" title={`${c.held} held up, ${c.partly} partly, ${c.missed} didn’t happen`}><strong>{pct(c.held, t)}%</strong><span>of {t}</span></p>
              </div>
              <p class="k-rule">{rule}</p>
              <div class="k-pucks" role="img" aria-label={`${c.held} held up, ${c.partly} partly, ${c.missed} didn’t happen`}>
                {pucks(c).map((v) => <i class:list={['pk', v]}></i>)}
              </div>
            </li>
          );
        })}
      </ol>
    ) : <p class="note">{emptyText}</p>}
  </Section>

  <Section id="weeks" title="Week by week" placeholder={false} takeaway="The share of each week’s calls that held up. The dotted line is half.">
    {n > 0 ? (
      <div class="card weeks-card">
        <div class="weeks" style={`--n:${calls.weeks.length}`}>
          <span class="half" aria-hidden="true"></span>
          {calls.weeks.map((w, k) => (
            <div class="wk" title={`${w.held} held up, ${w.partly} partly, ${w.missed} didn’t happen`}>
              <p class="wp">{pct(w.held, total(w))}%</p>
              <div class="col" role="img" aria-label={`Week of ${day(w.week)}: ${w.held} held up, ${w.partly} partly, ${w.missed} didn’t happen`} style={`--w:${k}`}>
                {(['missed', 'partly', 'held'] as const).map((v) => w[v] > 0 && <span class={v} style={`flex-grow:${w[v]}`}></span>)}
              </div>
              <p class="wl">{day(w.week)}</p>
              <p class="wn">{plural(total(w), 'call')}</p>
            </div>
          ))}
        </div>
        <div class="wrows">
          <span class="half-r" aria-hidden="true"></span>
          {calls.weeks.map((w, k) => (
            <div class="wr" title={`${w.held} held up, ${w.partly} partly, ${w.missed} didn’t happen`}>
              <p class="wr-l">{day(w.week)}<span>{plural(total(w), 'call')}</span></p>
              <div class="wr-bar" role="img" aria-label={`Week of ${day(w.week)}: ${w.held} held up, ${w.partly} partly, ${w.missed} didn’t happen`} style={`--w:${k}`}>
                {(['held', 'partly', 'missed'] as const).map((v) => w[v] > 0 && <span class={v} style={`flex-grow:${w[v]}`}></span>)}
              </div>
              <p class="wr-p">{pct(w.held, total(w))}%</p>
            </div>
          ))}
        </div>
        <p class="wkey"><span><i class="held"></i>Held up</span><span><i class="partly"></i>Partly</span><span><i class="missed"></i>Didn’t happen</span></p>
      </div>
    ) : <p class="note">{emptyText}</p>}
  </Section>

  <Section id="latest" title="Latest calls" placeholder={false} takeaway="The most recent games with graded calls, and how each call went.">
    {n > 0 ? (
      <>
        {[games.slice(0, SHOW), games.slice(SHOW)].map((set, i) => {
          if (!set.length) return null;
          const list = (
            <ol class="gcards">
              {set.map((g) => (
                <li class="card gcard">
                  <header class="g-head">
                    <p class="g-teams">
                      <a class="tlink" href={`${base}team/${g.away}/`}><i class="tdot" style={`--tc:${teamPaint(g.away)}`}></i>{g.away}</a>
                      <span class="at">at</span>
                      <a class="tlink" href={`${base}team/${g.home}/`}><i class="tdot" style={`--tc:${teamPaint(g.home)}`}></i>{g.home}</a>
                      <span class="g-day">{day(g.date, { weekday: 'short', month: 'short', day: 'numeric' })}</span>
                    </p>
                    <a class="g-link" href={`${base}recap/${g.game_id}/`}>Post-game <span aria-hidden="true">›</span></a>
                  </header>
                  <ol class="g-calls">
                    {g.calls.map((c) => (
                      <li>
                        <span class:list={['vchip', c.verdict]} title={word[c.verdict]}><span aria-hidden="true">{mark[c.verdict]}</span><span class="vh">{word[c.verdict]}</span></span>
                        <div class="lc">
                          <p class="lh">{c.head}</p>
                          {c.call && <p class="lcall">{c.call}</p>}
                        </div>
                        {shown(c.tonight) && (
                          <dl class="nums">
                            {shown(c.usual) && <div><dt>Coming in</dt><dd>{c.usual}</dd></div>}
                            <div><dt>In this game</dt><dd>{c.tonight}</dd></div>
                          </dl>
                        )}
                      </li>
                    ))}
                  </ol>
                </li>
              ))}
            </ol>
          );
          return i === 0 ? list : (
            <details class="fold">
              <summary><span class="closed">Show {plural(set.length, 'more game')}</span><span class="opened">Show fewer games</span></summary>
              {list}
            </details>
          );
        })}
      </>
    ) : <p class="note">{emptyText}</p>}
  </Section>

  <Section id="chances" title="Win chances, after the fact" placeholder={false} takeaway="When we gave a team about 60%, did teams like that win about 60% of the time?">
    <Fragment slot="explain">
      <p class="note foot">The win chance is never shown before a game. It is worked out afterwards from what was known that morning, and each post-game page reveals it with the reasons.</p>
    </Fragment>
    {win.season || win.past ? (
      <>
        <div class="tiles">
          {win.season && (
            <div class="card tile">
              <p class="eyebrow">This season</p>
              <p class="big">{win.season.picked}<span> of {win.season.games}</span></p>
              <p class="sub">games won by the team we favored ({Math.round(100 * win.season.hit_rate)}%)</p>
            </div>
          )}
          {win.season && (
            <div class="card tile">
              <p class="eyebrow">Home team every time</p>
              <p class="big">{Math.round(100 * win.season.home_rate)}%</p>
              <p class="sub">the score to beat this season</p>
            </div>
          )}
          {win.past && win.past.seasons && (
            <div class="card tile">
              <p class="eyebrow">{seasonsLabel(win.past.seasons)}</p>
              <p class="big">{Math.round(100 * win.past.hit_rate)}%<span> vs {Math.round(100 * win.past.home_rate)}%</span></p>
              <p class="sub">favorite against home team, {win.past.games.toLocaleString('en-US')} games</p>
            </div>
          )}
        </div>
        <div class="card calib-card">
          <div class="pick"><span>Show</span>
            <select id="win-pick" aria-label="Which games">
              {win.season && <option value="season">this season</option>}
              {win.past && win.past.seasons && <option value="past">{seasonsLabel(win.past.seasons)}</option>}
            </select>
          </div>
          {(['season', 'past'] as const).map((k) => {
            const w = win[k];
            if (!w) return null;
            return (
              <div class="calib" data-win={k} hidden={k !== (win.season ? 'season' : 'past')}>
                <p class="key"><span><i class="said"></i>Chance we gave</span><span><i class="won"></i>How often they won</span><span class="rng">Likely range</span><span class="avg">Even</span></p>
                <ol>
                  {w.bands.map((b) => (
                    <li>
                      <span class="bl">{b.band.replace('-', '–')}</span>
                      <div class="lane" title={`Given ${Math.round(100 * b.said)}% on average, won ${Math.round(100 * b.won)}% of ${b.games} games`}>
                        <span class="even" style={`left:${x(0.5)}`}></span>
                        <span class="whisk" style={`left:${x(Math.max(LO / 100, b.lo))};width:calc(${x(Math.min(HI / 100, b.hi))} - ${x(Math.max(LO / 100, b.lo))})`}></span>
                        <span class="said" style={`left:${x(b.said)}`}></span>
                        <span class="won" style={`left:${x(b.won)}`}></span>
                      </div>
                      <span class="bn"><strong>{Math.round(100 * b.won)}%</strong> of {b.games}</span>
                    </li>
                  ))}
                </ol>
                <div class="axis" aria-hidden="true"><span class="bl"></span><div class="ticks">{[30, 50, 70, 90].map((t) => <span style={`left:${x(t / 100)}`}>{t}%</span>)}</div><span class="bn"></span></div>
                {k === 'season' && w.games < 300 && <p class="note">Small samples: each row is only a handful of games so far, so the ranges are wide.</p>}
                {k === 'past' && <p class="note">Each of these seasons was predicted by the model fitted on the other two, so no game was scored by a model that had seen it.</p>}
              </div>
            );
          })}
        </div>
      </>
    ) : <p class="note">No finished games to score yet.</p>}
  </Section>
</Base>

<script>
  const wp = document.getElementById('win-pick') as HTMLSelectElement | null;
  wp?.addEventListener('change', () => document.querySelectorAll<HTMLElement>('[data-win]').forEach((c) => (c.hidden = c.dataset.win !== wp.value)));
</script>

<style>
  /* Pucks: held filled in ink, partly half filled, missed an empty puck (the site's quality-pip language). */
  .pk { display: inline-block; width: 12px; height: 12px; border-radius: 50%; flex: none; background: var(--rule); }
  .pk.held { background: var(--ink); }
  .pk.partly { background: linear-gradient(90deg, var(--ink) 50%, var(--rule) 50%); }

  .eyebrow { margin: 0; }
  .sub { font: 500 14px var(--ui); color: var(--ink-2); }

  /* The score: big number and counts on the left, every call as a puck on the right. */
  .score { display: grid; grid-template-columns: minmax(260px, 1fr) minmax(0, 1.25fr); gap: 28px 40px; align-items: center; padding: 26px 28px; }
  .hero { font: 700 88px / 0.95 var(--display); font-variation-settings: 'SOFT' 100; letter-spacing: -0.02em; margin-top: 8px; }
  .hero .pc { font-size: 0.5em; margin-left: 2px; vertical-align: 0.62em; }
  .hero-sub { font: 400 19px var(--body); color: var(--ink-2); margin-top: 6px; }
  .counts { display: flex; flex-wrap: wrap; gap: 10px 26px; margin: 22px 0 14px; padding-top: 16px; border-top: 1px solid var(--rule); }
  .counts dt { display: flex; align-items: center; gap: 7px; font: 500 13px var(--ui); color: var(--ink-2); }
  .counts dd { margin: 2px 0 0; font: 700 26px / 1.1 var(--display); font-variation-settings: 'SOFT' 100; }
  .sc-grid .pk { width: 14px; height: 14px; }
  .sc-grid { display: flex; flex-wrap: wrap; gap: 7px; align-content: center; max-width: 504px; justify-self: end; }

  /* By kind: one card per kind, a puck per call so the sample size is plain to see. */
  .kinds { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .kind { display: flex; flex-direction: column; gap: 6px; }
  .k-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .kind h3 { font: 600 20px / 1.25 var(--display); }
  .k-pct { display: flex; align-items: baseline; gap: 6px; white-space: nowrap; font: 500 13px var(--ui); color: var(--ink-2); }
  .k-pct strong { font: 700 26px var(--display); font-variation-settings: 'SOFT' 100; color: var(--ink); }
  .k-rule { font: 400 14px / 1.45 var(--ui); color: var(--ink-2); max-width: 46ch; }
  .k-pucks { display: flex; flex-wrap: wrap; gap: 5px; margin-top: auto; padding-top: 10px; }
  .k-pucks .pk { width: 11px; height: 11px; }
  .kind.thin .k-pct strong { color: var(--ink-3); }
  .kind.thin .k-pucks { opacity: 0.6; }

  /* Week by week: each column is one week's calls split by result, held at the bottom. Half is a named reference,
     so it is dotted. */
  .weeks-card { padding: 22px 28px 18px; width: fit-content; max-width: 100%; }
  .weeks { position: relative; display: flex; width: max-content; max-width: 100%; gap: 14px; align-items: flex-end; height: 220px; overflow-x: auto; }
  .half { position: absolute; left: 0; right: 0; bottom: calc(46px + 0.5 * (220px - 46px - 26px)); border-top: 2px dotted var(--ink-3); opacity: 0.7; pointer-events: none; z-index: 1; }
  .wk { flex: 0 0 56px; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; }
  .wp { font: 700 15px var(--ui); text-align: center; height: 26px; }
  .col { flex: 1 1 auto; display: flex; flex-direction: column; gap: 2px; border-radius: 8px; overflow: hidden; transform-origin: bottom; }
  .col span { flex-basis: 0; min-height: 3px; }
  .col .held, .wkey .held { background: var(--ink); }
  .col .partly, .wkey .partly { background: color-mix(in oklab, var(--ink) 40%, var(--rule)); }
  .col .missed, .wkey .missed { background: var(--track); }
  .wl { font: 600 12px var(--ui); text-align: center; margin-top: 8px; white-space: nowrap; height: 18px; }
  .wn { font: 500 11px var(--ui); color: var(--ink-3); text-align: center; white-space: nowrap; height: 20px; }
  .wkey { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 14px; font: 500 13px var(--ui); color: var(--ink-2); }
  .wkey span { display: inline-flex; align-items: center; gap: 6px; }
  .wkey i { width: 12px; height: 12px; border-radius: 3px; }
  :global(html.motion .seen) .weeks .col { animation: rec-rise 0.6s cubic-bezier(0.2, 0.8, 0.3, 1) backwards; animation-delay: calc(var(--rv-delay, 0ms) + 150ms + var(--w, 0) * 90ms); }
  @keyframes rec-rise { from { transform: scaleY(0); } }
  /* Phones read the weeks as rows, newest at the bottom, so a long season grows down the page, not sideways. */
  .wrows { display: none; position: relative; gap: 10px; }
  .wr { display: grid; grid-template-columns: 68px minmax(0, 1fr) 40px; gap: 10px; align-items: center; }
  .wr-l { font: 600 13px var(--ui); display: grid; white-space: nowrap; }
  .wr-l span { font: 500 11px var(--ui); color: var(--ink-3); }
  .wr-bar { display: flex; gap: 2px; height: 22px; border-radius: 6px; overflow: hidden; transform-origin: left; }
  .wr-bar span { flex-basis: 0; min-width: 3px; }
  .wr-bar .held { background: var(--ink); }
  .wr-bar .partly { background: color-mix(in oklab, var(--ink) 40%, var(--rule)); }
  .wr-bar .missed { background: var(--track); }
  .wr-p { font: 700 15px var(--ui); text-align: right; }
  .half-r { position: absolute; top: -6px; bottom: -6px; left: calc(78px + (100% - 128px) / 2); border-left: 2px dotted var(--ink-3); opacity: 0.7; z-index: 1; pointer-events: none; }
  :global(html.motion .seen) .wr-bar { animation: rec-row 0.6s cubic-bezier(0.2, 0.8, 0.3, 1) backwards; animation-delay: calc(var(--rv-delay, 0ms) + 150ms + var(--w, 0) * 90ms); }
  @keyframes rec-row { from { transform: scaleX(0); } }

  /* Latest calls: a card per game. */
  .gcards { display: grid; gap: 14px; }
  .fold .gcards { margin-top: 14px; }
  .gcard { padding: 0; overflow: hidden; }
  .g-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 18px; border-bottom: 1px solid var(--rule); }
  .g-teams { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; font: 700 15px var(--ui); }
  .tdot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--tc); margin-right: 6px; vertical-align: 1px; }
  .at { font-weight: 500; color: var(--ink-3); }
  .g-day { font-weight: 500; color: var(--ink-2); margin-left: 6px; }
  .g-link { font: 600 13px var(--ui); color: var(--ink-2); padding: 5px 12px; border-radius: 999px; background: var(--track); white-space: nowrap; transition: background-color 0.15s ease; }
  .g-link:hover { background: var(--rule); color: var(--ink); }
  .g-calls > li { display: grid; grid-template-columns: 132px minmax(0, 1fr) auto; gap: 16px; align-items: start; padding: 14px 18px; }
  .g-calls > li + li { border-top: 1px solid var(--rule); }
