---
import { srcInfo, srcPhrase } from '../../lib/goalSources';
import NoteText from '../../components/NoteText.astro';
import WorthKnowing from '../../components/WorthKnowing.astro';
// Team page: next game, results and schedule, season trend, fingerprint, lines, special teams, goalies, goal sources.
import Base from '../../layouts/Base.astro';
import { teamOg } from '../../lib/og';
import Section from '../../components/Section.astro';
import teams from '../../../public/data/teams.json';
import schedule from '../../../public/data/schedule.json';
import fpData from '../../../public/data/fingerprints.json';
import goalieData from '../../../public/data/goalies.json';
import previewIndex from '../../../public/data/previews/index.json';
import recapIndex from '../../../public/data/recaps/index.json';
import howData from '../../../public/data/goal_sources.json';
import Quadrant from '../../components/Quadrant.astro';
import Histogram from '../../components/Histogram.astro';
import linesData from '../../../public/data/lines.json';
import Pips from '../../components/Pips.astro';
import Portrait from '../../components/Portrait.astro';
import UnitNames from '../../components/UnitNames.astro';
import { clashes, fullName, unitShort } from '../../lib/playerLinks';
import NetUsage from '../../components/NetUsage.astro';
import PLink from '../../components/PLink.astro';
import SectionNav from '../../components/SectionNav.astro';
import TeamStats from '../../components/TeamStats.astro';
import { rows as statRows, seasons as statSeasons } from '../../lib/stats';
import PkRoles from '../../components/PkRoles.astro';
import KeyPlayers from '../../components/KeyPlayers.astro';
import Intro from '../../components/Intro.astro';
import { teamIntro } from '../../lib/intros';
import { teamPaint, cardTable } from '../../lib/teams';
import Roster from '../../components/Roster.astro';
import { KEY_COUNT } from '../../lib/keyPlayers';
import { roleTip, pkRoleWord, pkRoleTip } from '../../lib/players';
import Marker from '../../components/Marker.astro';
import Deployment from '../../components/Deployment.astro';
import UnitToi from '../../components/UnitToi.astro';
import AreaShapes from '../../components/AreaShapes.astro';
import ShotMap from '../../components/ShotMap.astro';
import { clock as mmss, compared } from '../../lib/format';
import '../../styles/blocks.css';
import { fpInfo, fpGroups, ordinal, goalieTraitInfo, rawWords, scoreTraits, elevenNote } from '../../lib/traits';
import { adjKind } from '../../lib/adjust';
import FpRow from '../../components/FpRow.astro';
import { doublesNote } from '../../lib/lineShape';
import { twoColumns } from '../../lib/masonry';
import SeasonTrend from '../../components/SeasonTrend.astro';
import SeasonMap from '../../components/SeasonMap.astro';
import ShareTeam from '../../components/ShareTeam.astro';
import ShareGoalies from '../../components/ShareGoalies.astro';
import ShareButton from '../../components/ShareButton.astro';
import { trendFor } from '../../lib/trend';

export function getStaticPaths() {
  return teams.map((t) => ({ params: { abbr: t.abbr } }));
}
const { abbr } = Astro.params;
const base = import.meta.env.BASE_URL;
const team = teams.find((t) => t.abbr === abbr)!;
const clash = clashes([abbr!]);
const names = Object.fromEntries(teams.map((t) => [t.abbr, t.name]));
const places = Object.fromEntries(teams.map((t) => [t.abbr, t.place]));
const games = schedule.games.filter((g) => g.home === abbr || g.away === abbr);
const finals = new Set(schedule.games.filter((g) => g.final).map((g) => g.id));
const recapIds = recapIndex.games.filter((g) => g.home === abbr || g.away === abbr).map((g) => g.id);
const previewIds = previewIndex.filter((p) => !finals.has(p.id) && (p.home === abbr || p.away === abbr)).map((p) => p.id);
type Est = { v: number; pct: number; lo: number; hi: number; rank: number; index: number; raw?: number; raw_rank?: number };
const mine = (fpData.teams as Record<string, { games: number; dims: Record<string, { blend: Est; season: Est }>; lineup?: { eleven: number; games: number; habit: boolean } }>)[abbr!];
const fp = fpData.ready.map((key) => ({ key, ...fpInfo[key], ...mine.dims[key] }));
// A club that dresses 11 forwards most nights: depth leaves those games out, and says so instead of ranking the habit.
const eleven = mine.lineup?.habit ? elevenNote(mine.lineup) : null;
// "What sets them apart": traits whose likely range sits clear of the middle (above the 65th or below the 35th percentile),
// most extreme first, two to four of them. Picked separately for the blended and season-only readings.
const fpStandouts = (mode: 'blend' | 'season') => {
  const ok = fp.filter((c) => c[mode] && c[mode].pct !== null && c[mode].pct !== undefined && !(eleven && c.key === 'depth'));
  const far = (c: (typeof fp)[number]) => Math.abs(c[mode].pct - 50);
  const clear = ok.filter((c) => c[mode].lo >= 65 || c[mode].hi <= 35).sort((x, y) => far(y) - far(x));
  return (clear.length >= 2 ? clear : [...ok].sort((x, y) => far(y) - far(x))).slice(0, 4);
};
type Unit = { label: string; players: string[]; gp?: number; new?: boolean; minutes: number; seconds: number; toi_sec: number | null; toi: number; xgf60: number; xga60: number; share: number; oz: number | null; pct: Record<string, number | null>; in_last_game: boolean; faced?: Faced | null };
const ln = (linesData.teams as Record<string, { games: number; units: Unit[]; last: { date: string; opponent: string; at_home: boolean; units: { label: string; players: string[]; minutes: number; seconds: number; usual: boolean }[] }; notes: { text: string }[] }>)[abbr!];
type Faced = { xgf60: number; xga60: number; share: number; score: number; opp_off: number; opp_def: number; pct: { xgf60: number; xga60: number; share: number; score: number; opp_off: number } };
// Line score sentence: how it compares, then how hard its opponents have been (both against the same line number).
const scoreWords = (p: number, peers: string) => (p >= 65 ? `Better than most ${peers}` : p <= 35 ? `Behind most ${peers}` : `About average for ${peers}`);
const facedWords = (p: number, peers: string) => (p >= 65 ? `after facing tougher opponents than most ${peers} face` : p <= 35 ? `against easier opponents than most ${peers} face` : 'against about the usual opponents');
// The line or pair score as a tag (the site's .chip.phrase), beside the label on wide cards and under the names on
// narrow cards, where the label row is already full; the sentence is in its tip.
const lsTip = (u: any) => `${scoreWords(u.faced.pct.score, peer[u.label])}, ${facedWords(u.faced.pct.opp_off, peer[u.label])}. The score is chances created for every chance allowed, allowing for the opponents this ${u.label[0] === 'L' ? 'line' : 'pair'} has been out against: 100 is average for ${peer[u.label]}, 120 means 20% more.`;
const peer: Record<string, string> = { L1: 'first lines', L2: 'second lines', L3: 'third lines', L4: 'fourth lines', P1: 'top defense pairs', P2: 'second defense pairs', P3: 'third defense pairs' };
type SUnit = { label: string; players: { id: number; name: string; role: string | null; both?: boolean; after?: string | null }[]; minutes: number; seconds: number; share: number; rate: number; pct?: number };
const sp = (ln as any)?.special as { pp: SUnit[]; pk: SUnit[]; faceoff: { text: string; player: string } | null; shots: { x: number; y: number; xg: number }[] } | undefined;
type MRow = { label: string; minutes: number; seconds: number; share: (number | null)[]; expected: number[] };
const mu = (ln as any)?.matchups as Record<'all' | 'home' | 'road', { games: number; rows: MRow[] }> | undefined;
const venues = [['all', 'in all games'], ['home', 'at home'], ['road', 'on the road']] as const;
const oppName = ['first', 'second', 'third', 'fourth'];
// Box shading lives in blocks.css (it differs between light and dark mode); the page only passes the share.
const heat = (v: number | null) => (v === null ? '' : `--h:${v}`);
const hot = (v: number | null) => ({ hot: (v ?? 0) >= 36, hotter: (v ?? 0) >= 46 });
const doubles = (u: any) => doublesNote(ln.units as any, u);
const unitNames = (label: string) => { const u = ln.units.find((x) => x.label === label) as any; return (u?.players ?? []).map((n: string, i: number) => fullName(u?.ids?.[i], n)).join(', '); };
const lastNames = (label: string) => unitShort(ln.units.find((u) => u.label === label) as any, clash);
const standouts = (rows: MRow[]) => rows.filter((r) => r.minutes >= 15).flatMap((r) => r.share.map((v, j) => ({ r, j, v: v ?? 0, gap: (v ?? 0) - r.expected[j] }))).filter((x) => x.gap >= 10).sort((a, b) => b.gap - a.gap).slice(0, 3);
type GMode = { starts: number; shots: number; gsax: number; gsax60: number | null; xga60: number | null; sv: number | null; sa60: number | null; danger: number | null; bd60: number | null; reb?: number | null; reb_exp?: number | null; gap: number | null; long_wait: number | null; qs: number | null; rbs: number | null; bins: number[]; tiers: Record<string, { shots: number; sv: number | null }>; pct: Record<string, number | null> };
type Goalie = { id: number; name: string; blend: GMode; season: GMode };
const goalies = ((goalieData.teams as Record<string, Goalie[]>)[abbr!] ?? []);
const lg = goalieData.league as { x: number; y: number }[];
const gx = lg.map((p) => p.x), gy = lg.map((p) => Math.abs(p.y));
const xDom: [number, number] = [Math.min(...gx) - 0.1, Math.max(...gx) + 0.1];
const yMax = Math.max(...gy) + 0.1;
const xMid = [...gx].sort((a, b) => a - b)[Math.floor(gx.length / 2)];
const sgn = (v: number) => (Math.abs(v) < 0.05 ? '0.0' : `${v > 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`);
const svp = (v: number | null) => (v === null ? '–' : v.toFixed(3).replace(/^0/, ''));
const gSay: Record<string, (g: GMode) => string> = {
  gsax: (g) => `${sgn(g.gsax)} goals saved above expected in ${g.starts} ${g.starts === 1 ? 'start' : 'starts'}`,
  rebounds: (g) => (g.reb == null ? '–' : `a rebound after ${g.reb} of every 100 saves, where the same saves usually give ${g.reb_exp}`),
  busy: (g) => `${g.sa60} shots faced per 60`,
  danger: (g) => (g.danger ? `the average shot he faces has a ${(100 * g.danger).toFixed(1)}% chance of going in` : '–'),
  breakdowns: (g) => `${g.bd60} defensive breakdowns in front of him per 60`,
  gaps: (g) => `a typical wait of ${g.gap} seconds between shots; ${g.long_wait}% come after three quiet minutes`,
  steady: (g) => `a quality start ${g.qs}% of the time`,
};
const gModes = [['blend', 'this season and last'], ['season', 'this season']] as const;
const lastDiff = ln ? ln.last.units.filter((u) => !u.usual) : [];
const asOf = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(fpData.generated_at));
const clock = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
// Where the goals come from, and the team's record when the things that go with winning happen.
type Src = { n: number; share: number | null; est: number; lo: number; hi: number; band: (number | null)[] };
type SrcSide = { goals: number; sources: Record<string, Src> };
type HowTeam = { sources: Record<'blend' | 'season', Record<'for' | 'against', SrcSide>> | null };
const how = (howData.teams as unknown as Record<string, HowTeam>)[abbr!];
const lgSrc = howData.league_sources as Record<string, number>;
const srcSides = [['for', `${team.place}’s goals`], ['against', `goals against ${team.place}`]] as const;
const srcMax = (key: string, mode: 'blend' | 'season') => {
  const vals = (['for', 'against'] as const).flatMap((side) => { const x = how.sources?.[mode]?.[side]?.sources[key]; return x ? [x.share ?? 0, x.band[1] ?? 0] : []; });
  return Math.max(lgSrc[key] * 2, ...vals) * 1.08;
};
const srcSay = (side: SrcSide | undefined, which: 'for' | 'against') => {
  if (!side) return '';
  const out = srcInfo.filter(([k]) => { const x = side.sources[k]; return x.share !== null && x.band[0] !== null && (x.share < x.band[0]! || x.share > x.band[1]!); });
  const whose = which === 'for' ? `${team.place}’s goals` : `the goals ${team.place} allows`;
  if (!out.length) return `Every row of ${whose} is within luck’s reach of the league average.`;
  const more = out.filter(([k]) => side.sources[k].share! > side.sources[k].band[1]!).map(([k]) => srcPhrase[k]);
  const fewer = out.filter(([k]) => side.sources[k].share! < side.sources[k].band[0]!).map(([k]) => srcPhrase[k]);
  const list = (a: string[]) => (a.length > 1 ? `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}` : a[0]);
  return `More than luck would explain: ${[more.length ? `more of ${whose} come from ${list(more)}` : '', fewer.length ? `${more.length ? 'fewer' : `fewer of ${whose} come`} from ${list(fewer)}` : ''].filter(Boolean).join('; ')}.`;
};
const trend = trendFor(abbr!);
const hasTeamStats = statSeasons('teams').some((x) => statRows('teams', x).some((r) => r.team === abbr));
const nav = [['next', 'Next'], ['form', 'Schedule'], ...(hasTeamStats ? [['stats', 'Stats']] : []), ...(trend ? [['trend', 'Trends']] : []), ['style', 'Style'], ['players', 'Players'], ['lines', 'Lines'], ['matchups', 'Matchups'], ['special', 'Special teams'], ['goalies', 'Goalies'], ['sources', 'Scoring']];
const _ = ordinal;
const tiText = teamIntro(abbr)?.text ?? [];
// The head coach from the club's latest game; a coach who took over this season says since when.
const coach: string | null = (team as any).coach ?? null;
const coachSince = coach && (team as any).coach_since
  ? new Date(`${(team as any).coach_since}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })
  : null;
---
<Base section="teams" title={team.name} description={`How the ${team.name} play: style, lines, special teams, goalies and where their goals come from.`} og={teamOg(abbr!)}>
  <AreaShapes />
  <nav class="crumbs" aria-label="Where this team sits"><a href={`${base}teams/`}>Teams</a><span aria-hidden="true">›</span><span>{team.division} Division</span><span aria-hidden="true">›</span><span aria-current="page">{team.name}</span></nav>
  <div class="tcard-wrap" style={`--team:${teamPaint(abbr)}`}>
    <div class:list={['card', 'tcard', tiText.length > 0 && 'joined']}>
      <span class="tabbr" aria-hidden="true">{abbr}</span>
      <header class="team-top">
        <h1>{team.name}</h1>
        <p class="rec">{team.w}-{team.l}-{team.otl}</p>
        {coach && <p class="coach">Head coach <span class="coach-name">{coach}</span>{coachSince && <span class="coach-since"> since {coachSince}</span>}</p>}
      </header>
    </div>
    <Intro text={tiText} colour={teamPaint(abbr)} class="tstory" />
  </div>
  <SectionNav items={nav as [string, string][]} />

  <section id="next" class="next" data-team={abbr} data-base={base}>
    <div class="tickets" id="tickets"></div>
  </section>

  <Section id="form" title="Results and schedule" placeholder={false} takeaway={`Every game of ${team.place}’s season beside a map of where it’s played. The map plays the season so far, the next road trip, a trip abroad or the full season; the list opens at today.`}>
    <Fragment slot="explain">
      <p>Each game is placed where it’s played, so a game abroad, like the Global Series in Europe, gets its own city even when the league lists it as a home game. Distances are straight-line flights between arenas: from home to the first game, game to game, and back home at the end of a trip or the season. A road trip is a run of games away from home. A back-to-back is a game the day after another one.</p>
    </Fragment>
    <SeasonMap abbr={abbr!} recaps={recapIds} previews={previewIds} />
  </Section>

  <TeamStats abbr={abbr!} place={team.place} />

  {trend && (
    <Section id="trend" title="Season trend" placeholder={false} takeaway={`Where ${team.place} has come from, and whether this season’s team plays a new way.`}>
      <Fragment slot="explain">
        <p><strong>What the line measures.</strong> Every shot gets a chance of going in, based on where and how it was taken. Add those chances up for both teams at 5-on-5 and take {team.place}’s share: 50% is an even game, 60% means the chances tilted 60-40 their way. It is adjusted for the score and home ice, because a team that is behind pushes harder. The thick line is a running average of that share over each stretch of {trend.window} games.</p>
        <p><strong>Normal ups and downs.</strong> The hatched band shows how far a {trend.window}-game stretch wanders from a team’s level on bounces alone, measured by shuffling the games of 2023-24 to 2025-26. A line inside it doesn’t mean anything changed.</p>
        <p><strong>When the play changed.</strong> The dotted levels split the two seasons into a before and an after only when the gap is bigger than 19 of 20 shuffles of the same games can make. Otherwise they show each season’s average. Numbered pins mark what else happened around the date the play changed.</p>
        <p>Then and now puts each style trait last season beside this season. A trait counts as new once the season has enough games to read it, the two are at least 25 percentile points apart, and last season sits outside this season’s likely range. Tested on 2024-25 and 2025-26, about three in four changes flagged seven games in were still there at the end of the season.</p>
        <p>The history columns are every season since 1997-98 from the NHL’s records: how many of the available points the franchise took, and how far it went in the playoffs.</p>
      </Fragment>
      <SeasonTrend abbr={abbr!} colour={teamPaint(abbr!)} place={team.place} t={trend.t} window={trend.window} band={trend.band} season={trend.season} />
    </Section>
  )}

  <Section id="style" title="Playing style" placeholder={false} share="team" takeaway={`How ${team.place} plays, trait by trait, against the rest of the league.`}>
    <Fragment slot="explain">
      <p class="note m-blend">Real numbers through {asOf}: {mine.games} games this season, blended with last season. Traits that take longer to settle lean more on last season.</p>
      <p class="note m-season">Real numbers through {asOf}, from this season’s {mine.games} games only. Expect these to swing a lot this early, which is why the likely ranges are so wide.</p>
      <p class="note">Shot volume, shots against and pace are weighted for the score and home ice, and forecheck pressure and physicality for each arena’s scorer, so all five are shown as scores; switch “Adjusted stats” to Recorded in the settings to see the numbers as recorded. <a href={`${base}methods/`}>How the arena adjustment works</a>.</p>
    </Fragment>
    <div class="key"><span class="one"><i></i>{team.name}</span><span class="avg">League average</span><span class="rng">Likely range</span></div>
    <h3 class="sub">What sets them apart</h3>
    {(['blend', 'season'] as const).map((mode) => (
      <div class={`gmode m-${mode}`}>
        <ul class="fpgrid">
          {fpStandouts(mode).map((c) => (
            <li class="card fpc" data-adj={adjKind(c.key)}>
              <div class="fpc-top"><span class="term fpc-name" tabindex="0" data-tip={c.tip}>{c.label}</span>{scoreTraits.has(c.key) && <span class="corner">100 is average</span>}</div>
              <div class="ends"><span>{c.lo}</span><span>{c.hi}</span></div>
              <div class="lanes"><div class="lane" style={`--b:${c.blend.pct};--blo:${c.blend.lo};--bhi:${c.blend.hi};--c:${c.season.pct};--clo:${c.season.lo};--chi:${c.season.hi}`}><span class="whisk"></span><span class="dot"></span></div></div>
              {(['blend', 'season'] as const).map((mode) => (
                <p class={`fpc-line m-${mode}`}>
                  {c[mode].raw === undefined
                    ? <><span>{c.say(scoreTraits.has(c.key) ? c[mode].index : c[mode].v)}</span><em>{ordinal(c[mode].rank)} of 32</em></>
                    : <>
                        <span class="a-adj">{c.say(c[mode].index)}</span><em class="a-adj">{ordinal(c[mode].rank)} of 32</em>
                        <span class="a-raw">{c[mode].raw!.toFixed(1)} {rawWords[c.key]}</span><em class="a-raw">{ordinal(c[mode].raw_rank!)} of 32</em>
                      </>}
                </p>
              ))}
            </li>
          ))}
        </ul>
      </div>
    ))}
    <h3 class="sub">Every trait</h3>
    <p class="note fpr-hint">Tap a trait for the number behind it.</p>
    <div class="fpr-groups"><div class="fpr-cols">
      {twoColumns(fpGroups.map((g) => ({ g, cs: fp.filter((c) => c.group === g) })).filter((x) => x.cs.length), (x) => x.cs.length + 1).map((col) => (
        <div class="fpr-col">
          {col.map(({ item: { g, cs }, order }) => (
            <div class="card fpr-grp" style={`order: ${order}`}>
              <h3>{g}</h3>
              {cs.map((c) => <FpRow c={{ ...c, [abbr!]: { blend: c.blend, season: c.season, note: c.key === 'depth' ? eleven : null } }} sides={[{ abbr: abbr!, cls: 't-one', place: team.place }]} />)}
            </div>
          ))}
        </div>
      ))}
    </div></div>
  </Section>

  <Section id="players" title="Key players" placeholder={false} takeaway={`Who ${team.place} leans on, and what they do best.`}>
    <Fragment slot="explain">
      <p class="note">The {KEY_COUNT.F} forwards and {KEY_COUNT.D} defensemen with the most ice time a game (at least half the games played), and the goalie with the most starts. Tags show how each is used; rows show his clearest strengths, and a weak spot in gray, as a percentile against his position. Point at anything for details. <a href={`${base}players/#${abbr}`}>All {team.nick} players</a>.</p>
    </Fragment>
    <KeyPlayers abbr={abbr!} place={team.place} />
    <Roster abbr={abbr!} />
  </Section>

  <Section id="lines" title="Lines" placeholder={false} takeaway={ln ? `Who plays together at 5-on-5, and how each group is doing.` : 'No games played yet.'} lead={!ln}>
    <Fragment slot="explain">
      {ln && <p class="note">Lines and pairs are picked by 5-on-5 ice time together over the team’s last {linesData.window} games ({ln.games} so far this season), with each older game counting half as much as the one after it, so the latest combinations come first. They are numbered by their players’ 5-on-5 and power-play ice time, so the first line is the one the coach leans on most. With so few games, each group’s results are pulled toward the average for its line number.</p>}
    </Fragment>
    {ln && (
      <>
        <div class="key">
          <span><span class="pips demo"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></span>How good, against the same line or pair on other teams</span>
          <span><span class="marker demo"><i style="--p:65"></i></span>How much, low to high (not good or bad)</span>
        </div>
        {ln.notes.length > 0 && (
          <WorthKnowing notes={ln.notes.map((n) => ({ text: n.text, names: (n as any).names }))} />
        )}
        <div class="two units2">
          {[ln.units.filter((u) => u.label[0] === 'L'), ln.units.filter((u) => u.label[0] === 'P')].map((group) => (
            <ul class="units">
              {group.map((u) => (
                <li class="card unit" data-adj={u.faced ? 'competition' : undefined}>
                  <div class="unit-top">
                    <span class="unit-label">{u.label}</span>
                    {u.faced && <span class="ls-top a-adj"><span class="chip phrase" tabindex="0" data-tip={lsTip(u)}>{u.label[0] === 'L' ? 'Line' : 'Pair'} score <b>{u.faced.score}</b></span></span>}
                    <UnitToi toi_sec={u.toi_sec} seconds={u.seconds} gp={u.gp} isNew={u.new} games={ln.games} pct={u.pct.sec_pg} peers={peer[u.label]} />
                  </div>
                  <UnitNames players={u.players} ids={(u as any).ids} clash={clash} />
                  {doubles(u) && <p class="unit-two">{doubles(u)}</p>}
                  {u.faced && <p class="ls-below a-adj"><span class="chip phrase" tabindex="0" data-tip={lsTip(u)}>{u.label[0] === 'L' ? 'Line' : 'Pair'} score <b>{u.faced.score}</b></span></p>}
                  {u.faced && (
                  <dl class="stats a-adj">
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals for per 60 with this group on the ice, allowing for how good the defenders it faced were.">Creates</span></dt><dd>{u.faced.xgf60.toFixed(2)}</dd><Pips pct={u.faced.pct.xgf60} tip={`${compared(u.faced.pct.xgf60, 'creates more than', 'creates less than', peer[u.label])}, allowing for opponents.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals against per 60 with this group on the ice, allowing for how dangerous the attackers it faced were. Lower is better.">Allows</span></dt><dd>{u.faced.xga60.toFixed(2)}</dd><Pips pct={u.faced.pct.xga60} tip={`${compared(u.faced.pct.xga60, 'stingier than', 'leakier than', peer[u.label])}, allowing for opponents.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="This group’s share of the expected goals, allowing for its opponents. Above 50% means it out-chances them.">Share</span></dt><dd>{u.faced.share.toFixed(1)}%</dd><Pips pct={u.faced.pct.share} tip={`${compared(u.faced.pct.share, 'a better share than', 'a worse share than', peer[u.label])}, allowing for opponents.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Of the faceoffs this group is on the ice for at either end, the share in the offensive zone."><span class="lab-long">Off. zone draws</span><span class="lab-short">O-zone draws</span></span></dt><dd>{u.oz === null ? '–' : `${u.oz}%`}</dd>{u.oz !== null && <Marker pct={u.pct.oz ?? 50} tip={`${compared(u.pct.oz ?? 50, 'more offensive-zone faceoffs than', 'fewer offensive-zone faceoffs than', peer[u.label])}.`} />}</div>
                  </dl>
                  )}
                  <dl class:list={['stats', { 'a-raw': u.faced }]}>
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals for per 60: how much offense the team creates with this group on the ice.">Creates</span></dt><dd>{u.xgf60.toFixed(2)}</dd><Pips pct={u.pct.xgf60 ?? 50} tip={`${compared(u.pct.xgf60 ?? 50, 'creates more than', 'creates less than', peer[u.label])}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals against per 60: how much the team gives up with this group on the ice. Lower is better.">Allows</span></dt><dd>{u.xga60.toFixed(2)}</dd><Pips pct={u.pct.xga60 ?? 50} tip={`${compared(u.pct.xga60 ?? 50, 'stingier than', 'leakier than', peer[u.label])}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="This group’s share of all expected goals while on the ice. Above 50% means they out-chance opponents.">Share</span></dt><dd>{u.share.toFixed(1)}%</dd><Pips pct={u.pct.share ?? 50} tip={`${compared(u.pct.share ?? 50, 'a better share than', 'a worse share than', peer[u.label])}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Of the faceoffs this group is on the ice for at either end, the share in the offensive zone."><span class="lab-long">Off. zone draws</span><span class="lab-short">O-zone draws</span></span></dt><dd>{u.oz === null ? '–' : `${u.oz}%`}</dd>{u.oz !== null && <Marker pct={u.pct.oz ?? 50} tip={`${compared(u.pct.oz ?? 50, 'more offensive-zone faceoffs than', 'fewer offensive-zone faceoffs than', peer[u.label])}.`} />}</div>
                  </dl>
                </li>
              ))}
            </ul>
          ))}
        </div>
        {(ln as any).deploy && <Deployment d={(ln as any).deploy} abbr={abbr} />}
        <h3 class="sub">Last game</h3>
        {lastDiff.length === 0
          ? <p class="note">{ln.last.at_home ? 'Against' : 'At'} {names[ln.last.opponent]}, the team used the same lines and pairs as above.</p>
          : (
            <div class="card worth">
              <p class="mini-h">{ln.last.at_home ? 'Against' : 'At'} {names[ln.last.opponent]}, these groups were different from the usual</p>
              <ul>{lastDiff.map((u) => <li><strong>{u.label}:</strong> {u.players.join(' · ')} ({mmss(u.seconds)})</li>)}</ul>
            </div>
          )}
      </>
    )}
  </Section>

  <Section id="matchups" title="Matchups" placeholder={false} takeaway={`Which opposing lines each ${team.place} group has actually been out against at 5-on-5.`}>
    <Fragment slot="explain">
      {mu && <p class="note">Each strip adds to 100%: it shows how one {team.place} group’s 5-on-5 time is split across the opponent’s four forward lines, numbered the same way as above. Sized by ice time, a wider box means more time against that line; even columns line the boxes up so you can compare groups straight down. At home the coach changes last and picks these matchups; on the road the other coach does. Faded rows have under ten minutes.</p>}
      {mu && <p class="note"><strong>What “with no line matching” means:</strong> if a coach just rolled his lines and took whoever was out there, each of his groups would face the opponent’s first line about as often as that line is on the ice. If opposing first lines play a third of the time against {team.place}, every {team.place} group would see them for about a third of its shifts. A number well above that means the coach is sending that group out against them on purpose; well below means he is keeping it away.</p>}
    </Fragment>
    {mu && (
      <>
        <div class="pick"><span>Show {team.place}</span>
          <select id="mu-venue" aria-label="Which games">{venues.map(([k, label]) => <option value={k}>{label} ({mu[k].games} {mu[k].games === 1 ? 'game' : 'games'})</option>)}</select>
          <span>with boxes</span>
          <select id="mu-size" aria-label="Box sizes"><option value="share">sized by ice time</option><option value="even">in even columns</option></select>
        </div>
        {venues.map(([k, label], vi) => {
          const top = standouts(mu[k].rows);
          return (
            <div data-venue={k} hidden={vi !== 0}>
              {top.length > 0 && (
                <div class="card worth">
                  <p class="mini-h">Standing out {label}</p>
                  <ul>{top.map((x) => <li><strong>{lastNames(x.r.label).join(', ')}</strong> ({x.r.label}) {x.r.label[0] === 'L' ? 'have' : 'have'} spent {x.v}% of their time against opponents’ {oppName[x.j]} lines. With no line matching it would be about {x.r.expected[x.j]}%.</li>)}</ul>
                </div>
              )}
              <div class="card stripcard">
                {[['L', 'Forward lines'], ['P', 'Defense pairs']].map(([kind, title]) => (
                  <>
                    <h3 class="mini-h">{title} against opposing forward lines</h3>
                    <ul class="strips">
                      {mu[k].rows.filter((r) => r.label[0] === kind).map((r) => (
                        <li class:list={{ thin: r.minutes < 10 }}>
                          <span class="lab" data-tip={`${unitNames(r.label)}. ${mmss(r.seconds)} of 5-on-5 ${label}.`}><b>{r.label}</b>{lastNames(r.label).join(' · ')}</span>
                          <span class="strip">
                            {r.share.map((v, j) => <span class:list={hot(v)} style={`--f:${Math.max(v ?? 0, 1)};${heat(v)}`} data-tip={v === null ? 'No ice time yet.' : `${lastNames(r.label).join(', ')} (${r.label}) have spent ${v}% of their 5-on-5 time ${label} against opponents’ ${oppName[j]} lines. With no line matching it would be about ${r.expected[j]}%.`}><i>Opp. L{j + 1}</i>{v === null ? '–' : `${v}%`}</span>)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </>
                ))}
              </div>
            </div>
          );
        })}
      </>
    )}
  </Section>

  <Section id="special" title="Special teams" placeholder={false} takeaway={`Who ${team.place} sends out with a man up and a man down.`}>
    <Fragment slot="explain">
      {sp && (
        <dl class="tagkey">
          <dt>What the tags mean</dt>
          {Object.entries(roleTip).map(([k, v]) => <dd><span class="chip">{k}</span>{v.slice(k.length + 2)}</dd>)}
        </dl>
      )}
      {sp && <p class="note">Each power-play unit is built around its quarterback, the defenseman running it, plus the four players most often out with him over the last {linesData.window} games ({ln.games} so far). Power-play units’ expected goals per 60 are pulled toward league average while samples are small. Penalty kills are too loose for fixed units (the most common foursome covers only about a tenth of a typical team’s shorthanded time), so penalty killers are grouped by when they go on: the ones who start kills, the second wave who come on after the first change, and spot duty. Point at a power-play name to see his shots on the map.</p>}
    </Fragment>
    {sp && (
      <>
        {sp.faceoff && (
          <div class="card worth">
            <p class="mini-h">Worth knowing</p>
            <ul><li><NoteText text={sp.faceoff.text} names={(sp.faceoff as any).names} /></li></ul>
          </div>
        )}
        <div class="st3">
          <div class="card">
            <h3 class="st-h">Power play</h3>
            {sp.pp.map((u, k) => (
              <div class="stunit">
                <p class="stunit-h"><span class="unit-label">{u.label}</span><span class="n term" tabindex="0" data-tip="Share of the team’s power-play time with this unit’s quarterback on the ice. A unit is its quarterback plus the four players most often out with him.">{u.share}% of the time</span></p><p class="stunit-rate"><span>Creates <strong>{u.rate.toFixed(1)}</strong> expected goals per 60</span><Pips pct={u.pct ?? 50} tip={`Creates ${u.rate.toFixed(1)} expected goals per 60, ${compared(u.pct ?? 50, 'more than', 'less than', `${k ? 'second' : 'top'} power-play units`, true)}. ${mmss(u.seconds)} on the ice.`} /></p>
                <ul class="roles-list">{u.players.map((pl) => <li><span><span class="plink" tabindex="0" data-shooter={pl.id}>{pl.name}</span>{pl.after && <span class="n both term" tabindex="0" data-tip={`${pl.after} usually takes the faceoff, then changes for ${pl.name} once play is under way. Their ice time is counted together here.`}>({pl.after})</span>}{pl.both && <span class="n both term" tabindex="0" data-tip="He regularly stays out when the units change, so he is listed on both.">both units</span>}</span>{pl.role && <span class="chip tag" tabindex="0" data-tip={roleTip[pl.role]}>{pl.role}</span>}</li>)}</ul>
              </div>
            ))}
          </div>
          <div class="card mapcard" id="ppmap">
            <p class="map-who" id="map-who" aria-live="polite">&nbsp;</p>
            <ShotMap long team="one" shots={sp.shots} title={`Where ${team.place}’s last ${sp.shots.length} power-play shots came from.`} />
          </div>
          <div class="card">
            <h3 class="st-h">Penalty kill</h3>
            <p class="n m-blend">Kills allow {mine.dims.pk.blend.v.toFixed(1)} expected goals per 60, {ordinal(mine.dims.pk.blend.rank)} of 32 (blended with last season).</p>
            <p class="n m-season">Kills allow {mine.dims.pk.season.v.toFixed(1)} expected goals per 60, {ordinal(mine.dims.pk.season.rank)} of 32 this season.</p>
            <PkRoles roles={(sp as any).pk_roles} />
          </div>
        </div>
      </>
    )}
  </Section>

  <Section id="goalies" title="Goalies" placeholder={false} takeaway="Is he stopping more than he should, and what is his team asking him to face?">
    <Fragment slot="explain">
      {goalies.length > 0 && <p class="note">Expected-goal models can’t see passes before a shot, so a goalie whose team gives up a lot of cross-ice passes will look worse here than he really is. Ratings compare him with goalies who have at least {goalieData.min_starts.blend} starts over two seasons, or {goalieData.min_starts.season} this season.</p>}
    </Fragment>
    {goalies.length > 0 && (
      <>
        <NetUsage team={abbr!} />
        <div class="pick"><span>Show</span>
          <select id="g-pick" aria-label="Goalie">{goalies.map((g) => <option value={String(g.id)}>{g.name}</option>)}</select>
          <ShareButton kind="goalie" label="Share this goalie" class="gshare" />
        </div>
        {goalies.map((g, gi) => (
          <div data-g={g.id} hidden={gi !== 0}>
            {gModes.map(([mode, words]) => {
              const x = g[mode];
              const few = x.pct.gsax === null;
              return (
                <div class={`gmode m-${mode}`}>
                  <div class="g2">
                    <div class="card gcard">
                      <div class="ghead">
                        <div class="ghead-text">
                          <p class="gname"><PLink id={g.id} name={g.name} /><span class="n">{x.starts} {x.starts === 1 ? 'start' : 'starts'} · {x.shots} shots faced, {words}</span></p>
                          <p class="gbig"><strong>{sgn(x.gsax)}</strong> <span class="term" tabindex="0" data-tip="Goals saved above expected: how many goals he has prevented compared with an average goalie facing the same shots. Positive is good.">goals saved above expected</span> {few ? <span class="n">too few starts to rate</span> : <Pips pct={x.pct.gsax!} tip={`Saving more than expected, per 60, pulled toward average until he has faced enough shots: ${compared(x.pct.gsax!, 'better than', 'worse than', 'goalies', true)}.`} />}</p>
                        </div>
                        <Portrait id={g.id} size={96} class="g-photo" />
                      </div>
                      <dl class="gkv">
                        {(['low', 'medium', 'high'] as const).map((t) => <div><dt>{t[0].toUpperCase() + t.slice(1)}-danger save %</dt><dd>{svp(x.tiers[t].sv)} <span class="n">{x.tiers[t].shots} shots</span></dd></div>)}
                        <div><dt><span class="term" tabindex="0" data-tip="Shots on goal he faces per 60.">Shots faced per 60</span></dt><dd>{x.sa60} {!few && <Marker pct={x.pct.busy!} tip={`${compared(x.pct.busy!, 'busier than', 'quieter than', 'goalies')}.`} />}</dd></div>
                        <div><dt><span class="term" tabindex="0" data-tip="Dangerous chances the team gives up in front of him within seconds of losing the puck, per 60 minutes. A stand-in for chances he faces alone; public data cannot see where defenders are.">Defensive breakdowns per 60</span></dt><dd>{x.bd60} {!few && <Marker pct={x.pct.breakdowns!} tip={`${x.pct.breakdowns! > 55 ? `His team breaks down in front of him more often than ${x.pct.breakdowns}% of goalies’ teams do` : x.pct.breakdowns! < 45 ? `His team breaks down in front of him less often than ${100 - x.pct.breakdowns!}% of goalies’ teams do` : 'His team breaks down in front of him about as often as most'}.`} />}</dd></div>
                        <div><dt><span class="term" tabindex="0" data-tip="Share of starts where he gave his team a fair chance to win: a save percentage at or above league average, or at least .885 on a light night.">Quality starts</span></dt><dd>{x.qs === null ? '–' : `${x.qs}%`} {!few && <Pips pct={x.pct.steady!} tip={`${compared(x.pct.steady!, 'steadier than', 'streakier than', 'goalies')}.`} />}</dd></div>
                      </dl>
                      <div class="gh"><p class="mini-h">Night to night: rough, about expected and strong starts</p><Histogram wide team="one" bins={x.bins.map((n, k) => ({ lo: k - 3, n }))} name={g.name} /></div>
                    </div>
                    <div class="card gmid">
                      <p class="chart-title"><span class="term" tabindex="0" data-tip="Higher means the goalie is stopping more than expected. Further right means his team gives up more in front of him. Gray dots are every goalie with at least ten starts over this season and last; point at one to see who it is. Outlined dots have fewer than ten starts.">Helping, or hung out to dry?</span></p>
                      <Quadrant tall league={lg} xDomain={xDom} yDomain={[-yMax, yMax]} xMid={xMid} highlights={goalies.filter((o) => o.blend.xga60 !== null && o.blend.gsax60 !== null).map((o) => ({ team: 'one', name: o.name, probable: o.blend.starts >= goalieData.min_starts.blend, x: o.blend.xga60!, y: o.blend.gsax60! }))} />
                    </div>
                  </div>
                  <details class="fold">
                    <summary><span class="closed">Show the full picture for {g.name}</span><span class="opened">Hide the full picture</span></summary>
                    <ul class="fpgrid">
                      {goalieTraitInfo.map((t) => (
                        <li class="card fpc">
                          <span class="term fpc-name" role="heading" aria-level="3" tabindex="0" data-tip={t.tip}>{t.label}</span>
                          <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
                          <div class="lanes">{x.pct[t.key] !== null && <div class="lane" style={`--b:${x.pct[t.key]};--blo:${x.pct[t.key]};--bhi:${x.pct[t.key]};--c:${x.pct[t.key]};--clo:${x.pct[t.key]};--chi:${x.pct[t.key]}`}><span class="whisk"></span><span class="dot"></span></div>}{x.pct[t.key] === null && <div class="lane empty"></div>}</div>
                          <p class="gline"><span>{gSay[t.key](x)}</span>{x.pct[t.key] === null && <em>too few starts to place him</em>}</p>
                        </li>
                      ))}
                    </ul>
                    <div class="card gnight">
                      <dl class="gkv">
                        <div><dt><span class="term" tabindex="0" data-tip="Share of starts with a save percentage under .850.">Really bad starts</span></dt><dd>{x.rbs === null ? '–' : `${x.rbs}%`}</dd></div>
                        <div><dt>Overall save %</dt><dd>{svp(x.sv)}</dd></div>
                      </dl>
                    </div>
                  </details>
                </div>
              );
            })}
          </div>
        ))}
      </>
    )}
  </Section>

  <Section id="sources" title="Goal sources" placeholder={false} takeaway={`How ${team.place}’s goals are scored and allowed, against the league average, and how much of any difference luck alone could explain.`}>
    <Fragment slot="explain">
      {how?.sources && <p class="note">Every goal counts once, in the first of these that applies: empty net, power play, shorthanded, goalie pulled, then rebound, turnover, faceoff win, and everyday play. These mixes are mostly luck: over three seasons, teams’ goals came from much the same places, and most of the differences here didn’t last.</p>}
      {how?.sources && <p class="note">Each row has its own scale, so a small source is not squeezed against the left edge.</p>}
    </Fragment>
    {how?.sources && (
      <>
        <div class="pick"><span>Show</span>
          <select id="src-side" aria-label="Whose goals">{srcSides.map(([k, label]) => <option value={k}>{label}</option>)}</select>
        </div>
        <div class="key t-one">
          <span><i></i>{team.place}</span>
          <span class="avg">League average</span>
          <span class="luck">Where luck alone could put an average team</span>
        </div>
        {srcSides.map(([side], si) => (
          <div data-src={side} hidden={si !== 0}>
            {gModes.map(([mode, words]) => {
              const x = how.sources![mode]?.[side];
              if (!x) return <div class={`gmode m-${mode}`}><p class="note">No goals yet {words}.</p></div>;
              const thin = x.goals < 40;
              return (
                <div class={`gmode m-${mode}`}>
                  <p class="src-say">{srcSay(x, side)}</p>
                  <div class:list={['card', { thin }]}>
                    <ul class="srows t-one">
                      {srcInfo.map(([k, label, tip]) => {
                        const r = x.sources[k], max = srcMax(k, mode), at = (v: number) => `${Math.min(100, (v / max) * 100)}%`;
                        const band = r.band[0] !== null ? `left:${at(r.band[0]!)};width:calc(${at(r.band[1]!)} - ${at(r.band[0]!)})` : '';
                        return (
                          <li>
                            <span class="term srow-name" tabindex="0" data-tip={tip}>{label}</span>
                            <span class="sline" tabindex="0" data-tip={`${r.share}% of ${side === 'for' ? `${team.place}’s goals` : `goals against ${team.place}`} (${r.n} of ${x.goals}) ${words}. League average: ${lgSrc[k]}%. An average team could land anywhere from ${r.band[0]}% to ${r.band[1]}% by luck alone. Allowing for luck, their real level is about ${r.est}%.`}>
                              {band && <span class="sband" style={band}></span>}
                              <span class="slg" style={`left:${at(lgSrc[k])}`}></span>
                              <span class="sdot" style={`left:${at(r.share ?? 0)}`}></span>
                            </span>
                            <span class="snums"><strong>{r.share}%</strong><span class="n">{r.n} of {x.goals}</span></span>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                  {thin && <p class="note">{x.goals} goals {words}, too few to say much: most of any gap from the league is luck.</p>}
                </div>
              );
            })}
          </div>
        ))}
      </>
    )}
  </Section>

  <script type="application/json" id="team-games" set:html={JSON.stringify(games)}></script>
  <script type="application/json" id="mcol" set:html={JSON.stringify(cardTable())}></script>
  <script type="application/json" id="team-names" set:html={JSON.stringify(names)}></script>
  <script type="application/json" id="team-places" set:html={JSON.stringify(places)}></script>
  <script type="application/json" id="team-previews" set:html={JSON.stringify(previewIds)}></script>
  <script type="application/json" id="team-recaps" set:html={JSON.stringify(recapIds)}></script>
  <ShareTeam abbr={abbr!} />
  <ShareGoalies abbr={abbr!} />
</Base>

<script is:inline>
  (() => {
    const host = document.getElementById('next');
    const me = host.dataset.team, base = host.dataset.base;
    const names = JSON.parse(document.getElementById('team-names').textContent);
    const games = JSON.parse(document.getElementById('team-games').textContent).map((g) => ({ ...g, t: new Date(g.start) })).sort((a, b) => a.t - b.t);
    window.lcLive.watch(games);
    const MC = JSON.parse(document.getElementById('mcol').textContent);
    const colourOf = (a, g) => (a === g.away ? MC.s[`${g.away}@${g.home}`] : null) ?? MC.c[a];
    const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
    const time = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const RECAPS = new Set(JSON.parse(document.getElementById('team-recaps').textContent));
    const PREVIEWS = Object.fromEntries(JSON.parse(document.getElementById('team-previews').textContent).map((id) => [id, 'Preview']));
    const now = new Date();
    const next = games.find((g) => !g.final && g.t > new Date(now - 4 * 3600e3));
    // Next game and latest post-game as two ticket stubs, each one opening its preview or post-game page (same as home).
    const places = JSON.parse(document.getElementById('team-places').textContent);
    const tickets = [];
    if (next) {
      const when = [el('strong', 'lv-clock', time.format(next.t)), ` · ${next.venue ?? ''}`];
      if (!PREVIEWS[next.id]) when.push(el('br'), 'Preview opens a week before the game');
      tickets.push(window.lcTicket(next, { eyebrow: 'Next game', href: PREVIEWS[next.id] ? `${base}preview/${next.id}/` : null, sub: when, colour: colourOf }));
    }
    const last = [...games].reverse().find((g) => g.final && RECAPS.has(g.id));
    if (last) {
      const [ms, ts] = last.home === me ? [last.hs, last.as] : [last.as, last.hs];
      const opp = last.home === me ? last.away : last.home;
      tickets.push(window.lcTicket(last, { eyebrow: 'Latest post-game', href: `${base}recap/${last.id}/`, sub: [`${ms > ts ? 'Won' : 'Lost'} ${last.home === me ? 'against' : 'at'} ${places[opp] ?? opp}`], colour: colourOf }));
    }
    if (tickets.length) document.getElementById('tickets').replaceChildren(...tickets);
    else document.getElementById('tickets').replaceWith(el('p', 'next-meta', 'No upcoming games on the schedule.'));
  })();
</script>



<script is:inline>
  // Point at (or tap) a power-play name to light up his shots on the map.
  (() => {
    const card = document.getElementById('ppmap');
    if (!card) return;
    const fig = card.querySelector('.shotmap');
    const label = document.getElementById('map-who');
    let pinned = null;
    const show = (el) => {
      document.querySelectorAll('[data-shooter].on').forEach((x) => x.classList.remove('on'));
      fig.querySelectorAll('.shot.hl').forEach((c) => c.classList.remove('hl'));
      if (!el) { fig.classList.remove('picking'); label.innerHTML = '&nbsp;'; return; }
      const mine = fig.querySelectorAll(`svg:not([style*="display: none"]) .shot[data-p="${el.dataset.shooter}"]`);
      fig.querySelectorAll(`.shot[data-p="${el.dataset.shooter}"]`).forEach((c) => c.classList.add('hl'));
      fig.classList.add('picking');
      el.classList.add('on');
      const n = fig.querySelectorAll(`svg.full .shot[data-p="${el.dataset.shooter}"]`).length;
      label.textContent = n ? `${el.textContent}: ${n} of these shots` : `${el.textContent}: none of these shots`;
    };
    document.querySelectorAll('[data-shooter]').forEach((el) => {
      el.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') show(el); });
      el.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') show(pinned); });
      el.addEventListener('focus', () => show(el));
      el.addEventListener('blur', () => show(pinned));
      el.addEventListener('click', () => { pinned = pinned === el ? null : el; show(pinned); });
    });
  })();

  // Matchup grid: all games, home or road.
  (() => {
    const sel = document.getElementById('mu-venue');
    if (!sel) return;
    sel.addEventListener('change', () => document.querySelectorAll('[data-venue]').forEach((b) => { b.hidden = b.dataset.venue !== sel.value; }));
    const size = document.getElementById('mu-size');
    const section = document.getElementById('matchups');
    let saved = 'share';
    try { saved = localStorage.getItem('lc-mu-size') || 'share'; } catch {}
    const apply = (v) => { section.classList.toggle('even', v === 'even'); size.value = v; };
    apply(saved);
    size.addEventListener('change', () => { apply(size.value); try { localStorage.setItem('lc-mu-size', size.value); } catch {} });
  })();

  // Goal sources: scored or allowed.
  (() => {
    const sel = document.getElementById('src-side');
    if (!sel) return;
    sel.addEventListener('change', () => document.querySelectorAll('[data-src]').forEach((b) => { b.hidden = b.dataset.src !== sel.value; }));
  })();

  // Goalie picker.
  (() => {
    const sel = document.getElementById('g-pick');
    if (!sel) return;
    sel.addEventListener('change', () => document.querySelectorAll('[data-g]').forEach((b) => { b.hidden = b.dataset.g !== sel.value; }));
  })();
</script>

<style>
  .pick :global(.gshare) { margin-left: auto; }
  /* Name card: the team's name and record, with the plain-English intro (Intro.astro) as the card's second half. */
  .tcard { position: relative; overflow: hidden; isolation: isolate; margin-top: 4px; padding: 26px 28px 22px; }
  .tcard.joined { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .tcard .team-top { margin: 0; }
  .tcard .coach { margin: 0; font: 500 15px var(--ui); color: var(--ink-3); }
  .tcard .coach-name { color: var(--ink-2); font-weight: 600; }
  .tcard .coach-name, .tcard .coach-since { white-space: nowrap; }
  .tcard h1 { margin: 0; font-size: 40px; line-height: 1.1; }
  .tcard .tabbr { position: absolute; z-index: -1; right: 14px; bottom: -48px; font: 700 170px/1 var(--ui); letter-spacing: -0.03em; color: color-mix(in oklab, var(--team) 14%, var(--sheet)); pointer-events: none; user-select: none; }
  .tcard-wrap :global(.tstory) { max-width: none; margin: -1px 0 0; background: var(--sheet); border: 1px solid var(--rule); border-top: 0; border-radius: 0 0 18px 18px; padding: 18px 28px 22px; }
  @media (max-width: 719px) {
    .tcard { padding: 20px 16px 16px; }
    .tcard h1 { font-size: 30px; }
    .tcard .tabbr { font-size: 104px; bottom: -22px; right: 8px; }
    .tcard-wrap :global(.tstory) { padding: 16px; }
  }
  /* Line and pair scores (the Competition switch): the score leads the card while it is on; Recorded shows the
     plain numbers underneath instead. Base shows .a-raw inline, so the recorded grid gets its display back here. */
  .ls-top { display: inline-flex; }
  .ls-below { display: none; margin: 12px 0 0; }
  .ls-top :global(.chip), .ls-below :global(.chip) { cursor: help; vertical-align: 0; }
  .ls-top :global(.chip b), .ls-below :global(.chip b) { color: var(--ink); font-weight: 700; margin-left: 2px; }
  /* By the card's own width, so two narrow cards side by side (tablets) move it under the names too. */
  .unit:has(.ls-top) { container-type: inline-size; }
  @container (max-width: 470px) { .ls-top { display: none; } .ls-below { display: block; } }
  .unit dl.stats.a-raw { display: none; }
  :global(html[data-raw-competition]) .unit[data-adj='competition'] dl.stats.a-raw, :global(html[data-arena='raw']) .unit[data-adj='competition'] dl.stats.a-raw { display: grid; }
</style>
