---
// Team page. Real: next game, results, schedule, last-game lines. Placeholder for now: the fingerprint.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import teams from '../../../public/data/teams.json';
import schedule from '../../../public/data/schedule.json';
import lines from '../../../public/data/last_game_lines.json';
import fpData from '../../../public/data/fingerprints.json';
import { fpInfo, fpGroups, ordinal } from '../../data/mock';

export function getStaticPaths() {
  return teams.map((t) => ({ params: { abbr: t.abbr } }));
}
const { abbr } = Astro.params;
const base = import.meta.env.BASE_URL;
const team = teams.find((t) => t.abbr === abbr)!;
const names = Object.fromEntries(teams.map((t) => [t.abbr, t.name]));
const games = schedule.games.filter((g) => g.home === abbr || g.away === abbr);
const last = lines.teams.find((t) => t.team === abbr);
type Est = { v: number; pct: number; lo: number; hi: number; rank: number; index: number; raw?: number; raw_rank?: number };
const rawWords: Record<string, string> = { physical: 'hits recorded per hour', forecheck: 'forecheck plays recorded per hour' };
const mine = (fpData.teams as Record<string, { games: number; dims: Record<string, { blend: Est; season: Est }> }>)[abbr!];
const fp = fpData.ready.map((key) => ({ key, ...fpInfo[key], ...mine.dims[key] }));
const asOf = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(fpData.generated_at));
const clock = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const nav = [['next', 'Next game'], ['form', 'Results and schedule'], ['style', 'Style'], ['lines', 'Lines'], ['more', 'Still to come']];
const _ = ordinal;
---
<Base title={team.name} mock={false}>
  <header class="team-top">
    <h1>{team.name}</h1>
    <p class="rec">{team.w}-{team.l}-{team.otl}</p>
  </header>
  <nav class="jump" aria-label="Sections">{nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>

  <section id="next" class="next" data-team={abbr} data-base={base}>
    <div id="next-card"></div>
  </section>

  <Section id="form" title="Results and schedule" placeholder={false}>
    <div class="cols">
      <div><h3 class="sub">Recent results</h3><ul class="games" id="recent"></ul></div>
      <div><h3 class="sub">Coming up</h3><ul class="games" id="upcoming"></ul></div>
    </div>
  </Section>

  <Section id="style" title="Style fingerprint" placeholder={false} takeaway={`How ${team.place} plays, trait by trait, against the rest of the league.`}>
    <div class="key"><span class="one"><i></i>{team.name}</span><span class="avg">League average</span><span class="rng">Likely range</span></div>
    <p class="note m-blend">Real numbers through {asOf}: {mine.games} games this season, blended with last season. Traits that take longer to settle lean more on last season.</p>
    <p class="note m-season">Real numbers through {asOf}, from this season’s {mine.games} games only. Expect these to swing a lot this early, which is why the likely ranges are so wide.</p>
    {fpGroups.map((g) => fp.some((c) => c.group === g) && (
      <>
        <h3 class="sub">{g}</h3>
        <ul class="fpgrid">
          {fp.filter((c) => c.group === g).map((c) => (
            <li class="card fpc">
              <span class="term fpc-name" tabindex="0" data-tip={c.tip}>{c.label}</span>
              <div class="ends"><span>{c.lo}</span><span>{c.hi}</span></div>
              <div class="lanes"><div class="lane" style={`--b:${c.blend.pct};--blo:${c.blend.lo};--bhi:${c.blend.hi};--c:${c.season.pct};--clo:${c.season.lo};--chi:${c.season.hi}`}><span class="whisk"></span><span class="dot"></span></div></div>
              {(['blend', 'season'] as const).map((mode) => (
                <p class={`fpc-line m-${mode}`}>
                  {c[mode].raw === undefined
                    ? <><span>{c.say(c[mode].v)}</span><em>{ordinal(c[mode].rank)} of 32</em></>
                    : <>
                        <span class="a-adj">{c.say(c[mode].index)}</span><em class="a-adj">{ordinal(c[mode].rank)} of 32</em>
                        <span class="a-raw">{c[mode].raw!.toFixed(1)} {rawWords[c.key]}</span><em class="a-raw">{ordinal(c[mode].raw_rank!)} of 32</em>
                      </>}
                </p>
              ))}
            </li>
          ))}
        </ul>
      </>
    ))}
    <p class="note">Still to come here: second chances and depth. Forecheck pressure and physicality are shown as arena-adjusted scores; switch “Hits and takeaways” to Raw in the settings to see the numbers as recorded. <a href={`${base}methods/`}>How the arena adjustment works</a>.</p>
  </Section>

  <Section id="lines" title="Lines" placeholder={false} takeaway={last ? `Who played together at 5-on-5 in the most recent game, ${last.at_home ? 'against' : 'at'} ${names[last.opponent]}.` : 'No games played yet.'}>
    {last && (
      <div class="card tablecard">
        <table class="lt">
          <thead><tr><th scope="col">Together at 5-on-5</th><th scope="col">Ice time</th><th scope="col">Shot attempts for–against</th><th scope="col">Expected goals for–against</th><th scope="col">Goals</th></tr></thead>
          <tbody>
            {[...last.lines, ...last.pairs].map((u, i) => (
              <tr class:list={{ gap: i === last.lines.length }}>
                <th scope="row">{u.players.join(' · ')}</th>
                <td>{clock(u.seconds)}</td><td>{u.cf}–{u.ca}</td><td>{u.xgf.toFixed(2)}–{u.xga.toFixed(2)}</td><td>{u.gf}–{u.ga}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    <p class="note">Real numbers from one game, so they show who played with whom rather than who is good. The usual lines over the last ten games, split by home and road, will sit here too.</p>
  </Section>

  <Section id="more" title="Still to come on this page" placeholder={false}>
    <ul class="todo">
      <li><strong>Special teams:</strong> power-play and penalty-kill units, who plays which role, and how dangerous the team is shorthanded.</li>
      <li><strong>Goalies:</strong> whether each one is helping or being hung out to dry, his workload, and how steady he is night to night.</li>
      <li><strong>Where the goals come from:</strong> rush, rebounds, power play, turnovers and zone time, for and against.</li>
      <li><strong>What tends to be true when they win.</strong></li>
    </ul>
  </Section>

  <script type="application/json" id="team-games" set:html={JSON.stringify(games)}></script>
  <script type="application/json" id="team-names" set:html={JSON.stringify(names)}></script>
</Base>

<script is:inline>
  (() => {
    const host = document.getElementById('next');
    const me = host.dataset.team, base = host.dataset.base;
    const names = JSON.parse(document.getElementById('team-names').textContent);
    const games = JSON.parse(document.getElementById('team-games').textContent).map((g) => ({ ...g, t: new Date(g.start) })).sort((a, b) => a.t - b.t);
    const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
    const day = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
    const time = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const PREVIEWS = { 2026020163: 'Mock-up preview' };
    const now = new Date();
    const next = games.find((g) => !g.final && g.t > new Date(now - 4 * 3600e3));
    const box = document.getElementById('next-card');
    if (next) {
      const rink = el('div', 'nrink');
      ['rl blue l', 'rl red', 'rl blue r'].forEach((c) => rink.append(el('span', c)));
      rink.append(el('span', 'circle', 'at'));
      [next.away, next.home].forEach((a, i) => {
        const side = el('div', 'side' + (i ? ' home' : ''));
        side.append(el('p', 'abbr' + (a === me ? ' me' : ''), a), el('p', 'full', names[a] ?? a));
        if (i) side.append(el('p', 'lc', 'Has last change'));
        rink.append(side);
      });
      const meta = el('p', 'next-meta', `Next game: ${day.format(next.t)}, ${time.format(next.t)} · ${next.venue ?? ''}`);
      if (PREVIEWS[next.id]) { const a = el('a', 'g-link', PREVIEWS[next.id]); a.href = `${base}preview/${next.id}/`; meta.append(' · ', a); }
      else meta.append(' · Preview coming once the real numbers are ready');
      box.append(rink, meta);
    } else {
      box.append(el('p', 'next-meta', 'No upcoming games on the schedule.'));
    }
    const row = (g) => {
      const li = el('li', 'card game');
      const opp = g.home === me ? g.away : g.home;
      li.append(el('span', 'g-when', day.format(g.t) + (g.final ? '' : ' · ' + time.format(g.t))), el('span', 'g-title', `${g.home === me ? 'vs' : 'at'} ${names[opp] ?? opp}`));
      if (g.final) {
        const s = g.home === me ? [g.hs, g.as] : [g.as, g.hs];
        li.append(el('span', 'g-score', `${s[0] > s[1] ? 'W' : 'L'} ${s[0]}–${s[1]}${g.end && g.end !== 'REG' ? ` (${g.end})` : ''}`));
      } else if (PREVIEWS[g.id]) { const a = el('a', 'g-link', PREVIEWS[g.id]); a.href = `${base}preview/${g.id}/`; li.append(a); }
      else li.append(el('span', 'g-soon', g.venue ?? ''));
      return li;
    };
    document.getElementById('recent').replaceChildren(...games.filter((g) => g.final).slice(-5).reverse().map(row));
    document.getElementById('upcoming').replaceChildren(...games.filter((g) => !g.final && g !== next).slice(0, 5).map(row));
  })();
</script>

<style is:global>
  .team-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin-top: 22px; }
  .team-top h1 { font: 700 clamp(34px, 7vw, 52px) / 1.05 var(--display); letter-spacing: -0.02em; }
  .team-top .rec { font: 600 16px var(--ui); color: var(--ink-2); }
  .jump { font-family: var(--ui); display: flex; gap: 6px; overflow-x: auto; margin: 14px -16px 0; padding: 2px 16px 6px; scrollbar-width: none; }
  .jump a { flex: none; font-size: 13px; font-weight: 500; text-decoration: none; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--rule); background: var(--sheet); }
  .next { margin-top: 18px; }
  .next-meta { font: 400 14px var(--ui); color: var(--ink-2); margin-top: 12px; }
  .cols { display: grid; gap: 0 28px; }
  @media (min-width: 820px) { .cols { grid-template-columns: 1fr 1fr; } }
  .cols .sub { margin-top: 22px; }
  .games { display: grid; gap: 8px; }
  .game { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; align-items: baseline; padding: 12px 16px; border-radius: 14px; }
  .g-when { grid-column: 1 / -1; font: 400 12px var(--ui); color: var(--ink-3); }
  .g-title { font-weight: 600; }
  .g-score { font: 700 16px var(--ui); white-space: nowrap; }
  .g-soon { font: 400 12px var(--ui); color: var(--ink-3); text-align: right; }
  .g-link { font: 600 13px var(--ui); }
  .key .one i { background: var(--ink); }
  .m-season { display: none; }
  html[data-mode='season'] .m-season { display: flex; }
  html[data-mode='season'] .m-blend { display: none; }
  .fpgrid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); }
  .fpc { display: grid; gap: 10px; align-content: start; }
  .fpc-name { font: 600 20px/1.15 var(--display); font-variation-settings: 'SOFT' 100; justify-self: start; }
  .ends { display: flex; justify-content: space-between; gap: 8px; font: italic 400 14px var(--body); color: var(--ink-2); margin-bottom: -4px; }
  .lanes { position: relative; padding: 4px 7px; }
  .lanes::after { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--ink); opacity: 0.5; border-radius: 1px; }
  .lane { position: relative; height: 14px; --team: var(--ink); --v: var(--b); --lo: var(--blo); --hi: var(--bhi); }
  html[data-mode='season'] .lane { --v: var(--c); --lo: var(--clo); --hi: var(--chi); }
  .lane::before { content: ''; position: absolute; left: -7px; right: -7px; top: 5px; height: 4px; border-radius: 2px; background: var(--track); }
  .whisk { position: absolute; top: 5px; height: 4px; border-radius: 2px; background: color-mix(in oklab, var(--team) 45%, var(--track)); left: calc(min(var(--lo), var(--v)) * 1%); width: calc((max(var(--hi), var(--v)) - min(var(--lo), var(--v))) * 1%); transition: left 0.35s, width 0.35s; }
  .dot { position: absolute; top: 0; left: calc(var(--v) * 1%); width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--team); box-shadow: 0 0 0 2px var(--sheet); z-index: 1; transition: left 0.35s; }
  @media (prefers-reduced-motion: reduce) { .dot, .whisk { transition: none; } }
  .fpc-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 12px; font: 400 14px/1.4 var(--ui); }
  .fpc-line.m-season { display: none; }
  html[data-mode='season'] .fpc-line.m-season { display: flex; }
  html[data-mode='season'] .fpc-line.m-blend { display: none; }
  .fpc-line em { font-style: normal; color: var(--ink-3); white-space: nowrap; }
  .tablecard { overflow-x: auto; margin-top: 18px; }
  .lt { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 560px; }
  .lt th, .lt td { text-align: right; padding: 8px 6px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  .lt thead th { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); white-space: normal; }
  .lt th:first-child { text-align: left; }
  .lt tbody th { font-weight: 600; }
  .lt tr.gap > * { border-top: 3px solid var(--line-red); }
  .lt tbody tr:last-child > * { border-bottom: 0; }
  .todo { margin-top: 16px; display: grid; gap: 10px; font: 400 15px/1.5 var(--ui); }
</style>
