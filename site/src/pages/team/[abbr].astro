---
// Team page. Real: next game, results, schedule, last-game lines. Placeholder for now: the fingerprint.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import teams from '../../../public/data/teams.json';
import schedule from '../../../public/data/schedule.json';
import lines from '../../../public/data/last_game_lines.json';
import fpData from '../../../public/data/fingerprints.json';
import linesData from '../../../public/data/lines.json';
import Pips from '../../components/Pips.astro';
import Marker from '../../components/Marker.astro';
import ShotMap from '../../components/ShotMap.astro';
import { fpInfo, fpGroups, ordinal } from '../../data/mock';

export function getStaticPaths() {
  return teams.map((t) => ({ params: { abbr: t.abbr } }));
}
const { abbr } = Astro.params;
const base = import.meta.env.BASE_URL;
const team = teams.find((t) => t.abbr === abbr)!;
const names = Object.fromEntries(teams.map((t) => [t.abbr, t.name]));
const games = schedule.games.filter((g) => g.home === abbr || g.away === abbr);
const last = lines.teams.find((t) => t.team === abbr);
type Est = { v: number; pct: number; lo: number; hi: number; rank: number; index: number; raw?: number; raw_rank?: number };
const rawWords: Record<string, string> = { physical: 'hits recorded per hour', forecheck: 'forecheck plays recorded per hour' };
const mine = (fpData.teams as Record<string, { games: number; dims: Record<string, { blend: Est; season: Est }> }>)[abbr!];
const fp = fpData.ready.map((key) => ({ key, ...fpInfo[key], ...mine.dims[key] }));
type Unit = { label: string; players: string[]; minutes: number; toi: number; xgf60: number; xga60: number; share: number; oz: number | null; pct: Record<string, number | null>; in_last_game: boolean };
const ln = (linesData.teams as Record<string, { games: number; units: Unit[]; last: { date: string; opponent: string; at_home: boolean; units: { label: string; players: string[]; minutes: number; usual: boolean }[] }; notes: { text: string }[] }>)[abbr!];
const peer: Record<string, string> = { L1: 'first lines', L2: 'second lines', L3: 'third lines', L4: 'fourth lines', P1: 'top pairs', P2: 'second pairs', P3: 'third pairs' };
const roleTip: Record<string, string> = {
  Quarterback: 'Quarterback: the defenseman who runs the unit from the blue line. Each unit is built around its quarterback.',
  Trigger: 'Trigger: the unit’s main shooter. He has produced the most shot danger on the power play over the last two seasons.',
  Distributor: 'Distributor: the main passer. He has the most primary assists on power-play goals over the last two seasons.',
  'Net-front': 'Net-front: at least 40% of his power-play shots come from within 15 feet of the net.',
  Point: 'Point: a second defenseman on the unit, alongside the quarterback.',
};
type SUnit = { label: string; players: { id: number; name: string; role: string | null; both?: boolean }[]; minutes: number; share: number; rate: number; pct?: number };
const sp = (ln as any)?.special as { pp: SUnit[]; pk: SUnit[]; shots: { x: number; y: number; xg: number }[] } | undefined;
const lastDiff = ln ? ln.last.units.filter((u) => !u.usual) : [];
const asOf = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(fpData.generated_at));
const clock = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const nav = [['next', 'Next game'], ['form', 'Results and schedule'], ['style', 'Style'], ['lines', 'Lines'], ['special', 'Special teams'], ['more', 'Still to come']];
const _ = ordinal;
---
<Base title={team.name} mock={false}>
  <header class="team-top">
    <h1>{team.name}</h1>
    <p class="rec">{team.w}-{team.l}-{team.otl}</p>
  </header>
  <nav class="jump" aria-label="Sections">{nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>

  <section id="next" class="next" data-team={abbr} data-base={base}>
    <div id="next-card"></div>
  </section>

  <Section id="form" title="Results and schedule" placeholder={false}>
    <div class="cols">
      <div><h3 class="sub">Recent results</h3><ul class="games" id="recent"></ul></div>
      <div><h3 class="sub">Coming up</h3><ul class="games" id="upcoming"></ul></div>
    </div>
  </Section>

  <Section id="style" title="Style fingerprint" placeholder={false} takeaway={`How ${team.place} plays, trait by trait, against the rest of the league.`}>
    <div class="key"><span class="one"><i></i>{team.name}</span><span class="avg">League average</span><span class="rng">Likely range</span></div>
    <p class="note m-blend">Real numbers through {asOf}: {mine.games} games this season, blended with last season. Traits that take longer to settle lean more on last season.</p>
    <p class="note m-season">Real numbers through {asOf}, from this season’s {mine.games} games only. Expect these to swing a lot this early, which is why the likely ranges are so wide.</p>
    {fpGroups.map((g) => fp.some((c) => c.group === g) && (
      <>
        <h3 class="sub">{g}</h3>
        <ul class="fpgrid">
          {fp.filter((c) => c.group === g).map((c) => (
            <li class="card fpc">
              <span class="term fpc-name" tabindex="0" data-tip={c.tip}>{c.label}</span>
              <div class="ends"><span>{c.lo}</span><span>{c.hi}</span></div>
              <div class="lanes"><div class="lane" style={`--b:${c.blend.pct};--blo:${c.blend.lo};--bhi:${c.blend.hi};--c:${c.season.pct};--clo:${c.season.lo};--chi:${c.season.hi}`}><span class="whisk"></span><span class="dot"></span></div></div>
              {(['blend', 'season'] as const).map((mode) => (
                <p class={`fpc-line m-${mode}`}>
                  {c[mode].raw === undefined
                    ? <><span>{c.say(c[mode].v)}</span><em>{ordinal(c[mode].rank)} of 32</em></>
                    : <>
                        <span class="a-adj">{c.say(c[mode].index)}</span><em class="a-adj">{ordinal(c[mode].rank)} of 32</em>
                        <span class="a-raw">{c[mode].raw!.toFixed(1)} {rawWords[c.key]}</span><em class="a-raw">{ordinal(c[mode].raw_rank!)} of 32</em>
                      </>}
                </p>
              ))}
            </li>
          ))}
        </ul>
      </>
    ))}
    <p class="note">Forecheck pressure and physicality are shown as arena-adjusted scores; switch “Hits and takeaways” to Raw in the settings to see the numbers as recorded. <a href={`${base}methods/`}>How the arena adjustment works</a>.</p>
  </Section>

  <Section id="lines" title="Lines" placeholder={false} takeaway={ln ? `Who plays together at 5-on-5, and how each group is doing.` : 'No games played yet.'}>
    {ln && (
      <>
        <div class="key">
          <span><span class="pips demo"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></span>How good, against the same line or pair on other teams</span>
          <span><span class="marker demo"><i style="--p:65"></i></span>How much, low to high (not good or bad)</span>
        </div>
        <p class="note">Lines and pairs are numbered by 5-on-5 ice time together over the team’s last {linesData.window} games ({ln.games} so far this season). With so few games, each group’s results are pulled toward the average for its line number.</p>
        {ln.notes.length > 0 && (
          <div class="card worth">
            <p class="mini-h">Worth knowing</p>
            <ul>{ln.notes.map((n) => <li>{n.text}</li>)}</ul>
          </div>
        )}
        <div class="two units2">
          {[ln.units.filter((u) => u.label[0] === 'L'), ln.units.filter((u) => u.label[0] === 'P')].map((group) => (
            <ul class="units">
              {group.map((u) => (
                <li class="card unit">
                  <div class="unit-top">
                    <span class="unit-label">{u.label}</span>
                    <span class="unit-toi"><strong>{u.toi.toFixed(1)}</strong> min a game <Marker pct={u.pct.sec_pg ?? 50} tip={`More 5-on-5 ice time together than ${u.pct.sec_pg}% of ${peer[u.label]}. ${u.minutes} minutes together in all.`} /></span>
                  </div>
                  <p class="unit-names">{u.players.map((n) => <span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{n}</span>)}</p>
                  <dl class="stats">
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals for per hour: how much offense the team creates with this group on the ice.">Creates</span></dt><dd>{u.xgf60.toFixed(2)}</dd><Pips pct={u.pct.xgf60 ?? 50} tip={`Creates more than ${u.pct.xgf60}% of ${peer[u.label]}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals against per hour: how much the team gives up with this group on the ice. Lower is better.">Allows</span></dt><dd>{u.xga60.toFixed(2)}</dd><Pips pct={u.pct.xga60 ?? 50} tip={`Stingier than ${u.pct.xga60}% of ${peer[u.label]}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="This group’s share of all expected goals while on the ice. Above 50% means they out-chance opponents.">Share</span></dt><dd>{u.share.toFixed(1)}%</dd><Pips pct={u.pct.share ?? 50} tip={`A better share than ${u.pct.share}% of ${peer[u.label]}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Of the faceoffs this group is on the ice for at either end, the share in the offensive zone.">Off. zone draws</span></dt><dd>{u.oz === null ? '–' : `${u.oz}%`}</dd>{u.oz !== null && <Marker pct={u.pct.oz ?? 50} tip={`More offensive-zone faceoffs than ${u.pct.oz}% of ${peer[u.label]}.`} />}</div>
                  </dl>
                </li>
              ))}
            </ul>
          ))}
        </div>
        <h3 class="sub">Last game</h3>
        {lastDiff.length === 0
          ? <p class="note">{ln.last.at_home ? 'Against' : 'At'} {names[ln.last.opponent]}, the team used the same lines and pairs as above.</p>
          : (
            <div class="card worth">
              <p class="mini-h">{ln.last.at_home ? 'Against' : 'At'} {names[ln.last.opponent]}, these groups were different from the usual</p>
              <ul>{lastDiff.map((u) => <li><strong>{u.label}:</strong> {u.players.join(' · ')} ({u.minutes.toFixed(1)} minutes)</li>)}</ul>
            </div>
          )}
      </>
    )}
  </Section>

  <Section id="special" title="Special teams" placeholder={false} takeaway={`Who ${team.place} sends out with a man up and a man down.`}>
    {sp && (
      <>
        <p class="note">Each power-play unit is built around its quarterback, the defenseman running it, plus the four players most often out with him over the last {linesData.window} games ({ln.games} so far). Penalty-kill units are the forwards and defensemen who kill most. The number beside each unit is expected goals per hour, created for a power play and allowed for a penalty kill, pulled toward league average while samples are small. Point at a power-play name to see his shots on the map.</p>
        <div class="st3">
          <div class="card">
            <h4 class="st-h">Power play</h4>
            {sp.pp.map((u, k) => (
              <div class="stunit">
                <p class="stunit-h"><span class="unit-label">{u.label}</span><span class="n term" tabindex="0" data-tip="Share of the team’s power-play time with this unit’s quarterback on the ice. A unit is its quarterback plus the four players most often out with him.">{u.share}% of the time</span><span class="stunit-v">{u.rate.toFixed(1)} <Pips pct={u.pct ?? 50} tip={`Creates ${u.rate.toFixed(1)} expected goals per hour, more than ${u.pct}% of ${k ? 'second' : 'top'} power-play units. ${u.minutes} minutes together.`} /></span></p>
                <ul class="roles-list">{u.players.map((pl) => <li><span><span class="plink" tabindex="0" data-shooter={pl.id}>{pl.name}</span>{pl.both && <span class="n both term" tabindex="0" data-tip="He regularly stays out when the units change, so he is listed on both.">both units</span>}</span>{pl.role && <span class="chip tag" tabindex="0" data-tip={roleTip[pl.role]}>{pl.role}</span>}</li>)}</ul>
              </div>
            ))}
          </div>
          <div class="card mapcard" id="ppmap">
            <p class="map-who" id="map-who" aria-live="polite">&nbsp;</p>
            <ShotMap long team="one" shots={sp.shots} title={`Where ${team.place}’s last ${sp.shots.length} power-play shots came from. Bigger dots are more dangerous.`} />
          </div>
          <div class="card">
            <h4 class="st-h">Penalty kill</h4>
            {sp.pk.map((u, k) => (
              <div class="stunit">
                <p class="stunit-h"><span class="unit-label">{u.label}</span><span class="n term" tabindex="0" data-tip="Share of the team’s shorthanded time when most of this group was on the ice. A unit is the two forwards and two defensemen who kill penalties most (PK1) and the next two of each (PK2).">{u.share}% of the time</span><span class="stunit-v">{u.rate.toFixed(1)} <Pips pct={u.pct ?? 50} tip={`Allows ${u.rate.toFixed(1)} expected goals per hour, stingier than ${u.pct}% of ${k ? 'second' : 'top'} penalty-kill units. ${u.minutes} minutes together.`} /></span></p>
                <ul class="roles-list">{u.players.map((pl) => <li><span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{pl.name}</span></li>)}</ul>
              </div>
            ))}
          </div>
        </div>
        <dl class="tagkey">
          <dt>What the tags mean</dt>
          {Object.entries(roleTip).map(([k, v]) => <dd><span class="chip">{k}</span>{v.slice(k.length + 2)}</dd>)}
        </dl>
      </>
    )}
  </Section>

  <Section id="more" title="Still to come on this page" placeholder={false}>
    <ul class="todo">
      <li><strong>Who plays against whom,</strong> home and road, and how tough each group’s opponents are.</li>
      <li><strong>Goalies:</strong> whether each one is helping or being hung out to dry, his workload, and how steady he is night to night.</li>
      <li><strong>Where the goals come from:</strong> rush, rebounds, power play, turnovers and zone time, for and against.</li>
      <li><strong>What tends to be true when they win.</strong></li>
    </ul>
  </Section>

  <script type="application/json" id="team-games" set:html={JSON.stringify(games)}></script>
  <script type="application/json" id="team-names" set:html={JSON.stringify(names)}></script>
</Base>

<script is:inline>
  (() => {
    const host = document.getElementById('next');
    const me = host.dataset.team, base = host.dataset.base;
    const names = JSON.parse(document.getElementById('team-names').textContent);
    const games = JSON.parse(document.getElementById('team-games').textContent).map((g) => ({ ...g, t: new Date(g.start) })).sort((a, b) => a.t - b.t);
    const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
    const day = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
    const time = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const PREVIEWS = { 2026020163: 'Mock-up preview' };
    const now = new Date();
    const next = games.find((g) => !g.final && g.t > new Date(now - 4 * 3600e3));
    const box = document.getElementById('next-card');
    if (next) {
      const rink = el('div', 'nrink');
      ['rl blue l', 'rl red', 'rl blue r'].forEach((c) => rink.append(el('span', c)));
      rink.append(el('span', 'circle', 'at'));
      [next.away, next.home].forEach((a, i) => {
        const side = el('div', 'side' + (i ? ' home' : ''));
        side.append(el('p', 'abbr' + (a === me ? ' me' : ''), a), el('p', 'full', names[a] ?? a));
        if (i) side.append(el('p', 'lc', 'Has last change'));
        rink.append(side);
      });
      const meta = el('p', 'next-meta', `Next game: ${day.format(next.t)}, ${time.format(next.t)} · ${next.venue ?? ''}`);
      if (PREVIEWS[next.id]) { const a = el('a', 'g-link', PREVIEWS[next.id]); a.href = `${base}preview/${next.id}/`; meta.append(' · ', a); }
      else meta.append(' · Preview coming once the real numbers are ready');
      box.append(rink, meta);
    } else {
      box.append(el('p', 'next-meta', 'No upcoming games on the schedule.'));
    }
    const row = (g) => {
      const li = el('li', 'card game');
      const opp = g.home === me ? g.away : g.home;
      li.append(el('span', 'g-when', day.format(g.t) + (g.final ? '' : ' · ' + time.format(g.t))), el('span', 'g-title', `${g.home === me ? 'vs' : 'at'} ${names[opp] ?? opp}`));
      if (g.final) {
        const s = g.home === me ? [g.hs, g.as] : [g.as, g.hs];
        li.append(el('span', 'g-score', `${s[0] > s[1] ? 'W' : 'L'} ${s[0]}–${s[1]}${g.end && g.end !== 'REG' ? ` (${g.end})` : ''}`));
      } else if (PREVIEWS[g.id]) { const a = el('a', 'g-link', PREVIEWS[g.id]); a.href = `${base}preview/${g.id}/`; li.append(a); }
      else li.append(el('span', 'g-soon', g.venue ?? ''));
      return li;
    };
    document.getElementById('recent').replaceChildren(...games.filter((g) => g.final).slice(-5).reverse().map(row));
    document.getElementById('upcoming').replaceChildren(...games.filter((g) => !g.final && g !== next).slice(0, 5).map(row));
  })();
</script>

<style is:global>
  .team-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin-top: 22px; }
  .team-top h1 { font: 700 clamp(34px, 7vw, 52px) / 1.05 var(--display); letter-spacing: -0.02em; }
  .team-top .rec { font: 600 16px var(--ui); color: var(--ink-2); }
  .jump { font-family: var(--ui); display: flex; gap: 6px; overflow-x: auto; margin: 14px -16px 0; padding: 2px 16px 6px; scrollbar-width: none; }
  .jump a { flex: none; font-size: 13px; font-weight: 500; text-decoration: none; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--rule); background: var(--sheet); }
  .next { margin-top: 18px; }
  .next-meta { font: 400 14px var(--ui); color: var(--ink-2); margin-top: 12px; }
  .cols { display: grid; gap: 0 28px; }
  @media (min-width: 820px) { .cols { grid-template-columns: 1fr 1fr; } }
  .cols .sub { margin-top: 22px; }
  .games { display: grid; gap: 8px; }
  .game { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; align-items: baseline; padding: 12px 16px; border-radius: 14px; }
  .g-when { grid-column: 1 / -1; font: 400 12px var(--ui); color: var(--ink-3); }
  .g-title { font-weight: 600; }
  .g-score { font: 700 16px var(--ui); white-space: nowrap; }
  .g-soon { font: 400 12px var(--ui); color: var(--ink-3); text-align: right; }
  .g-link { font: 600 13px var(--ui); }
  .key .one i { background: var(--ink); }
  .m-season { display: none; }
  html[data-mode='season'] .m-season { display: flex; }
  html[data-mode='season'] .m-blend { display: none; }
  .fpgrid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); }
  .fpc { display: grid; gap: 10px; align-content: start; }
  .fpc-name { font: 600 20px/1.15 var(--display); font-variation-settings: 'SOFT' 100; justify-self: start; }
  .ends { display: flex; justify-content: space-between; gap: 8px; font: italic 400 14px var(--body); color: var(--ink-2); margin-bottom: -4px; }
  .lanes { position: relative; padding: 4px 7px; }
  .lanes::after { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -1px; background: var(--ink); opacity: 0.5; border-radius: 1px; }
  .lane { position: relative; height: 14px; --team: var(--ink); --v: var(--b); --lo: var(--blo); --hi: var(--bhi); }
  html[data-mode='season'] .lane { --v: var(--c); --lo: var(--clo); --hi: var(--chi); }
  .lane::before { content: ''; position: absolute; left: -7px; right: -7px; top: 5px; height: 4px; border-radius: 2px; background: var(--track); }
  .whisk { position: absolute; top: 5px; height: 4px; border-radius: 2px; background: color-mix(in oklab, var(--team) 45%, var(--track)); left: calc(min(var(--lo), var(--v)) * 1%); width: calc((max(var(--hi), var(--v)) - min(var(--lo), var(--v))) * 1%); transition: left 0.35s, width 0.35s; }
  .dot { position: absolute; top: 0; left: calc(var(--v) * 1%); width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--team); box-shadow: 0 0 0 2px var(--sheet); z-index: 1; transition: left 0.35s; }
  @media (prefers-reduced-motion: reduce) { .dot, .whisk { transition: none; } }
  .fpc-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 12px; font: 400 14px/1.4 var(--ui); }
  .fpc-line.m-season { display: none; }
  html[data-mode='season'] .fpc-line.m-season { display: flex; }
  html[data-mode='season'] .fpc-line.m-blend { display: none; }
  .fpc-line em { font-style: normal; color: var(--ink-3); white-space: nowrap; }
  .units2 { align-items: start; }
  .st3 { display: grid; gap: 12px; margin-top: 16px; }
  @media (min-width: 900px) { .st3 { grid-template-columns: 1fr 0.8fr 1fr; } }
  .st3 > .card { display: flex; flex-direction: column; }
  .st3 .stunit { flex: 1; }
  .mapcard { justify-content: center; }
  .st-h { font: 600 16px var(--ui); margin: 0 0 4px; }
  .stunit { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--rule); }
  .stunit-h { display: flex; align-items: center; gap: 10px; }
  .stunit-v { margin-left: auto; font: 600 15px var(--ui); display: inline-flex; align-items: center; gap: 8px; }
  .roles-list { margin-top: 8px; display: grid; gap: 6px; }
  .roles-list li { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 15px; }
  .t-one { --team: var(--ink); }
  .chip.tag { cursor: help; }
  .both { margin-left: 8px; }
  .roles-list .plink[data-shooter]:hover, .roles-list .plink.on { text-decoration-color: var(--ink); }
  .map-who { font: 600 13px var(--ui); color: var(--ink-2); min-height: 20px; margin-bottom: 6px; }
  .tagkey { margin-top: 16px; display: grid; gap: 8px; font: 400 14px/1.45 var(--ui); color: var(--ink-2); }
  .tagkey dt { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); }
  .tagkey dd { display: grid; grid-template-columns: 108px 1fr; gap: 10px; align-items: baseline; }
  .tagkey .chip { justify-self: start; }
  .n { font: 400 12px var(--ui); color: var(--ink-3); }
  .units { display: grid; gap: 14px; }
  .unit-top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .unit-label { font: 700 19px/1 var(--display); }
  .unit-toi { margin-left: auto; font: 400 13px var(--ui); color: var(--ink-2); display: inline-flex; align-items: center; gap: 6px; }
  .unit-toi strong { font-size: 15px; color: var(--ink); }
  .unit-names { font-weight: 600; margin-top: 10px; display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px 10px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--rule); }
  @media (min-width: 480px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stats > div { display: grid; gap: 3px; justify-items: start; }
  .stats dt { font-size: 12px; color: var(--ink-2); }
  .stats dd { font-weight: 600; font-size: 15px; }
  .mini-h { font: 600 11px var(--ui); text-transform: uppercase; letter-spacing: 0.07em; color: var(--ink-3); margin-bottom: 8px; }
  .worth { margin-top: 16px; }
  .worth ul { display: grid; gap: 8px; font: 400 15px/1.5 var(--ui); }
  .tablecard { overflow-x: auto; margin-top: 18px; }
  .lt { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 560px; }
  .lt th, .lt td { text-align: right; padding: 8px 6px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  .lt thead th { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); white-space: normal; }
  .lt th:first-child { text-align: left; }
  .lt tbody th { font-weight: 600; }
  .lt tr.gap > * { border-top: 3px solid var(--line-red); }
