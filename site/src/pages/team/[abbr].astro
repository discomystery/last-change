---
// Team page. Real: next game, results, schedule, last-game lines. Placeholder for now: the fingerprint.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import teams from '../../../public/data/teams.json';
import schedule from '../../../public/data/schedule.json';
import lines from '../../../public/data/last_game_lines.json';
import fpData from '../../../public/data/fingerprints.json';
import goalieData from '../../../public/data/goalies.json';
import howData from '../../../public/data/how_they_win.json';
import Quadrant from '../../components/Quadrant.astro';
import Histogram from '../../components/Histogram.astro';
import linesData from '../../../public/data/lines.json';
import Pips from '../../components/Pips.astro';
import Marker from '../../components/Marker.astro';
import ShotMap from '../../components/ShotMap.astro';
import { clock as mmss } from '../../lib/format';
import { fpInfo, fpGroups, ordinal, goalieTraitInfo } from '../../data/mock';

export function getStaticPaths() {
  return teams.map((t) => ({ params: { abbr: t.abbr } }));
}
const { abbr } = Astro.params;
const base = import.meta.env.BASE_URL;
const team = teams.find((t) => t.abbr === abbr)!;
const names = Object.fromEntries(teams.map((t) => [t.abbr, t.name]));
const games = schedule.games.filter((g) => g.home === abbr || g.away === abbr);
const last = lines.teams.find((t) => t.team === abbr);
type Est = { v: number; pct: number; lo: number; hi: number; rank: number; index: number; raw?: number; raw_rank?: number };
const rawWords: Record<string, string> = { physical: 'hits recorded per 60', forecheck: 'forecheck plays recorded per 60' };
const mine = (fpData.teams as Record<string, { games: number; dims: Record<string, { blend: Est; season: Est }> }>)[abbr!];
const fp = fpData.ready.map((key) => ({ key, ...fpInfo[key], ...mine.dims[key] }));
type Unit = { label: string; players: string[]; minutes: number; seconds: number; toi_sec: number; toi: number; xgf60: number; xga60: number; share: number; oz: number | null; pct: Record<string, number | null>; in_last_game: boolean };
const ln = (linesData.teams as Record<string, { games: number; units: Unit[]; last: { date: string; opponent: string; at_home: boolean; units: { label: string; players: string[]; minutes: number; seconds: number; usual: boolean }[] }; notes: { text: string }[] }>)[abbr!];
const peer: Record<string, string> = { L1: 'first lines', L2: 'second lines', L3: 'third lines', L4: 'fourth lines', P1: 'top pairs', P2: 'second pairs', P3: 'third pairs' };
const roleTip: Record<string, string> = {
  Quarterback: 'Quarterback: the defenseman who runs the unit from the blue line. Each unit is built around its quarterback.',
  Trigger: 'Trigger: the unit’s main shooter. He has produced the most shot danger on the power play over the last two seasons.',
  Distributor: 'Distributor: the main passer. He has the most primary assists on power-play goals over the last two seasons.',
  'Net-front': 'Net-front: at least 40% of his power-play shots come from within 15 feet of the net.',
  Point: 'Point: a second defenseman on the unit, alongside the quarterback.',
};
type SUnit = { label: string; players: { id: number; name: string; role: string | null; both?: boolean; after?: string | null }[]; minutes: number; seconds: number; share: number; rate: number; pct?: number };
const sp = (ln as any)?.special as { pp: SUnit[]; pk: SUnit[]; faceoff: { text: string; player: string } | null; shots: { x: number; y: number; xg: number }[] } | undefined;
type MRow = { label: string; minutes: number; seconds: number; share: (number | null)[]; expected: number[] };
const mu = (ln as any)?.matchups as Record<'all' | 'home' | 'road', { games: number; rows: MRow[] }> | undefined;
const venues = [['all', 'in all games'], ['home', 'at home'], ['road', 'on the road']] as const;
const oppName = ['first', 'second', 'third', 'fourth'];
const heat = (v: number | null) => (v === null ? '' : `background: color-mix(in oklab, var(--ink) ${Math.round(v * 1.5)}%, var(--sheet)); color: ${v >= 36 ? 'var(--sheet)' : 'var(--ink)'}`);
const unitNames = (label: string) => ln.units.find((u) => u.label === label)?.players.join(', ') ?? '';
const lastNames = (label: string) => (ln.units.find((u) => u.label === label)?.players ?? []).map((n) => n.split(' ').slice(1).join(' '));
const standouts = (rows: MRow[]) => rows.filter((r) => r.minutes >= 15).flatMap((r) => r.share.map((v, j) => ({ r, j, v: v ?? 0, gap: (v ?? 0) - r.expected[j] }))).filter((x) => x.gap >= 10).sort((a, b) => b.gap - a.gap).slice(0, 3);
type GMode = { starts: number; shots: number; gsax: number; gsax60: number | null; xga60: number | null; sv: number | null; sa60: number | null; danger: number | null; bd60: number | null; gap: number | null; long_wait: number | null; qs: number | null; rbs: number | null; bins: number[]; tiers: Record<string, { shots: number; sv: number | null }>; pct: Record<string, number | null> };
type Goalie = { id: number; name: string; blend: GMode; season: GMode };
const goalies = ((goalieData.teams as Record<string, Goalie[]>)[abbr!] ?? []);
const lg = goalieData.league as { x: number; y: number }[];
const gx = lg.map((p) => p.x), gy = lg.map((p) => Math.abs(p.y));
const xDom: [number, number] = [Math.min(...gx) - 0.1, Math.max(...gx) + 0.1];
const yMax = Math.max(...gy) + 0.1;
const xMid = [...gx].sort((a, b) => a - b)[Math.floor(gx.length / 2)];
const sgn = (v: number) => (Math.abs(v) < 0.05 ? '0.0' : `${v > 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`);
const svp = (v: number | null) => (v === null ? '–' : v.toFixed(3).replace(/^0/, ''));
const gSay: Record<string, (g: GMode) => string> = {
  gsax: (g) => `${sgn(g.gsax)} goals saved above expected in ${g.starts} ${g.starts === 1 ? 'start' : 'starts'}`,
  busy: (g) => `${g.sa60} shots faced per 60`,
  danger: (g) => `the average shot against is worth ${(g.danger ?? 0).toFixed(3)} expected goals`,
  breakdowns: (g) => `${g.bd60} defensive breakdowns in front of him per 60`,
  gaps: (g) => `a typical wait of ${g.gap} seconds between shots; ${g.long_wait}% come after three quiet minutes`,
  steady: (g) => `a quality start ${g.qs}% of the time`,
};
const gModes = [['blend', 'this season and last'], ['season', 'this season']] as const;
const lastDiff = ln ? ln.last.units.filter((u) => !u.usual) : [];
const asOf = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'America/New_York' }).format(new Date(fpData.generated_at));
const clock = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
// Where the goals come from, and the team's record when the things that go with winning happen.
type Src = { n: number; share: number | null; est: number; lo: number; hi: number; band: (number | null)[] };
type SrcSide = { goals: number; sources: Record<string, Src> };
type Split = { yes: [number, number]; no: [number, number] };
type HowTeam = { sources: Record<'blend' | 'season', Record<'for' | 'against', SrcSide>> | null; wins: Record<'blend' | 'season', { games: number; wins: number; splits: Record<string, Split> }> | null };
const how = (howData.teams as unknown as Record<string, HowTeam>)[abbr!];
const lgSrc = howData.league_sources as Record<string, number>;
const lgWin = howData.league_wins as unknown as Record<string, Split>;
const srcPhrase: Record<string, string> = { other: 'everyday even-strength play', pp: 'the power play', rebound: 'rebounds', en: 'empty nets', turnover: 'turnovers', ea: 'play with the goalie pulled', sh: 'shorthanded play', faceoff: 'faceoff wins' };
const srcInfo: [string, string, string][] = [
  ['other', 'Everyday even-strength play', 'Even-strength goals that were not a rebound and did not come within five seconds of a turnover or an offensive-zone faceoff win. Rush goals land here too: the league’s game data records too little between the blue lines to pick them out.'],
  ['pp', 'Power play', 'Goals scored with more skaters on the ice than the opponent.'],
  ['rebound', 'Rebound', 'Goals scored within three seconds of a teammate’s shot on goal.'],
  ['en', 'Empty net', 'Goals into a net with no goalie in it.'],
  ['turnover', 'Off a turnover', 'Even-strength goals within five seconds of winning the puck (a takeaway, or the opponent’s giveaway) with no stoppage in between.'],
  ['ea', 'Goalie pulled', 'Goals scored with their own goalie off for an extra skater.'],
  ['sh', 'Shorthanded', 'Goals scored with fewer skaters on the ice than the opponent.'],
  ['faceoff', 'Off a faceoff win', 'Even-strength goals within five seconds of winning a faceoff in the offensive zone.'],
];
const srcSides = [['for', `${team.place}’s goals`], ['against', `goals against ${team.place}`]] as const;
const srcMax = (key: string, mode: 'blend' | 'season') => {
  const vals = (['for', 'against'] as const).flatMap((side) => { const x = how.sources?.[mode]?.[side]?.sources[key]; return x ? [x.share ?? 0, x.band[1] ?? 0] : []; });
  return Math.max(lgSrc[key] * 2, ...vals) * 1.08;
};
const srcSay = (side: SrcSide | undefined, which: 'for' | 'against') => {
  if (!side) return '';
  const out = srcInfo.filter(([k]) => { const x = side.sources[k]; return x.share !== null && x.band[0] !== null && (x.share < x.band[0]! || x.share > x.band[1]!); });
  const whose = which === 'for' ? `${team.place}’s goals` : `the goals ${team.place} allows`;
  if (!out.length) return `Every row of ${whose} is within luck’s reach of the league average.`;
  const more = out.filter(([k]) => side.sources[k].share! > side.sources[k].band[1]!).map(([k]) => srcPhrase[k]);
  const fewer = out.filter(([k]) => side.sources[k].share! < side.sources[k].band[0]!).map(([k]) => srcPhrase[k]);
  const list = (a: string[]) => (a.length > 1 ? `${a.slice(0, -1).join(', ')} and ${a[a.length - 1]}` : a[0]);
  return `More than luck would explain: ${[more.length ? `more of ${whose} come from ${list(more)}` : '', fewer.length ? `${more.length ? 'fewer' : `fewer of ${whose} come`} from ${list(fewer)}` : ''].filter(Boolean).join('; ')}.`;
};
const winInfo: [string, string, string][] = [
  ['goalie', 'Goaltending at or above expected', 'Their goalies allowed no more goals than expected from the shots they faced (empty-net time left out).'],
  ['first', 'Scored first', 'They scored the game’s first goal.'],
  ['chances', 'Had the better 5-on-5 chances', 'They created at least as many expected goals as they allowed at 5-on-5, adjusted for score and venue.'],
  ['attempts', 'Out-attempted them at 5-on-5', 'They took at least as many shot attempts as they allowed at 5-on-5, adjusted for score and venue.'],
  ['pp', 'Drew three or more power plays', 'The opponent was shorthanded at least three separate times.'],
];
const pctOf = (x: [number, number]) => (x[0] ? Math.round((100 * x[1]) / x[0]) : null);
const nav = [['next', 'Next game'], ['form', 'Results and schedule'], ['style', 'Style'], ['lines', 'Lines'], ['matchups', 'Matchups'], ['special', 'Special teams'], ['goalies', 'Goalies'], ['sources', 'Goal sources'], ['wins', 'When they win']];
const _ = ordinal;
---
<Base title={team.name} mock={false}>
  <header class="team-top">
    <h1>{team.name}</h1>
    <p class="rec">{team.w}-{team.l}-{team.otl}</p>
  </header>
  <nav class="jump" aria-label="Sections">{nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>

  <section id="next" class="next" data-team={abbr} data-base={base}>
    <div id="next-card"></div>
  </section>

  <Section id="form" title="Results and schedule" placeholder={false}>
    <div class="cols">
      <div><h3 class="sub">Recent results</h3><ul class="games" id="recent"></ul></div>
      <div><h3 class="sub">Coming up</h3><ul class="games" id="upcoming"></ul></div>
    </div>
  </Section>

  <Section id="style" title="Style fingerprint" placeholder={false} takeaway={`How ${team.place} plays, trait by trait, against the rest of the league.`}>
    <div class="key"><span class="one"><i></i>{team.name}</span><span class="avg">League average</span><span class="rng">Likely range</span></div>
    <p class="note m-blend">Real numbers through {asOf}: {mine.games} games this season, blended with last season. Traits that take longer to settle lean more on last season.</p>
    <p class="note m-season">Real numbers through {asOf}, from this season’s {mine.games} games only. Expect these to swing a lot this early, which is why the likely ranges are so wide.</p>
    {fpGroups.map((g) => fp.some((c) => c.group === g) && (
      <>
        <h3 class="sub">{g}</h3>
        <ul class="fpgrid">
          {fp.filter((c) => c.group === g).map((c) => (
            <li class="card fpc">
              <span class="term fpc-name" tabindex="0" data-tip={c.tip}>{c.label}</span>
              <div class="ends"><span>{c.lo}</span><span>{c.hi}</span></div>
              <div class="lanes"><div class="lane" style={`--b:${c.blend.pct};--blo:${c.blend.lo};--bhi:${c.blend.hi};--c:${c.season.pct};--clo:${c.season.lo};--chi:${c.season.hi}`}><span class="whisk"></span><span class="dot"></span></div></div>
              {(['blend', 'season'] as const).map((mode) => (
                <p class={`fpc-line m-${mode}`}>
                  {c[mode].raw === undefined
                    ? <><span>{c.say(c[mode].v)}</span><em>{ordinal(c[mode].rank)} of 32</em></>
                    : <>
                        <span class="a-adj">{c.say(c[mode].index)}</span><em class="a-adj">{ordinal(c[mode].rank)} of 32</em>
                        <span class="a-raw">{c[mode].raw!.toFixed(1)} {rawWords[c.key]}</span><em class="a-raw">{ordinal(c[mode].raw_rank!)} of 32</em>
                      </>}
                </p>
              ))}
            </li>
          ))}
        </ul>
      </>
    ))}
    <p class="note">Forecheck pressure and physicality are shown as arena-adjusted scores; switch “Hits and takeaways” to Raw in the settings to see the numbers as recorded. <a href={`${base}methods/`}>How the arena adjustment works</a>.</p>
  </Section>

  <Section id="lines" title="Lines" placeholder={false} takeaway={ln ? `Who plays together at 5-on-5, and how each group is doing.` : 'No games played yet.'}>
    {ln && (
      <>
        <div class="key">
          <span><span class="pips demo"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i></span>How good, against the same line or pair on other teams</span>
          <span><span class="marker demo"><i style="--p:65"></i></span>How much, low to high (not good or bad)</span>
        </div>
        <p class="note">Lines and pairs are numbered by 5-on-5 ice time together over the team’s last {linesData.window} games ({ln.games} so far this season). With so few games, each group’s results are pulled toward the average for its line number.</p>
        {ln.notes.length > 0 && (
          <div class="card worth">
            <p class="mini-h">Worth knowing</p>
            <ul>{ln.notes.map((n) => <li>{n.text}</li>)}</ul>
          </div>
        )}
        <div class="two units2">
          {[ln.units.filter((u) => u.label[0] === 'L'), ln.units.filter((u) => u.label[0] === 'P')].map((group) => (
            <ul class="units">
              {group.map((u) => (
                <li class="card unit">
                  <div class="unit-top">
                    <span class="unit-label">{u.label}</span>
                    <span class="unit-toi"><strong>{mmss(u.toi_sec)}</strong> a game <Marker pct={u.pct.sec_pg ?? 50} tip={`More 5-on-5 ice time together than ${u.pct.sec_pg}% of ${peer[u.label]}. ${mmss(u.seconds)} together in all.`} /></span>
                  </div>
                  <p class="unit-names">{u.players.map((n) => <span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{n}</span>)}</p>
                  <dl class="stats">
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals for per 60: how much offense the team creates with this group on the ice.">Creates</span></dt><dd>{u.xgf60.toFixed(2)}</dd><Pips pct={u.pct.xgf60 ?? 50} tip={`Creates more than ${u.pct.xgf60}% of ${peer[u.label]}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Expected goals against per 60: how much the team gives up with this group on the ice. Lower is better.">Allows</span></dt><dd>{u.xga60.toFixed(2)}</dd><Pips pct={u.pct.xga60 ?? 50} tip={`Stingier than ${u.pct.xga60}% of ${peer[u.label]}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="This group’s share of all expected goals while on the ice. Above 50% means they out-chance opponents.">Share</span></dt><dd>{u.share.toFixed(1)}%</dd><Pips pct={u.pct.share ?? 50} tip={`A better share than ${u.pct.share}% of ${peer[u.label]}.`} /></div>
                    <div><dt><span class="term" tabindex="0" data-tip="Of the faceoffs this group is on the ice for at either end, the share in the offensive zone.">Off. zone draws</span></dt><dd>{u.oz === null ? '–' : `${u.oz}%`}</dd>{u.oz !== null && <Marker pct={u.pct.oz ?? 50} tip={`More offensive-zone faceoffs than ${u.pct.oz}% of ${peer[u.label]}.`} />}</div>
                  </dl>
                </li>
              ))}
            </ul>
          ))}
        </div>
        <h3 class="sub">Last game</h3>
        {lastDiff.length === 0
          ? <p class="note">{ln.last.at_home ? 'Against' : 'At'} {names[ln.last.opponent]}, the team used the same lines and pairs as above.</p>
          : (
            <div class="card worth">
              <p class="mini-h">{ln.last.at_home ? 'Against' : 'At'} {names[ln.last.opponent]}, these groups were different from the usual</p>
              <ul>{lastDiff.map((u) => <li><strong>{u.label}:</strong> {u.players.join(' · ')} ({mmss(u.seconds)})</li>)}</ul>
            </div>
          )}
      </>
    )}
  </Section>

  <Section id="matchups" title="Who plays against whom" placeholder={false} takeaway={`Which opposing lines each ${team.place} group has actually been out against at 5-on-5.`}>
    {mu && (
      <>
        <div class="pick"><span>Show {team.place}</span>
          <select id="mu-venue" aria-label="Which games">{venues.map(([k, label]) => <option value={k}>{label} ({mu[k].games} {mu[k].games === 1 ? 'game' : 'games'})</option>)}</select>
          <span>with boxes</span>
          <select id="mu-size" aria-label="Box sizes"><option value="share">sized by ice time</option><option value="even">in even columns</option></select>
        </div>
        {venues.map(([k, label], vi) => {
          const top = standouts(mu[k].rows);
          return (
            <div data-venue={k} hidden={vi !== 0}>
              {top.length > 0 && (
                <div class="card worth">
                  <p class="mini-h">Standing out {label}</p>
                  <ul>{top.map((x) => <li><strong>{lastNames(x.r.label).join(', ')}</strong> ({x.r.label}) {x.r.label[0] === 'L' ? 'have' : 'have'} spent {x.v}% of their time against opponents’ {oppName[x.j]} lines. With no line matching it would be about {x.r.expected[x.j]}%.</li>)}</ul>
                </div>
              )}
              <div class="card stripcard">
                {[['L', 'Forward lines'], ['P', 'Defense pairs']].map(([kind, title]) => (
                  <>
                    <h4 class="mini-h">{title} against opposing forward lines</h4>
                    <ul class="strips">
                      {mu[k].rows.filter((r) => r.label[0] === kind).map((r) => (
                        <li class:list={{ thin: r.minutes < 10 }}>
                          <span class="lab" data-tip={`${unitNames(r.label)}. ${mmss(r.seconds)} of 5-on-5 ${label}.`}><b>{r.label}</b>{lastNames(r.label).join(' · ')}</span>
                          <span class="strip">
                            {r.share.map((v, j) => <span style={`--f:${Math.max(v ?? 0, 1)};${heat(v)}`} data-tip={v === null ? 'No ice time yet.' : `${lastNames(r.label).join(', ')} (${r.label}) have spent ${v}% of their 5-on-5 time ${label} against opponents’ ${oppName[j]} lines. With no line matching it would be about ${r.expected[j]}%, because that is how much of the time those lines are on the ice against ${team.place}.`}><i>Opp. L{j + 1}</i>{v === null ? '–' : `${v}%`}</span>)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </>
                ))}
              </div>
            </div>
          );
        })}
        <p class="note">Each strip adds to 100%: it shows how one {team.place} group’s 5-on-5 time is split across the opponent’s four forward lines, numbered the same way as above. Sized by ice time, a wider box means more time against that line; even columns line the boxes up so you can compare groups straight down. At home the coach changes last and picks these matchups; on the road the other coach does. Faded rows have under ten minutes.</p>
        <p class="note"><strong>What “with no line matching” means:</strong> if a coach just rolled his lines and took whoever was out there, each of his groups would face the opponent’s first line about as often as that line is on the ice. If opposing first lines play a third of the time against {team.place}, every {team.place} group would see them for about a third of its shifts. A number well above that means the coach is sending that group out against them on purpose; well below means he is keeping it away.</p>
      </>
    )}
  </Section>

  <Section id="special" title="Special teams" placeholder={false} takeaway={`Who ${team.place} sends out with a man up and a man down.`}>
    {sp && (
      <>
        <p class="note">Each power-play unit is built around its quarterback, the defenseman running it, plus the four players most often out with him over the last {linesData.window} games ({ln.games} so far). Penalty-kill units are the forwards and defensemen who kill most. Each unit’s expected goals per 60 are pulled toward league average while samples are small. Point at a power-play name to see his shots on the map.</p>
        {sp.faceoff && (
          <div class="card worth">
            <p class="mini-h">Worth knowing</p>
            <ul><li>{sp.faceoff.text}</li></ul>
          </div>
        )}
        <div class="st3">
          <div class="card">
            <h4 class="st-h">Power play</h4>
            {sp.pp.map((u, k) => (
              <div class="stunit">
                <p class="stunit-h"><span class="unit-label">{u.label}</span><span class="n term" tabindex="0" data-tip="Share of the team’s power-play time with this unit’s quarterback on the ice. A unit is its quarterback plus the four players most often out with him.">{u.share}% of the time</span></p><p class="stunit-rate"><span>Creates <strong>{u.rate.toFixed(1)}</strong> expected goals per 60</span><Pips pct={u.pct ?? 50} tip={`Creates ${u.rate.toFixed(1)} expected goals per 60, more than ${u.pct}% of ${k ? 'second' : 'top'} power-play units. ${mmss(u.seconds)} on the ice.`} /></p>
                <ul class="roles-list">{u.players.map((pl) => <li><span><span class="plink" tabindex="0" data-shooter={pl.id}>{pl.name}</span>{pl.after && <span class="n both term" tabindex="0" data-tip={`${pl.after} usually takes the faceoff, then changes for ${pl.name} once play is under way. Their ice time is counted together here.`}>({pl.after})</span>}{pl.both && <span class="n both term" tabindex="0" data-tip="He regularly stays out when the units change, so he is listed on both.">both units</span>}</span>{pl.role && <span class="chip tag" tabindex="0" data-tip={roleTip[pl.role]}>{pl.role}</span>}</li>)}</ul>
              </div>
            ))}
          </div>
          <div class="card mapcard" id="ppmap">
            <p class="map-who" id="map-who" aria-live="polite">&nbsp;</p>
            <ShotMap long team="one" shots={sp.shots} title={`Where ${team.place}’s last ${sp.shots.length} power-play shots came from. Bigger dots are more dangerous.`} />
          </div>
          <div class="card">
            <h4 class="st-h">Penalty kill</h4>
            {sp.pk.map((u, k) => (
              <div class="stunit">
                <p class="stunit-h"><span class="unit-label">{u.label}</span><span class="n term" tabindex="0" data-tip="Share of the team’s shorthanded time when most of this group was on the ice. A unit is the two forwards and two defensemen who kill penalties most (PK1) and the next two of each (PK2).">{u.share}% of the time</span></p><p class="stunit-rate"><span>Allows <strong>{u.rate.toFixed(1)}</strong> expected goals per 60</span><Pips pct={u.pct ?? 50} tip={`Allows ${u.rate.toFixed(1)} expected goals per 60, stingier than ${u.pct}% of ${k ? 'second' : 'top'} penalty-kill units. ${mmss(u.seconds)} on the ice.`} /></p>
                <ul class="roles-list">{u.players.map((pl) => <li><span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{pl.name}</span></li>)}</ul>
              </div>
            ))}
          </div>
        </div>
        <dl class="tagkey">
          <dt>What the tags mean</dt>
          {Object.entries(roleTip).map(([k, v]) => <dd><span class="chip">{k}</span>{v.slice(k.length + 2)}</dd>)}
        </dl>
      </>
    )}
  </Section>

  <Section id="goalies" title="Goalies" placeholder={false} takeaway="Is he stopping more than he should, and what is his team asking him to face?">
    {goalies.length > 0 && (
      <>
        <div class="pick"><span>Show</span>
          <select id="g-pick" aria-label="Goalie">{goalies.map((g) => <option value={String(g.id)}>{g.name}</option>)}</select>
        </div>
        {goalies.map((g, gi) => (
          <div data-g={g.id} hidden={gi !== 0}>
            {gModes.map(([mode, words]) => {
              const x = g[mode];
              const few = x.pct.gsax === null;
              return (
                <div class={`gmode m-${mode}`}>
                  <div class="g2">
                    <div class="card gcard">
                      <p class="gname"><span class="plink" tabindex="0" data-tip="Player pages are coming. This name will open his.">{g.name}</span><span class="n">{x.starts} {x.starts === 1 ? 'start' : 'starts'} · {x.shots} shots faced, {words}</span></p>
                      <p class="gbig"><strong>{sgn(x.gsax)}</strong> <span class="term" tabindex="0" data-tip="Goals saved above expected: how many goals he has prevented compared with an average goalie facing the same shots. Positive is good.">goals saved above expected</span> {few ? <span class="n">too few starts to rate</span> : <Pips pct={x.pct.gsax!} tip={`Better than ${x.pct.gsax}% of goalies at stopping more than expected, per 60.`} />}</p>
                      <dl class="gkv">
                        {(['low', 'medium', 'high'] as const).map((t) => <div><dt>{t[0].toUpperCase() + t.slice(1)}-danger save %</dt><dd>{svp(x.tiers[t].sv)} <span class="n">{x.tiers[t].shots} shots</span></dd></div>)}
                        <div><dt><span class="term" tabindex="0" data-tip="Shots on goal he faces per 60.">Shots faced per 60</span></dt><dd>{x.sa60} {!few && <Marker pct={x.pct.busy!} tip={`Busier than ${x.pct.busy}% of goalies.`} />}</dd></div>
                        <div><dt><span class="term" tabindex="0" data-tip="Dangerous rush or turnover chances the team gives up in front of him, per 60 minutes. A stand-in for chances he faces alone; public data cannot see where defenders are.">Defensive breakdowns per 60</span></dt><dd>{x.bd60} {!few && <Marker pct={x.pct.breakdowns!} tip={`His team breaks down in front of him more than ${x.pct.breakdowns}% of goalies’ teams do.`} />}</dd></div>
                        <div><dt><span class="term" tabindex="0" data-tip="Share of starts where he gave his team a fair chance to win: a save percentage at or above league average, or at least .885 on a light night.">Quality starts</span></dt><dd>{x.qs === null ? '–' : `${x.qs}%`} {!few && <Pips pct={x.pct.steady!} tip={`Steadier than ${x.pct.steady}% of goalies.`} />}</dd></div>
                      </dl>
                      <div class="gh"><p class="mini-h">Night to night: goals saved above expected in each start</p><Histogram wide team="one" bins={x.bins.map((n, k) => ({ lo: k - 3, n }))} name={g.name} /></div>
                    </div>
                    <div class="card gmid">
                      <p class="chart-title"><span class="term" tabindex="0" data-tip="Higher means the goalie is stopping more than expected. Further right means his team gives up more in front of him. Grey dots are every goalie with at least ten starts over this season and last; point at one to see who it is. Outlined dots have fewer than ten starts.">Helping, or hung out to dry?</span></p>
                      <Quadrant tall league={lg} xDomain={xDom} yDomain={[-yMax, yMax]} xMid={xMid} highlights={goalies.filter((o) => o.blend.xga60 !== null && o.blend.gsax60 !== null).map((o) => ({ team: 'one', name: o.name, probable: o.blend.starts >= goalieData.min_starts.blend, x: o.blend.xga60!, y: o.blend.gsax60! }))} />
                    </div>
                  </div>
                  <details class="fold">
                    <summary><span class="closed">Show the full picture for {g.name}</span><span class="opened">Hide the full picture</span></summary>
                    <ul class="fpgrid">
                      {goalieTraitInfo.map((t) => (
                        <li class="card fpc">
                          <span class="term fpc-name" tabindex="0" data-tip={t.tip}>{t.label}</span>
                          <div class="ends"><span>{t.lo}</span><span>{t.hi}</span></div>
                          <div class="lanes">{x.pct[t.key] !== null && <div class="lane" style={`--b:${x.pct[t.key]};--blo:${x.pct[t.key]};--bhi:${x.pct[t.key]};--c:${x.pct[t.key]};--clo:${x.pct[t.key]};--chi:${x.pct[t.key]}`}><span class="whisk"></span><span class="dot"></span></div>}{x.pct[t.key] === null && <div class="lane empty"></div>}</div>
                          <p class="gline"><span>{gSay[t.key](x)}</span>{x.pct[t.key] === null && <em>too few starts to place him</em>}</p>
                        </li>
                      ))}
                    </ul>
                    <div class="card gnight">
                      <dl class="gkv">
                        <div><dt><span class="term" tabindex="0" data-tip="Share of starts with a save percentage under .850.">Really bad starts</span></dt><dd>{x.rbs === null ? '–' : `${x.rbs}%`}</dd></div>
                        <div><dt>Overall save %</dt><dd>{svp(x.sv)}</dd></div>
                      </dl>
                    </div>
                  </details>
                </div>
              );
            })}
          </div>
        ))}
        <p class="note">Expected-goal models can’t see passes before a shot, so a goalie whose team gives up a lot of cross-ice passes will look worse here than he really is. Ratings compare him with goalies who have at least {goalieData.min_starts.blend} starts over two seasons, or {goalieData.min_starts.season} this season.</p>
      </>
    )}
  </Section>

  <Section id="sources" title="Where the goals come from" placeholder={false} takeaway={`How ${team.place}’s goals are scored and allowed, against the league average, and how much of any difference luck alone could explain.`}>
    {how?.sources && (
      <>
        <div class="pick"><span>Show</span>
          <select id="src-side" aria-label="Whose goals">{srcSides.map(([k, label]) => <option value={k}>{label}</option>)}</select>
        </div>
        <div class="key t-one">
          <span><i></i>{team.place}</span>
          <span class="avg">League average</span>
          <span class="luck">Where luck alone could put an average team</span>
        </div>
        {srcSides.map(([side], si) => (
          <div data-src={side} hidden={si !== 0}>
            {gModes.map(([mode, words]) => {
              const x = how.sources![mode]?.[side];
              if (!x) return <div class={`gmode m-${mode}`}><p class="note">No goals yet {words}.</p></div>;
              const thin = x.goals < 40;
              return (
                <div class={`gmode m-${mode}`}>
                  <p class="src-say">{srcSay(x, side)}</p>
                  <div class:list={['card', { thin }]}>
                    <ul class="srows t-one">
                      {srcInfo.map(([k, label, tip]) => {
                        const r = x.sources[k], max = srcMax(k, mode), at = (v: number) => `${Math.min(100, (v / max) * 100)}%`;
                        const band = r.band[0] !== null ? `left:${at(r.band[0]!)};width:calc(${at(r.band[1]!)} - ${at(r.band[0]!)})` : '';
                        return (
                          <li>
                            <span class="term srow-name" tabindex="0" data-tip={tip}>{label}</span>
                            <span class="sline" tabindex="0" data-tip={`${r.share}% of ${side === 'for' ? `${team.place}’s goals` : `goals against ${team.place}`} (${r.n} of ${x.goals}) ${words}. League average: ${lgSrc[k]}%. With ${x.goals} goals, luck alone would put a league-average team between ${r.band[0]}% and ${r.band[1]}%. Our best estimate of their true rate: ${r.est}%.`}>
                              {band && <span class="sband" style={band}></span>}
                              <span class="slg" style={`left:${at(lgSrc[k])}`}></span>
                              <span class="sdot" style={`left:${at(r.share ?? 0)}`}></span>
                            </span>
                            <span class="snums"><strong>{r.share}%</strong><span class="n">{r.n} of {x.goals}</span></span>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                  <p class="note">{x.goals} goals {words}{thin ? ', too few to say much: most of any gap from the league is luck' : ''}. Each row has its own scale, so a small source is not squeezed against the left edge.</p>
                </div>
              );
            })}
          </div>
        ))}
        <p class="note">Every goal counts once, in the first of these that applies: empty net, power play, shorthanded, goalie pulled, then rebound, turnover, faceoff win, and everyday play. Teams’ goal mixes differ far less than a single season suggests: over three seasons, most of the gap between one team and another in these rows was luck.</p>
      </>
    )}
  </Section>

  <Section id="wins" title="What tends to be true when they win" placeholder={false} takeaway={`How often ${team.place} wins when each of these happens, and when it doesn’t, beside the league’s record.`}>
    {how?.wins && (
      <>
        <div class="key">
          <span><span class="wdot yes"></span>Win rate when it happened</span>
          <span><span class="wdot no"></span>When it didn’t</span>
          <span><span class="ldot yes"></span><span class="ldot no"></span>The league’s rates, for comparison</span>
        </div>
        {gModes.map(([mode, words]) => {
          const w = how.wins![mode];
          if (!w) return <div class={`gmode m-${mode}`}><p class="note">No games yet {words}.</p></div>;
          return (
            <div class={`gmode m-${mode}`}>
              <div class:list={['card', { thin: w.games < 20 }]}>
                <ul class="srows wrows t-one">
                  {winInfo.map(([k, label, tip]) => {
                    const sp = w.splits[k], lg = lgWin[k];
                    const yes = pctOf(sp.yes), no = pctOf(sp.no), lyes = pctOf(lg.yes)!, lno = pctOf(lg.no)!;
                    const lo = Math.min(yes ?? no ?? 0, no ?? yes ?? 0), hi = Math.max(yes ?? 0, no ?? 0);
                    return (
                      <li>
                        <span class="srow-name"><span class="term" tabindex="0" data-tip={tip}>{label}</span><span class="n">In {sp.yes[0]} of {w.games} games {words}</span></span>
                        <span class="sline" tabindex="0" data-tip={`${team.place} ${words}: won ${yes ?? '–'}% when it happened (${sp.yes[1]} of ${sp.yes[0]}), ${no ?? '–'}% when it didn’t (${sp.no[1]} of ${sp.no[0]}). League over three seasons: ${lyes}% and ${lno}%.`}>
                          {yes !== null && no !== null && <span class="sspan" style={`left:${lo}%;width:${hi - lo}%`}></span>}
                          <span class="ldot yes" style={`left:${lyes}%`}></span>
                          <span class="ldot no" style={`left:${lno}%`}></span>
                          {no !== null && <span class="wdot no" style={`left:${no}%`}></span>}
                          {yes !== null && <span class="wdot yes" style={`left:${yes}%`}></span>}
                        </span>
                        <span class="snums wnums"><span><span class="wdot yes"></span><strong>{yes ?? '–'}%</strong></span><span><span class="wdot no"></span>{no ?? '–'}%</span></span>
                      </li>
                    );
                  })}
                </ul>
              </div>
              <p class="note">{w.wins} wins in {w.games} regular-season games {words}; overtime and shootout wins count as wins. The line runs from 0% to 100% of games won.{w.games < 20 ? ' Too few games yet to read much into these.' : ''}</p>
            </div>
          );
        })}
        <p class="note">These five go with winning across the whole league (over 7,870 team-games, teams win {pctOf(lgWin.first.yes)}% when they score first and {pctOf(lgWin.first.no)}% when they don’t), except power plays: drawing three or more goes with winning no more often than drawing fewer. Teams’ own splits differ from the league’s about as much as luck alone would produce over a season or two, so read these as {team.place}’s record, not as their formula. They describe what has gone along with winning, not what causes it.</p>
      </>
    )}
  </Section>

  <script type="application/json" id="team-games" set:html={JSON.stringify(games)}></script>
  <script type="application/json" id="team-names" set:html={JSON.stringify(names)}></script>
</Base>

<script is:inline>
  (() => {
    const host = document.getElementById('next');
    const me = host.dataset.team, base = host.dataset.base;
    const names = JSON.parse(document.getElementById('team-names').textContent);
    const games = JSON.parse(document.getElementById('team-games').textContent).map((g) => ({ ...g, t: new Date(g.start) })).sort((a, b) => a.t - b.t);
    const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };
    const day = new Intl.DateTimeFormat(undefined, { weekday: 'short', month: 'short', day: 'numeric' });
    const time = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const PREVIEWS = { 2026020163: 'Mock-up preview' };
    const now = new Date();
    const next = games.find((g) => !g.final && g.t > new Date(now - 4 * 3600e3));
    const box = document.getElementById('next-card');
    if (next) {
      const rink = el('div', 'nrink');
      ['rl blue l', 'rl red', 'rl blue r'].forEach((c) => rink.append(el('span', c)));
      rink.append(el('span', 'circle', 'at'));
      [next.away, next.home].forEach((a, i) => {
        const side = el('div', 'side' + (i ? ' home' : ''));
        side.append(el('p', 'abbr' + (a === me ? ' me' : ''), a), el('p', 'full', names[a] ?? a));
        if (i) side.append(el('p', 'lc', 'Has last change'));
        rink.append(side);
      });
      const meta = el('p', 'next-meta', `Next game: ${day.format(next.t)}, ${time.format(next.t)} · ${next.venue ?? ''}`);
      if (PREVIEWS[next.id]) { const a = el('a', 'g-link', PREVIEWS[next.id]); a.href = `${base}preview/${next.id}/`; meta.append(' · ', a); }
      else meta.append(' · Preview coming once the real numbers are ready');
      box.append(rink, meta);
    } else {
      box.append(el('p', 'next-meta', 'No upcoming games on the schedule.'));
    }
    const row = (g) => {
      const li = el('li', 'card game');
      const opp = g.home === me ? g.away : g.home;
      li.append(el('span', 'g-when', day.format(g.t) + (g.final ? '' : ' · ' + time.format(g.t))), el('span', 'g-title', `${g.home === me ? 'vs' : 'at'} ${names[opp] ?? opp}`));
      if (g.final) {
        const s = g.home === me ? [g.hs, g.as] : [g.as, g.hs];
        li.append(el('span', 'g-score', `${s[0] > s[1] ? 'W' : 'L'} ${s[0]}–${s[1]}${g.end && g.end !== 'REG' ? ` (${g.end})` : ''}`));
      } else if (PREVIEWS[g.id]) { const a = el('a', 'g-link', PREVIEWS[g.id]); a.href = `${base}preview/${g.id}/`; li.append(a); }
      else li.append(el('span', 'g-soon', g.venue ?? ''));
      return li;
    };
    document.getElementById('recent').replaceChildren(...games.filter((g) => g.final).slice(-5).reverse().map(row));
    document.getElementById('upcoming').replaceChildren(...games.filter((g) => !g.final && g !== next).slice(0, 5).map(row));
  })();
</script>

<style is:global>
  .team-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; margin-top: 22px; }
  .team-top h1 { font: 700 clamp(34px, 7vw, 52px) / 1.05 var(--display); letter-spacing: -0.02em; }
  .team-top .rec { font: 600 16px var(--ui); color: var(--ink-2); }
  .jump { font-family: var(--ui); display: flex; gap: 6px; overflow-x: auto; margin: 14px -16px 0; padding: 2px 16px 6px; scrollbar-width: none; }
