  html[data-mode='season'] .lane { --v: var(--c); --lo: var(--clo); --hi: var(--chi); }
  .lane::before { content: ''; position: absolute; left: -7px; right: -7px; top: 5px; height: 4px; border-radius: 2px; background: var(--track); }
  .whisk { position: absolute; top: 5px; height: 4px; border-radius: 2px; background: color-mix(in oklab, var(--team) 45%, var(--track)); left: calc(min(var(--lo), var(--v)) * 1%); width: calc((max(var(--hi), var(--v)) - min(var(--lo), var(--v))) * 1%); transition: left 0.35s, width 0.35s; }
  .dot { position: absolute; top: 0; left: calc(var(--v) * 1%); width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: var(--team); box-shadow: 0 0 0 2px var(--sheet); z-index: 1; transition: left 0.35s; }
  @media (prefers-reduced-motion: reduce) { .dot, .whisk { transition: none; } }
  .fpc-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 12px; font: 400 14px/1.4 var(--ui); }
  .fpc-line.m-season { display: none; }
  html[data-mode='season'] .fpc-line.m-season { display: flex; }
  html[data-mode='season'] .fpc-line.m-blend { display: none; }
