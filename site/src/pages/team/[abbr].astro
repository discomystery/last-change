  .gline { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 12px; font: 400 14px/1.4 var(--ui); }
  .gline em { font-style: normal; color: var(--ink-3); }
  .lane.empty::before { opacity: 0.6; }
  .gnight { margin-top: 14px; display: grid; gap: 16px; }
  .gnight { max-width: 520px; }
  .gh { margin-top: 14px; padding: 14px 16px 12px; background: var(--ice); border-radius: 12px; }
  .gh .histo { max-width: none; }
  .chart-title { font: 600 20px/1.15 var(--display); font-variation-settings: 'SOFT' 100; margin-bottom: 8px; }
  .pick { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 20px 0 6px; font: 600 20px var(--display); }
  .pick select { font: 600 17px var(--ui); color: var(--ink); background: var(--sheet); border: 0; border-bottom: 3px solid var(--ink); border-radius: 8px 8px 0 0; padding: 8px 10px; max-width: 100%; cursor: pointer; }
  .stripcard { margin-top: 16px; }
  .strips { display: grid; gap: 8px; margin-bottom: 20px; }
  .strips:last-child { margin-bottom: 0; }
  .strips li { display: grid; grid-template-columns: minmax(150px, 290px) 1fr; align-items: center; gap: 14px; }
  .strips li.thin .strip { opacity: 0.45; }
  .lab { font: 400 14px var(--ui); color: var(--ink-2); cursor: help; }
  .lab b { font-weight: 700; color: var(--ink); margin-right: 8px; }
  .strip { display: flex; gap: 2px; height: 40px; }
  /* --even runs from 0 (sized by share) to 1 (even columns); every box slides in a straight line between the two. */
  .strip > span { flex: calc(var(--f) * (1 - var(--even)) + 25 * var(--even)) 1 0; min-width: 44px; display: flex; flex-direction: column; justify-content: center; align-items: center; border-radius: 4px; font: 600 13px/1.1 var(--ui); overflow: hidden; }
  @property --even { syntax: '<number>'; inherits: true; initial-value: 0; }
  #matchups { --even: 0; transition: --even 0.5s cubic-bezier(0.3, 0.7, 0.2, 1); }
