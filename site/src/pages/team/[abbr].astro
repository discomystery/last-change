  .g-soon { font: 400 12px var(--ui); color: var(--ink-3); text-align: right; }
  .g-link { font: 600 13px var(--ui); }
  .key .one i { background: var(--ink); }
  .m-season { display: none; }
  html[data-mode='season'] .m-season { display: flex; }
  html[data-mode='season'] .m-blend { display: none; }
  .fpgrid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr)); }
  .fpc { display: grid; gap: 10px; align-content: start; }
  .fpc-name { font: 600 20px/1.15 var(--display); font-variation-settings: 'SOFT' 100; justify-self: start; }
