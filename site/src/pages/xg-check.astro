---
// Eye-test page for the in-house expected-goals model: every goal and the best chances from each team's last game.
import Base from '../layouts/Base.astro';
import data from '../../public/data/xg_check.json';
const day = (d: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(d + 'T12:00:00Z'));
const pct = (v: number | null) => (v === null ? '–' : `${Math.round(v * 100)}%`);
---
<Base title="Expected goals check" mock={false}>
  <h1 class="page-h">How dangerous was that chance?</h1>
  <p class="lede">Our own expected-goals model rates every shot by how often shots like it go in. Here is every goal and the eight best chances that didn’t go in, from each team’s most recent game. Pick a game you watched and see whether the ratings match your memory.</p>
  <div class="pick"><span>Show</span>
    <select id="xg-game" aria-label="Game">{data.games.map((g) => <option value={String(g.id)} data-teams={`${g.home} ${g.away}`}>{g.away} at {g.home}, {day(g.date)}</option>)}</select>
  </div>
  {data.games.map((g, i) => (
    <section class="game" data-game={g.id} hidden={i !== 0}>
      <p class="sum">Final: {g.away} {g.as}, {g.home} {g.hs}. Expected goals by our model: {g.away} {g.totals.away.ours.toFixed(1)}, {g.home} {g.totals.home.ours.toFixed(1)}. By MoneyPuck’s: {g.away} {g.totals.away.mp.toFixed(1)}, {g.home} {g.totals.home.mp.toFixed(1)}.</p>
      <div class="card tablecard">
        <table class="xt">
          <thead><tr><th scope="col">When</th><th scope="col">Shooter</th><th scope="col">Shot</th><th scope="col">Situation</th><th scope="col">Just before</th><th scope="col">Our rating</th><th scope="col">MoneyPuck</th></tr></thead>
          <tbody>
            {g.shots.map((s) => (
              <tr class:list={{ goal: s.goal }}>
                <td>{s.when}</td>
                <th scope="row">{s.who} <span class="tm">{s.team}</span>{s.goal && <span class="chip solid">Goal</span>}</th>
                <td>{s.shot}, {s.feet} ft</td><td>{s.strength}</td><td>{s.before}</td>
                <td class="num">{pct(s.ours)}</td><td class="num muted">{pct(s.mp)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
  <p class="note">A rating of 25% means shots like this one go in about one time in four. The model knows where the shot came from, what kind it was, what happened just before, and the manpower. It does not know who took it, who was in net, or whether there was a pass across the slot or a screen.</p>
</Base>

<script is:inline>
  (() => {
    const sel = document.getElementById('xg-game');
    const mine = window.lcPrefs?.get('team');
    const opt = mine && [...sel.options].find((o) => o.dataset.teams.split(' ').includes(mine));
    if (opt) sel.value = opt.value;
    const show = () => document.querySelectorAll('[data-game]').forEach((s) => { s.hidden = s.dataset.game !== sel.value; });
    sel.addEventListener('change', show);
    show();
  })();
</script>

<style>
  .page-h { font: 700 clamp(34px, 7vw, 52px) / 1.05 var(--display); letter-spacing: -0.02em; margin-top: 26px; }
  .lede { color: var(--ink-2); margin-top: 10px; font-size: 18px; }
  .pick { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 24px 0 14px; font: 600 20px var(--display); }
  .pick select { font: 600 17px var(--ui); color: var(--ink); background: var(--sheet); border: 0; border-bottom: 3px solid var(--ink); border-radius: 8px 8px 0 0; padding: 8px 10px; max-width: 100%; }
  .sum { font: 400 15px/1.5 var(--ui); color: var(--ink-2); margin-bottom: 12px; }
  .tablecard { overflow-x: auto; }
  .xt { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 760px; }
  .xt th, .xt td { text-align: left; padding: 9px 8px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  .xt thead th { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-3); }
  .xt tbody th { font-weight: 600; }
  .xt .tm { font-weight: 400; color: var(--ink-3); margin: 0 6px 0 2px; }
  .xt .num { text-align: right; font-weight: 700; font-size: 15px; }
  .xt thead th:nth-last-child(-n + 2) { text-align: right; }
  .xt .muted { font-weight: 400; color: var(--ink-2); }
  .xt tr.goal > * { background: var(--ice); }
  .xt tbody tr:last-child > * { border-bottom: 0; }
</style>
